<Window x:Class="MusicEngineEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:views="clr-namespace:MusicEngineEditor.Views"
        xmlns:controls="clr-namespace:MusicEngineEditor.Controls"
        Title="MusicEngine Editor"
        Icon="/Resources/Icons/CodeEditorLogo.png"
        Height="800" Width="1200"
        MinHeight="500" MinWidth="800"
        Style="{StaticResource DarkWindowStyle}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <!-- Run with Ctrl+Enter or F5 -->
        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding RunCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
        <!-- Stop with Escape -->
        <KeyBinding Key="Escape" Command="{Binding StopCommand}"/>
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding StopCommand}"/>
        <!-- File operations -->
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl+Shift" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewFileCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FindCommand}"/>
        <KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding ReplaceCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding OpenSettingsCommand}"/>
        <!-- Command Palette -->
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding ShowCommandPaletteCommand}"/>
        <!-- Synth Editor toggle is handled in PreviewKeyDown for F4 -->
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Audio Reactive Background Visualizer Layer -->
        <Canvas x:Name="AudioVisualizerCanvas"
                Grid.RowSpan="5"
                IsHitTestVisible="False"
                Panel.ZIndex="-1">

            <!-- Bass Glow (Bottom - Purple/Blue) -->
            <Rectangle x:Name="BassGlow"
                       Canvas.Left="0" Canvas.Bottom="0"
                       Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                       Height="300"
                       IsHitTestVisible="False"
                       Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#4400D9FF" Offset="0"/>
                        <GradientStop Color="#220066FF" Offset="0.3"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Mid Glow (Sides - Cyan/Turquoise) -->
            <Rectangle x:Name="MidGlowLeft"
                       Canvas.Left="0" Canvas.Top="0"
                       Width="150"
                       Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                       IsHitTestVisible="False"
                       Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#3300D9FF" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle x:Name="MidGlowRight"
                       Canvas.Right="0" Canvas.Top="0"
                       Width="150"
                       Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                       IsHitTestVisible="False"
                       Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                        <GradientStop Color="#3300D9FF" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- High Glow (Top - White/Cyan sparkle) -->
            <Rectangle x:Name="HighGlow"
                       Canvas.Left="0" Canvas.Top="0"
                       Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                       Height="200"
                       IsHitTestVisible="False"
                       Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                        <GradientStop Color="#1100D9FF" Offset="0.2"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Center Ambient Pulse -->
            <Ellipse x:Name="AmbientPulse"
                     Width="800" Height="800"
                     IsHitTestVisible="False"
                     Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1500D9FF" Offset="0"/>
                        <GradientStop Color="#0800D9FF" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Custom Title Bar with Menu and Window Controls -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                MouseMove="TitleBar_MouseMove">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Icon + Menu -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- App Logo -->
                    <Image Source="/Resources/Icons/CodeEditorLogo.png" Width="50" Height="800" Margin="8,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>

                    <!-- Menu Bar (integrated into title bar) -->
                    <Menu Background="{DynamicResource MenuBackgroundBrush}"
                          Foreground="{DynamicResource ForegroundBrush}"
                          VerticalAlignment="Center"
                          BorderThickness="0"
                          Padding="0">
                        <Menu.Resources>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Grid>
                                                <Border x:Name="Border"
                                                        Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}"
                                                        CornerRadius="3">
                                                    <ContentPresenter ContentSource="Header"/>
                                                </Border>
                                                <Popup x:Name="PART_Popup"
                                                       Placement="Bottom"
                                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                                                       AllowsTransparency="True"
                                                       Focusable="False"
                                                       PopupAnimation="Fade">
                                                    <Border Background="{DynamicResource MenuBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="2">
                                                        <StackPanel IsItemsHost="True"
                                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#252525"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource BrightForegroundBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSubmenuOpen" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="#303030"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource BrightForegroundBrush}"/>
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="PART_Popup" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Menu.Resources>
                        <MenuItem Header="File">
                            <MenuItem Header="_New Project..." InputGestureText="Ctrl+Shift+N" Click="NewProject_Click"/>
                            <MenuItem Header="_Open Project..." InputGestureText="Ctrl+Shift+O" Click="OpenProject_Click"/>
                            <Separator/>
                            <MenuItem Header="New _File..." InputGestureText="Ctrl+N" Click="NewFile_Click"/>
                            <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveScript_Click"/>
                            <MenuItem Header="Save _All" InputGestureText="Ctrl+Shift+S" Click="SaveAll_Click"/>
                            <Separator/>
                            <MenuItem Header="Recent Projects" x:Name="RecentProjectsMenu"/>
                            <Separator/>
                            <MenuItem Header="_Settings..." InputGestureText="Ctrl+," Click="Settings_Click"/>
                            <Separator/>
                            <MenuItem Header="E_xit" Click="Exit_Click"/>
                        </MenuItem>
                        <MenuItem Header="Edit">
                            <MenuItem Header="_Undo" Command="Undo" InputGestureText="Ctrl+Z"/>
                            <MenuItem Header="_Redo" Command="Redo" InputGestureText="Ctrl+Y"/>
                            <Separator/>
                            <MenuItem Header="Cu_t" Command="Cut" InputGestureText="Ctrl+X"/>
                            <MenuItem Header="_Copy" Command="Copy" InputGestureText="Ctrl+C"/>
                            <MenuItem Header="_Paste" Command="Paste" InputGestureText="Ctrl+V"/>
                            <Separator/>
                            <MenuItem Header="_Find..." InputGestureText="Ctrl+F" Click="Find_Click"/>
                            <MenuItem Header="Find and _Replace..." InputGestureText="Ctrl+H" Click="Replace_Click"/>
                        </MenuItem>
                        <MenuItem Header="View">
                            <!-- Panels Submenu -->
                            <MenuItem Header="_Panels">
                                <MenuItem Header="Project Explorer" IsCheckable="True" IsChecked="True" x:Name="ProjectExplorerMenuItem" Click="ToggleProjectExplorer_Click"/>
                                <MenuItem Header="Workshop" IsCheckable="True" IsChecked="False" x:Name="WorkshopMenuItem" Click="ToggleWorkshop_Click"/>
                                <MenuItem Header="Output" IsCheckable="True" IsChecked="True" x:Name="OutputMenuItem" Click="ToggleOutput_Click"/>
                                <Separator/>
                                <MenuItem Header="MIDI Panel" IsCheckable="True" IsChecked="False" x:Name="MidiPanelMenuItem" Click="ToggleMidiPanel_Click"/>
                                <MenuItem Header="VST Panel" IsCheckable="True" IsChecked="False" x:Name="VstPanelMenuItem" Click="ToggleVstPanel_Click"/>
                                <MenuItem Header="Audio Panel" IsCheckable="True" IsChecked="False" x:Name="AudioPanelMenuItem" Click="ToggleAudioPanel_Click"/>
                                <Separator/>
                                <MenuItem Header="Track Properties" IsCheckable="True" IsChecked="False" x:Name="TrackPropertiesMenuItem" Click="ToggleTrackPropertiesPanel_Click"/>
                                <MenuItem Header="Undo History" IsCheckable="True" IsChecked="False" x:Name="UndoHistoryMenuItem" Click="ToggleUndoHistory_Click"/>
                            </MenuItem>
                            <!-- Editors Submenu -->
                            <MenuItem Header="_Editors">
                                <MenuItem Header="AI Assistant" IsCheckable="True" IsChecked="False" x:Name="AIAssistantMenuItem" Click="ToggleAIAssistant_Click" InputGestureText="F3"/>
                                <MenuItem Header="Synth Editor" IsCheckable="True" IsChecked="False" x:Name="SynthEditorMenuItem" Click="ToggleSynthEditor_Click" InputGestureText="F4"/>
                                <MenuItem Header="Effects Editor" IsCheckable="True" IsChecked="False" x:Name="EffectsEditorMenuItem" Click="ToggleEffectsEditor_Click" InputGestureText="F5"/>
                                <MenuItem Header="Pattern Editor" x:Name="PatternEditorMenuItem" Click="OpenPatternEditor_Click" InputGestureText="F6"/>
                                <MenuItem Header="Mixer" IsCheckable="True" IsChecked="False" x:Name="MixerMenuItem" Click="ToggleMixer_Click" InputGestureText="F7"/>
                                <MenuItem Header="Arrangement" x:Name="ArrangementMenuItem" Click="OpenArrangement_Click" InputGestureText="F8"/>
                                <MenuItem Header="Session View" x:Name="SessionViewMenuItem" Click="OpenSessionView_Click" InputGestureText="Ctrl+Alt+S"/>
                            </MenuItem>
                            <!-- Code View Submenu -->
                            <MenuItem Header="_Code View">
                                <MenuItem Header="Fold All" Click="FoldAll_Click" InputGestureText="Ctrl+Shift+["/>
                                <MenuItem Header="Unfold All" Click="UnfoldAll_Click" InputGestureText="Ctrl+Shift+]"/>
                                <Separator/>
                                <MenuItem Header="Toggle Minimap" IsCheckable="True" IsChecked="True" x:Name="MinimapMenuItem" Click="ToggleMinimap_Click"/>
                            </MenuItem>
                            <Separator/>
                            <!-- Quick Actions Toolbar -->
                            <MenuItem Header="Quick Actions Toolbar" IsCheckable="True" IsChecked="True" x:Name="QuickActionsMenuItem" Click="ToggleQuickActions_Click"/>
                            <Separator/>
                            <!-- Workspace Presets -->
                            <MenuItem Header="_Workspace Presets..." Click="WorkspacePresets_Click" InputGestureText="Ctrl+Shift+W"/>
                            <MenuItem Header="Quick Workspace">
                                <MenuItem Header="Recording" Click="WorkspaceRecording_Click" InputGestureText="Ctrl+1"/>
                                <MenuItem Header="Mixing" Click="WorkspaceMixing_Click" InputGestureText="Ctrl+2"/>
                                <MenuItem Header="Mastering" Click="WorkspaceMastering_Click" InputGestureText="Ctrl+3"/>
                                <MenuItem Header="Editing" Click="WorkspaceEditing_Click" InputGestureText="Ctrl+4"/>
                                <MenuItem Header="Performance" Click="WorkspacePerformance_Click" InputGestureText="Ctrl+5"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Cloud Storage..." Click="CloudStorage_Click"/>
                            <MenuItem Header="Collaboration..." Click="Collaboration_Click"/>
                            <MenuItem Header="Network MIDI..." Click="NetworkMidi_Click"/>
                        </MenuItem>
                        <MenuItem Header="Project">
                            <MenuItem Header="_Add New Script..." Click="AddScript_Click"/>
                            <MenuItem Header="Import _Audio..." Click="ImportAudio_Click"/>
                            <Separator/>
                            <MenuItem Header="Add Project _Reference..." Click="AddReference_Click"/>
                            <Separator/>
                            <MenuItem Header="Project _Settings..." Click="ProjectSettings_Click"/>
                        </MenuItem>
                        <MenuItem Header="Run">
                            <MenuItem Header="_Run" InputGestureText="Ctrl+Enter" Click="RunScript_Click"/>
                            <MenuItem Header="_Stop" InputGestureText="Esc" Click="Stop_Click"/>
                        </MenuItem>
                        <MenuItem Header="Help">
                            <MenuItem Header="_Documentation" Click="Documentation_Click"/>
                            <MenuItem Header="_About" Click="About_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <!-- Center: Window Title -->
                <TextBlock Grid.Column="1" Text="MusicEngine Editor"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12" FontWeight="Normal"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <!-- Right: Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <!-- Minimize Button -->
                    <Button x:Name="MinimizeButton" Click="MinimizeButton_Click"
                            Width="46" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Stretch" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="Transparent">
                                                <Path Data="M 0,0 H 10" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ElementHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximize/Restore Button -->
                    <Button x:Name="MaximizeButton" Click="MaximizeButton_Click"
                            Width="46" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Stretch" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="Transparent">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Maximize icon (square) -->
                                                    <Rectangle x:Name="MaximizeIcon" Width="10" Height="10"
                                                               Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1" Fill="Transparent"/>
                                                    <!-- Restore icon (two overlapping squares) - hidden by default -->
                                                    <Canvas x:Name="RestoreIcon" Width="10" Height="10" Visibility="Collapsed">
                                                        <Rectangle Width="8" Height="8" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1"
                                                                   Fill="Transparent" Canvas.Left="2" Canvas.Top="0"/>
                                                        <Rectangle Width="8" Height="8" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1"
                                                                   Fill="{DynamicResource BackgroundBrush}" Canvas.Left="0" Canvas.Top="2"/>
                                                    </Canvas>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ElementHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Close Button -->
                    <Button x:Name="CloseButton" Click="CloseButton_Click"
                            Width="46" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Stretch" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="Transparent">
                                                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource CloseButtonHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Toolbar -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource ToolbarGradientTopColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource EditorBackgroundColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="10,6">
                <!-- Left: Project Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- New Project -->
                    <Button Style="{StaticResource IconButtonStyle}" Click="NewProject_Click" ToolTip="New Project (Ctrl+Shift+N)">
                        <Grid Width="18" Height="18">
                            <Rectangle Width="12" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>
                            <Path Data="M 4,9 H 14 M 9,4 V 14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                        </Grid>
                    </Button>
                    <!-- Open Project -->
                    <Button Style="{StaticResource IconButtonStyle}" Click="OpenProject_Click" ToolTip="Open Project (Ctrl+Shift+O)" Margin="2,0,0,0">
                        <Path Data="M 2,5 H 6 L 8,3 H 16 V 13 H 2 Z M 2,6 H 16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="16"/>
                    </Button>
                    <!-- Save All -->
                    <Button Style="{StaticResource IconButtonStyle}" Click="SaveAll_Click" ToolTip="Save All (Ctrl+Shift+S)" Margin="2,0,0,0">
                        <Path Data="M 2,2 H 12 L 16,6 V 16 H 2 Z M 4,2 V 6 H 11 V 2 M 4,16 V 11 H 12 V 16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="18"/>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="10,4"/>

                    <!-- Undo Button -->
                    <Button x:Name="UndoButton" Style="{StaticResource IconButtonStyle}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)">
                        <Path Data="M 14,5 A 6,6 0 1 0 14,13 M 14,5 L 11,2 M 14,5 L 11,8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Fill="Transparent" Width="18" Height="16"/>
                    </Button>
                    <!-- Redo Button -->
                    <Button x:Name="RedoButton" Style="{StaticResource IconButtonStyle}" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" Margin="2,0,0,0">
                        <Path Data="M 4,5 A 6,6 0 1 1 4,13 M 4,5 L 7,2 M 4,5 L 7,8"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Fill="Transparent" Width="18" Height="16"/>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="10,4"/>

                    <!-- Transport Controls -->
                    <!-- Run Button (Ctrl+Enter) -->
                    <Button x:Name="RunStopButton" Click="RunStopButton_Click"
                            ToolTip="Run (Ctrl+Enter) - Execute script and start playback"
                            Style="{StaticResource TransportPlayButtonStyle}" MinWidth="70">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RunStopIcon" Text="&#x25B6;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="RunStopText" Text="Run" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <!-- Stop Button -->
                    <Button x:Name="StopButton" Style="{StaticResource IconButtonStyle}" Click="Transport_Stop_Click"
                            ToolTip="Stop (Escape)" Margin="4,0,0,0">
                        <Rectangle Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RadiusX="1" RadiusY="1"/>
                    </Button>

                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="10,4"/>

                    <!-- Live Mode Toggle -->
                    <ToggleButton x:Name="LiveModeToggle" Click="LiveModeToggle_Click"
                                  ToolTip="Live Mode (Ctrl+S auto-reloads script)"
                                  Background="Transparent" BorderThickness="0" Padding="8,4" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveModeIndicator" Width="8" Height="8" Fill="#606060" Margin="0,0,6,0"/>
                            <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SecondaryForegroundBrush}"/>
                        </StackPanel>
                    </ToggleButton>

                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="10,4"/>

                    <!-- Workspace Preset Quick Switcher -->
                    <ComboBox x:Name="WorkspacePresetCombo"
                              Width="140"
                              ToolTip="Quick switch workspace preset (Ctrl+1 to Ctrl+5)"
                              Background="{StaticResource EditorBackgroundBrush}"
                              Foreground="{StaticResource ForegroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              Padding="8,4"
                              SelectionChanged="WorkspacePresetCombo_SelectionChanged">
                        <ComboBoxItem Content="Recording" Tag="Ctrl+1"/>
                        <ComboBoxItem Content="Mixing" Tag="Ctrl+2"/>
                        <ComboBoxItem Content="Mastering" Tag="Ctrl+3"/>
                        <ComboBoxItem Content="Editing" Tag="Ctrl+4"/>
                        <ComboBoxItem Content="Performance" Tag="Ctrl+5"/>
                    </ComboBox>
                </StackPanel>

                <!-- Center: Spacer -->
                <Border Background="Transparent" HorizontalAlignment="Stretch"/>
            </DockPanel>
        </Border>

        <!-- Quick Actions Toolbar (Collapsible) -->
        <controls:QuickActionsToolbar x:Name="QuickActionsToolbar"
                                      Grid.Row="2"
                                      Visibility="Visible"
                                      AIMasterRequested="QuickActionsToolbar_AIMasterRequested"
                                      StemSplitRequested="QuickActionsToolbar_StemSplitRequested"
                                      QuantizeRequested="QuickActionsToolbar_QuantizeRequested"
                                      QuantizeDialogRequested="QuickActionsToolbar_QuantizeDialogRequested"
                                      TransposeRequested="QuickActionsToolbar_TransposeRequested"
                                      DuplicateRequested="QuickActionsToolbar_DuplicateRequested"
                                      SplitRequested="QuickActionsToolbar_SplitRequested"
                                      HideRequested="QuickActionsToolbar_HideRequested"/>

        <!-- Main Content Area -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" x:Name="LeftPanelColumn"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1" x:Name="RightSplitterColumn"/>
                <ColumnDefinition Width="0" MinWidth="0" x:Name="RightPanelColumn"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Project Explorer / Workshop -->
            <Grid Grid.Column="0">
                <!-- Project Explorer Panel - Enhanced DAW Style -->
                <Border x:Name="ProjectExplorerPanel">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#181818" Offset="0"/>
                            <GradientStop Color="#141414" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <!-- Panel Header with Tabs -->
                        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1E1E1E" Offset="0"/>
                                    <GradientStop Color="#181818" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal" Margin="4,0">
                                <!-- Files Tab -->
                                <Border x:Name="FilesTabHeader" Padding="12,8" Cursor="Hand" MouseDown="FilesTab_Click"
                                        Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="{StaticResource AccentBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2,2 H 6 L 7,1 H 12 V 11 H 2 Z" Stroke="{StaticResource AccentBrush}"
                                              StrokeThickness="1.2" Fill="Transparent" Width="14" Height="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="FILES" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrightForegroundBrush}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Presets Tab (Left Panel) -->
                                <Border x:Name="LeftPresetsTabHeader" Padding="12,8" Cursor="Hand" MouseDown="LeftPresetsTab_Click"
                                        Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2,2 H 12 V 4 H 2 Z M 3,4 V 11 H 11 V 4" Stroke="{StaticResource SecondaryForegroundBrush}"
                                              StrokeThickness="1.2" Fill="Transparent" Width="14" Height="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="PRESETS" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Samples Tab -->
                                <Border x:Name="SamplesTabHeader" Padding="12,8" Cursor="Hand" MouseDown="SamplesTab_Click"
                                        Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2,6 Q 4,2 7,6 T 12,6 M 2,9 Q 4,5 7,9 T 12,9" Stroke="{StaticResource SecondaryForegroundBrush}"
                                              StrokeThickness="1.2" Fill="Transparent" Width="14" Height="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="SAMPLES" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SecondaryForegroundBrush}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Refresh Button -->
                                <Button Style="{StaticResource IconButtonStyle}" Click="RefreshProjectTree_Click"
                                        ToolTip="Refresh" Width="26" Height="26" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Path Data="M 7,2 A 5,5 0 1 1 2,7 M 7,2 L 9,4 M 7,2 L 5,4"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.2" Fill="Transparent" Width="12" Height="12"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Files Panel (Project Tree) -->
                        <Grid x:Name="FilesPanel">
                            <TreeView x:Name="ProjectTree"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="6,4"
                                      MouseDoubleClick="ProjectTree_MouseDoubleClick"
                                      VirtualizingPanel.IsVirtualizing="True"/>
                            <!-- Placeholder when empty -->
                            <TextBlock x:Name="FilesPlaceholder" Text="No project loaded"
                                       Foreground="{StaticResource SecondaryForegroundBrush}"
                                       FontSize="11" FontStyle="Italic"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,40,0,0"/>
                        </Grid>

                        <!-- Presets Panel (hidden by default) -->
                        <Grid x:Name="PresetsPanel" Visibility="Collapsed">
                            <TreeView x:Name="PresetsTree"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="6,4"
                                      MouseDoubleClick="PresetsTree_MouseDoubleClick"/>
                            <!-- Placeholder when empty -->
                            <TextBlock x:Name="PresetsPlaceholder" Text="No presets available"
                                       Foreground="{StaticResource SecondaryForegroundBrush}"
                                       FontSize="11" FontStyle="Italic"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,40,0,0"/>
                        </Grid>

                        <!-- Samples Panel (hidden by default) -->
                        <Grid x:Name="SamplesPanel" Visibility="Collapsed">
                            <TreeView x:Name="SamplesTree"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="6,4"
                                      MouseDoubleClick="SamplesTree_MouseDoubleClick"/>
                            <!-- Placeholder when empty -->
                            <TextBlock x:Name="SamplesPlaceholder" Text="No samples loaded"
                                       Foreground="{StaticResource SecondaryForegroundBrush}"
                                       FontSize="11" FontStyle="Italic"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,40,0,0"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Workshop Panel (hidden by default) -->
                <controls:WorkshopPanel x:Name="WorkshopPanel" Visibility="Collapsed"/>
            </Grid>

            <!-- Left Splitter -->
            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                          Background="{StaticResource BorderBrush}"/>

            <!-- Center: Editor + Output -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150"/>
                    <RowDefinition Height="Auto" x:Name="OutputSplitterRow"/>
                    <RowDefinition Height="Auto" x:Name="OutputPanelRow"/>
                </Grid.RowDefinitions>

                <!-- Code Editor Area - Enhanced -->
                <Border Grid.Row="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#141414" Offset="0"/>
                            <GradientStop Color="#121212" Offset="0.1"/>
                            <GradientStop Color="#121212" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <!-- Tab Bar - Enhanced DAW Style with more visual weight -->
                        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#222222" Offset="0"/>
                                    <GradientStop Color="#1A1A1A" Offset="0.5"/>
                                    <GradientStop Color="#161616" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00D9FF" Offset="0"/>
                                    <GradientStop Color="#00D9FF40" Offset="0.3"/>
                                    <GradientStop Color="#2A2A2A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <TabControl x:Name="EditorTabs"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        SelectionChanged="EditorTabs_SelectionChanged">
                                <TabControl.ItemContainerStyle>
                                    <Style TargetType="TabItem">
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TabItem">
                                                    <Border x:Name="Border"
                                                            Background="{TemplateBinding Background}"
                                                            BorderThickness="0,0,1,2"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            Padding="14,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#x1F4C4;" FontSize="12" Margin="0,0,6,0"
                                                                       Foreground="{StaticResource SecondaryForegroundBrush}"/>
                                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                            <Button Content="&#x2715;" Margin="10,0,0,0"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Foreground="{StaticResource SecondaryForegroundBrush}"
                                                                    FontSize="10"
                                                                    Padding="4,2"
                                                                    Cursor="Hand"
                                                                    Click="CloseTab_Click"
                                                                    Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource EditorBackgroundBrush}"/>
                                                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsSelected" Value="False"/>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ElementHoverBrush}"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TabControl.ItemContainerStyle>
                            </TabControl>
                        </Border>

                        <!-- Find/Replace Control -->
                        <controls:FindReplaceControl x:Name="FindReplaceBar" DockPanel.Dock="Top"/>

                        <!-- Code Editor with Minimap -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <avalonedit:TextEditor
                                Grid.Column="0"
                                x:Name="CodeEditor"
                                FontFamily="JetBrains Mono, Cascadia Code, Consolas, Courier New"
                                FontSize="13"
                                ShowLineNumbers="True"
                                Background="{StaticResource EditorBackgroundBrush}"
                                Foreground="{StaticResource ForegroundBrush}"
                                LineNumbersForeground="{StaticResource SecondaryForegroundBrush}"
                                Padding="8,4"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"/>

                            <!-- Minimap Container -->
                            <Border Grid.Column="1" x:Name="MinimapContainer"
                                    Width="80"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1,0,0,0"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Splitter for Output -->
                <GridSplitter Grid.Row="1" Height="1" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                              Background="{StaticResource BorderBrush}" x:Name="OutputSplitter"/>

                <!-- Output Panel (Collapsible) -->
                <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" x:Name="OutputPanel" Height="200">
                    <DockPanel>
                        <!-- Output Header - Enhanced DAW Style with more visual weight -->
                        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#222222" Offset="0"/>
                                    <GradientStop Color="#1A1A1A" Offset="0.5"/>
                                    <GradientStop Color="#161616" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00D9FF" Offset="0"/>
                                    <GradientStop Color="#00D9FF40" Offset="0.3"/>
                                    <GradientStop Color="#2A2A2A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <DockPanel Margin="0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <!-- Output Search Box -->
                                    <Border Background="#0A0A0A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="3"
                                            Margin="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 10,10 L 14,14 M 6,2 A 4,4 0 1 1 6,10 A 4,4 0 1 1 6,2"
                                                  Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="1.2"
                                                  Width="14" Height="14" Margin="6,0,4,0"/>
                                            <TextBox x:Name="OutputSearchBox" Width="120" Background="Transparent"
                                                     BorderThickness="0" Foreground="{StaticResource ForegroundBrush}"
                                                     FontSize="11" Padding="2,4" VerticalAlignment="Center"
                                                     TextChanged="OutputSearchBox_TextChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="4,0"/>

                                    <!-- Log Level Filters -->
                                    <ToggleButton x:Name="FilterInfoButton" IsChecked="True" Click="FilterInfo_Click"
                                                  ToolTip="Show Info" Background="Transparent" BorderThickness="0"
                                                  Width="26" Height="26" Margin="2">
                                        <Ellipse Width="8" Height="8" Fill="#00D9FF"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="FilterWarningButton" IsChecked="True" Click="FilterWarning_Click"
                                                  ToolTip="Show Warnings" Background="Transparent" BorderThickness="0"
                                                  Width="26" Height="26" Margin="2">
                                        <Ellipse Width="8" Height="8" Fill="#FFB800"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="FilterErrorButton" IsChecked="True" Click="FilterError_Click"
                                                  ToolTip="Show Errors" Background="Transparent" BorderThickness="0"
                                                  Width="26" Height="26" Margin="2">
                                        <Ellipse Width="8" Height="8" Fill="#FF4757"/>
                                    </ToggleButton>

                                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="4,0"/>

                                    <Button Content="Clear" Style="{StaticResource ToolbarButtonStyle}"
                                            Click="ClearOutput_Click" FontSize="11" Padding="12,6" Margin="4"/>
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Click="ToggleOutput_Click" ToolTip="Close Output" Margin="0,4,6,4"
                                            Width="26" Height="26">
                                        <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <!-- Output Tab -->
                                    <Border x:Name="OutputTabHeader" Padding="16,10" Cursor="Hand" MouseDown="OutputTab_Click"
                                            CornerRadius="4,4,0,0" Margin="6,4,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 2,10 V 4 L 6,2 V 8 L 2,10 Z M 10,10 V 4 L 14,2 V 8 L 10,10 Z"
                                                  Stroke="White" StrokeThickness="1.2" Fill="Transparent"
                                                  Width="14" Height="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="OUTPUT" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Console Tab -->
                                    <Border x:Name="ConsoleTabHeader" Background="Transparent" Padding="16,10" Cursor="Hand" MouseDown="ConsoleTab_Click"
                                            CornerRadius="4,4,0,0" Margin="2,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 2,2 H 12 V 12 H 2 Z M 4,5 L 6,7 L 4,9 M 7,9 H 10"
                                                  Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="1.2" Fill="Transparent"
                                                  Width="14" Height="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="CONSOLE" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- Errors Tab -->
                                    <Border x:Name="ProblemsTabHeader" Background="Transparent" Padding="16,10" Cursor="Hand" MouseDown="ProblemsTab_Click"
                                            CornerRadius="4,4,0,0" Margin="2,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 8,2 L 14,12 H 2 Z M 8,6 V 8 M 8,10 V 10.5"
                                                  Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="1.5" Fill="Transparent"
                                                  Width="14" Height="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="ERRORS" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" FontWeight="SemiBold"/>
                                            <Border x:Name="ErrorCountBadge" Background="{StaticResource ErrorBrush}" CornerRadius="8"
                                                    Padding="6,2" Margin="8,0,0,0" Visibility="Collapsed">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#FF4757" BlurRadius="4" ShadowDepth="0" Opacity="0.4"/>
                                                </Border.Effect>
                                                <TextBlock x:Name="ErrorCountText" Text="0" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Output/Problems Content -->
                        <Grid>
                            <!-- Output Content -->
                            <RichTextBox x:Name="OutputBox"
                                         Style="{StaticResource OutputRichTextBoxStyle}"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>

                            <!-- User Console -->
                            <TextBox x:Name="UserConsoleBox"
                                     Visibility="Collapsed"
                                     Style="{StaticResource OutputTextBoxStyle}"
                                     TextWrapping="NoWrap"
                                     AcceptsReturn="True"
                                     KeyDown="UserConsoleBox_KeyDown"/>

                            <!-- Errors List -->
                            <ListView x:Name="ProblemsListView" Visibility="Collapsed"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource ForegroundBrush}"
                                      MouseDoubleClick="ProblemsListView_DoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="" Width="24">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Icon}" Foreground="{Binding IconColor}" FontSize="12"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Description" Width="320" DisplayMemberBinding="{Binding Message}"/>
                                        <GridViewColumn Header="Hint" Width="200" DisplayMemberBinding="{Binding Suggestion}"/>
                                        <GridViewColumn Header="File" Width="140" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="Line" Width="50" DisplayMemberBinding="{Binding Line}"/>
                                        <GridViewColumn Header="Col" Width="50" DisplayMemberBinding="{Binding Column}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Right Splitter -->
            <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                          Background="{StaticResource BorderBrush}" x:Name="RightSplitter" Visibility="Collapsed"/>

            <!-- Right Panel (MIDI/VST/Audio) - Enhanced DAW Style -->
            <Border Grid.Column="4" x:Name="RightPanel" Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#181818" Offset="0"/>
                        <GradientStop Color="#141414" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <!-- Panel Header with Tabs - Enhanced DAW Style with more visual weight -->
                    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#222222" Offset="0"/>
                                <GradientStop Color="#1A1A1A" Offset="0.5"/>
                                <GradientStop Color="#161616" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00D9FF" Offset="0"/>
                                <GradientStop Color="#00D9FF40" Offset="0.3"/>
                                <GradientStop Color="#2A2A2A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <DockPanel>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Click="CloseRightPanel_Click" ToolTip="Close Panel" DockPanel.Dock="Right"
                                    Width="28" Height="28" Margin="4,4,6,4">
                                <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <!-- MIDI Tab -->
                                <Border x:Name="MidiTabHeader" Background="{StaticResource AccentBrush}" Padding="14,10" Cursor="Hand" MouseDown="MidiTab_Click"
                                        CornerRadius="4,4,0,0" Margin="6,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2,2 H 10 V 10 H 2 Z M 4,5 H 6 M 4,7 H 8"
                                              Stroke="White" StrokeThickness="1.2" Fill="Transparent"
                                              Width="12" Height="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="MIDI" FontWeight="Bold" Foreground="White" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <!-- VST Tab -->
                                <Border x:Name="VstTabHeader" Background="Transparent" Padding="14,10" Cursor="Hand" MouseDown="VstTab_Click"
                                        CornerRadius="4,4,0,0" Margin="2,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2,4 L 6,2 L 10,4 L 10,10 L 6,12 L 2,10 Z"
                                              Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="1.2" Fill="Transparent"
                                              Width="12" Height="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="VST" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <!-- Audio Tab -->
                                <Border x:Name="AudioTabHeader" Background="Transparent" Padding="14,10" Cursor="Hand" MouseDown="AudioTab_Click"
                                        CornerRadius="4,4,0,0" Margin="2,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2,6 Q 4,4 6,6 T 10,6"
                                              Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="1.5" Fill="Transparent"
                                              Width="12" Height="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="AUDIO" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <!-- Synth Tab -->
                                <Border x:Name="SynthTabHeader" Background="Transparent" Padding="14,10" Cursor="Hand" MouseDown="SynthTab_Click"
                                        CornerRadius="4,4,0,0" Margin="2,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 4,8 L 8,4 L 12,8 L 16,4 M 4,12 L 8,8 L 12,12 L 16,8"
                                              Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="1.5" Fill="Transparent"
                                              Width="12" Height="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="SYNTH" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <!-- Effects Tab -->
                                <Border x:Name="EffectsTabHeader" Background="Transparent" Padding="14,10" Cursor="Hand" MouseDown="EffectsTab_Click"
                                        CornerRadius="4,4,0,0" Margin="2,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 8,2 L 14,8 L 8,14 L 2,8 Z"
                                              Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="1.5" Fill="Transparent"
                                              Width="12" Height="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="EFFECTS" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <!-- Presets Tab -->
                                <Border x:Name="PresetsTabHeader" Background="Transparent" Padding="14,10" Cursor="Hand" MouseDown="PresetsTab_Click"
                                        CornerRadius="4,4,0,0" Margin="2,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2,2 H 12 V 4 H 2 Z M 2,6 H 10 V 8 H 2 Z M 2,10 H 14 V 12 H 2 Z"
                                              Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="1.2" Fill="Transparent"
                                              Width="12" Height="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="PRESETS" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Tab Content -->
                    <Grid>
                        <!-- MIDI Devices Panel -->
                        <Border x:Name="MidiDevicesPanel" Visibility="Visible" Padding="8">
                            <DockPanel>
                                <Button Content="Refresh Devices" Style="{StaticResource ToolbarButtonStyle}"
                                        DockPanel.Dock="Top" Click="RefreshMidiDevices_Click" Margin="0,0,0,8"/>

                                <!-- Section Headers -->
                                <TextBlock DockPanel.Dock="Top" Text="Connected MIDI Devices"
                                           Foreground="{StaticResource SecondaryForegroundBrush}"
                                           FontSize="10" Margin="0,0,0,8"/>

                                <ListBox x:Name="MidiDevicesList" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource ForegroundBrush}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="4" Padding="10,8">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ElementHoverBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#00D9FF"/>
                                                                <Setter TargetName="Border" Property="BorderBrush" Value="#00D9FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Device Name Row -->
                                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                    <!-- Type indicator icon -->
                                                    <TextBlock Text="{Binding TypeIcon}"
                                                               Foreground="{Binding TypeColor}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               Margin="0,0,6,0" FontWeight="Bold"/>
                                                    <!-- Device Name -->
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource BrightForegroundBrush}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Type and Channel Info Row -->
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="18,4,0,0">
                                                    <!-- Type Badge -->
                                                    <Border Background="{Binding TypeColor}" CornerRadius="3"
                                                            Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Type}" Foreground="White"
                                                                   FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <!-- Channel Info -->
                                                    <TextBlock Text="{Binding DisplayChannel}"
                                                               Foreground="{StaticResource SecondaryForegroundBrush}"
                                                               FontSize="11" VerticalAlignment="Center"/>
                                                    <!-- Device Index (for scripting reference) -->
                                                    <TextBlock Text=" - Index: " Foreground="{StaticResource SecondaryForegroundBrush}"
                                                               FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding DeviceIndex}"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- VST Plugins Panel (Enhanced) -->
                        <controls:VstPluginPanel x:Name="VstPluginsPanel" Visibility="Collapsed"/>

                        <!-- Audio Files Panel -->
                        <Border x:Name="AudioFilesPanel" Visibility="Collapsed" Padding="8"
                                AllowDrop="True" Drop="AudioFilesPanel_Drop" DragOver="AudioFilesPanel_DragOver">
                            <DockPanel>
                                <Button Content="Import Audio" Style="{StaticResource ToolbarButtonStyle}"
                                        DockPanel.Dock="Top" Click="ImportAudio_Click" Margin="0,0,0,8"/>
                                <Border x:Name="AudioDropZone" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="2" CornerRadius="4" Margin="0,0,0,8"
                                        Background="Transparent" Padding="16"
                                        AllowDrop="True" Drop="AudioFilesPanel_Drop" DragOver="AudioFilesPanel_DragOver">
                                    <TextBlock Text="Drop audio files here"
                                               Foreground="{StaticResource SecondaryForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ListView x:Name="AudioFilesList" Background="Transparent" BorderThickness="0"
                                          Foreground="{StaticResource ForegroundBrush}" MouseDoubleClick="AudioFile_DoubleClick">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding Alias}"/>
                                            <GridViewColumn Header="Duration" Width="60" DisplayMemberBinding="{Binding Duration}"/>
                                            <GridViewColumn Header="Format" Width="50" DisplayMemberBinding="{Binding Format}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>

                        <!-- Track Properties Panel -->
                        <controls:TrackPropertiesPanel x:Name="TrackPropertiesPanel" Visibility="Collapsed"
                                                       CloseRequested="TrackPropertiesPanel_CloseRequested"
                                                       TrackPropertyChanged="TrackPropertiesPanel_TrackPropertyChanged"
                                                       TrackDuplicateRequested="TrackPropertiesPanel_TrackDuplicateRequested"
                                                       TrackDeleteRequested="TrackPropertiesPanel_TrackDeleteRequested"
                                                       TrackFreezeRequested="TrackPropertiesPanel_TrackFreezeRequested"/>

                        <!-- Undo History Panel -->
                        <controls:UndoHistoryPanel x:Name="UndoHistoryPanel" Visibility="Collapsed"/>

                        <!-- Synth Editor Panel -->
                        <controls:SynthEditorPanel x:Name="SynthEditorPanel" Visibility="Collapsed"
                                                   CloseRequested="SynthEditorPanel_CloseRequested"/>

                        <!-- Effects Editor Panel -->
                        <controls:EffectsEditorPanel x:Name="EffectsEditorPanel" Visibility="Collapsed"
                                                      CloseRequested="EffectsEditorPanel_CloseRequested"/>

                        <!-- Preset Browser Panel -->
                        <controls:PresetBrowserPanel x:Name="PresetBrowserPanel" Visibility="Collapsed"
                                                      PresetLoadRequested="PresetBrowserPanel_PresetLoadRequested"/>

                        <!-- AI Assistant Panel -->
                        <controls:AIAssistantPanel x:Name="AIAssistantPanel" Visibility="Collapsed"
                                                   CloseRequested="AIAssistantPanel_CloseRequested"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Right Sidebar Tool Buttons - DAW Style -->
            <Border Grid.Column="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#141414" Offset="0"/>
                        <GradientStop Color="#181818" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Vertical" Width="40">
                    <!-- MIDI Devices -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="ToggleMidiPanel_Click"
                            ToolTip="MIDI Devices" Margin="4,6,4,2" x:Name="MidiToolButton">
                        <StackPanel>
                            <Path Data="M 3,2 H 13 V 14 H 3 Z M 5,5 H 7 V 7 H 5 Z M 9,5 H 11 V 7 H 9 Z M 5,9 H 11 V 11 H 5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Fill="Transparent" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>
                    <!-- VST Plugins -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="ToggleVstPanel_Click"
                            ToolTip="VST Plugins" Margin="4,2" x:Name="VstToolButton">
                        <StackPanel>
                            <Path Data="M 2,4 L 8,2 L 14,4 L 14,12 L 8,14 L 2,12 Z M 8,2 V 14 M 2,4 L 8,6 L 14,4"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Fill="Transparent" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>
                    <!-- Audio Files -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="ToggleAudioPanel_Click"
                            ToolTip="Audio Files" Margin="4,2" x:Name="AudioToolButton">
                        <StackPanel>
                            <Path Data="M 2,4 Q 4,2 6,4 T 10,4 T 14,4 M 2,8 Q 4,6 6,8 T 10,8 T 14,8 M 2,12 Q 4,10 6,12 T 10,12 T 14,12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="8,6" Opacity="0.5"/>

                    <!-- Track Properties -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="ToggleTrackPropertiesPanel_Click"
                            ToolTip="Track Properties" Margin="4,2" x:Name="TrackPropertiesToolButton">
                        <StackPanel>
                            <Path Data="M 4,3 H 12 M 4,6 H 10 M 4,9 H 14 M 4,12 H 8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>
                    <!-- Synth Editor -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="ToggleSynthEditor_Click"
                            ToolTip="Synth Editor (F4)" Margin="4,2" x:Name="SynthEditorToolButton">
                        <StackPanel>
                            <Path Data="M 4,8 L 8,4 L 12,8 L 16,4 M 4,12 L 8,8 L 12,12 L 16,8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>
                    <!-- Effects Editor -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="ToggleEffectsEditor_Click"
                            ToolTip="Effects Editor (F5)" Margin="4,2" x:Name="EffectsEditorToolButton">
                        <StackPanel>
                            <Path Data="M 8,2 L 14,8 L 8,14 L 2,8 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>
                    <!-- Preset Browser -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="TogglePresetsPanel_Click"
                            ToolTip="Preset Browser" Margin="4,2" x:Name="PresetBrowserToolButton">
                        <StackPanel>
                            <Path Data="M 2,2 H 12 V 4 H 2 Z M 2,6 H 10 V 8 H 2 Z M 2,10 H 14 V 12 H 2 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="8,6" Opacity="0.5"/>

                    <!-- Output Console -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="ToggleOutput_Click"
                            ToolTip="Output Console" Margin="4,2" x:Name="OutputToolButton">
                        <StackPanel>
                            <Path Data="M 2,2 H 14 V 14 H 2 Z M 4,5 H 10 M 4,8 H 12 M 4,11 H 8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Fill="Transparent" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="8,6" Opacity="0.5"/>

                    <!-- Undo History -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="ToggleUndoHistory_Click"
                            ToolTip="Undo History" Margin="4,2" x:Name="UndoHistoryToolButton">
                        <StackPanel>
                            <Path Data="M 4,8 A 5,5 0 1 1 8,13 M 4,8 L 2,5 M 4,8 L 7,6"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="8,6" Opacity="0.5"/>

                    <!-- Workshop -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="ToggleWorkshop_Click"
                            ToolTip="Workshop Tutorials" Margin="4,2" x:Name="WorkshopToolButton">
                        <StackPanel>
                            <Path Data="M 3,2 H 13 V 4 H 3 Z M 4,4 V 14 H 12 V 4 M 6,7 H 10 M 6,10 H 10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Fill="Transparent" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="8,6" Opacity="0.5"/>

                    <!-- Network & Cloud Features -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="CloudStorage_Click"
                            ToolTip="Cloud Storage" Margin="4,2" x:Name="CloudStorageToolButton">
                        <StackPanel>
                            <Path Data="M 4,10 A 3,3 0 1 1 4,9.9 M 4,10 H 12 A 2,2 0 1 0 12,6 A 4,4 0 0 0 4,6"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>
                    <!-- Collaboration -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="Collaboration_Click"
                            ToolTip="Collaboration" Margin="4,2" x:Name="CollaborationToolButton">
                        <StackPanel>
                            <Path Data="M 5,5 A 2,2 0 1 1 5,4.9 M 11,5 A 2,2 0 1 1 11,4.9 M 3,14 V 12 A 3,3 0 0 1 7,12 M 9,14 V 12 A 3,3 0 0 1 13,12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Fill="Transparent" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>
                    <!-- Network MIDI -->
                    <Button Style="{StaticResource SidebarToolButtonStyle}" Click="NetworkMidi_Click"
                            ToolTip="Network MIDI" Margin="4,2,4,6" x:Name="NetworkMidiToolButton">
                        <StackPanel>
                            <Path Data="M 8,2 V 8 M 4,4 H 12 M 2,8 H 6 V 14 H 2 Z M 10,8 H 14 V 14 H 10 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Fill="Transparent" Width="16" Height="16"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar - Modern DAW Style -->
        <StatusBar Grid.Row="4" Padding="4,0">
            <StatusBar.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1A1A1A" Offset="0"/>
                    <GradientStop Color="#0D0D0D" Offset="1"/>
                </LinearGradientBrush>
            </StatusBar.Background>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <!-- Status Indicator with Glow -->
                    <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#00FF88" Offset="0.3"/>
                                <GradientStop Color="#00CC66" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#00FF88" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold" FontSize="11"/>
                    <Ellipse x:Name="StatusIndicator" Width="0" Height="0" Fill="{StaticResource SuccessBrush}" Visibility="Collapsed"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Background="{StaticResource BorderBrush}" Margin="8,4"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 2,2 H 6 L 7,1 H 12 V 11 H 2 Z"
                          Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="1" Fill="Transparent"
                          Width="12" Height="12" Margin="0,0,6,0"/>
                    <TextBlock x:Name="ProjectNameDisplay" Text="No project loaded"
                               Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="11"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Background="{StaticResource BorderBrush}" Margin="8,4"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 2,2 H 12 V 12 H 2 Z M 4,4 H 10"
                          Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="1" Fill="Transparent"
                          Width="12" Height="12" Margin="0,0,6,0"/>
                    <TextBlock x:Name="FileNameDisplay" Text="" FontSize="11"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <!-- Playback Time Display -->
                    <Border Background="#0A0A0A" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="3" Padding="10,3" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 8,2 A 6,6 0 1 1 8,14 A 6,6 0 1 1 8,2 M 8,4 V 8 H 11"
                                  Stroke="{StaticResource SecondaryForegroundBrush}" StrokeThickness="1.2"
                                  Fill="Transparent" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock x:Name="PlaybackTimeDisplay" Text="00:00.000" FontSize="12"
                                       FontFamily="JetBrains Mono, Consolas" FontWeight="SemiBold"
                                       Foreground="{StaticResource ForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="16" Fill="{StaticResource BorderBrush}" Margin="0,0,12,0"/>

                    <!-- MIDI Activity Indicator -->
                    <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,12,0"
                            ToolTip="MIDI Activity">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MIDI" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryForegroundBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <Border x:Name="MidiActivityIndicator" Width="8" Height="8" CornerRadius="4" Background="#404040">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="MidiActivityGlow" Color="#00D9FF" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                </Border.Effect>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Rectangle Width="1" Height="16" Fill="{StaticResource BorderBrush}" Margin="0,0,12,0"/>

                    <!-- Performance Meter -->
                    <controls:PerformanceMeter x:Name="PerformanceMeterControl"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"/>

                    <Rectangle Width="1" Height="16" Fill="{StaticResource BorderBrush}" Margin="0,0,12,0"/>

                    <!-- Caret Position -->
                    <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="3" Padding="10,3" Margin="0,0,12,0">
                        <TextBlock x:Name="CaretPositionDisplay" Text="Ln 1, Col 1" FontSize="11" FontFamily="JetBrains Mono, Consolas"/>
                    </Border>

                    <Rectangle Width="1" Height="16" Fill="{StaticResource BorderBrush}" Margin="0,0,12,0"/>

                    <!-- Encoding Badge -->
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="8,3">
                        <Border.Effect>
                            <DropShadowEffect Color="#00D9FF" BlurRadius="4" ShadowDepth="0" Opacity="0.2"/>
                        </Border.Effect>
                        <TextBlock Text="UTF-8" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
