<UserControl x:Class="MusicEngineEditor.Controls.PatternEditor.PianoRollControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.PatternEditor"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900"
             Background="#0D0D0D"
             Focusable="True">

    <UserControl.Resources>
        <!-- Dark Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="WhiteKeyColor">#E8E8E8</Color>
        <Color x:Key="BlackKeyColor">#2D2D2D</Color>
        <Color x:Key="GridLineColor">#2A2A2A</Color>
        <Color x:Key="BarLineColor">#3A3A3A</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="WhiteKeyBrush" Color="{StaticResource WhiteKeyColor}"/>
        <SolidColorBrush x:Key="BlackKeyBrush" Color="{StaticResource BlackKeyColor}"/>
        <SolidColorBrush x:Key="GridLineBrush" Color="{StaticResource GridLineColor}"/>
        <SolidColorBrush x:Key="BarLineBrush" Color="{StaticResource BarLineColor}"/>

        <!-- Velocity Gradient (Blue=soft to Red=loud) -->
        <LinearGradientBrush x:Key="VelocityGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0066FF" Offset="0.0"/>
            <GradientStop Color="#00CCFF" Offset="0.25"/>
            <GradientStop Color="#00FF66" Offset="0.5"/>
            <GradientStop Color="#FFCC00" Offset="0.75"/>
            <GradientStop Color="#FF3300" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Drop Shadow for Notes -->
        <DropShadowEffect x:Key="NoteDropShadow"
                          Color="#000000"
                          BlurRadius="4"
                          ShadowDepth="1"
                          Opacity="0.4"/>

        <!-- Glow Effect for Selected Notes -->
        <DropShadowEffect x:Key="SelectedNoteGlow"
                          Color="#00D9FF"
                          BlurRadius="10"
                          ShadowDepth="0"
                          Opacity="0.7"/>

        <!-- Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="ZoomSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0.25"/>
            <Setter Property="Maximum" Value="4"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Piano Key Style -->
        <Style x:Key="PianoKeyStyle" TargetType="Border">
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="0,3,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">

                <!-- Grid Resolution -->
                <TextBlock Text="Grid:"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <ComboBox x:Name="GridResolutionComboBox"
                          Style="{StaticResource ToolbarComboBoxStyle}"
                          SelectionChanged="GridResolutionComboBox_SelectionChanged">
                    <ComboBoxItem Content="1/4" Tag="0.25" IsSelected="True"/>
                    <ComboBoxItem Content="1/8" Tag="0.125"/>
                    <ComboBoxItem Content="1/16" Tag="0.0625"/>
                    <ComboBoxItem Content="1/32" Tag="0.03125"/>
                </ComboBox>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="8,4"/>

                <!-- Quantize Button -->
                <Button Content="Quantize"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="QuantizeButton_Click"
                        ToolTip="Quantize selected notes to grid"/>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="8,4"/>

                <!-- Snap Toggle -->
                <ToggleButton x:Name="SnapToggleButton"
                              Content="Snap"
                              Style="{StaticResource ToolbarToggleStyle}"
                              IsChecked="{Binding IsSnapEnabled, Mode=TwoWay}"
                              ToolTip="Toggle snap to grid"/>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="8,4"/>

                <!-- Zoom Controls -->
                <TextBlock Text="Zoom:"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <Button Content="-"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="24"
                        Click="ZoomOutButton_Click"/>
                <Slider x:Name="ZoomSlider"
                        Style="{StaticResource ZoomSliderStyle}"
                        Value="{Binding HorizontalZoom, Mode=TwoWay}"
                        ValueChanged="ZoomSlider_ValueChanged"/>
                <Button Content="+"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="24"
                        Click="ZoomInButton_Click"/>
                <TextBlock x:Name="ZoomPercentText"
                           Text="100%"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"
                           Width="40"
                           Margin="4,0,0,0"/>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="8,4"/>

                <!-- Selection Actions -->
                <Button Content="Select All"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="SelectAllButton_Click"/>
                <Button Content="Delete"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="DeleteSelectedButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Piano Keyboard (Left Side) -->
            <Border Grid.Column="0"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer x:Name="KeyboardScrollViewer"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <Canvas x:Name="PianoKeyboardCanvas"
                            Background="{StaticResource BackgroundBrush}"
                            MouseLeftButtonDown="PianoKeyboardCanvas_MouseLeftButtonDown"/>
                </ScrollViewer>
            </Border>

            <!-- Note Grid (Main Area) -->
            <Border Grid.Column="1"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0">
                <ScrollViewer x:Name="NoteGridScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              ScrollChanged="NoteGridScrollViewer_ScrollChanged">
                    <Grid>
                        <!-- Grid Lines Canvas (Background) -->
                        <Canvas x:Name="GridLinesCanvas"
                                Background="{StaticResource BackgroundBrush}"
                                ClipToBounds="True"/>

                        <!-- Note Canvas (Foreground) -->
                        <Canvas x:Name="NoteCanvas"
                                Background="Transparent"
                                ClipToBounds="True"
                                MouseLeftButtonDown="NoteCanvas_MouseLeftButtonDown"
                                MouseRightButtonDown="NoteCanvas_MouseRightButtonDown"
                                MouseMove="NoteCanvas_MouseMove"
                                MouseLeave="NoteCanvas_MouseLeave"/>

                        <!-- Ghost Note Preview -->
                        <Canvas x:Name="GhostNoteCanvas"
                                Background="Transparent"
                                ClipToBounds="True"
                                IsHitTestVisible="False"/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"
                           FontSize="11"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Notes: "
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               VerticalAlignment="Center"
                               FontSize="11"/>
                    <TextBlock x:Name="NoteCountText"
                               Text="0"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
