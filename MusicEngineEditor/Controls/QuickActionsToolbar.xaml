<UserControl x:Class="MusicEngineEditor.Controls.QuickActionsToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="36" d:DesignWidth="800"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Theme Colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#808080"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D9FF"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#00FF88"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFB800"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#252525"/>
        <SolidColorBrush x:Key="PressedBrush" Color="#00D9FF"/>

        <!-- Quick Action Button Style -->
        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#404040"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Action Toggle Button Style -->
        <Style x:Key="QuickActionToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Button Style -->
        <Style x:Key="DropdownButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{TemplateBinding Foreground}"
                                      VerticalAlignment="Center"
                                      Margin="6,1,0,0"
                                      Width="8" Height="4"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transpose Increment/Decrement Button Style -->
        <Style x:Key="TransposeButtonStyle" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Delay" Value="300"/>
            <Setter Property="Interval" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separator Style -->
        <Style x:Key="ToolbarSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="8,6"/>
        </Style>

        <!-- Popup Menu Item Style -->
        <Style x:Key="PopupMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.ContextMenu>
        <ContextMenu Background="#1E1E1E" BorderBrush="{StaticResource BorderBrush}">
            <MenuItem Header="Customize Toolbar..." Click="CustomizeToolbar_Click"/>
            <Separator/>
            <MenuItem Header="Reset to Defaults" Click="ResetToDefaults_Click"/>
            <Separator/>
            <MenuItem Header="Hide Quick Actions" Click="HideToolbar_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Quick Actions Label -->
            <TextBlock Grid.Column="0"
                       Text="QUICK ACTIONS"
                       Foreground="{StaticResource SecondaryForegroundBrush}"
                       FontSize="9"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <!-- Action Buttons Container -->
            <StackPanel x:Name="ActionButtonsPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!-- AI Master Button -->
                <Button x:Name="AIMasterButton"
                        Style="{StaticResource QuickActionButtonStyle}"
                        Click="AIMaster_Click"
                        ToolTip="AI Master - Open AI Mastering Assistant">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F9E0;" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="AI Master" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                <!-- Stem Split Button -->
                <Button x:Name="StemSplitButton"
                        Style="{StaticResource QuickActionButtonStyle}"
                        Click="StemSplit_Click"
                        ToolTip="Stem Separation - Split audio into stems">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="14" Height="14" Margin="0,0,6,0">
                            <Path Data="M 0,7 H 5 M 9,7 H 14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"/>
                            <Path Data="M 5,3 L 9,7 L 5,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"/>
                        </Grid>
                        <TextBlock Text="Stem Split" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                <!-- Quantize Dropdown -->
                <Grid>
                    <ToggleButton x:Name="QuantizeDropdownButton"
                                  Style="{StaticResource DropdownButtonStyle}"
                                  ToolTip="Quantize - Align notes to grid">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="M 0,0 V 14 M 4.67,0 V 14 M 9.33,0 V 14 M 14,0 V 14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1"/>
                            </Grid>
                            <TextBlock Text="Quantize" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="QuantizePopup"
                           IsOpen="{Binding IsChecked, ElementName=QuantizeDropdownButton}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PlacementTarget="{Binding ElementName=QuantizeDropdownButton}"
                           Placement="Bottom">
                        <Border Background="#1E1E1E"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,2,0,0">
                            <StackPanel MinWidth="120">
                                <Button Style="{StaticResource PopupMenuItemStyle}"
                                        Content="25% Strength"
                                        Tag="0.25"
                                        Click="QuantizePreset_Click"/>
                                <Button Style="{StaticResource PopupMenuItemStyle}"
                                        Content="50% Strength"
                                        Tag="0.5"
                                        Click="QuantizePreset_Click"/>
                                <Button Style="{StaticResource PopupMenuItemStyle}"
                                        Content="75% Strength"
                                        Tag="0.75"
                                        Click="QuantizePreset_Click"/>
                                <Button Style="{StaticResource PopupMenuItemStyle}"
                                        Content="100% Strength"
                                        Tag="1.0"
                                        Click="QuantizePreset_Click"/>
                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="8,4"/>
                                <Button Style="{StaticResource PopupMenuItemStyle}"
                                        Content="Open Quantize Dialog..."
                                        Click="QuantizeDialog_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                <!-- Transpose Controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="Transpose - Shift notes up/down by semitones">
                    <Grid Width="14" Height="14" Margin="0,0,6,0">
                        <Path Data="M 7,0 L 7,14 M 3,4 L 7,0 L 11,4 M 3,10 L 7,14 L 11,10"
                              Stroke="{StaticResource SecondaryForegroundBrush}"
                              StrokeThickness="1.5"/>
                    </Grid>
                    <RepeatButton x:Name="TransposeDownButton"
                                  Style="{StaticResource TransposeButtonStyle}"
                                  Content="-"
                                  Click="TransposeDown_Click"/>
                    <TextBlock x:Name="TransposeValueText"
                               Text="0"
                               Width="24"
                               TextAlignment="Center"
                               Foreground="{StaticResource ForegroundBrush}"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <RepeatButton x:Name="TransposeUpButton"
                                  Style="{StaticResource TransposeButtonStyle}"
                                  Content="+"
                                  Click="TransposeUp_Click"/>
                    <Button x:Name="TransposeApplyButton"
                            Style="{StaticResource QuickActionButtonStyle}"
                            Content="Apply"
                            Padding="6,4"
                            Margin="4,0,0,0"
                            Click="TransposeApply_Click"
                            ToolTip="Apply transpose to selection"/>
                </StackPanel>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                <!-- Duplicate Button -->
                <Button x:Name="DuplicateButton"
                        Style="{StaticResource QuickActionButtonStyle}"
                        Click="Duplicate_Click"
                        ToolTip="Duplicate - Copy selected clips/notes (Ctrl+D)">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="14" Height="14" Margin="0,0,6,0">
                            <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1.5" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       StrokeThickness="1.5" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Fill="#0D0D0D"/>
                        </Grid>
                        <TextBlock Text="Duplicate" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Button>

                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

                <!-- Split at Playhead Button -->
                <Button x:Name="SplitButton"
                        Style="{StaticResource QuickActionButtonStyle}"
                        Click="Split_Click"
                        ToolTip="Split at Playhead - Split clip at current position (S)">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="14" Height="14" Margin="0,0,6,0">
                            <!-- Scissors icon -->
                            <Path Data="M 2,3 C 2,1 4,1 4,3 C 4,5 2,5 2,3 M 2,11 C 2,9 4,9 4,11 C 4,13 2,13 2,11 M 4,4 L 12,10 M 4,10 L 12,4"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Fill="Transparent"/>
                        </Grid>
                        <TextBlock Text="Split" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Button>

            </StackPanel>

            <!-- Collapse/Settings Button -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SettingsButton"
                        Style="{StaticResource QuickActionButtonStyle}"
                        Click="CustomizeToolbar_Click"
                        ToolTip="Customize Quick Actions"
                        Padding="6,4">
                    <Grid Width="14" Height="14">
                        <!-- Gear icon -->
                        <Path Data="M 7,4 A 3,3 0 1 1 7,10 A 3,3 0 1 1 7,4 M 7,0 V 2 M 7,12 V 14 M 0,7 H 2 M 12,7 H 14 M 2,2 L 3.5,3.5 M 10.5,10.5 L 12,12 M 2,12 L 3.5,10.5 M 10.5,3.5 L 12,2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2"/>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
