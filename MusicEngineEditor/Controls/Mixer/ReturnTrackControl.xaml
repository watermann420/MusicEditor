<UserControl x:Class="MusicEngineEditor.Controls.Mixer.ReturnTrackControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Mixer"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="80"
             Width="80"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <!-- Volume Fader Style -->
        <Style x:Key="VolumeFaderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Minimum" Value="-60"/>
            <Setter Property="Maximum" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="4" Background="{DynamicResource BackgroundBrush}" CornerRadius="2"
                                    HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="24" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF9500" CornerRadius="2"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Rectangle Width="16" Height="2" Fill="#0D0D0D"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pan Knob Style -->
        <Style x:Key="PanKnobStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Minimum" Value="-100"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20">
                            <Border Height="4" Background="{DynamicResource BackgroundBrush}" CornerRadius="2"
                                    VerticalAlignment="Center"/>
                            <Border Width="2" Height="8" Background="#606060"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="10" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF9500" CornerRadius="2"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mute Button Style -->
        <Style x:Key="MuteButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <TextBlock Text="M" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF4040"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF9500"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FX Button Style -->
        <Style x:Key="FXButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <TextBlock Text="FX" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF9500"/>
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF9500"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Return Label -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>   <!-- FX Button -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>   <!-- Pan -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>      <!-- Fader + Meter -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>   <!-- dB Display -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>   <!-- Mute -->
            </Grid.RowDefinitions>

            <!-- Return Label (Different header color - orange for aux/return) -->
            <Border Grid.Row="0" Background="#FF9500" CornerRadius="2" Padding="4,2">
                <TextBlock x:Name="ReturnLabelText" Text="A" FontSize="14"
                           Foreground="#0D0D0D" FontFamily="Segoe UI" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- FX/Effects Chain Button -->
            <Button x:Name="FXButton" Grid.Row="2" Style="{StaticResource FXButtonStyle}"
                    Click="FXButton_Click" ToolTip="Open Effects Chain"
                    HorizontalAlignment="Center"/>

            <!-- Pan Control -->
            <StackPanel Grid.Row="4">
                <TextBlock Text="PAN" FontSize="8" Foreground="#606060"
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <Slider x:Name="PanSlider" Style="{StaticResource PanKnobStyle}"
                        Value="0" ValueChanged="PanSlider_ValueChanged"/>
                <TextBlock x:Name="PanValueText" Text="C" FontSize="8" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Fader and Meter -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>

                <!-- Volume Fader -->
                <Slider x:Name="VolumeFader" Grid.Column="0"
                        Style="{StaticResource VolumeFaderStyle}"
                        Value="0" ValueChanged="VolumeFader_ValueChanged"/>

                <!-- Level Meter -->
                <local:MeterControl x:Name="LevelMeter" Grid.Column="2"/>
            </Grid>

            <!-- dB Display -->
            <Border Grid.Row="8" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="2">
                <TextBlock x:Name="VolumeDisplay" Text="0.0 dB" FontSize="9"
                           Foreground="#FF9500" FontFamily="Consolas"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Mute Button -->
            <ToggleButton x:Name="MuteButton" Grid.Row="10" Style="{StaticResource MuteButtonStyle}"
                          Checked="MuteButton_Changed" Unchecked="MuteButton_Changed"
                          ToolTip="Mute" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
