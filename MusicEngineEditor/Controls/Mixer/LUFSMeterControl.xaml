<UserControl x:Class="MusicEngineEditor.Controls.Mixer.LUFSMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="80"
             Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Integrated LUFS -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="6,4" CornerRadius="2">
            <StackPanel>
                <TextBlock Text="INT" FontSize="9" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           FontFamily="Segoe UI" FontWeight="SemiBold"/>
                <TextBlock x:Name="IntegratedText" Text="-14.0" FontSize="14"
                           Foreground="{DynamicResource ForegroundBrush}" FontFamily="Consolas" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="LUFS" FontSize="8" Foreground="#606060"
                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Short-term LUFS -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="6,4" CornerRadius="2">
            <StackPanel>
                <TextBlock Text="SHORT" FontSize="9" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           FontFamily="Segoe UI" FontWeight="SemiBold"/>
                <TextBlock x:Name="ShortTermText" Text="-14.0" FontSize="14"
                           Foreground="{DynamicResource ForegroundBrush}" FontFamily="Consolas" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="LUFS" FontSize="8" Foreground="#606060"
                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Momentary LUFS -->
        <Border Grid.Row="4" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="6,4" CornerRadius="2">
            <StackPanel>
                <TextBlock Text="MOM" FontSize="9" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           FontFamily="Segoe UI" FontWeight="SemiBold"/>
                <TextBlock x:Name="MomentaryText" Text="-14.0" FontSize="14"
                           Foreground="{DynamicResource ForegroundBrush}" FontFamily="Consolas" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="LUFS" FontSize="8" Foreground="#606060"
                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- True Peak -->
        <Border Grid.Row="6" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Padding="6,4" CornerRadius="2">
            <StackPanel>
                <TextBlock Text="TP" FontSize="9" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           FontFamily="Segoe UI" FontWeight="SemiBold"/>
                <TextBlock x:Name="TruePeakText" Text="-1.0" FontSize="14"
                           Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="dBTP" FontSize="8" Foreground="#606060"
                           FontFamily="Segoe UI" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- True Peak Warning Indicator -->
        <Border x:Name="TruePeakWarning" Grid.Row="6" Background="#FF4040"
                BorderBrush="#FF0000" BorderThickness="2" CornerRadius="2"
                Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.3"/>
    </Grid>
</UserControl>
