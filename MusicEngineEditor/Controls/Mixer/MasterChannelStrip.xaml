<UserControl x:Class="MusicEngineEditor.Controls.Mixer.MasterChannelStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Mixer"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="100"
             Width="100"
             Background="#1E1E1E">
    <UserControl.Resources>
        <!-- Master Volume Fader Style -->
        <Style x:Key="MasterVolumeFaderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Minimum" Value="-60"/>
            <Setter Property="Maximum" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="6" Background="{DynamicResource BackgroundBrush}" CornerRadius="3"
                                    HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="32" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#00D9FF" CornerRadius="2"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Rectangle Width="24" Height="2" Fill="#0D0D0D"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Base Style -->
        <Style x:Key="ToggleButtonBaseStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Solo Button Style -->
        <Style x:Key="SoloButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFD700"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mute Button Style -->
        <Style x:Key="MuteButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <TextBlock Text="M" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF4040"/>
                                <Setter Property="Foreground" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Effects Button Style -->
        <Style x:Key="EffectsButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2">
                            <TextBlock Text="FX CHAIN" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D9FF"/>
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Accent border on left side -->
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2">
        <Grid>
            <!-- Left accent stripe -->
            <Rectangle Width="3" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>

            <Grid Margin="6,4,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- MASTER Label -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>      <!-- Fader + VU Meter -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>   <!-- LUFS Display -->
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>   <!-- True Peak -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>   <!-- dB Display -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>   <!-- Solo/Mute -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>   <!-- FX Chain Button -->
                </Grid.RowDefinitions>

                <!-- MASTER Label -->
                <Border Grid.Row="0" Background="#00D9FF" CornerRadius="2" Padding="4,3">
                    <TextBlock Text="MASTER" FontSize="11" Foreground="#0D0D0D"
                               FontFamily="Segoe UI" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Fader and Stereo VU Meter -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>      <!-- Fader -->
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>   <!-- Stereo VU Meter -->
                    </Grid.ColumnDefinitions>

                    <!-- Master Volume Fader -->
                    <Slider x:Name="VolumeFader" Grid.Column="0"
                            Style="{StaticResource MasterVolumeFaderStyle}"
                            Value="0" ValueChanged="VolumeFader_ValueChanged"/>

                    <!-- Stereo VU Meter -->
                    <local:MeterControl x:Name="StereoVUMeter" Grid.Column="2" Width="36"/>
                </Grid>

                <!-- LUFS Display (Integrated and Short-term) -->
                <Border Grid.Row="4" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="2" Padding="4,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Integrated LUFS -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="INT" FontSize="7" Foreground="#606060"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="IntegratedLUFSText" Text="-14.0" FontSize="10"
                                       Foreground="{DynamicResource ForegroundBrush}" FontFamily="Consolas" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Short-term LUFS -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="ST" FontSize="7" Foreground="#606060"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ShortTermLUFSText" Text="-14.0" FontSize="10"
                                       Foreground="{DynamicResource ForegroundBrush}" FontFamily="Consolas" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- True Peak Indicator -->
                <Border x:Name="TruePeakBorder" Grid.Row="6" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="2" Padding="4,2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="TP:" FontSize="9" Foreground="#606060"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TruePeakText" Text="-1.0" FontSize="10"
                                   Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="dB" FontSize="8" Foreground="#606060"
                                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- dB Display -->
                <Border Grid.Row="8" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="2" Padding="4,3">
                    <TextBlock x:Name="VolumeDisplay" Text="0.0 dB" FontSize="11"
                               Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Solo/Mute Buttons -->
                <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center">
                    <ToggleButton x:Name="SoloButton" Style="{StaticResource SoloButtonStyle}"
                                  Checked="SoloButton_Changed" Unchecked="SoloButton_Changed"
                                  ToolTip="Solo Master"/>
                    <ToggleButton x:Name="MuteButton" Style="{StaticResource MuteButtonStyle}"
                                  Margin="6,0,0,0"
                                  Checked="MuteButton_Changed" Unchecked="MuteButton_Changed"
                                  ToolTip="Mute Master"/>
                </StackPanel>

                <!-- Effects Chain Button -->
                <Button x:Name="EffectsChainButton" Grid.Row="12"
                        Style="{StaticResource EffectsButtonStyle}"
                        Click="EffectsChainButton_Click"
                        ToolTip="Open Master Effects Chain"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
