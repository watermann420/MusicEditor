<UserControl x:Class="MusicEngineEditor.Controls.Mixer.MixerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Mixer"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800"
             Background="#0D0D0D">
    <UserControl.Resources>
        <!-- ScrollBar Styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#181818"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Add Return Button Style -->
        <Style x:Key="AddReturnButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF9500"/>
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF9500"/>
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF9500"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>           <!-- Channel Strips -->
            <ColumnDefinition Width="2"/>           <!-- Separator -->
            <ColumnDefinition Width="Auto"/>        <!-- Returns Section -->
            <ColumnDefinition Width="Auto"/>        <!-- Vertical Divider before Master -->
            <ColumnDefinition Width="Auto"/>        <!-- Master Channel Strip -->
        </Grid.ColumnDefinitions>

        <!-- Channel Strips ScrollViewer -->
        <ScrollViewer Grid.Column="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Background="#0D0D0D">
            <StackPanel x:Name="ChannelStripContainer"
                        Orientation="Horizontal"
                        Margin="4"/>
        </ScrollViewer>

        <!-- Separator between Channels and Returns -->
        <Rectangle Grid.Column="1" Fill="#2A2A2A"/>

        <!-- Returns Section -->
        <Border Grid.Column="2" Background="#141414" Padding="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Returns Header -->
                    <RowDefinition Height="*"/>     <!-- Return Tracks -->
                </Grid.RowDefinitions>

                <!-- Returns Header -->
                <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="2" Padding="6,4" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="RETURNS" FontSize="10" Foreground="#FF9500"
                                   FontFamily="Segoe UI" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="AddReturnButton" Style="{StaticResource AddReturnButtonStyle}"
                                Margin="8,0,0,0" Click="AddReturnButton_Click"
                                ToolTip="Add Return Track"
                                Width="20" Height="20" FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- Return Tracks Container -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ReturnTrackContainer"
                                Orientation="Horizontal"
                                Margin="2"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Vertical Separator/Divider before Master -->
        <Border Grid.Column="3" Width="6" Background="#0D0D0D" Margin="2,4">
            <Grid>
                <!-- Decorative divider lines -->
                <Rectangle Width="1" Fill="#2A2A2A" HorizontalAlignment="Left"/>
                <Rectangle Width="1" Fill="#2A2A2A" HorizontalAlignment="Right"/>
                <!-- Center accent line -->
                <Rectangle Width="2" Fill="#00D9FF" HorizontalAlignment="Center" Opacity="0.4"/>
            </Grid>
        </Border>

        <!-- Master Channel Strip -->
        <local:MasterChannelStrip x:Name="MasterChannel" Grid.Column="4"
                                  Margin="2,4,4,4"
                                  VolumeChanged="MasterChannel_VolumeChanged"
                                  SoloChanged="MasterChannel_SoloChanged"
                                  MuteChanged="MasterChannel_MuteChanged"
                                  EffectsChainRequested="MasterChannel_EffectsChainRequested"/>
    </Grid>
</UserControl>
