<UserControl x:Class="MusicEngineEditor.Controls.Mixer.ChannelStripControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Mixer"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="80"
             Width="80"
             Background="{DynamicResource PanelBackgroundBrush}">
    <UserControl.Resources>
        <!-- Volume Fader Style -->
        <Style x:Key="VolumeFaderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Minimum" Value="-60"/>
            <Setter Property="Maximum" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="4" Background="{DynamicResource BackgroundBrush}" CornerRadius="2"
                                    HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="24" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Rectangle Width="16" Height="2" Fill="{DynamicResource BackgroundBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pan Knob Style -->
        <Style x:Key="PanKnobStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Minimum" Value="-100"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20">
                            <Border Height="4" Background="{DynamicResource BackgroundBrush}" CornerRadius="2"
                                    VerticalAlignment="Center"/>
                            <Border Width="2" Height="8" Background="{DynamicResource SecondaryForegroundBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="10" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Send Knob Style -->
        <Style x:Key="SendKnobStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Ellipse Width="18" Height="18" Fill="{DynamicResource BackgroundBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/>
                            <Ellipse Width="12" Height="12" Fill="{DynamicResource PanelBackgroundBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="4" Height="4">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Base Style -->
        <Style x:Key="ToggleButtonBaseStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Solo Button Style with Hover Glow -->
        <Style x:Key="SoloButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glowEffect" Color="{DynamicResource WarningColor}"
                                                  BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <TextBlock Text="S" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource WarningBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="8" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.5" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mute Button Style with Hover Glow -->
        <Style x:Key="MuteButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glowEffect" Color="{DynamicResource ErrorColor}"
                                                  BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <TextBlock Text="M" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="8" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.5" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="glowEffect"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Track Name -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>   <!-- Pan -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>      <!-- Fader + Meter -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>   <!-- dB Display -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>   <!-- Solo/Mute -->
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>   <!-- Sends -->
            </Grid.RowDefinitions>

            <!-- Track Name -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="4,2">
                <Grid>
                    <TextBlock x:Name="TrackNameText" Text="Track" FontSize="10"
                               Foreground="{DynamicResource ForegroundBrush}" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MouseLeftButtonDown="TrackNameText_MouseLeftButtonDown"/>
                    <TextBox x:Name="TrackNameEdit" FontSize="10" Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0"
                             HorizontalAlignment="Stretch" VerticalAlignment="Center"
                             TextAlignment="Center" Visibility="Collapsed"
                             LostFocus="TrackNameEdit_LostFocus"
                             KeyDown="TrackNameEdit_KeyDown"/>
                </Grid>
            </Border>

            <!-- Pan Control -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="PAN" FontSize="8" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <Slider x:Name="PanSlider" Style="{StaticResource PanKnobStyle}"
                        Value="0" ValueChanged="PanSlider_ValueChanged"
                        ToolTip="Pan: Stereo position (L to R)"/>
                <TextBlock x:Name="PanValueText" Text="C" FontSize="8" Foreground="{DynamicResource SecondaryForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Fader and Meter -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>

                <!-- Volume Fader -->
                <Slider x:Name="VolumeFader" Grid.Column="0"
                        Style="{StaticResource VolumeFaderStyle}"
                        Value="0" ValueChanged="VolumeFader_ValueChanged"
                        ToolTip="Volume: Track output level (-&#x221E; to +6dB)"/>

                <!-- Level Meter -->
                <local:MeterControl x:Name="LevelMeter" Grid.Column="2"/>
            </Grid>

            <!-- dB Display -->
            <Border Grid.Row="6" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="2">
                <TextBlock x:Name="VolumeDisplay" Text="0.0 dB" FontSize="9"
                           Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Solo/Mute Buttons -->
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center">
                <ToggleButton x:Name="SoloButton" Style="{StaticResource SoloButtonStyle}"
                              Checked="SoloButton_Changed" Unchecked="SoloButton_Changed"
                              ToolTip="Solo: Listen only to this track [S]"/>
                <ToggleButton x:Name="MuteButton" Style="{StaticResource MuteButtonStyle}"
                              Margin="4,0,0,0"
                              Checked="MuteButton_Changed" Unchecked="MuteButton_Changed"
                              ToolTip="Mute: Silence this track [M]"/>
            </StackPanel>

            <!-- Send Knobs -->
            <Border Grid.Row="10" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="2" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="A" FontSize="8" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                        <Slider x:Name="SendASlider" Style="{StaticResource SendKnobStyle}"
                                Value="0" ToolTip="Send A: Aux send level" ValueChanged="SendASlider_ValueChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="B" FontSize="8" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                        <Slider x:Name="SendBSlider" Style="{StaticResource SendKnobStyle}"
                                Value="0" ToolTip="Send B: Aux send level" ValueChanged="SendBSlider_ValueChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="C" FontSize="8" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                        <Slider x:Name="SendCSlider" Style="{StaticResource SendKnobStyle}"
                                Value="0" ToolTip="Send C: Aux send level" ValueChanged="SendCSlider_ValueChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="D" FontSize="8" Foreground="{DynamicResource SecondaryForegroundBrush}" HorizontalAlignment="Center"/>
                        <Slider x:Name="SendDSlider" Style="{StaticResource SendKnobStyle}"
                                Value="0" ToolTip="Send D: Aux send level" ValueChanged="SendDSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
