<UserControl x:Class="MusicEngineEditor.Controls.Effects.ReverbControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="400"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D9FF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#808080"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A"/>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="ParamSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelStyle}" Margin="0">
        <StackPanel>
            <TextBlock Text="REVERB" Style="{StaticResource HeaderStyle}"/>

            <!-- Room Size -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Room Size:" Style="{StaticResource LabelStyle}"/>
                <Slider Grid.Column="1" x:Name="RoomSizeSlider"
                        Value="{Binding RoomSize, Mode=TwoWay, FallbackValue=0.5}"
                        Minimum="0" Maximum="1" Style="{StaticResource ParamSliderStyle}"
                        ValueChanged="RoomSizeSlider_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="RoomSizeValue" Text="0.50"
                           Style="{StaticResource ValueStyle}"/>
            </Grid>

            <!-- Damping -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Damping:" Style="{StaticResource LabelStyle}"/>
                <Slider Grid.Column="1" x:Name="DampingSlider"
                        Value="{Binding Damping, Mode=TwoWay, FallbackValue=0.5}"
                        Minimum="0" Maximum="1" Style="{StaticResource ParamSliderStyle}"
                        ValueChanged="DampingSlider_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="DampingValue" Text="0.50"
                           Style="{StaticResource ValueStyle}"/>
            </Grid>

            <!-- Width -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Width:" Style="{StaticResource LabelStyle}"/>
                <Slider Grid.Column="1" x:Name="WidthSlider"
                        Value="{Binding Width, Mode=TwoWay, FallbackValue=1.0}"
                        Minimum="0" Maximum="1" Style="{StaticResource ParamSliderStyle}"
                        ValueChanged="WidthSlider_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="WidthValue" Text="1.00"
                           Style="{StaticResource ValueStyle}"/>
            </Grid>

            <!-- Pre-Delay -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Pre-Delay:" Style="{StaticResource LabelStyle}"/>
                <Slider Grid.Column="1" x:Name="PreDelaySlider"
                        Value="{Binding PreDelay, Mode=TwoWay, FallbackValue=20}"
                        Minimum="0" Maximum="100" Style="{StaticResource ParamSliderStyle}"
                        ValueChanged="PreDelaySlider_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="PreDelayValue" Text="20 ms"
                           Style="{StaticResource ValueStyle}"/>
            </Grid>

            <!-- Mix -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Mix:" Style="{StaticResource LabelStyle}"/>
                <Slider Grid.Column="1" x:Name="MixSlider"
                        Value="{Binding Mix, Mode=TwoWay, FallbackValue=30}"
                        Minimum="0" Maximum="100" Style="{StaticResource ParamSliderStyle}"
                        ValueChanged="MixSlider_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="MixValue" Text="30%"
                           Style="{StaticResource ValueStyle}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
