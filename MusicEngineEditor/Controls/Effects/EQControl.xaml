<UserControl x:Class="MusicEngineEditor.Controls.Effects.EQControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Effects"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="600"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>

        <!-- Band Colors -->
        <Color x:Key="Band1Color">#FF6B6B</Color>
        <Color x:Key="Band2Color">#FFA500</Color>
        <Color x:Key="Band3Color">#00FF88</Color>
        <Color x:Key="Band4Color">#00D9FF</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

        <SolidColorBrush x:Key="Band1Brush" Color="{StaticResource Band1Color}"/>
        <SolidColorBrush x:Key="Band2Brush" Color="{StaticResource Band2Color}"/>
        <SolidColorBrush x:Key="Band3Brush" Color="{StaticResource Band3Color}"/>
        <SolidColorBrush x:Key="Band4Brush" Color="{StaticResource Band4Color}"/>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Band Header Style -->
        <Style x:Key="BandHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Vertical Slider Style -->
        <Style x:Key="EQVerticalSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="TrackBackground"
                                    Width="4"
                                    Background="{StaticResource BorderBrush}"
                                    CornerRadius="2"
                                    HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Width="4"
                                                        Background="{StaticResource AccentBrush}"
                                                        CornerRadius="0,0,2,2"
                                                        HorizontalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14"
                                                         Fill="{StaticResource AccentBrush}"
                                                         Stroke="{StaticResource BackgroundBrush}"
                                                         StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Horizontal Slider Style -->
        <Style x:Key="EQSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="TrackBackground"
                                    Height="4"
                                    Background="{StaticResource BorderBrush}"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        Background="{StaticResource AccentBrush}"
                                                        CornerRadius="2,0,0,2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14"
                                                         Fill="{StaticResource AccentBrush}"
                                                         Stroke="{StaticResource BackgroundBrush}"
                                                         StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="4-BAND PARAMETRIC EQ" Style="{StaticResource HeaderStyle}" Margin="0,0,0,16"/>

            <!-- Bands -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Band 1 (Low) -->
                <Border Grid.Column="0"
                        Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource Band1Brush}"
                        BorderThickness="2"
                        CornerRadius="4"
                        Margin="4"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="BAND 1" Style="{StaticResource BandHeaderStyle}"
                                   Foreground="{StaticResource Band1Brush}"/>

                        <!-- Frequency -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="FREQ" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="Band1FreqSlider"
                                    Style="{StaticResource EQSliderStyle}"
                                    Minimum="0" Maximum="100" Value="20"
                                    ValueChanged="Band1FreqSlider_ValueChanged"/>
                            <TextBlock x:Name="Band1FreqValue" Text="100 Hz" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Gain -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock Text="GAIN" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="Band1GainSlider"
                                    Style="{StaticResource EQSliderStyle}"
                                    Minimum="0" Maximum="100" Value="50"
                                    ValueChanged="Band1GainSlider_ValueChanged"/>
                            <TextBlock x:Name="Band1GainValue" Text="0.0 dB" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Q -->
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Q" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="Band1QSlider"
                                    Style="{StaticResource EQSliderStyle}"
                                    Minimum="0" Maximum="100" Value="50"
                                    ValueChanged="Band1QSlider_ValueChanged"/>
                            <TextBlock x:Name="Band1QValue" Text="1.0" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Band 2 (Low-Mid) -->
                <Border Grid.Column="1"
                        Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource Band2Brush}"
                        BorderThickness="2"
                        CornerRadius="4"
                        Margin="4"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="BAND 2" Style="{StaticResource BandHeaderStyle}"
                                   Foreground="{StaticResource Band2Brush}"/>

                        <!-- Frequency -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="FREQ" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="Band2FreqSlider"
                                    Style="{StaticResource EQSliderStyle}"
                                    Minimum="0" Maximum="100" Value="40"
                                    ValueChanged="Band2FreqSlider_ValueChanged"/>
                            <TextBlock x:Name="Band2FreqValue" Text="500 Hz" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Gain -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock Text="GAIN" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="Band2GainSlider"
                                    Style="{StaticResource EQSliderStyle}"
                                    Minimum="0" Maximum="100" Value="50"
                                    ValueChanged="Band2GainSlider_ValueChanged"/>
                            <TextBlock x:Name="Band2GainValue" Text="0.0 dB" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Q -->
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Q" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="Band2QSlider"
                                    Style="{StaticResource EQSliderStyle}"
                                    Minimum="0" Maximum="100" Value="50"
                                    ValueChanged="Band2QSlider_ValueChanged"/>
                            <TextBlock x:Name="Band2QValue" Text="1.0" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Band 3 (High-Mid) -->
                <Border Grid.Column="2"
                        Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource Band3Brush}"
                        BorderThickness="2"
                        CornerRadius="4"
                        Margin="4"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="BAND 3" Style="{StaticResource BandHeaderStyle}"
                                   Foreground="{StaticResource Band3Brush}"/>

                        <!-- Frequency -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="FREQ" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="Band3FreqSlider"
                                    Style="{StaticResource EQSliderStyle}"
                                    Minimum="0" Maximum="100" Value="60"
                                    ValueChanged="Band3FreqSlider_ValueChanged"/>
                            <TextBlock x:Name="Band3FreqValue" Text="2.0 kHz" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Gain -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock Text="GAIN" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="Band3GainSlider"
                                    Style="{StaticResource EQSliderStyle}"
                                    Minimum="0" Maximum="100" Value="50"
                                    ValueChanged="Band3GainSlider_ValueChanged"/>
                            <TextBlock x:Name="Band3GainValue" Text="0.0 dB" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Q -->
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Q" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="Band3QSlider"
                                    Style="{StaticResource EQSliderStyle}"
                                    Minimum="0" Maximum="100" Value="50"
                                    ValueChanged="Band3QSlider_ValueChanged"/>
                            <TextBlock x:Name="Band3QValue" Text="1.0" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Band 4 (High) -->
                <Border Grid.Column="3"
                        Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource Band4Brush}"
                        BorderThickness="2"
                        CornerRadius="4"
                        Margin="4"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="BAND 4" Style="{StaticResource BandHeaderStyle}"
                                   Foreground="{StaticResource Band4Brush}"/>

                        <!-- Frequency -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="FREQ" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="Band4FreqSlider"
                                    Style="{StaticResource EQSliderStyle}"
                                    Minimum="0" Maximum="100" Value="80"
                                    ValueChanged="Band4FreqSlider_ValueChanged"/>
                            <TextBlock x:Name="Band4FreqValue" Text="8.0 kHz" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Gain -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock Text="GAIN" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="Band4GainSlider"
                                    Style="{StaticResource EQSliderStyle}"
                                    Minimum="0" Maximum="100" Value="50"
                                    ValueChanged="Band4GainSlider_ValueChanged"/>
                            <TextBlock x:Name="Band4GainValue" Text="0.0 dB" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Q -->
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Q" Style="{StaticResource LabelStyle}"/>
                            <Slider x:Name="Band4QSlider"
                                    Style="{StaticResource EQSliderStyle}"
                                    Minimum="0" Maximum="100" Value="50"
                                    ValueChanged="Band4QSlider_ValueChanged"/>
                            <TextBlock x:Name="Band4QValue" Text="1.0" Style="{StaticResource ValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
