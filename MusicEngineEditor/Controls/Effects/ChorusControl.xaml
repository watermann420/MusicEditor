<UserControl x:Class="MusicEngineEditor.Controls.Effects.ChorusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="400"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D9FF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#808080"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A"/>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="ParamSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelStyle}" Margin="0">
        <StackPanel>
            <TextBlock Text="CHORUS" Style="{StaticResource HeaderStyle}"/>

            <!-- Rate -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Rate:" Style="{StaticResource LabelStyle}"/>
                <Slider Grid.Column="1" x:Name="RateSlider"
                        Value="{Binding Rate, Mode=TwoWay, FallbackValue=1.0}"
                        Minimum="0.1" Maximum="10" Style="{StaticResource ParamSliderStyle}"
                        ValueChanged="RateSlider_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="RateValue" Text="1.00 Hz"
                           Style="{StaticResource ValueStyle}"/>
            </Grid>

            <!-- Depth -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Depth:" Style="{StaticResource LabelStyle}"/>
                <Slider Grid.Column="1" x:Name="DepthSlider"
                        Value="{Binding Depth, Mode=TwoWay, FallbackValue=50}"
                        Minimum="0" Maximum="100" Style="{StaticResource ParamSliderStyle}"
                        ValueChanged="DepthSlider_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="DepthValue" Text="50%"
                           Style="{StaticResource ValueStyle}"/>
            </Grid>

            <!-- Mix -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Mix:" Style="{StaticResource LabelStyle}"/>
                <Slider Grid.Column="1" x:Name="MixSlider"
                        Value="{Binding Mix, Mode=TwoWay, FallbackValue=50}"
                        Minimum="0" Maximum="100" Style="{StaticResource ParamSliderStyle}"
                        ValueChanged="MixSlider_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="MixValue" Text="50%"
                           Style="{StaticResource ValueStyle}"/>
            </Grid>

            <!-- Voices -->
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Voices:" Style="{StaticResource LabelStyle}"/>
                <Slider Grid.Column="1" x:Name="VoicesSlider"
                        Value="{Binding Voices, Mode=TwoWay, FallbackValue=2}"
                        Minimum="1" Maximum="4"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        Style="{StaticResource ParamSliderStyle}"
                        ValueChanged="VoicesSlider_ValueChanged"/>
                <TextBlock Grid.Column="2" x:Name="VoicesValue" Text="2"
                           Style="{StaticResource ValueStyle}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
