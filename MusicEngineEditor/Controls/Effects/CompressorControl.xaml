<UserControl x:Class="MusicEngineEditor.Controls.Effects.CompressorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D9FF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="#808080"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A"/>

        <Style x:Key="ParamSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Main Controls -->
        <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
            <StackPanel>
                <TextBlock Text="COMPRESSOR" Style="{StaticResource HeaderStyle}"/>

                <!-- Threshold -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Threshold:" Style="{StaticResource LabelStyle}"/>
                    <Slider Grid.Column="1" x:Name="ThresholdSlider"
                            Value="{Binding Threshold, Mode=TwoWay, FallbackValue=-20}"
                            Minimum="-60" Maximum="0" Style="{StaticResource ParamSliderStyle}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Threshold, StringFormat='{}{0:F1} dB', FallbackValue='-20.0 dB'}"
                               Style="{StaticResource ValueStyle}"/>
                </Grid>

                <!-- Ratio -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ratio:" Style="{StaticResource LabelStyle}"/>
                    <Slider Grid.Column="1" x:Name="RatioSlider"
                            Value="{Binding Ratio, Mode=TwoWay, FallbackValue=4}"
                            Minimum="1" Maximum="20" Style="{StaticResource ParamSliderStyle}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Ratio, StringFormat='{}{0:F1}:1', FallbackValue='4.0:1'}"
                               Style="{StaticResource ValueStyle}"/>
                </Grid>

                <!-- Attack -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Attack:" Style="{StaticResource LabelStyle}"/>
                    <Slider Grid.Column="1" x:Name="AttackSlider"
                            Value="{Binding Attack, Mode=TwoWay, FallbackValue=10}"
                            Minimum="0.1" Maximum="100" Style="{StaticResource ParamSliderStyle}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Attack, StringFormat='{}{0:F1} ms', FallbackValue='10.0 ms'}"
                               Style="{StaticResource ValueStyle}"/>
                </Grid>

                <!-- Release -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Release:" Style="{StaticResource LabelStyle}"/>
                    <Slider Grid.Column="1" x:Name="ReleaseSlider"
                            Value="{Binding Release, Mode=TwoWay, FallbackValue=100}"
                            Minimum="10" Maximum="1000" Style="{StaticResource ParamSliderStyle}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Release, StringFormat='{}{0:F0} ms', FallbackValue='100 ms'}"
                               Style="{StaticResource ValueStyle}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Right: Additional Controls -->
        <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
            <StackPanel>
                <TextBlock Text="OUTPUT" Style="{StaticResource HeaderStyle}"/>

                <!-- Knee -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Knee:" Style="{StaticResource LabelStyle}"/>
                    <Slider Grid.Column="1" x:Name="KneeSlider"
                            Value="{Binding Knee, Mode=TwoWay, FallbackValue=6}"
                            Minimum="0" Maximum="20" Style="{StaticResource ParamSliderStyle}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Knee, StringFormat='{}{0:F1} dB', FallbackValue='6.0 dB'}"
                               Style="{StaticResource ValueStyle}"/>
                </Grid>

                <!-- Makeup Gain -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Makeup:" Style="{StaticResource LabelStyle}"/>
                    <Slider Grid.Column="1" x:Name="MakeupSlider"
                            Value="{Binding MakeupGain, Mode=TwoWay, FallbackValue=0}"
                            Minimum="-12" Maximum="24" Style="{StaticResource ParamSliderStyle}"/>
                    <TextBlock Grid.Column="2" Text="{Binding MakeupGain, StringFormat='{}{0:F1} dB', FallbackValue='0.0 dB'}"
                               Style="{StaticResource ValueStyle}"/>
                </Grid>

                <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

                <!-- Gain Reduction Meter Placeholder -->
                <TextBlock Text="GAIN REDUCTION" Style="{StaticResource HeaderStyle}"/>
                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="2" Height="20" Margin="0,4">
                    <Border x:Name="GainReductionMeter" Background="#FF6B6B"
                            HorizontalAlignment="Left" Width="0" CornerRadius="2"/>
                </Border>
                <TextBlock Text="{Binding GainReduction, StringFormat='{}{0:F1} dB', FallbackValue='0.0 dB'}"
                           Foreground="{StaticResource TextDimBrush}" FontSize="10" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
