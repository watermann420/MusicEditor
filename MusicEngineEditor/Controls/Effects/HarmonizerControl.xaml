<UserControl x:Class="MusicEngineEditor.Controls.Effects.HarmonizerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Effects"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="500"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Theme Colors -->
        <Color x:Key="HarmonizerBackgroundColor">#0D0D0D</Color>
        <Color x:Key="HarmonizerPanelColor">#181818</Color>
        <Color x:Key="HarmonizerAccentColor">#00D9FF</Color>
        <Color x:Key="HarmonizerSuccessColor">#00FF88</Color>
        <Color x:Key="HarmonizerWarningColor">#FFB800</Color>
        <Color x:Key="HarmonizerErrorColor">#FF4757</Color>
        <Color x:Key="HarmonizerTextColor">#E0E0E0</Color>
        <Color x:Key="HarmonizerSecondaryTextColor">#808080</Color>
        <Color x:Key="HarmonizerBorderColor">#2A2A2A</Color>
        <Color x:Key="HarmonizerWhiteKeyColor">#E8E8E8</Color>
        <Color x:Key="HarmonizerBlackKeyColor">#2D2D2D</Color>
        <Color x:Key="HarmonizerActiveKeyColor">#00D9FF</Color>
        <Color x:Key="HarmonizerHarmonyKeyColor">#00FF88</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="HarmonizerBackgroundBrush" Color="{StaticResource HarmonizerBackgroundColor}"/>
        <SolidColorBrush x:Key="HarmonizerPanelBrush" Color="{StaticResource HarmonizerPanelColor}"/>
        <SolidColorBrush x:Key="HarmonizerAccentBrush" Color="{StaticResource HarmonizerAccentColor}"/>
        <SolidColorBrush x:Key="HarmonizerSuccessBrush" Color="{StaticResource HarmonizerSuccessColor}"/>
        <SolidColorBrush x:Key="HarmonizerWarningBrush" Color="{StaticResource HarmonizerWarningColor}"/>
        <SolidColorBrush x:Key="HarmonizerErrorBrush" Color="{StaticResource HarmonizerErrorColor}"/>
        <SolidColorBrush x:Key="HarmonizerTextBrush" Color="{StaticResource HarmonizerTextColor}"/>
        <SolidColorBrush x:Key="HarmonizerSecondaryTextBrush" Color="{StaticResource HarmonizerSecondaryTextColor}"/>
        <SolidColorBrush x:Key="HarmonizerBorderBrush" Color="{StaticResource HarmonizerBorderColor}"/>
        <SolidColorBrush x:Key="HarmonizerWhiteKeyBrush" Color="{StaticResource HarmonizerWhiteKeyColor}"/>
        <SolidColorBrush x:Key="HarmonizerBlackKeyBrush" Color="{StaticResource HarmonizerBlackKeyColor}"/>
        <SolidColorBrush x:Key="HarmonizerActiveKeyBrush" Color="{StaticResource HarmonizerActiveKeyColor}"/>
        <SolidColorBrush x:Key="HarmonizerHarmonyKeyBrush" Color="{StaticResource HarmonizerHarmonyKeyColor}"/>

        <!-- Harmony Voice Color Gradient -->
        <LinearGradientBrush x:Key="HarmonizerVoiceGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00D9FF" Offset="0.0"/>
            <GradientStop Color="#00FF88" Offset="0.33"/>
            <GradientStop Color="#FFB800" Offset="0.66"/>
            <GradientStop Color="#FF6B9D" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Parameter Label Style -->
        <Style x:Key="HarmonizerParameterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource HarmonizerSecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Parameter Value Style -->
        <Style x:Key="HarmonizerParameterValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource HarmonizerTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="45"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="HarmonizerSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource HarmonizerTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="HarmonizerToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource HarmonizerPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource HarmonizerTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HarmonizerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource HarmonizerAccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{StaticResource HarmonizerAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Toggle Button Style for Voice Enable/Mute -->
        <Style x:Key="HarmonizerSmallToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource HarmonizerToggleButtonStyle}">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="MinWidth" Value="32"/>
        </Style>

        <!-- Voice Panel Border Style -->
        <Style x:Key="HarmonizerVoicePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HarmonizerPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HarmonizerBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="HarmonizerSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" VerticalAlignment="Center"
                                    Background="#2A2A2A" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="{StaticResource HarmonizerAccentBrush}"
                                                        CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource HarmonizerAccentBrush}"
                                                         Width="12" Height="12"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource HarmonizerBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{StaticResource HarmonizerBackgroundBrush}"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Harmonizer"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource HarmonizerTextBrush}"
                               VerticalAlignment="Center"/>
                    <Ellipse x:Name="ActiveIndicator"
                             Width="8" Height="8"
                             Fill="{StaticResource HarmonizerSuccessBrush}"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"
                             ToolTip="Effect Active"/>
                </StackPanel>

                <ToggleButton Grid.Column="1"
                              x:Name="MidiInputToggle"
                              Content="MIDI"
                              Style="{StaticResource HarmonizerToggleButtonStyle}"
                              ToolTip="Enable MIDI input for manual harmony control"
                              Click="MidiInputToggle_Click"
                              Margin="0,0,8,0"/>

                <ToggleButton Grid.Column="2"
                              x:Name="BypassToggle"
                              Content="Bypass"
                              Style="{StaticResource HarmonizerToggleButtonStyle}"
                              Click="BypassToggle_Click"/>
            </Grid>

            <!-- Keyboard Visualization -->
            <Border Grid.Row="1"
                    Background="{StaticResource HarmonizerPanelBrush}"
                    BorderBrush="{StaticResource HarmonizerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Height="60"
                    Margin="0,0,0,12">
                <Canvas x:Name="KeyboardCanvas" ClipToBounds="True"/>
            </Border>

            <!-- Harmony Voice Slots (Scrollable) -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,12">
                <StackPanel x:Name="VoiceSlotsPanel">
                    <!-- Voice slots will be added programmatically -->
                </StackPanel>
            </ScrollViewer>

            <!-- Scale Lock Section -->
            <Border Grid.Row="3"
                    Background="{StaticResource HarmonizerPanelBrush}"
                    BorderBrush="{StaticResource HarmonizerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ToggleButton Grid.Column="0"
                                      x:Name="ScaleLockToggle"
                                      Content="Scale Lock"
                                      Style="{StaticResource HarmonizerToggleButtonStyle}"
                                      ToolTip="Constrain harmonies to selected scale"
                                      Click="ScaleLockToggle_Click"
                                      Margin="0,0,12,0"/>

                        <ComboBox Grid.Column="1"
                                  x:Name="KeyComboBox"
                                  IsEnabled="False"
                                  MinWidth="70"
                                  Margin="0,0,12,0"
                                  SelectionChanged="KeyComboBox_SelectionChanged"
                                  ToolTip="Root key for scale lock">
                            <ComboBoxItem Content="C" Tag="0" IsSelected="True"/>
                            <ComboBoxItem Content="C#/Db" Tag="1"/>
                            <ComboBoxItem Content="D" Tag="2"/>
                            <ComboBoxItem Content="D#/Eb" Tag="3"/>
                            <ComboBoxItem Content="E" Tag="4"/>
                            <ComboBoxItem Content="F" Tag="5"/>
                            <ComboBoxItem Content="F#/Gb" Tag="6"/>
                            <ComboBoxItem Content="G" Tag="7"/>
                            <ComboBoxItem Content="G#/Ab" Tag="8"/>
                            <ComboBoxItem Content="A" Tag="9"/>
                            <ComboBoxItem Content="A#/Bb" Tag="10"/>
                            <ComboBoxItem Content="B" Tag="11"/>
                        </ComboBox>

                        <TextBlock Grid.Column="2"
                                   Text="Scale:"
                                   Style="{StaticResource HarmonizerParameterLabelStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <ComboBox Grid.Column="3"
                                  x:Name="ScaleComboBox"
                                  IsEnabled="False"
                                  SelectionChanged="ScaleComboBox_SelectionChanged"
                                  ToolTip="Scale type for scale lock">
                            <ComboBoxItem Content="Major" Tag="Major" IsSelected="True"/>
                            <ComboBoxItem Content="Minor" Tag="Minor"/>
                            <ComboBoxItem Content="Harmonic Minor" Tag="HarmonicMinor"/>
                            <ComboBoxItem Content="Melodic Minor" Tag="MelodicMinor"/>
                            <ComboBoxItem Content="Dorian" Tag="Dorian"/>
                            <ComboBoxItem Content="Phrygian" Tag="Phrygian"/>
                            <ComboBoxItem Content="Lydian" Tag="Lydian"/>
                            <ComboBoxItem Content="Mixolydian" Tag="Mixolydian"/>
                            <ComboBoxItem Content="Chromatic" Tag="Chromatic"/>
                        </ComboBox>
                    </Grid>

                    <ToggleButton Grid.Row="1"
                                  x:Name="FormantCorrectionToggle"
                                  Content="Formant Correction"
                                  Style="{StaticResource HarmonizerToggleButtonStyle}"
                                  ToolTip="Preserve vocal character when shifting pitch"
                                  Click="FormantCorrectionToggle_Click"
                                  Margin="0,12,0,0"
                                  HorizontalAlignment="Left"/>
                </Grid>
            </Border>

            <!-- Mix Controls -->
            <Border Grid.Row="4"
                    Background="{StaticResource HarmonizerPanelBrush}"
                    BorderBrush="{StaticResource HarmonizerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Mix (Dry/Wet)"
                                   Style="{StaticResource HarmonizerParameterLabelStyle}"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="MixValue"
                                   Text="50%"
                                   Style="{StaticResource HarmonizerParameterValueStyle}"/>
                    </Grid>
                    <Slider x:Name="MixSlider"
                            Style="{StaticResource HarmonizerSliderStyle}"
                            Minimum="0" Maximum="100" Value="50"
                            ValueChanged="MixSlider_ValueChanged"
                            ToolTip="Dry/Wet mix (0% = all dry, 100% = all wet)"/>
                </StackPanel>
            </Border>

            <!-- Status Bar -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="AddVoiceButton"
                        Content="+ Add Voice"
                        Click="AddVoiceButton_Click"
                        Padding="8,4"
                        ToolTip="Add a new harmony voice (max 4)">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource HarmonizerPanelBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource HarmonizerTextBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource HarmonizerBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush"
                                                        Value="{StaticResource HarmonizerAccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Border Grid.Column="2"
                        Background="{StaticResource HarmonizerPanelBrush}"
                        BorderBrush="{StaticResource HarmonizerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,4"
                        MinWidth="100">
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontSize="11"
                               Foreground="{StaticResource HarmonizerSecondaryTextBrush}"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
