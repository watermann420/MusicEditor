<UserControl x:Class="MusicEngineEditor.Controls.Analysis.AnalysisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Analysis"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="400"
             Background="{DynamicResource BackgroundBrush}"
             MinWidth="320"
             MinHeight="400">

    <UserControl.Resources>
        <!-- Local CardColor (not in global theme) -->
        <Color x:Key="CardColor">#1E1E1E</Color>

        <!-- Local Brush Aliases referencing global theme -->
        <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelBackgroundColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource ForegroundColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource SecondaryForegroundColor}"/>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Global Enable Toggle Style -->
        <Style x:Key="EnableToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="AnalysisComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"/>
                                    <Path Grid.Column="1"
                                          Data="M0,0 L4,4 L8,0"
                                          Fill="{StaticResource TextSecondaryBrush}"
                                          Margin="8,0,8,0"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0"
                                        MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Item Style -->
        <Style x:Key="AnalysisTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Card Border Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Value Display Style -->
        <Style x:Key="ValueDisplayStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Confidence Meter Gradient -->
        <LinearGradientBrush x:Key="ConfidenceGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF4757" Offset="0.0"/>
            <GradientStop Color="#FFB800" Offset="0.5"/>
            <GradientStop Color="#00FF88" Offset="1.0"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Analysis Tools"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>

                    <ToggleButton x:Name="GlobalEnableToggle"
                                  Grid.Column="2"
                                  Style="{StaticResource EnableToggleStyle}"
                                  Content="Enabled"
                                  IsChecked="True"
                                  Checked="GlobalEnableToggle_Changed"
                                  Unchecked="GlobalEnableToggle_Changed"
                                  ToolTip="Enable/disable all analysis"/>
                </Grid>
            </Border>

            <!-- Global Controls -->
            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Input Source Selector -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="INPUT SOURCE" Style="{StaticResource SectionHeaderStyle}"/>
                        <ComboBox x:Name="InputSourceComboBox"
                                  Style="{StaticResource AnalysisComboBoxStyle}"
                                  SelectedIndex="0"
                                  SelectionChanged="InputSource_SelectionChanged">
                            <ComboBoxItem Content="Master Output"/>
                            <ComboBoxItem Content="Selected Track"/>
                            <ComboBoxItem Content="External Input"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Resolution/Quality Selector -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ANALYSIS QUALITY" Style="{StaticResource SectionHeaderStyle}"/>
                        <ComboBox x:Name="QualityComboBox"
                                  Style="{StaticResource AnalysisComboBoxStyle}"
                                  SelectedIndex="1"
                                  SelectionChanged="Quality_SelectionChanged">
                            <ComboBoxItem Content="Low (Fast)"/>
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="High (Accurate)"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content - Tab Control -->
            <TabControl x:Name="AnalysisTabControl"
                        Grid.Row="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        SelectionChanged="AnalysisTab_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource AnalysisTabItemStyle}"/>
                </TabControl.Resources>

                <!-- Guitar Tuner Tab -->
                <TabItem Header="Tuner">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <!-- Tuner Display -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="DETECTED NOTE" Style="{StaticResource SectionHeaderStyle}"/>

                                    <!-- Note Name Display -->
                                    <TextBlock x:Name="TunerNoteText"
                                               Text="--"
                                               Style="{StaticResource ValueDisplayStyle}"
                                               FontSize="48"/>

                                    <!-- Octave Display -->
                                    <TextBlock x:Name="TunerOctaveText"
                                               Text=""
                                               FontSize="16"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,12"/>

                                    <!-- Frequency Display -->
                                    <TextBlock x:Name="TunerFrequencyText"
                                               Text="-- Hz"
                                               FontSize="14"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,16"/>

                                    <!-- Tuning Indicator -->
                                    <Grid Height="40" Margin="0,0,0,8">
                                        <Border Background="{DynamicResource PianoRollBackgroundBrush}" CornerRadius="4" Height="8" VerticalAlignment="Center"/>

                                        <!-- Center marker -->
                                        <Border Width="2" Background="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Height="20"/>

                                        <!-- Tuning needle -->
                                        <Border x:Name="TunerNeedle"
                                                Width="4"
                                                Height="32"
                                                Background="{StaticResource AccentBrush}"
                                                CornerRadius="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="TunerNeedleTransform" X="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>

                                    <!-- Cents Display -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TunerCentsText"
                                                   Text="0"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text=" cents"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,0,2"/>
                                    </StackPanel>

                                    <!-- Flat/Sharp Labels -->
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Flat" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="In Tune" FontSize="10" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Sharp" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Tuner Settings -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="TUNER SETTINGS" Style="{StaticResource SectionHeaderStyle}"/>

                                    <!-- Reference Pitch -->
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Reference A4"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="ReferencePitchText"
                                                   Text="440 Hz"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="ReferencePitchSlider"
                                                Minimum="415"
                                                Maximum="465"
                                                Value="440"
                                                Margin="12,0"
                                                ValueChanged="ReferencePitch_ValueChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Chord Detector Tab -->
                <TabItem Header="Chords">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <!-- Chord Display -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="DETECTED CHORD" Style="{StaticResource SectionHeaderStyle}"/>

                                    <!-- Chord Name -->
                                    <TextBlock x:Name="ChordNameText"
                                               Text="--"
                                               Style="{StaticResource ValueDisplayStyle}"
                                               FontSize="36"/>

                                    <!-- Chord Type -->
                                    <TextBlock x:Name="ChordTypeText"
                                               Text=""
                                               FontSize="14"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,12"/>

                                    <!-- Confidence Bar -->
                                    <StackPanel Margin="0,8,0,0">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Confidence"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       DockPanel.Dock="Left"/>
                                            <TextBlock x:Name="ChordConfidenceText"
                                                       Text="0%"
                                                       FontSize="10"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <Border Background="{DynamicResource PianoRollBackgroundBrush}" CornerRadius="4" Height="6">
                                            <Border x:Name="ChordConfidenceFill"
                                                    Background="{StaticResource ConfidenceGradient}"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    Width="0"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Detected Notes -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="NOTES IN CHORD" Style="{StaticResource SectionHeaderStyle}"/>
                                    <ItemsControl x:Name="ChordNotesItemsControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PanelBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,4"
                                                        Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="NoChordNotesText"
                                               Text="No notes detected"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontStyle="Italic"
                                               Visibility="Visible"/>
                                </StackPanel>
                            </Border>

                            <!-- Chord History -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="RECENT CHORDS" Style="{StaticResource SectionHeaderStyle}" DockPanel.Dock="Left" Margin="0"/>
                                        <Button x:Name="ClearChordHistoryButton"
                                                Content="Clear"
                                                Click="ClearChordHistory_Click"
                                                Background="{DynamicResource BorderBrush}"
                                                Foreground="{StaticResource TextBrush}"
                                                BorderThickness="0"
                                                Padding="8,2"
                                                Cursor="Hand"
                                                DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="ChordHistoryItemsControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ElementHoverBrush}"
                                                        CornerRadius="3"
                                                        Padding="6,3"
                                                        Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Key Detector Tab -->
                <TabItem Header="Key">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <!-- Key Display -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="DETECTED KEY" Style="{StaticResource SectionHeaderStyle}"/>

                                    <!-- Key Name -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="KeyRootText"
                                                   Text="--"
                                                   Style="{StaticResource ValueDisplayStyle}"
                                                   FontSize="42"/>
                                        <TextBlock x:Name="KeyModeText"
                                                   Text=""
                                                   FontSize="18"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="8,0,0,8"/>
                                    </StackPanel>

                                    <!-- Relative Key -->
                                    <TextBlock x:Name="RelativeKeyText"
                                               Text=""
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,12"/>

                                    <!-- Confidence Bar -->
                                    <StackPanel Margin="0,8,0,0">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Confidence"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       DockPanel.Dock="Left"/>
                                            <TextBlock x:Name="KeyConfidenceText"
                                                       Text="0%"
                                                       FontSize="10"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <Border Background="{DynamicResource PianoRollBackgroundBrush}" CornerRadius="4" Height="6">
                                            <Border x:Name="KeyConfidenceFill"
                                                    Background="{StaticResource ConfidenceGradient}"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    Width="0"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Scale Notes -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="SCALE NOTES" Style="{StaticResource SectionHeaderStyle}"/>
                                    <ItemsControl x:Name="ScaleNotesItemsControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PanelBrush}"
                                                        BorderBrush="{StaticResource AccentBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10,6"
                                                        Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Chromagram Visualization -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="CHROMAGRAM" Style="{StaticResource SectionHeaderStyle}"/>
                                    <Canvas x:Name="ChromagramCanvas"
                                            Height="80"
                                            Background="{DynamicResource PianoRollBackgroundBrush}"
                                            ClipToBounds="True"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="C" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="C#" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="D" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="D#" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="E" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="F" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="F#" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="G" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="8" Text="G#" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="9" Text="A" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="10" Text="A#" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="11" Text="B" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tempo Detector Tab -->
                <TabItem Header="Tempo">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <!-- Tempo Display -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="DETECTED TEMPO" Style="{StaticResource SectionHeaderStyle}"/>

                                    <!-- BPM Display -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TempoBpmText"
                                                   Text="--"
                                                   Style="{StaticResource ValueDisplayStyle}"
                                                   FontSize="48"/>
                                        <TextBlock Text=" BPM"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="4,0,0,12"/>
                                    </StackPanel>

                                    <!-- Beat Indicator -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                        <Ellipse x:Name="BeatIndicator1" Width="16" Height="16" Fill="#2A2A2A" Margin="4,0"/>
                                        <Ellipse x:Name="BeatIndicator2" Width="16" Height="16" Fill="#2A2A2A" Margin="4,0"/>
                                        <Ellipse x:Name="BeatIndicator3" Width="16" Height="16" Fill="#2A2A2A" Margin="4,0"/>
                                        <Ellipse x:Name="BeatIndicator4" Width="16" Height="16" Fill="#2A2A2A" Margin="4,0"/>
                                    </StackPanel>

                                    <!-- Confidence Bar -->
                                    <StackPanel Margin="0,16,0,0">
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Confidence"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       DockPanel.Dock="Left"/>
                                            <TextBlock x:Name="TempoConfidenceText"
                                                       Text="0%"
                                                       FontSize="10"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <Border Background="{DynamicResource PianoRollBackgroundBrush}" CornerRadius="4" Height="6">
                                            <Border x:Name="TempoConfidenceFill"
                                                    Background="{StaticResource ConfidenceGradient}"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    Width="0"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Tap Tempo -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="TAP TEMPO" Style="{StaticResource SectionHeaderStyle}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="TapTempoButton"
                                                Grid.Column="0"
                                                Content="TAP"
                                                Click="TapTempo_Click"
                                                Height="50"
                                                Background="{StaticResource PanelBrush}"
                                                Foreground="{StaticResource TextBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Margin="0,0,8,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="80">
                                            <TextBlock x:Name="TapTempoBpmText"
                                                       Text="-- BPM"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TapCountText"
                                                       Text="0 taps"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button x:Name="ResetTapTempoButton"
                                            Content="Reset"
                                            Click="ResetTapTempo_Click"
                                            Height="28"
                                            Background="{DynamicResource BorderBrush}"
                                            Foreground="{StaticResource TextBrush}"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Time Signature -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="TIME SIGNATURE" Style="{StaticResource SectionHeaderStyle}"/>
                                    <TextBlock x:Name="TimeSignatureText"
                                               Text="4/4"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Loop Finder Tab -->
                <TabItem Header="Loops">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <!-- Loop Finder Status -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="LOOP FINDER" Style="{StaticResource SectionHeaderStyle}"/>

                                    <TextBlock x:Name="LoopFinderStatusText"
                                               Text="Select audio to analyze"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,12"/>

                                    <Button x:Name="AnalyzeLoopsButton"
                                            Content="Find Loop Points"
                                            Click="AnalyzeLoops_Click"
                                            Height="36"
                                            Background="{StaticResource AccentBrush}"
                                            Foreground="#0D0D0D"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Detected Loops -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="DETECTED LOOP POINTS" Style="{StaticResource SectionHeaderStyle}"/>

                                    <ItemsControl x:Name="DetectedLoopsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ElementHoverBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10,8"
                                                        Margin="0,0,0,6"
                                                        Cursor="Hand">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}"/>
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Margin="0,2,0,0">
                                                                <Run Text="{Binding StartTime, StringFormat={}{0:F2}s}"/>
                                                                <Run Text=" - "/>
                                                                <Run Text="{Binding EndTime, StringFormat={}{0:F2}s}"/>
                                                                <Run Text=" ("/>
                                                                <Run Text="{Binding Bars}"/>
                                                                <Run Text=" bars)"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Score, StringFormat={}{0:P0}}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"/>
                                                            <Button Content="Use"
                                                                    Background="{StaticResource PanelBrush}"
                                                                    Foreground="{StaticResource TextBrush}"
                                                                    BorderThickness="0"
                                                                    Padding="8,4"
                                                                    Cursor="Hand"
                                                                    Tag="{Binding}"
                                                                    Click="UseLoop_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock x:Name="NoLoopsText"
                                               Text="No loops detected yet"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontStyle="Italic"
                                               HorizontalAlignment="Center"
                                               Visibility="Visible"/>
                                </StackPanel>
                            </Border>

                            <!-- Loop Settings -->
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="LOOP SETTINGS" Style="{StaticResource SectionHeaderStyle}"/>

                                    <!-- Min Loop Length -->
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Min Length (bars)"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="MinLoopLengthText"
                                                   Text="1"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   Width="30"
                                                   TextAlignment="Right"/>
                                        <Slider x:Name="MinLoopLengthSlider"
                                                Minimum="1"
                                                Maximum="16"
                                                Value="1"
                                                IsSnapToTickEnabled="True"
                                                TickFrequency="1"
                                                Margin="12,0"
                                                ValueChanged="MinLoopLength_ValueChanged"/>
                                    </DockPanel>

                                    <!-- Max Loop Length -->
                                    <DockPanel>
                                        <TextBlock Text="Max Length (bars)"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextBrush}"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="MaxLoopLengthText"
                                                   Text="16"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   DockPanel.Dock="Right"
                                                   VerticalAlignment="Center"
                                                   Width="30"
                                                   TextAlignment="Right"/>
                                        <Slider x:Name="MaxLoopLengthSlider"
                                                Minimum="1"
                                                Maximum="64"
                                                Value="16"
                                                IsSnapToTickEnabled="True"
                                                TickFrequency="1"
                                                Margin="12,0"
                                                ValueChanged="MaxLoopLength_ValueChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
