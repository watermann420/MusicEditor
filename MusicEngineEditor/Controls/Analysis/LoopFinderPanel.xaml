<UserControl x:Class="MusicEngineEditor.Controls.Analysis.LoopFinderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Analysis"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900"
             Background="#0D0D0D"
             MinHeight="500"
             MinWidth="700">

    <UserControl.Resources>
        <!-- Theme Colors -->
        <Color x:Key="LoopFinderBackgroundColor">#0D0D0D</Color>
        <Color x:Key="LoopFinderPanelColor">#181818</Color>
        <Color x:Key="LoopFinderAccentColor">#00D9FF</Color>
        <Color x:Key="LoopFinderSuccessColor">#00FF88</Color>
        <Color x:Key="LoopFinderWarningColor">#FFB800</Color>
        <Color x:Key="LoopFinderErrorColor">#FF4757</Color>
        <Color x:Key="LoopFinderTextColor">#E0E0E0</Color>
        <Color x:Key="LoopFinderDimTextColor">#808080</Color>
        <Color x:Key="LoopFinderBorderColor">#2A2A2A</Color>
        <Color x:Key="LoopFinderLoopRegionColor">#3300D9FF</Color>
        <Color x:Key="LoopFinderMarkerColor">#00D9FF</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="LoopFinderBackgroundBrush" Color="{StaticResource LoopFinderBackgroundColor}"/>
        <SolidColorBrush x:Key="LoopFinderPanelBrush" Color="{StaticResource LoopFinderPanelColor}"/>
        <SolidColorBrush x:Key="LoopFinderAccentBrush" Color="{StaticResource LoopFinderAccentColor}"/>
        <SolidColorBrush x:Key="LoopFinderSuccessBrush" Color="{StaticResource LoopFinderSuccessColor}"/>
        <SolidColorBrush x:Key="LoopFinderWarningBrush" Color="{StaticResource LoopFinderWarningColor}"/>
        <SolidColorBrush x:Key="LoopFinderErrorBrush" Color="{StaticResource LoopFinderErrorColor}"/>
        <SolidColorBrush x:Key="LoopFinderTextBrush" Color="{StaticResource LoopFinderTextColor}"/>
        <SolidColorBrush x:Key="LoopFinderDimTextBrush" Color="{StaticResource LoopFinderDimTextColor}"/>
        <SolidColorBrush x:Key="LoopFinderBorderBrush" Color="{StaticResource LoopFinderBorderColor}"/>
        <SolidColorBrush x:Key="LoopFinderLoopRegionBrush" Color="{StaticResource LoopFinderLoopRegionColor}"/>
        <SolidColorBrush x:Key="LoopFinderMarkerBrush" Color="{StaticResource LoopFinderMarkerColor}"/>

        <!-- Waveform Gradient -->
        <LinearGradientBrush x:Key="LoopFinderWaveformGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00D9FF" Offset="0.0"/>
            <GradientStop Color="#0080FF" Offset="0.5"/>
            <GradientStop Color="#00D9FF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Loop Region Gradient -->
        <LinearGradientBrush x:Key="LoopFinderLoopRegionGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4400D9FF" Offset="0.0"/>
            <GradientStop Color="#2200D9FF" Offset="0.5"/>
            <GradientStop Color="#4400D9FF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Button Style -->
        <Style x:Key="LoopFinderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource LoopFinderTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LoopFinderBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource LoopFinderAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource LoopFinderAccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="LoopFinderPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LoopFinderButtonStyle}">
            <Setter Property="Background" Value="{StaticResource LoopFinderAccentBrush}"/>
            <Setter Property="Foreground" Value="#0D0D0D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="LoopFinderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource LoopFinderDimTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LoopFinderBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource LoopFinderAccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource LoopFinderAccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="LoopFinderSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" VerticalAlignment="Center"
                                    Background="#2A2A2A" CornerRadius="2"/>
                            <Border Height="4" VerticalAlignment="Center"
                                    Background="{StaticResource LoopFinderAccentBrush}"
                                    CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={x:Static local:LoopFinderSliderWidthConverter.Instance}}"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource LoopFinderAccentBrush}"
                                                         Width="14" Height="14"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="LoopFinderCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource LoopFinderTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="checkBorder"
                                    Grid.Column="0"
                                    Width="16" Height="16"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource LoopFinderBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <Path x:Name="checkMark"
                                      Data="M2,5 L5,8 L10,2"
                                      Stroke="{StaticResource LoopFinderAccentBrush}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Margin="2"/>
                            </Border>
                            <ContentPresenter Grid.Column="2"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush"
                                        Value="{StaticResource LoopFinderAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush"
                                        Value="{StaticResource LoopFinderAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Item Style -->
        <Style x:Key="LoopFinderListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource LoopFinderTextBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LoopFinderBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A3A4A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource LoopFinderAccentBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2,0,0,1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Style -->
        <Style x:Key="LoopFinderListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource LoopFinderPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LoopFinderBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LoopFinderListBoxItemStyle}"/>
        </Style>

        <!-- Parameter Label Style -->
        <Style x:Key="LoopFinderParameterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource LoopFinderDimTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Parameter Value Style -->
        <Style x:Key="LoopFinderParameterValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource LoopFinderTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="45"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource LoopFinderBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{StaticResource LoopFinderBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="180"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource LoopFinderPanelBrush}"
                    BorderBrush="{StaticResource LoopFinderBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Loop Finder"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource LoopFinderTextBrush}"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="AudioFileNameText"
                                   Text=""
                                   FontSize="11"
                                   Foreground="{StaticResource LoopFinderDimTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>

                    <!-- BPM Display -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="BPM:"
                                   FontSize="11"
                                   Foreground="{StaticResource LoopFinderDimTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBlock x:Name="BpmText"
                                   Text="120"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource LoopFinderAccentBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Header Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="DetectLoopsButton"
                                Content="Auto-Detect Loops"
                                Style="{StaticResource LoopFinderPrimaryButtonStyle}"
                                Click="DetectLoopsButton_Click"
                                ToolTip="Automatically detect loop points in the audio"
                                Margin="0,0,8,0"/>

                        <Button x:Name="ResetButton"
                                Content="Reset"
                                Style="{StaticResource LoopFinderButtonStyle}"
                                Click="ResetButton_Click"
                                ToolTip="Reset all loop detection results"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Waveform Display Area -->
            <Border Grid.Row="1"
                    Background="#1A1A1A"
                    BorderBrush="{StaticResource LoopFinderBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="12,12,12,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Time Scale -->
                    <Canvas x:Name="TimeScaleCanvas"
                            Grid.Row="0"
                            Height="20"
                            Background="Transparent"/>

                    <!-- Waveform Canvas with Loop Regions -->
                    <Grid Grid.Row="1">
                        <!-- Waveform -->
                        <Canvas x:Name="WaveformCanvas"
                                ClipToBounds="True"
                                Background="Transparent"
                                MouseLeftButtonDown="WaveformCanvas_MouseLeftButtonDown"
                                MouseMove="WaveformCanvas_MouseMove"
                                MouseLeftButtonUp="WaveformCanvas_MouseLeftButtonUp"
                                SizeChanged="WaveformCanvas_SizeChanged"/>

                        <!-- Loop Region Overlay -->
                        <Canvas x:Name="LoopRegionCanvas"
                                ClipToBounds="True"
                                IsHitTestVisible="False"/>

                        <!-- Loop Markers (Draggable) -->
                        <Canvas x:Name="MarkersCanvas"
                                ClipToBounds="True"/>

                        <!-- Playhead -->
                        <Canvas x:Name="PlayheadCanvas"
                                ClipToBounds="True"
                                IsHitTestVisible="False">
                            <Line x:Name="PlayheadLine"
                                  Y1="0" Y2="200"
                                  Stroke="{StaticResource LoopFinderErrorBrush}"
                                  StrokeThickness="1"
                                  Visibility="Collapsed"/>
                        </Canvas>

                        <!-- Detection Progress Overlay -->
                        <Border x:Name="ProgressOverlay"
                                Background="#80000000"
                                Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Detecting loops..."
                                           Foreground="{StaticResource LoopFinderTextBrush}"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12"/>
                                <Border Background="#2A2A2A" CornerRadius="4" Width="200" Height="8">
                                    <Border x:Name="ProgressBar"
                                            Background="{StaticResource LoopFinderAccentBrush}"
                                            CornerRadius="4"
                                            HorizontalAlignment="Left"
                                            Width="0"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Position Info -->
                    <Grid Grid.Row="2" Margin="8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Name="LoopStartText"
                                   Text="Start: 0.00s"
                                   FontSize="10"
                                   Foreground="{StaticResource LoopFinderDimTextBrush}"/>

                        <TextBlock Grid.Column="1"
                                   x:Name="LoopDurationText"
                                   Text="Duration: --"
                                   FontSize="10"
                                   Foreground="{StaticResource LoopFinderAccentBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   x:Name="LoopEndText"
                                   Text="End: 0.00s"
                                   FontSize="10"
                                   Foreground="{StaticResource LoopFinderDimTextBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Settings Panel -->
            <Border Grid.Row="2"
                    Background="{StaticResource LoopFinderPanelBrush}"
                    BorderBrush="{StaticResource LoopFinderBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="12,6"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Min/Max Loop Length -->
                    <StackPanel Grid.Column="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Loop Length (bars)"
                                       Style="{StaticResource LoopFinderParameterLabelStyle}"/>
                            <TextBlock Grid.Column="1" x:Name="LoopLengthValue" Text="1-8"
                                       Style="{StaticResource LoopFinderParameterValueStyle}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MinLoopLengthSlider"
                                    Grid.Column="0"
                                    Style="{StaticResource LoopFinderSliderStyle}"
                                    Minimum="1" Maximum="16" Value="1"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="MinLoopLengthSlider_ValueChanged"
                                    ToolTip="Minimum loop length in bars"/>
                            <Slider x:Name="MaxLoopLengthSlider"
                                    Grid.Column="2"
                                    Style="{StaticResource LoopFinderSliderStyle}"
                                    Minimum="1" Maximum="16" Value="8"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="MaxLoopLengthSlider_ValueChanged"
                                    ToolTip="Maximum loop length in bars"/>
                        </Grid>
                    </StackPanel>

                    <!-- Similarity Threshold -->
                    <StackPanel Grid.Column="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Similarity Threshold"
                                       Style="{StaticResource LoopFinderParameterLabelStyle}"/>
                            <TextBlock Grid.Column="1" x:Name="SimilarityThresholdValue" Text="80%"
                                       Style="{StaticResource LoopFinderParameterValueStyle}"/>
                        </Grid>
                        <Slider x:Name="SimilarityThresholdSlider"
                                Style="{StaticResource LoopFinderSliderStyle}"
                                Minimum="50" Maximum="99" Value="80"
                                ValueChanged="SimilarityThresholdSlider_ValueChanged"
                                ToolTip="Minimum similarity score for loop detection"/>
                    </StackPanel>

                    <!-- Crossfade Length -->
                    <StackPanel Grid.Column="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Crossfade Length"
                                       Style="{StaticResource LoopFinderParameterLabelStyle}"/>
                            <TextBlock Grid.Column="1" x:Name="CrossfadeLengthValue" Text="10ms"
                                       Style="{StaticResource LoopFinderParameterValueStyle}"/>
                        </Grid>
                        <Slider x:Name="CrossfadeLengthSlider"
                                Style="{StaticResource LoopFinderSliderStyle}"
                                Minimum="0" Maximum="100" Value="10"
                                ValueChanged="CrossfadeLengthSlider_ValueChanged"
                                ToolTip="Crossfade length for seamless looping"/>
                    </StackPanel>

                    <!-- Toggle Options -->
                    <StackPanel Grid.Column="6" Orientation="Vertical" VerticalAlignment="Center">
                        <CheckBox x:Name="SnapToBeatCheckBox"
                                  Content="Snap to Beat"
                                  Style="{StaticResource LoopFinderCheckBoxStyle}"
                                  IsChecked="True"
                                  Checked="SnapOption_Changed"
                                  Unchecked="SnapOption_Changed"
                                  ToolTip="Snap loop points to beat grid"/>
                        <CheckBox x:Name="SnapToBarCheckBox"
                                  Content="Snap to Bar"
                                  Style="{StaticResource LoopFinderCheckBoxStyle}"
                                  IsChecked="True"
                                  Checked="SnapOption_Changed"
                                  Unchecked="SnapOption_Changed"
                                  ToolTip="Snap loop points to bar grid"/>
                        <CheckBox x:Name="ZeroCrossingCheckBox"
                                  Content="Zero Crossing"
                                  Style="{StaticResource LoopFinderCheckBoxStyle}"
                                  IsChecked="True"
                                  Checked="ZeroCrossingCheckBox_Changed"
                                  Unchecked="ZeroCrossingCheckBox_Changed"
                                  ToolTip="Find nearest zero crossing for click-free edits"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Loop Candidates List and Preview -->
            <Grid Grid.Row="3" Margin="12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <!-- Loop Candidates List -->
                <Border Grid.Column="0"
                        Background="{StaticResource LoopFinderPanelBrush}"
                        BorderBrush="{StaticResource LoopFinderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- List Header -->
                        <Border Grid.Row="0"
                                Background="#1A1A1A"
                                BorderBrush="{StaticResource LoopFinderBorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="4,4,0,0"
                                Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Time Range"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource LoopFinderDimTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="Duration"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource LoopFinderDimTextBrush}"/>
                                <TextBlock Grid.Column="2" Text="Similarity"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource LoopFinderDimTextBrush}"/>
                                <TextBlock Grid.Column="3" Text="Actions"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource LoopFinderDimTextBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Candidates List -->
                        <ListBox Grid.Row="1"
                                 x:Name="LoopCandidatesListBox"
                                 Style="{StaticResource LoopFinderListBoxStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="LoopCandidatesListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding TimeRangeText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource LoopFinderTextBrush}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DurationText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource LoopFinderAccentBrush}"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SimilarityText}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource LoopFinderSuccessBrush}"
                                                   FontWeight="SemiBold"/>

                                        <Button Grid.Column="3"
                                                Content="Preview"
                                                Style="{StaticResource LoopFinderButtonStyle}"
                                                Padding="8,3"
                                                FontSize="10"
                                                HorizontalAlignment="Right"
                                                Click="PreviewLoopButton_Click"
                                                Tag="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State -->
                        <TextBlock x:Name="EmptyStateText"
                                   Grid.Row="1"
                                   Text="Click 'Auto-Detect Loops' to find loop candidates"
                                   FontSize="11"
                                   Foreground="{StaticResource LoopFinderDimTextBrush}"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Preview and A/B Comparison Panel -->
                <Border Grid.Column="1"
                        Background="{StaticResource LoopFinderPanelBrush}"
                        BorderBrush="{StaticResource LoopFinderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Preview Header -->
                        <Border Grid.Row="0"
                                Background="#1A1A1A"
                                BorderBrush="{StaticResource LoopFinderBorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="4,4,0,0"
                                Padding="12,8">
                            <TextBlock Text="A/B Comparison"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource LoopFinderTextBrush}"/>
                        </Border>

                        <!-- Crossfade Preview -->
                        <StackPanel Grid.Row="1" Margin="12,12">
                            <TextBlock Text="Crossfade Preview"
                                       FontSize="11"
                                       Foreground="{StaticResource LoopFinderDimTextBrush}"
                                       Margin="0,0,0,8"/>

                            <Canvas x:Name="CrossfadePreviewCanvas"
                                    Height="60"
                                    Background="#1A1A1A"
                                    ClipToBounds="True"
                                    Margin="0,0,0,12"/>

                            <CheckBox x:Name="CrossfadePreviewCheckBox"
                                      Content="Enable Crossfade Preview"
                                      Style="{StaticResource LoopFinderCheckBoxStyle}"
                                      IsChecked="True"
                                      Checked="CrossfadePreviewCheckBox_Changed"
                                      Unchecked="CrossfadePreviewCheckBox_Changed"/>
                        </StackPanel>

                        <!-- A/B Buttons -->
                        <StackPanel Grid.Row="2" Margin="12">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="PlayOriginalToggle"
                                              Grid.Column="0"
                                              Content="A Original"
                                              Style="{StaticResource LoopFinderToggleStyle}"
                                              Checked="PlayOriginalToggle_Changed"
                                              Unchecked="PlayOriginalToggle_Changed"
                                              ToolTip="Play original (non-looped) audio"/>

                                <ToggleButton x:Name="PlayLoopedToggle"
                                              Grid.Column="2"
                                              Content="B Looped"
                                              Style="{StaticResource LoopFinderToggleStyle}"
                                              Checked="PlayLoopedToggle_Changed"
                                              Unchecked="PlayLoopedToggle_Changed"
                                              ToolTip="Play looped audio with crossfade"/>
                            </Grid>

                            <Button x:Name="StopPreviewButton"
                                    Content="Stop Preview"
                                    Style="{StaticResource LoopFinderButtonStyle}"
                                    Click="StopPreviewButton_Click"
                                    Margin="0,0,0,8"/>

                            <Button x:Name="ExportLoopButton"
                                    Content="Export Selected Loop"
                                    Style="{StaticResource LoopFinderPrimaryButtonStyle}"
                                    Click="ExportLoopButton_Click"
                                    ToolTip="Export the selected loop as a new audio clip"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="4"
                    Background="{StaticResource LoopFinderPanelBrush}"
                    BorderBrush="{StaticResource LoopFinderBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,6,6"
                    Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Text="Ready"
                               FontSize="11"
                               Foreground="{StaticResource LoopFinderDimTextBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="CandidateCountText"
                               Grid.Column="1"
                               Text="0 candidates"
                               FontSize="11"
                               Foreground="{StaticResource LoopFinderDimTextBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
