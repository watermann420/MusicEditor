<UserControl x:Class="MusicEngineEditor.Controls.Analysis.GuitarTunerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Analysis"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="400"
             Background="#0D0D0D"
             MinHeight="500"
             MinWidth="320">

    <UserControl.Resources>
        <!-- Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="WarningColor">#FFB800</Color>
        <Color x:Key="ErrorColor">#FF4757</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="DimTextColor">#808080</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimTextColor}"/>

        <!-- Tuner Arc Gradient -->
        <LinearGradientBrush x:Key="TunerArcGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF4757" Offset="0.0"/>
            <GradientStop Color="#FFB800" Offset="0.3"/>
            <GradientStop Color="#00FF88" Offset="0.5"/>
            <GradientStop Color="#FFB800" Offset="0.7"/>
            <GradientStop Color="#FF4757" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Button Style -->
        <Style x:Key="TunerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="TunerToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- String Button Style -->
        <Style x:Key="StringButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="TunerComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="TunerSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Guitar Tuner"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton x:Name="StrobeModeToggle"
                                      Style="{StaticResource TunerToggleStyle}"
                                      Content="Strobe"
                                      IsChecked="{Binding IsStrobeMode, Mode=TwoWay}"
                                      ToolTip="Enable strobe tuner mode"
                                      Margin="0,0,8,0"/>
                        <ToggleButton x:Name="ListenToggle"
                                      Style="{StaticResource TunerToggleStyle}"
                                      Content="Listen"
                                      IsChecked="{Binding IsListening, Mode=TwoWay}"
                                      Click="ListenToggle_Click"
                                      ToolTip="Start/stop listening"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Tuner Display -->
            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tuner Arc Display -->
                    <Canvas x:Name="TunerArcCanvas"
                            Grid.Row="0"
                            Width="280"
                            Height="160"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                        <!-- Arc background will be drawn in code-behind -->
                    </Canvas>

                    <!-- Note Name Display -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Note Name -->
                            <TextBlock x:Name="NoteNameText"
                                       Grid.Column="0"
                                       Text="--"
                                       FontSize="72"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"/>

                            <!-- Octave -->
                            <TextBlock x:Name="OctaveText"
                                       Grid.Column="1"
                                       Text="4"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DimTextBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="4,0,0,12"/>
                        </Grid>

                        <!-- Cents Deviation -->
                        <TextBlock x:Name="CentsText"
                                   Text="0 cents"
                                   FontSize="18"
                                   Foreground="{StaticResource DimTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Frequency Display -->
                    <TextBlock x:Name="FrequencyText"
                               Grid.Row="2"
                               Text="--- Hz"
                               FontSize="16"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </Grid>
            </Border>

            <!-- Strobe Display (visible when strobe mode enabled) -->
            <Border x:Name="StrobePanel"
                    Grid.Row="2"
                    Background="#1A1A1A"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Height="60"
                    Visibility="Collapsed">
                <Canvas x:Name="StrobeCanvas"
                        ClipToBounds="True"
                        Margin="12,8"/>
            </Border>

            <!-- String Selector -->
            <Border Grid.Row="3"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header with Auto-Detect Toggle -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Strings"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <ToggleButton x:Name="AutoDetectToggle"
                                      Style="{StaticResource TunerToggleStyle}"
                                      Content="Auto"
                                      IsChecked="{Binding IsAutoDetect, Mode=TwoWay}"
                                      Click="AutoDetectToggle_Click"
                                      ToolTip="Auto-detect string"
                                      HorizontalAlignment="Right"
                                      Padding="8,3"/>
                    </Grid>

                    <!-- String Buttons -->
                    <ItemsControl x:Name="StringButtonsPanel"
                                  Grid.Row="1"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Visual String Representation -->
                    <Canvas x:Name="StringVisualizationCanvas"
                            Grid.Row="2"
                            Height="80"
                            Margin="0,10,0,0"
                            ClipToBounds="True"/>
                </Grid>
            </Border>

            <!-- Tuning Preset Selector -->
            <Border Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Tuning Preset"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="TuningPresetCombo"
                              Grid.Row="1"
                              Style="{StaticResource TunerComboBoxStyle}"
                              ItemsSource="{Binding TuningPresets}"
                              SelectedItem="{Binding SelectedTuningPreset, Mode=TwoWay}"
                              SelectionChanged="TuningPresetCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource DimTextBrush}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Reference Pitch -->
            <Border Grid.Row="5"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Reference Pitch (A4)"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ReferencePitchText"
                                   Text="440 Hz"
                                   FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource TunerButtonStyle}"
                                Content="-"
                                Width="32"
                                Padding="0,4"
                                Click="DecrementPitch_Click"
                                ToolTip="Decrease reference pitch"/>

                        <Slider x:Name="ReferencePitchSlider"
                                Grid.Column="1"
                                Style="{StaticResource TunerSliderStyle}"
                                Minimum="432"
                                Maximum="446"
                                Value="{Binding ReferencePitch, Mode=TwoWay}"
                                ValueChanged="ReferencePitchSlider_ValueChanged"
                                VerticalAlignment="Center"
                                Margin="8,0"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource TunerButtonStyle}"
                                Content="+"
                                Width="32"
                                Padding="0,4"
                                Click="IncrementPitch_Click"
                                ToolTip="Increase reference pitch"/>

                        <Button Grid.Column="3"
                                Style="{StaticResource TunerButtonStyle}"
                                Content="440"
                                Padding="8,4"
                                Margin="8,0,0,0"
                                Click="ResetPitch_Click"
                                ToolTip="Reset to 440 Hz"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Input Level Meter -->
            <Border Grid.Row="6"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="0,0,6,6"
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Input Level"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock x:Name="InputLevelText"
                                   Text="No Signal"
                                   FontSize="10"
                                   Foreground="{StaticResource DimTextBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#1A1A1A"
                            CornerRadius="4"
                            Height="12">
                        <Grid>
                            <!-- Level bar -->
                            <Border x:Name="InputLevelBar"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    Width="0"/>

                            <!-- Peak indicator -->
                            <Border x:Name="InputPeakIndicator"
                                    Background="{StaticResource ErrorBrush}"
                                    Width="3"
                                    CornerRadius="1"
                                    HorizontalAlignment="Left"
                                    Margin="0,1"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
