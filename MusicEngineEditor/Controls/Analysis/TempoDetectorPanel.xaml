<UserControl x:Class="MusicEngineEditor.Controls.Analysis.TempoDetectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Analysis"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="450"
             Background="{DynamicResource BackgroundBrush}"
             MinHeight="500"
             MinWidth="350">

    <UserControl.Resources>
        <!-- Local Colors (not in global theme) -->
        <Color x:Key="BeatColor">#00D9FF</Color>
        <Color x:Key="DownbeatColor">#00FF88</Color>
        <Color x:Key="WaveformColor">#3A3A3A</Color>

        <!-- Local Brush Aliases referencing global theme -->
        <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelBackgroundColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource ForegroundColor}"/>
        <SolidColorBrush x:Key="DimTextBrush" Color="{DynamicResource SecondaryForegroundColor}"/>
        <SolidColorBrush x:Key="BeatBrush" Color="{StaticResource BeatColor}"/>
        <SolidColorBrush x:Key="DownbeatBrush" Color="{StaticResource DownbeatColor}"/>
        <SolidColorBrush x:Key="WaveformBrush" Color="{StaticResource WaveformColor}"/>

        <!-- Confidence Gradient -->
        <LinearGradientBrush x:Key="ConfidenceGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF4757" Offset="0.0"/>
            <GradientStop Color="#FFB800" Offset="0.5"/>
            <GradientStop Color="#00FF88" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Button Style -->
        <Style x:Key="TempoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource TempoButtonStyle}">
            <Setter Property="Background" Value="#00D9FF"/>
            <Setter Property="Foreground" Value="#0D0D0D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33E5FF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#00B8D9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tap Button Style (Large) -->
        <Style x:Key="TapButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="20,16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A3A4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="TempoToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="TempoSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4"
                                    Background="{DynamicResource BorderBrush}"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        Background="{StaticResource AccentBrush}"
                                                        CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16"
                                                         Fill="{StaticResource AccentBrush}"
                                                         Stroke="#0D0D0D"
                                                         StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Time Signature ComboBox Style -->
        <Style x:Key="TimeSignatureComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Tempo Detector"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Border x:Name="AnalyzingIndicator"
                                Width="8" Height="8"
                                CornerRadius="4"
                                Background="{StaticResource AccentBrush}"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"/>
                        <Button Style="{StaticResource TempoButtonStyle}"
                                Content="Reset"
                                Click="ResetButton_Click"
                                Padding="8,4"
                                FontSize="11"
                                ToolTip="Reset all detection data"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Large BPM Display -->
            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="DETECTED BPM"
                                   FontSize="10"
                                   Foreground="{StaticResource DimTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="BpmDisplayText"
                                   Text="---"
                                   FontSize="56"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock x:Name="TimeSignatureText"
                                       Text="4/4"
                                       FontSize="14"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,12,0"/>
                            <Border x:Name="DownbeatIndicator"
                                    Background="#1A00FF88"
                                    BorderBrush="{StaticResource SuccessBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    Visibility="Collapsed">
                                <TextBlock Text="Downbeat"
                                           FontSize="10"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Confidence Meter -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="80">
                        <TextBlock Text="Confidence"
                                   FontSize="9"
                                   Foreground="{StaticResource DimTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource PianoRollBackgroundBrush}"
                                CornerRadius="4"
                                Height="80"
                                Width="24"
                                HorizontalAlignment="Center">
                            <Grid>
                                <Border x:Name="ConfidenceFill"
                                        Background="{StaticResource SuccessBrush}"
                                        CornerRadius="4"
                                        VerticalAlignment="Bottom"
                                        Height="0"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ConfidenceText"
                                   Text="0%"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="ConfidenceLevelText"
                                   Text="Low"
                                   FontSize="9"
                                   Foreground="{StaticResource DimTextBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tap Tempo Section -->
            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="TAP TEMPO"
                                   FontSize="10"
                                   Foreground="{StaticResource DimTextBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="TapBpmText"
                                   Text="---"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="TapCountText"
                                   Text="0 taps"
                                   FontSize="10"
                                   Foreground="{StaticResource DimTextBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource TapButtonStyle}"
                            Content="TAP"
                            Click="TapButton_Click"
                            Width="100"
                            Height="60"
                            ToolTip="Tap to set tempo (Space key)"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TempoButtonStyle}"
                                Content="Use Tap"
                                Click="UseTapButton_Click"
                                Padding="10,6"
                                FontSize="11"
                                Margin="0,0,0,4"
                                ToolTip="Apply tap tempo as detected BPM"/>
                        <Button Style="{StaticResource TempoButtonStyle}"
                                Content="Reset"
                                Click="ResetTapButton_Click"
                                Padding="10,6"
                                FontSize="11"
                                ToolTip="Reset tap tempo"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Beat Grid Visualization -->
            <Border Grid.Row="3"
                    Background="{DynamicResource PianoRollBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="12,8"
                    MinHeight="100">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Beat Grid"
                               FontSize="10"
                               Foreground="{StaticResource DimTextBrush}"
                               Margin="8,6,8,4"/>

                    <!-- Waveform and Beat Markers Canvas -->
                    <Canvas x:Name="BeatGridCanvas"
                            Grid.Row="1"
                            ClipToBounds="True"
                            Margin="4"
                            SizeChanged="BeatGridCanvas_SizeChanged"/>
                </Grid>
            </Border>

            <!-- Tempo Variation Graph -->
            <Border Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="60"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Tempo Variation"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TempoStabilityText"
                                       Text="Stable"
                                       FontSize="10"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,0,8,0"/>
                            <TextBlock x:Name="VariationPercentText"
                                       Text="0%"
                                       FontSize="10"
                                       Foreground="{StaticResource DimTextBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource PianoRollBackgroundBrush}"
                            CornerRadius="4">
                        <Canvas x:Name="VariationGraphCanvas"
                                ClipToBounds="True"
                                Margin="4"
                                SizeChanged="VariationGraphCanvas_SizeChanged"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Half-time / Double-time Alternatives -->
            <Border Grid.Row="5"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Half-time"
                                   FontSize="10"
                                   Foreground="{StaticResource DimTextBrush}"
                                   Margin="0,0,0,4"/>
                        <Button x:Name="HalfTimeButton"
                                Style="{StaticResource TempoButtonStyle}"
                                Click="HalfTimeButton_Click"
                                HorizontalContentAlignment="Center">
                            <TextBlock x:Name="HalfTimeBpmText"
                                       Text="---"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="Double-time"
                                   FontSize="10"
                                   Foreground="{StaticResource DimTextBrush}"
                                   Margin="0,0,0,4"/>
                        <Button x:Name="DoubleTimeButton"
                                Style="{StaticResource TempoButtonStyle}"
                                Click="DoubleTimeButton_Click"
                                HorizontalContentAlignment="Center">
                            <TextBlock x:Name="DoubleTimeBpmText"
                                       Text="---"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Settings Panel -->
            <Border Grid.Row="6"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Time Signature -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Time Signature"
                                   FontSize="11"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"
                                   Width="110"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton x:Name="Sig44Button"
                                          Style="{StaticResource TempoToggleStyle}"
                                          Content="4/4"
                                          IsChecked="True"
                                          Checked="TimeSignatureButton_Checked"
                                          Margin="0,0,4,0"/>
                            <ToggleButton x:Name="Sig34Button"
                                          Style="{StaticResource TempoToggleStyle}"
                                          Content="3/4"
                                          Checked="TimeSignatureButton_Checked"
                                          Margin="0,0,4,0"/>
                            <ToggleButton x:Name="Sig68Button"
                                          Style="{StaticResource TempoToggleStyle}"
                                          Content="6/8"
                                          Checked="TimeSignatureButton_Checked"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tempo Range Filter -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Tempo Range"
                                   FontSize="11"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"
                                   Width="110"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="MinBpmTextBox"
                                     Text="60"
                                     Width="50"
                                     Background="{DynamicResource BorderBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     Padding="4,2"
                                     TextChanged="MinBpmTextBox_TextChanged"/>
                            <TextBlock Text=" - "
                                       Foreground="{StaticResource DimTextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="MaxBpmTextBox"
                                     Text="200"
                                     Width="50"
                                     Background="{DynamicResource BorderBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     Padding="4,2"
                                     TextChanged="MaxBpmTextBox_TextChanged"/>
                            <TextBlock Text=" BPM"
                                       FontSize="10"
                                       Foreground="{StaticResource DimTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Onset Sensitivity -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Onset Sensitivity"
                                   FontSize="11"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"
                                   Width="110"/>

                        <Slider x:Name="SensitivitySlider"
                                Grid.Column="1"
                                Style="{StaticResource TempoSliderStyle}"
                                Value="0.5"
                                Minimum="0"
                                Maximum="1"
                                ValueChanged="SensitivitySlider_ValueChanged"
                                Margin="0,0,8,0"/>

                        <TextBlock x:Name="SensitivityValueText"
                                   Grid.Column="2"
                                   Text="50%"
                                   FontSize="10"
                                   Foreground="{StaticResource DimTextBrush}"
                                   VerticalAlignment="Center"
                                   Width="35"/>
                    </Grid>

                    <!-- Metronome Sync -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Metronome Sync"
                                   FontSize="11"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"
                                   Width="110"/>

                        <ToggleButton x:Name="MetronomeSyncToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource TempoToggleStyle}"
                                      Content="Off"
                                      HorizontalAlignment="Left"
                                      Checked="MetronomeSyncToggle_Changed"
                                      Unchecked="MetronomeSyncToggle_Changed"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Apply Button -->
            <Border Grid.Row="7"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="0,0,6,6"
                    Padding="12,10">
                <Button x:Name="ApplyButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="Apply Detected Tempo to Project"
                        Click="ApplyButton_Click"
                        IsEnabled="False"
                        Padding="16,10"
                        FontSize="13"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
