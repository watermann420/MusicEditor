<UserControl x:Class="MusicEngineEditor.Controls.Analysis.ChordDetectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Analysis"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="400"
             Background="#0D0D0D"
             MinHeight="400"
             MinWidth="320">

    <UserControl.Resources>
        <!-- Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="WarningColor">#FFB800</Color>
        <Color x:Key="ErrorColor">#FF4757</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="DimTextColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="WhiteKeyColor">#E8E8E8</Color>
        <Color x:Key="BlackKeyColor">#2D2D2D</Color>
        <Color x:Key="HighlightedKeyColor">#00D9FF</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimTextColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="WhiteKeyBrush" Color="{StaticResource WhiteKeyColor}"/>
        <SolidColorBrush x:Key="BlackKeyBrush" Color="{StaticResource BlackKeyColor}"/>
        <SolidColorBrush x:Key="HighlightedKeyBrush" Color="{StaticResource HighlightedKeyColor}"/>

        <!-- Confidence Gradient -->
        <LinearGradientBrush x:Key="ConfidenceGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF4757" Offset="0.0"/>
            <GradientStop Color="#FFB800" Offset="0.5"/>
            <GradientStop Color="#00FF88" Offset="0.8"/>
            <GradientStop Color="#00D9FF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Button Style -->
        <Style x:Key="ChordDetectorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ChordDetectorToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="ChordDetectorSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Height" Value="20"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ChordDetectorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Section Label Style -->
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- ListBox Style -->
        <Style x:Key="ChordDetectorListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{StaticResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Chord Detector"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton x:Name="DetectionToggle"
                                      Style="{StaticResource ChordDetectorToggleStyle}"
                                      Content="Active"
                                      IsChecked="{Binding IsDetectionActive, Mode=TwoWay}"
                                      ToolTip="Enable/disable chord detection"
                                      Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ChordDetectorButtonStyle}"
                                Content="Reset"
                                Command="{Binding ResetDetectionCommand}"
                                ToolTip="Reset detection"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Chord Display -->
            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Chord Name and Quality -->
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="ChordNameText"
                                   Text="{Binding ChordName}"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding QualityText}"
                                       FontSize="14"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="SlashChordIndicator"
                                       Text=" (Slash Chord)"
                                       FontSize="12"
                                       Foreground="{StaticResource DimTextBrush}"
                                       Visibility="{Binding IsSlashChord, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding IsSlashChord, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Bass: "
                                       FontSize="12"
                                       Foreground="{StaticResource DimTextBrush}"/>
                            <TextBlock Text="{Binding BassNote}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Roman Numeral -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Roman Numeral"
                                   FontSize="10"
                                   Foreground="{StaticResource DimTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <Border Background="#1A1A1A"
                                CornerRadius="6"
                                Padding="16,8"
                                Margin="0,4,0,0">
                            <TextBlock x:Name="RomanNumeralText"
                                       Text="{Binding RomanNumeral}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Confidence Meter -->
            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Detection Confidence"
                                   FontSize="11"
                                   Foreground="{StaticResource DimTextBrush}"
                                   Margin="0,0,0,4"/>
                        <Grid>
                            <Border Background="#1A1A1A"
                                    CornerRadius="4"
                                    Height="10">
                                <Border x:Name="ConfidenceFill"
                                        Background="{StaticResource ConfidenceGradientBrush}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Width="0"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               x:Name="ConfidenceText"
                               Text="{Binding ConfidenceText}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </Grid>
            </Border>

            <!-- Piano Keyboard Visualization -->
            <Border Grid.Row="3"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="DETECTED NOTES"
                               Style="{StaticResource SectionLabelStyle}"/>
                    <Border Background="#1A1A1A"
                            CornerRadius="4"
                            Height="60"
                            Margin="0,4,0,0">
                        <Canvas x:Name="PianoKeyboardCanvas"
                                ClipToBounds="True"
                                SizeChanged="PianoKeyboardCanvas_SizeChanged"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Guitar Chord Diagram -->
            <Border Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10"
                    Visibility="{Binding HasGuitarDiagram, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="GUITAR FINGERING"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <Border Background="#1A1A1A"
                                CornerRadius="4"
                                Width="100"
                                Height="120"
                                Margin="0,4,0,0">
                            <Canvas x:Name="GuitarDiagramCanvas"
                                    ClipToBounds="True"
                                    SizeChanged="GuitarDiagramCanvas_SizeChanged"/>
                        </Border>
                    </StackPanel>

                    <!-- Alternative Chords -->
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="ALTERNATIVE INTERPRETATIONS"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <ItemsControl ItemsSource="{Binding AlternativeChords}"
                                      MaxHeight="120">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A1A"
                                            CornerRadius="3"
                                            Padding="8,4"
                                            Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ConfidenceText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource DimTextBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Key Selection -->
            <Border Grid.Row="5"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="KEY (for Roman Numeral Analysis)"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <ComboBox x:Name="KeyComboBox"
                                  Style="{StaticResource ChordDetectorComboBoxStyle}"
                                  ItemsSource="{Binding AvailableKeys}"
                                  SelectedItem="{Binding CurrentKey, Mode=TwoWay}"
                                  Width="150"
                                  HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Sensitivity Slider -->
                    <StackPanel Grid.Column="1" Width="150">
                        <TextBlock Text="SENSITIVITY"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <Grid>
                            <Slider x:Name="SensitivitySlider"
                                    Style="{StaticResource ChordDetectorSliderStyle}"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding Sensitivity, Mode=TwoWay}"
                                    TickFrequency="0.1"/>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="Low"
                                       FontSize="9"
                                       Foreground="{StaticResource DimTextBrush}"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="High"
                                       FontSize="9"
                                       Foreground="{StaticResource DimTextBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chord History -->
            <Border Grid.Row="6"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10"
                    MinHeight="100">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="CHORD HISTORY"
                                   Style="{StaticResource SectionLabelStyle}"
                                   VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ChordDetectorButtonStyle}"
                                Content="Clear"
                                Command="{Binding ClearHistoryCommand}"
                                HorizontalAlignment="Right"
                                Padding="8,2"
                                FontSize="10"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ChordHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A1A"
                                            CornerRadius="3"
                                            Padding="8,4"
                                            Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TimeText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource DimTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center"/>

                                            <Border Grid.Column="2"
                                                    Background="#2A2A2A"
                                                    CornerRadius="2"
                                                    Padding="4,1">
                                                <TextBlock Text="{Binding ConfidenceText}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource DimTextBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- MIDI Output Toggle -->
            <Border Grid.Row="7"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="0,0,6,6"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ToggleButton x:Name="MidiOutputToggle"
                                      Style="{StaticResource ChordDetectorToggleStyle}"
                                      Content="MIDI Output"
                                      IsChecked="{Binding IsMidiOutputEnabled, Mode=TwoWay}"
                                      ToolTip="Send detected chord as MIDI notes"/>
                        <TextBlock Text="Send detected chord to MIDI output"
                                   FontSize="10"
                                   Foreground="{StaticResource DimTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               x:Name="DetectedNotesText"
                               Text=""
                               FontSize="10"
                               Foreground="{StaticResource DimTextBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
