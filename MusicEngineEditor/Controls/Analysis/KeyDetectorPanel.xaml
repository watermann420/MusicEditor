<UserControl x:Class="MusicEngineEditor.Controls.Analysis.KeyDetectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Analysis"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="450"
             Background="#0D0D0D"
             MinHeight="500"
             MinWidth="350">

    <UserControl.Resources>
        <!-- Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="WarningColor">#FFB800</Color>
        <Color x:Key="ErrorColor">#FF4757</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="DimTextColor">#808080</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="DimTextBrush" Color="{StaticResource DimTextColor}"/>

        <!-- Circle of Fifths Colors -->
        <LinearGradientBrush x:Key="CircleOfFifthsGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00D9FF" Offset="0.0"/>
            <GradientStop Color="#00FF88" Offset="0.5"/>
            <GradientStop Color="#FFB800" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Button Style -->
        <Style x:Key="KeyDetectorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource KeyDetectorButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#0D0D0D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="KeyDetectorToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Alternative Key Item Style -->
        <Style x:Key="AlternativeKeyItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252525"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6,6,0,0"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Key Detector"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <ToggleButton x:Name="LiveModeToggle"
                                          Style="{StaticResource KeyDetectorToggleStyle}"
                                          Content="Live"
                                          IsChecked="True"
                                          Checked="LiveModeToggle_Changed"
                                          Unchecked="LiveModeToggle_Changed"
                                          ToolTip="Enable/disable real-time analysis"
                                          Margin="0,0,8,0"/>
                            <ToggleButton x:Name="FlatsToggle"
                                          Style="{StaticResource KeyDetectorToggleStyle}"
                                          Content="Flats"
                                          Checked="FlatsToggle_Changed"
                                          Unchecked="FlatsToggle_Changed"
                                          ToolTip="Use flat notation instead of sharps"
                                          Margin="0,0,8,0"/>
                            <Button Style="{StaticResource KeyDetectorButtonStyle}"
                                    Content="Reset"
                                    Click="ResetButton_Click"
                                    ToolTip="Reset analysis data"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Large Key Display -->
                <Border Grid.Row="1"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,20">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="DetectedKeyDisplay"
                                   Text="---"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DetectedModeDisplay"
                                   Text="Ionian (Major)"
                                   FontSize="14"
                                   Foreground="{StaticResource DimTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Confidence Indicator -->
                <Border Grid.Row="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Confidence:"
                                   FontSize="11"
                                   Foreground="{StaticResource DimTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <Border Grid.Column="1"
                                Background="#1A1A1A"
                                CornerRadius="4"
                                Height="8"
                                VerticalAlignment="Center">
                            <Border x:Name="ConfidenceFill"
                                    Background="{StaticResource SuccessBrush}"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    Width="0"/>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                            <TextBlock x:Name="ConfidenceText"
                                       Text="0%"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConfidenceLevelText"
                                       Text=" (Unknown)"
                                       FontSize="11"
                                       Foreground="{StaticResource DimTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Circle of Fifths Visualization -->
                <Border Grid.Row="3"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Circle of Fifths"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,8"/>

                        <Canvas x:Name="CircleOfFifthsCanvas"
                                Grid.Row="1"
                                Width="200"
                                Height="200"
                                HorizontalAlignment="Center"
                                SizeChanged="CircleOfFifthsCanvas_SizeChanged"/>
                    </Grid>
                </Border>

                <!-- Related Keys Panel -->
                <Border Grid.Row="4"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Related Keys"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,8"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Relative Major/Minor -->
                            <Border Grid.Column="0"
                                    Background="#1A1A1A"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="Relative"
                                               FontSize="10"
                                               Foreground="{StaticResource DimTextBrush}"/>
                                    <TextBlock x:Name="RelativeKeyDisplay"
                                               Text="---"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Parallel Major/Minor -->
                            <Border Grid.Column="1"
                                    Background="#1A1A1A"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="4,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Parallel"
                                               FontSize="10"
                                               Foreground="{StaticResource DimTextBrush}"/>
                                    <TextBlock x:Name="ParallelKeyDisplay"
                                               Text="---"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Scale Degrees / Chromagram Visualization -->
                <Border Grid.Row="5"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Pitch Class Distribution"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,8"/>

                        <!-- Chromagram Bars -->
                        <Canvas x:Name="ChromagramCanvas"
                                Grid.Row="1"
                                Height="80"
                                ClipToBounds="True"
                                SizeChanged="ChromagramCanvas_SizeChanged"/>

                        <!-- Note Labels -->
                        <ItemsControl x:Name="NoteLabelsControl"
                                      Grid.Row="2"
                                      Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Alternative Key Suggestions -->
                <Border Grid.Row="6"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8"
                        MaxHeight="150">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Alternative Keys"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,6"/>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="AlternativeKeysItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource AlternativeKeyItemStyle}"
                                                MouseLeftButtonDown="AlternativeKey_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding KeyName}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ConfidenceText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource DimTextBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="NoAlternativesText"
                                   Grid.Row="1"
                                   Text="No alternative keys detected"
                                   FontSize="11"
                                   Foreground="{StaticResource DimTextBrush}"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Key Changes Timeline -->
                <Border Grid.Row="7"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Key Changes"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,6"/>

                        <!-- Timeline Canvas -->
                        <Border Grid.Row="1"
                                Background="#1A1A1A"
                                CornerRadius="4"
                                Height="40"
                                Margin="0,0,0,8">
                            <Canvas x:Name="KeyChangesCanvas"
                                    ClipToBounds="True"
                                    SizeChanged="KeyChangesCanvas_SizeChanged"/>
                        </Border>

                        <!-- Key Changes List -->
                        <ItemsControl x:Name="KeyChangesItemsControl"
                                      Grid.Row="2"
                                      MaxHeight="80">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A1A"
                                            CornerRadius="3"
                                            Padding="8,4"
                                            Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding TimeText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource DimTextBrush}"
                                                       VerticalAlignment="Center"
                                                       MinWidth="40"
                                                       Margin="0,0,8,0"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FromKey}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text=" -> "
                                                           FontSize="11"
                                                           Foreground="{StaticResource DimTextBrush}"/>
                                                <TextBlock Text="{Binding ToKey}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoKeyChangesText"
                                   Grid.Row="2"
                                   Text="No key changes detected"
                                   FontSize="11"
                                   Foreground="{StaticResource DimTextBrush}"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Export Button -->
                <Border Grid.Row="8"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="0,0,6,6"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Name="StatusText"
                                   Text="Ready"
                                   FontSize="11"
                                   Foreground="{StaticResource DimTextBrush}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                x:Name="ExportButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Export to Project"
                                Click="ExportButton_Click"
                                IsEnabled="False"
                                ToolTip="Set detected key as project key"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
