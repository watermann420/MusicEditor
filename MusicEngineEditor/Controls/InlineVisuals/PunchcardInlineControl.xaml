<UserControl x:Class="MusicEngineEditor.Controls.InlineVisuals.PunchcardInlineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MusicEngineEditor.Controls"
             MinHeight="80"
             Height="100"
             HorizontalAlignment="Stretch"
             Background="Transparent">
    <Border Background="#0A0A0A" CornerRadius="4" Margin="0,4,0,4">
        <controls:PunchcardVisualization x:Name="Punch"
                                         TotalBeats="16"
                                         BeatWidth="40"
                                         Cycles="2"
                                         ShowLabels="False"
                                         AutoRange="True"
                                         PlayheadPosition="0.15"
                                         ScrollingMode="FollowPlayhead"/>
    </Border>
</UserControl>
