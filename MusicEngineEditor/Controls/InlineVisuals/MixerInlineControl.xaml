<UserControl x:Class="MusicEngineEditor.Controls.InlineVisuals.MixerInlineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="140"
             Width="400"
             Background="#111"
             Opacity="0.95">
    <Border CornerRadius="6" BorderBrush="#222" BorderThickness="1" Padding="8" Background="#181818">
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" x:Name="MetersPanel" />
            <StackPanel DockPanel.Dock="Right" Orientation="Vertical" HorizontalAlignment="Right">
                <TextBlock Text="Mixer" Foreground="#DDD" FontWeight="SemiBold" />
                <TextBlock Text="60fps" Foreground="#777" FontSize="10"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
