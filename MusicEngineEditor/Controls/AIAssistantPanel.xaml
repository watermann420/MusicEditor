<UserControl x:Class="MusicEngineEditor.Controls.AIAssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="400"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="HeaderColor">#1F1F1F</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="TextPrimaryColor">#E0E0E0</Color>
        <Color x:Key="TextSecondaryColor">#808080</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="WarningColor">#FFB800</Color>
        <Color x:Key="HoverColor">#252525</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

        <!-- Tab Button Style -->
        <Style x:Key="AITabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="AIButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#0D0D0D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33E0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00B3CC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#404040"/>
                                <Setter Property="Foreground" Value="#808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource AIButtonStyle}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="AISliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="TrackBackground"
                                    Grid.Row="1"
                                    Height="4"
                                    Background="{StaticResource BorderBrush}"
                                    CornerRadius="2"
                                    Margin="5,0"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="AIComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Value Label Style -->
        <Style x:Key="ValueLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Status Label Style -->
        <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>

        <!-- ListBox Item Style -->
        <Style x:Key="AIListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A00D9FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress Bar Style -->
        <Style x:Key="AIProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="3"/>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A/B Toggle Button Style -->
        <Style x:Key="ABToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SuccessBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <Path x:Name="icon" Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="10" Height="10"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3C3C3C"/>
                                <Setter TargetName="icon" Property="Stroke" Value="#FF6B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="AI ASSISTANT"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Border Background="{StaticResource AccentBrush}"
                                CornerRadius="3"
                                Padding="6,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="F3"
                                       Foreground="#0D0D0D"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close AI Assistant (F3)"/>
                </Grid>
            </Border>

            <!-- Tab Bar -->
            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AutoMasterTab"
                                 Content="Auto-Master"
                                 Style="{StaticResource AITabButtonStyle}"
                                 IsChecked="True"
                                 Checked="Tab_Checked"
                                 GroupName="AITabs"/>
                    <RadioButton x:Name="AutoMixTab"
                                 Content="Auto-Mix"
                                 Style="{StaticResource AITabButtonStyle}"
                                 Checked="Tab_Checked"
                                 GroupName="AITabs"/>
                    <RadioButton x:Name="MelodyGenTab"
                                 Content="Melody Gen"
                                 Style="{StaticResource AITabButtonStyle}"
                                 Checked="Tab_Checked"
                                 GroupName="AITabs"/>
                    <RadioButton x:Name="ChordSuggestTab"
                                 Content="Chords"
                                 Style="{StaticResource AITabButtonStyle}"
                                 Checked="Tab_Checked"
                                 GroupName="AITabs"/>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ContentContainer">

                    <!-- Tab 1: Auto-Master -->
                    <StackPanel x:Name="AutoMasterContent" Margin="16">
                        <TextBlock Text="AI-powered mastering for your mix"
                                   Style="{StaticResource StatusLabelStyle}"
                                   Margin="0,0,0,20"/>

                        <!-- Target LUFS Slider -->
                        <TextBlock Text="TARGET LUFS" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="TargetLufsSlider"
                                    Grid.Column="0"
                                    Style="{StaticResource AISliderStyle}"
                                    Minimum="-14" Maximum="-8"
                                    Value="-14"
                                    ValueChanged="TargetLufsSlider_ValueChanged"/>
                            <TextBlock x:Name="TargetLufsValue"
                                       Grid.Column="1"
                                       Text="-14 LUFS"
                                       Style="{StaticResource ValueLabelStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Limiting Threshold Slider -->
                        <TextBlock Text="LIMITING THRESHOLD" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="LimitingThresholdSlider"
                                    Grid.Column="0"
                                    Style="{StaticResource AISliderStyle}"
                                    Minimum="-6" Maximum="0"
                                    Value="-1"
                                    ValueChanged="LimitingThresholdSlider_ValueChanged"/>
                            <TextBlock x:Name="LimitingThresholdValue"
                                       Grid.Column="1"
                                       Text="-1.0 dB"
                                       Style="{StaticResource ValueLabelStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Master It Button -->
                        <Button x:Name="MasterItButton"
                                Content="Master It"
                                Style="{StaticResource AIButtonStyle}"
                                Click="MasterItButton_Click"
                                Margin="0,8,0,16"/>

                        <!-- Progress Indicator -->
                        <StackPanel x:Name="MasteringProgress" Visibility="Collapsed" Margin="0,0,0,16">
                            <ProgressBar x:Name="MasteringProgressBar"
                                         Style="{StaticResource AIProgressBarStyle}"
                                         Value="0" Maximum="100"
                                         Margin="0,0,0,8"/>
                            <TextBlock x:Name="MasteringProgressText"
                                       Text="Processing..."
                                       Style="{StaticResource StatusLabelStyle}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Before/After Toggle -->
                        <TextBlock Text="A/B COMPARISON" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Toggle between original and mastered"
                                       Style="{StaticResource StatusLabelStyle}"
                                       VerticalAlignment="Center"/>
                            <ToggleButton x:Name="ABToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ABToggleStyle}"
                                          Content="A (Before)"
                                          Width="100"
                                          Click="ABToggle_Click"/>
                        </Grid>

                        <!-- Status -->
                        <TextBlock x:Name="MasteringStatus"
                                   Text="Ready to master"
                                   Style="{StaticResource StatusLabelStyle}"/>
                    </StackPanel>

                    <!-- Tab 2: Auto-Mix -->
                    <StackPanel x:Name="AutoMixContent" Visibility="Collapsed" Margin="16">
                        <TextBlock Text="AI-powered mix analysis and suggestions"
                                   Style="{StaticResource StatusLabelStyle}"
                                   Margin="0,0,0,20"/>

                        <!-- Analyze Mix Button -->
                        <Button x:Name="AnalyzeMixButton"
                                Content="Analyze Mix"
                                Style="{StaticResource AIButtonStyle}"
                                Click="AnalyzeMixButton_Click"
                                Margin="0,0,0,16"/>

                        <!-- Results Panel -->
                        <Border x:Name="MixResultsPanel"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,16"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="FREQUENCY COLLISION WARNINGS"
                                           Style="{StaticResource LabelStyle}"/>
                                <ListBox x:Name="CollisionWarningsList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerStyle="{StaticResource AIListBoxItemStyle}"
                                         MaxHeight="150">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Suggested Adjustments -->
                        <TextBlock Text="SUGGESTED ADJUSTMENTS" Style="{StaticResource LabelStyle}"/>
                        <ListBox x:Name="SuggestedAdjustmentsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource AIListBoxItemStyle}"
                                 MaxHeight="200"
                                 Margin="0,0,0,16">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Track}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Adjustment}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="11"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Value}"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Apply Suggestions Button -->
                        <Button x:Name="ApplySuggestionsButton"
                                Content="Apply Suggestions"
                                Style="{StaticResource SuccessButtonStyle}"
                                Click="ApplySuggestionsButton_Click"
                                IsEnabled="False"/>

                        <TextBlock x:Name="MixStatus"
                                   Text="Click 'Analyze Mix' to start"
                                   Style="{StaticResource StatusLabelStyle}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>

                    <!-- Tab 3: Melody Generator -->
                    <StackPanel x:Name="MelodyGenContent" Visibility="Collapsed" Margin="16">
                        <TextBlock Text="AI-powered melody generation"
                                   Style="{StaticResource StatusLabelStyle}"
                                   Margin="0,0,0,20"/>

                        <!-- Scale Dropdown -->
                        <TextBlock Text="SCALE" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="ScaleComboBox"
                                  Style="{StaticResource AIComboBoxStyle}"
                                  Margin="0,0,0,16"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Major"/>
                            <ComboBoxItem Content="Natural Minor"/>
                            <ComboBoxItem Content="Harmonic Minor"/>
                            <ComboBoxItem Content="Dorian"/>
                            <ComboBoxItem Content="Phrygian"/>
                            <ComboBoxItem Content="Lydian"/>
                            <ComboBoxItem Content="Mixolydian"/>
                            <ComboBoxItem Content="Locrian"/>
                            <ComboBoxItem Content="Pentatonic Major"/>
                            <ComboBoxItem Content="Pentatonic Minor"/>
                            <ComboBoxItem Content="Blues"/>
                        </ComboBox>

                        <!-- Key Dropdown -->
                        <TextBlock Text="KEY" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="KeyComboBox"
                                  Style="{StaticResource AIComboBoxStyle}"
                                  Margin="0,0,0,16"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="C#"/>
                            <ComboBoxItem Content="D"/>
                            <ComboBoxItem Content="D#"/>
                            <ComboBoxItem Content="E"/>
                            <ComboBoxItem Content="F"/>
                            <ComboBoxItem Content="F#"/>
                            <ComboBoxItem Content="G"/>
                            <ComboBoxItem Content="G#"/>
                            <ComboBoxItem Content="A"/>
                            <ComboBoxItem Content="A#"/>
                            <ComboBoxItem Content="B"/>
                        </ComboBox>

                        <!-- Length Slider (1-16 bars) -->
                        <TextBlock Text="LENGTH (BARS)" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="LengthSlider"
                                    Grid.Column="0"
                                    Style="{StaticResource AISliderStyle}"
                                    Minimum="1" Maximum="16"
                                    Value="4"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    ValueChanged="LengthSlider_ValueChanged"/>
                            <TextBlock x:Name="LengthValue"
                                       Grid.Column="1"
                                       Text="4"
                                       Style="{StaticResource ValueLabelStyle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Generate Button -->
                        <Button x:Name="GenerateMelodyButton"
                                Content="Generate"
                                Style="{StaticResource AIButtonStyle}"
                                Click="GenerateMelodyButton_Click"
                                Margin="0,8,0,16"/>

                        <!-- Preview Player -->
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PreviewPlayButton"
                                        Grid.Column="0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Play"
                                        Width="60"
                                        Click="PreviewPlayButton_Click"
                                        Margin="0,0,8,0"/>
                                <Button x:Name="PreviewStopButton"
                                        Grid.Column="1"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Stop"
                                        Width="60"
                                        Click="PreviewStopButton_Click"
                                        IsEnabled="False"/>
                                <TextBlock x:Name="MelodyPreviewStatus"
                                           Grid.Column="2"
                                           Text="No melody generated"
                                           Style="{StaticResource StatusLabelStyle}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="MelodyStatus"
                                   Text="Ready to generate"
                                   Style="{StaticResource StatusLabelStyle}"/>
                    </StackPanel>

                    <!-- Tab 4: Chord Suggester -->
                    <StackPanel x:Name="ChordSuggestContent" Visibility="Collapsed" Margin="16">
                        <TextBlock Text="AI-powered chord progression suggestions"
                                   Style="{StaticResource StatusLabelStyle}"
                                   Margin="0,0,0,20"/>

                        <!-- Current Chord Display -->
                        <TextBlock Text="CURRENT CHORD" Style="{StaticResource LabelStyle}"/>
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="6"
                                Padding="16,12"
                                Margin="0,0,0,16">
                            <TextBlock x:Name="CurrentChordDisplay"
                                       Text="C Major"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Suggest Next Button -->
                        <Button x:Name="SuggestNextButton"
                                Content="Suggest Next"
                                Style="{StaticResource AIButtonStyle}"
                                Click="SuggestNextButton_Click"
                                Margin="0,0,0,16"/>

                        <!-- Suggested Chords List -->
                        <TextBlock Text="SUGGESTIONS" Style="{StaticResource LabelStyle}"/>
                        <ListBox x:Name="SuggestedChordsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource AIListBoxItemStyle}"
                                 MaxHeight="180"
                                 Margin="0,0,0,16"
                                 SelectionChanged="SuggestedChordsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ChordName}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RomanNumeral}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ScoreDisplay}"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Chord Progression History -->
                        <TextBlock Text="PROGRESSION HISTORY" Style="{StaticResource LabelStyle}"/>
                        <Border Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,16"
                                MinHeight="40">
                            <TextBlock x:Name="ChordProgressionHistory"
                                       Text=""
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Apply Button -->
                        <Button x:Name="ApplyChordButton"
                                Content="Apply"
                                Style="{StaticResource SuccessButtonStyle}"
                                Click="ApplyChordButton_Click"
                                IsEnabled="False"/>

                        <TextBlock x:Name="ChordStatus"
                                   Text="Select a chord to add to progression"
                                   Style="{StaticResource StatusLabelStyle}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
