<UserControl x:Class="MusicEngineEditor.Controls.PunchcardVisualization"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource InputBackgroundBrush}"
             ClipToBounds="True">

    <Grid x:Name="VisualizationContainer">
        <!-- Background gradient for depth -->
        <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect Color="#000" BlurRadius="8" ShadowDepth="2" Opacity="0.5" Direction="270"/>
            </Border.Effect>
        </Border>

        <!-- Scrolling container -->
        <ScrollViewer x:Name="ScrollContainer"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      Background="Transparent"
                      Focusable="False">
            <Grid x:Name="ContentGrid">
                <!-- Grid lines (bars/beats) -->
                <Canvas x:Name="GridCanvas" Background="Transparent"/>

                <!-- Notes layer -->
                <Canvas x:Name="NotesCanvas" Background="Transparent"/>

                <!-- Labels layer (on top of notes) -->
                <Canvas x:Name="LabelsCanvas" Background="Transparent" IsHitTestVisible="False"/>
            </Grid>
        </ScrollViewer>

        <!-- Fixed playhead overlay (stays in center when scrolling) -->
        <Canvas x:Name="PlayheadCanvas" IsHitTestVisible="False" ClipToBounds="False">
            <!-- Playhead glow -->
            <Line x:Name="PlayheadGlow" Y1="0" Stroke="#FFCA28" StrokeThickness="6" Opacity="0.3">
                <Line.Effect>
                    <BlurEffect Radius="4"/>
                </Line.Effect>
            </Line>
            <!-- Playhead line -->
            <Line x:Name="Playhead" Y1="0" Stroke="#FFCA28" StrokeThickness="2" Opacity="0.95"/>
            <!-- Playhead triangle marker -->
            <Polygon x:Name="PlayheadMarker" Fill="#FFCA28" Opacity="0.9"
                     Points="0,0 6,8 -6,8"/>
        </Canvas>

        <!-- Cycle/loop markers -->
        <Canvas x:Name="CycleCanvas" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
