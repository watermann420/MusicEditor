<UserControl x:Class="MusicEngineEditor.Controls.Session.ClipSlotControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MusicEngineEditor.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="90"
             d:DataContext="{d:DesignInstance Type=vm:ClipSlotViewModel}"
             MinWidth="80"
             MinHeight="50"
             Margin="1"
             Cursor="Hand"
             MouseLeftButtonDown="OnMouseLeftButtonDown"
             MouseLeftButtonUp="OnMouseLeftButtonUp"
             MouseDoubleClick="OnMouseDoubleClick"
             MouseEnter="OnMouseEnter"
             MouseLeave="OnMouseLeave">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="SlotEmptyColor">#1A1A1A</Color>
        <Color x:Key="SlotHoverColor">#252525</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="ErrorColor">#FF4757</Color>
        <Color x:Key="WarningColor">#FFB800</Color>
        <Color x:Key="TextPrimaryColor">#E0E0E0</Color>
        <Color x:Key="TextSecondaryColor">#808080</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="SlotEmptyBrush" Color="{StaticResource SlotEmptyColor}"/>
        <SolidColorBrush x:Key="SlotHoverBrush" Color="{StaticResource SlotHoverColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>

        <!-- Recording Pulse Animation -->
        <Storyboard x:Key="RecordingPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RecordingOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="0.4"
                             Duration="0:0:0.5"
                             AutoReverse="True"/>
        </Storyboard>

        <!-- Playing Pulse Animation -->
        <Storyboard x:Key="PlayingPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PlayingIndicator"
                             Storyboard.TargetProperty="Opacity"
                             From="0.6" To="1.0"
                             Duration="0:0:0.3"
                             AutoReverse="True"/>
        </Storyboard>

        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Launch" Click="LaunchMenuItem_Click"/>
            <MenuItem Header="Stop" Click="StopMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Edit" Click="EditMenuItem_Click"/>
            <MenuItem Header="Create Clip" Click="CreateMenuItem_Click"/>
            <MenuItem Header="Duplicate" Click="DuplicateMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="Set Color">
                <MenuItem Header="Red" Click="SetColorRed_Click" Tag="#FF5555"/>
                <MenuItem Header="Orange" Click="SetColorOrange_Click" Tag="#FF9500"/>
                <MenuItem Header="Yellow" Click="SetColorYellow_Click" Tag="#FFFF55"/>
                <MenuItem Header="Green" Click="SetColorGreen_Click" Tag="#55FF55"/>
                <MenuItem Header="Cyan" Click="SetColorCyan_Click" Tag="#55FFFF"/>
                <MenuItem Header="Blue" Click="SetColorBlue_Click" Tag="#5555FF"/>
                <MenuItem Header="Purple" Click="SetColorPurple_Click" Tag="#AA55FF"/>
                <MenuItem Header="Magenta" Click="SetColorMagenta_Click" Tag="#FF55FF"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Delete" Click="DeleteMenuItem_Click" Foreground="{StaticResource ErrorBrush}"/>
        </ContextMenu>
    </UserControl.ContextMenu>

    <Border x:Name="SlotBorder"
            Background="{StaticResource SlotEmptyBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <!-- Progress Bar Background (behind everything) -->
            <Border x:Name="ProgressBarBackground"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="#2000FF88"
                    CornerRadius="3"
                    Width="0"
                    IsHitTestVisible="False"/>

            <!-- Empty Slot Content -->
            <Grid x:Name="EmptySlotContent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasClip}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TextBlock Text="+"
                           FontSize="18"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.4"/>
            </Grid>

            <!-- Clip Content -->
            <Grid x:Name="ClipContent"
                  Visibility="{Binding HasClip, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                </Grid.RowDefinitions>

                <!-- Color Bar at Top -->
                <Border x:Name="ColorBar"
                        Grid.Row="0"
                        CornerRadius="3,3,0,0"
                        Margin="0,0,0,0">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding ClipColor}"/>
                    </Border.Background>
                </Border>

                <!-- Main Content Area -->
                <Grid Grid.Row="1" Margin="4,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Clip Name -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding ClipName}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               MaxWidth="75"/>

                    <!-- Play/Stop Button Overlay (centered) -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Play Icon -->
                        <Path x:Name="PlayIcon"
                              Data="M 0,0 L 12,7 L 0,14 Z"
                              Fill="{StaticResource SuccessBrush}"
                              Opacity="0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

                        <!-- Stop Icon -->
                        <Rectangle x:Name="StopIcon"
                                   Width="10" Height="10"
                                   Fill="{StaticResource ErrorBrush}"
                                   Opacity="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Clip Type Indicator -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom">
                        <TextBlock FontSize="8"
                                   Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="MIDI"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAudioClip}" Value="True">
                                            <Setter Property="Text" Value="AUDIO"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Progress Bar at Bottom -->
                <Grid Grid.Row="2" Margin="2,0">
                    <Border Background="#303030"
                            CornerRadius="2"
                            Height="3"/>
                    <Border x:Name="ProgressBar"
                            Background="{StaticResource SuccessBrush}"
                            CornerRadius="2"
                            Height="3"
                            HorizontalAlignment="Stretch"
                            RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding PlaybackProgress}" ScaleY="1"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <!-- Status Indicator (top-right corner) -->
                <Border x:Name="StatusIndicator"
                        Grid.Row="0" Grid.RowSpan="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="8" Height="8"
                        CornerRadius="4"
                        Margin="0,1,2,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Playing Indicator Glow -->
                <Border x:Name="PlayingIndicator"
                        Grid.Row="0" Grid.RowSpan="3"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="2"
                        CornerRadius="4"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Queued Indicator -->
                <Border x:Name="QueuedIndicator"
                        Grid.Row="0" Grid.RowSpan="3"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="2"
                        CornerRadius="4"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Recording Overlay (pulsing red) -->
                <Border x:Name="RecordingOverlay"
                        Grid.Row="0" Grid.RowSpan="3"
                        Background="{StaticResource ErrorBrush}"
                        CornerRadius="4"
                        Opacity="0"
                        IsHitTestVisible="False"/>
            </Grid>

            <!-- Selection Border -->
            <Border x:Name="SelectionBorder"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2"
                    CornerRadius="4"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}"
                    IsHitTestVisible="False"/>

            <!-- Hover Overlay -->
            <Border x:Name="HoverOverlay"
                    Background="#20FFFFFF"
                    CornerRadius="4"
                    Opacity="0"
                    IsHitTestVisible="False"/>
        </Grid>
    </Border>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard x:Name="RecordingStoryboard" Storyboard="{StaticResource RecordingPulseStoryboard}"/>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
