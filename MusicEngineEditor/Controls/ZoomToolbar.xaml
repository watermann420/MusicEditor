<UserControl x:Class="MusicEngineEditor.Controls.ZoomToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MusicEngineEditor.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="700"
             d:DataContext="{d:DesignInstance Type=vm:ZoomToolbarViewModel}"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Theme Colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#808080"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D9FF"/>
        <SolidColorBrush x:Key="FollowActiveBrush" Color="#00CC66"/>
        <SolidColorBrush x:Key="SliderTrackBrush" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="SliderThumbBrush" Color="#00D9FF"/>

        <!-- Toolbar Button Style -->
        <Style x:Key="ZoomToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Button Style (for +/- buttons) -->
        <Style x:Key="ZoomCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ZoomToolbarButtonStyle}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ZoomToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource FollowActiveBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource FollowActiveBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ZoomPresetComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Zoom Slider Style -->
        <Style x:Key="ZoomSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{x:Null}"
                                                  Command="Slider.DecreaseLarge"
                                                  Background="{StaticResource AccentBrush}"
                                                  Height="4"
                                                  BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{x:Null}"
                                                  Command="Slider.IncreaseLarge"
                                                  Background="{StaticResource SliderTrackBrush}"
                                                  Height="4"
                                                  BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource SliderThumbBrush}"
                                                         Width="12" Height="12"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separator Style -->
        <Style x:Key="ToolbarSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Fill" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="6,4"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="ZoomLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- Zoom Percentage Display Style -->
        <Style x:Key="ZoomPercentStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Margin="8,4">

            <!-- Zoom Presets Dropdown -->
            <TextBlock Text="Zoom:" Style="{StaticResource ZoomLabelStyle}"/>
            <ComboBox x:Name="PresetComboBox"
                      Style="{StaticResource ZoomPresetComboBoxStyle}"
                      SelectedIndex="0"
                      SelectionChanged="PresetComboBox_SelectionChanged"
                      ToolTip="Select a zoom preset">
                <ComboBoxItem Content="Fit All" Tag="FitAll"/>
                <ComboBoxItem Content="Fit Selection" Tag="FitSelection"/>
                <ComboBoxItem Content="1 Bar" Tag="OneBar"/>
                <ComboBoxItem Content="4 Bars" Tag="FourBars"/>
                <ComboBoxItem Content="16 Bars" Tag="SixteenBars"/>
                <ComboBoxItem Content="Full Song" Tag="FullSong"/>
            </ComboBox>

            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

            <!-- Horizontal Zoom -->
            <TextBlock Text="H:" Style="{StaticResource ZoomLabelStyle}" ToolTip="Horizontal Zoom"/>
            <Button Content="-"
                    Style="{StaticResource ZoomCompactButtonStyle}"
                    Command="{Binding ZoomOutHorizontalCommand}"
                    ToolTip="Zoom Out Horizontal"/>
            <Slider x:Name="HorizontalZoomSlider"
                    Style="{StaticResource ZoomSliderStyle}"
                    Width="80"
                    Minimum="0.25"
                    Maximum="4.0"
                    Value="{Binding HorizontalZoom, Mode=TwoWay}"
                    SmallChange="0.1"
                    LargeChange="0.25"
                    ToolTip="Horizontal Zoom Level"/>
            <Button Content="+"
                    Style="{StaticResource ZoomCompactButtonStyle}"
                    Command="{Binding ZoomInHorizontalCommand}"
                    ToolTip="Zoom In Horizontal"/>
            <TextBlock x:Name="HorizontalZoomText"
                       Style="{StaticResource ZoomPercentStyle}"
                       Text="{Binding HorizontalZoomPercent, StringFormat={}{0}%}"/>

            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

            <!-- Vertical Zoom -->
            <TextBlock Text="V:" Style="{StaticResource ZoomLabelStyle}" ToolTip="Vertical Zoom (Track Heights / Note Height)"/>
            <Button Content="-"
                    Style="{StaticResource ZoomCompactButtonStyle}"
                    Command="{Binding ZoomOutVerticalCommand}"
                    ToolTip="Zoom Out Vertical"/>
            <Slider x:Name="VerticalZoomSlider"
                    Style="{StaticResource ZoomSliderStyle}"
                    Width="60"
                    Minimum="0.5"
                    Maximum="2.0"
                    Value="{Binding VerticalZoom, Mode=TwoWay}"
                    SmallChange="0.1"
                    LargeChange="0.25"
                    ToolTip="Vertical Zoom Level"/>
            <Button Content="+"
                    Style="{StaticResource ZoomCompactButtonStyle}"
                    Command="{Binding ZoomInVerticalCommand}"
                    ToolTip="Zoom In Vertical"/>
            <TextBlock x:Name="VerticalZoomText"
                       Style="{StaticResource ZoomPercentStyle}"
                       Text="{Binding VerticalZoomPercent, StringFormat={}{0}%}"/>

            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

            <!-- Navigation Controls -->
            <ToggleButton x:Name="FollowPlayheadToggle"
                          Style="{StaticResource ZoomToggleButtonStyle}"
                          IsChecked="{Binding FollowPlayhead, Mode=TwoWay}"
                          ToolTip="Follow Playhead - Auto-scroll during playback">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Follow" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>

            <Button x:Name="GoToPlayheadButton"
                    Style="{StaticResource ZoomToolbarButtonStyle}"
                    Content="Go To"
                    Command="{Binding GoToPlayheadCommand}"
                    Margin="4,0,0,0"
                    ToolTip="Scroll to current playhead position"/>

            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>

            <!-- Reset Zoom -->
            <Button x:Name="ResetZoomButton"
                    Style="{StaticResource ZoomToolbarButtonStyle}"
                    Content="Reset"
                    Command="{Binding ResetZoomCommand}"
                    ToolTip="Reset zoom to 100%"/>
        </StackPanel>
    </Border>
</UserControl>
