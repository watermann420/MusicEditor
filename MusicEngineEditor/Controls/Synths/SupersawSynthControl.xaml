<UserControl x:Class="MusicEngineEditor.Controls.Synths.SupersawSynthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="HighlightColor">#FF6B6B</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Vertical Slider Style -->
        <Style x:Key="VerticalSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="SUPERSAW SYNTH" Style="{StaticResource HeaderStyle}"
                           FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource HighlightBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Volume:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider Value="{Binding Volume, Mode=TwoWay, FallbackValue=0.8}"
                            Minimum="0" Maximum="1" Width="100" Style="{StaticResource DarkSliderStyle}"/>
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:F2}', FallbackValue='0.80'}"
                               Style="{StaticResource ValueStyle}" Width="40" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Unison Settings -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="UNISON" Style="{StaticResource HeaderStyle}"/>

                    <!-- Unison Count -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Voices:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding UnisonCount, Mode=TwoWay, FallbackValue=7}"
                                Minimum="1" Maximum="16" IsSnapToTickEnabled="True" TickFrequency="1"
                                Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding UnisonCount, FallbackValue='7'}"
                                   Style="{StaticResource ValueStyle}" FontWeight="Bold"/>
                    </Grid>

                    <!-- Detune Spread -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Detune:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding DetuneSpread, Mode=TwoWay, FallbackValue=25}"
                                Minimum="0" Maximum="100" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding DetuneSpread, StringFormat='{}{0:F0} ct', FallbackValue='25 ct'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Stereo Width -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Width:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding StereoWidth, Mode=TwoWay, FallbackValue=0.8}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding StereoWidth, StringFormat='{}{0:P0}', FallbackValue='80%'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Mix -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mix:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Mix, Mode=TwoWay, FallbackValue=1}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Mix, StringFormat='{}{0:P0}', FallbackValue='100%'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

                    <!-- Filter Section -->
                    <TextBlock Text="FILTER" Style="{StaticResource HeaderStyle}"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cutoff:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Cutoff, Mode=TwoWay, FallbackValue=8000}"
                                Minimum="20" Maximum="20000" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Cutoff, StringFormat='{}{0:F0} Hz', FallbackValue='8000 Hz'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Resonance:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Resonance, Mode=TwoWay, FallbackValue=0.3}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Resonance, StringFormat='{}{0:F2}', FallbackValue='0.30'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Center Column: Filter Envelope -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="FILTER ENVELOPE" Style="{StaticResource HeaderStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Attack -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="A" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Slider Value="{Binding FilterAttack, Mode=TwoWay, FallbackValue=0.01}"
                                    Minimum="0.001" Maximum="5" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding FilterAttack, StringFormat='{}{0:F2}', FallbackValue='0.01'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Decay -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="D" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Slider Value="{Binding FilterDecay, Mode=TwoWay, FallbackValue=0.2}"
                                    Minimum="0.001" Maximum="5" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding FilterDecay, StringFormat='{}{0:F2}', FallbackValue='0.20'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Sustain -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="S" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Slider Value="{Binding FilterSustain, Mode=TwoWay, FallbackValue=0.5}"
                                    Minimum="0" Maximum="1" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding FilterSustain, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Release -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="R" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Slider Value="{Binding FilterRelease, Mode=TwoWay, FallbackValue=0.3}"
                                    Minimum="0.001" Maximum="10" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding FilterRelease, StringFormat='{}{0:F2}', FallbackValue='0.30'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Envelope Amount -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Amount:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding FilterEnvAmount, Mode=TwoWay, FallbackValue=0.5}"
                                Minimum="-1" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding FilterEnvAmount, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Column: Presets -->
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="PRESETS" Style="{StaticResource HeaderStyle}"/>

                    <Button Content="Trance Lead" Style="{StaticResource PresetButtonStyle}"
                            Command="{Binding LoadPresetCommand}" CommandParameter="TranceLead"/>
                    <Button Content="EDM Chord" Style="{StaticResource PresetButtonStyle}"
                            Command="{Binding LoadPresetCommand}" CommandParameter="EDMChord"/>
                    <Button Content="Soft Pad" Style="{StaticResource PresetButtonStyle}"
                            Command="{Binding LoadPresetCommand}" CommandParameter="SoftPad"/>
                    <Button Content="Aggressive Bass" Style="{StaticResource PresetButtonStyle}"
                            Command="{Binding LoadPresetCommand}" CommandParameter="AggressiveBass"/>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

                    <TextBlock Text="AMP ENVELOPE" Style="{StaticResource HeaderStyle}"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Atk:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Attack, Mode=TwoWay, FallbackValue=0.01}"
                                Minimum="0.001" Maximum="5" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Attack, StringFormat='{}{0:F2}', FallbackValue='0.01'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dec:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Decay, Mode=TwoWay, FallbackValue=0.1}"
                                Minimum="0.001" Maximum="5" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Decay, StringFormat='{}{0:F2}', FallbackValue='0.10'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Sus:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Sustain, Mode=TwoWay, FallbackValue=0.8}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Sustain, StringFormat='{}{0:F2}', FallbackValue='0.80'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rel:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Release, Mode=TwoWay, FallbackValue=0.5}"
                                Minimum="0.001" Maximum="10" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Release, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
