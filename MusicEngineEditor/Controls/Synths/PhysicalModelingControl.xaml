<UserControl x:Class="MusicEngineEditor.Controls.Synths.PhysicalModelingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="ModelColor">#FFA657</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="ModelBrush" Color="{StaticResource ModelColor}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="40"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="PHYSICAL MODELING" Style="{StaticResource HeaderStyle}"
                           FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource ModelBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Model:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ModelTypeCombo" Width="150"
                              SelectedIndex="{Binding ModelTypeIndex, Mode=TwoWay, FallbackValue=0}"
                              Style="{StaticResource DarkComboBoxStyle}"
                              SelectionChanged="ModelTypeCombo_SelectionChanged">
                        <ComboBoxItem Content="Plucked String"/>
                        <ComboBoxItem Content="Bowed String"/>
                        <ComboBoxItem Content="Drum Membrane"/>
                        <ComboBoxItem Content="Wind Tube"/>
                        <ComboBoxItem Content="Bell"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Volume:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider Value="{Binding Volume, Mode=TwoWay, FallbackValue=0.8}"
                            Minimum="0" Maximum="1" Width="100" Style="{StaticResource DarkSliderStyle}"/>
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:F2}', FallbackValue='0.80'}"
                               Style="{StaticResource ValueStyle}" Width="40" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Model-Specific Parameters -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="MODEL PARAMETERS" Style="{StaticResource HeaderStyle}"/>

                    <!-- Plucked String Panel -->
                    <StackPanel x:Name="PluckedStringPanel" Grid.Row="1" Visibility="Visible">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pluck Position:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding PluckPosition, Mode=TwoWay, FallbackValue=0.3}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding PluckPosition, StringFormat='{}{0:F2}', FallbackValue='0.30'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Decay:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding PluckDecay, Mode=TwoWay, FallbackValue=0.5}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding PluckDecay, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Bowed String Panel -->
                    <StackPanel x:Name="BowedStringPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bow Pressure:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding BowPressure, Mode=TwoWay, FallbackValue=0.5}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding BowPressure, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bow Velocity:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding BowVelocity, Mode=TwoWay, FallbackValue=0.5}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding BowVelocity, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bow Position:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding BowPosition, Mode=TwoWay, FallbackValue=0.5}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding BowPosition, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Drum Membrane Panel -->
                    <StackPanel x:Name="DrumMembranePanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tension:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding DrumTension, Mode=TwoWay, FallbackValue=0.5}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding DrumTension, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Strike Position:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding DrumStrikePosition, Mode=TwoWay, FallbackValue=0.3}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding DrumStrikePosition, StringFormat='{}{0:F2}', FallbackValue='0.30'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Wind Tube Panel -->
                    <StackPanel x:Name="WindTubePanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Breath Press:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding BreathPressure, Mode=TwoWay, FallbackValue=0.5}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding BreathPressure, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Embouchure:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Embouchure, Mode=TwoWay, FallbackValue=0.5}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Embouchure, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Bell Panel -->
                    <StackPanel x:Name="BellPanel" Grid.Row="1" Visibility="Collapsed">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Strike Hard:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding BellStrikeHardness, Mode=TwoWay, FallbackValue=0.5}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding BellStrikeHardness, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Strike Position:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding BellStrikePosition, Mode=TwoWay, FallbackValue=0.3}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding BellStrikePosition, StringFormat='{}{0:F2}', FallbackValue='0.30'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Common Parameters -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="COMMON PARAMETERS" Style="{StaticResource HeaderStyle}"/>

                    <!-- Damping -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Damping:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Damping, Mode=TwoWay, FallbackValue=0.3}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Damping, StringFormat='{}{0:F2}', FallbackValue='0.30'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Brightness -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Brightness:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Brightness, Mode=TwoWay, FallbackValue=0.5}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Body Resonance -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Body Reso:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding BodyResonance, Mode=TwoWay, FallbackValue=0.5}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding BodyResonance, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Inharmonicity -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Inharmonicity:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Inharmonicity, Mode=TwoWay, FallbackValue=0}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Inharmonicity, StringFormat='{}{0:F2}', FallbackValue='0.00'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

                    <!-- Exciter Type -->
                    <TextBlock Text="EXCITER" Style="{StaticResource HeaderStyle}"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Type:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding ExciterTypeIndex, Mode=TwoWay, FallbackValue=0}"
                                  Style="{StaticResource DarkComboBoxStyle}">
                            <ComboBoxItem Content="Impulse"/>
                            <ComboBoxItem Content="Noise Burst"/>
                            <ComboBoxItem Content="Sine Burst"/>
                            <ComboBoxItem Content="Bow"/>
                            <ComboBoxItem Content="Breath"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
