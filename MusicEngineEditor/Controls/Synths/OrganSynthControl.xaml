<UserControl x:Class="MusicEngineEditor.Controls.Synths.OrganSynthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Synths"
             xmlns:vm="clr-namespace:MusicEngineEditor.ViewModels.Synths"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vm:OrganSynthViewModel}"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Dark Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="PanelLightColor">#1E1E1E</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="AccentDarkColor">#00A8CC</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="WarningColor">#FFB800</Color>

        <!-- Drawbar Colors (Traditional Hammond) -->
        <Color x:Key="DrawbarBrownColor">#8B4513</Color>
        <Color x:Key="DrawbarWhiteColor">#F0F0F0</Color>
        <Color x:Key="DrawbarBlackColor">#2A2A2A</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource PanelLightColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="DrawbarBrownBrush" Color="{StaticResource DrawbarBrownColor}"/>
        <SolidColorBrush x:Key="DrawbarWhiteBrush" Color="{StaticResource DrawbarWhiteColor}"/>
        <SolidColorBrush x:Key="DrawbarBlackBrush" Color="{StaticResource DrawbarBlackColor}"/>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Label Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="40"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Vertical Drawbar Slider Style -->
        <Style x:Key="DrawbarSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="8"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset Button Style -->
        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PanelLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio Button Style for Selectors -->
        <Style x:Key="SelectorRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PanelLightBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel Border Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Drawbar Template -->
        <DataTemplate x:Key="DrawbarTemplate" DataType="{x:Type vm:OrganDrawbarViewModel}">
            <StackPanel Margin="4,0" Width="36">
                <!-- Drawbar Value Display -->
                <TextBlock Text="{Binding Value}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="16"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <!-- Drawbar Slider with colored background -->
                <Border Background="{Binding ColorBrush}"
                        CornerRadius="4"
                        Padding="4,8">
                    <Slider Style="{StaticResource DrawbarSliderStyle}"
                            Value="{Binding Value, Mode=TwoWay}"
                            IsDirectionReversed="True"
                            ToolTip="{Binding Footage}"/>
                </Border>

                <!-- Footage Label -->
                <TextBlock Text="{Binding Footage}"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="9"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title and Preset -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ORGAN SYNTH" Style="{StaticResource HeaderStyle}"
                               Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding PresetName}" Style="{StaticResource ValueStyle}"
                               FontSize="14" Margin="0,0,16,0"/>
                </StackPanel>

                <!-- Preset Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Presets:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Button Content="Hammond B3" Style="{StaticResource PresetButtonStyle}"
                            Command="{Binding LoadPresetCommand}" CommandParameter="HammondB3"
                            ToolTip="Classic Hammond B3 sound"/>
                    <Button Content="Full Organ" Style="{StaticResource PresetButtonStyle}"
                            Command="{Binding LoadPresetCommand}" CommandParameter="FullOrgan"
                            ToolTip="All drawbars full"/>
                    <Button Content="Gospel" Style="{StaticResource PresetButtonStyle}"
                            Command="{Binding LoadPresetCommand}" CommandParameter="Gospel"
                            ToolTip="Gospel/Jazz organ"/>
                    <Button Content="Rock" Style="{StaticResource PresetButtonStyle}"
                            Command="{Binding LoadPresetCommand}" CommandParameter="Rock"
                            ToolTip="Rock organ sound"/>
                    <Button Content="Ballad" Style="{StaticResource PresetButtonStyle}"
                            Command="{Binding LoadPresetCommand}" CommandParameter="Ballad"
                            ToolTip="Soft ballad organ"/>
                    <Button Content="Theatre" Style="{StaticResource PresetButtonStyle}"
                            Command="{Binding LoadPresetCommand}" CommandParameter="Theatre"
                            ToolTip="Theatre pipe organ style"/>
                </StackPanel>

                <!-- Master Volume -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Volume:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider Value="{Binding Volume}" Minimum="0" Maximum="1" Width="100"
                            Style="{StaticResource DarkSliderStyle}"/>
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:P0}'}"
                               Style="{StaticResource ValueStyle}" Width="45" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Drawbars and Effects -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Drawbars Panel -->
                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Drawbar Preset Buttons -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="DRAWBARS (Hammond Style)" Style="{StaticResource HeaderStyle}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Quick:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                                <Button Content="888000000" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding ApplyDrawbarPresetCommand}" CommandParameter="888000000"
                                        ToolTip="Classic organ"/>
                                <Button Content="888888888" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding ApplyDrawbarPresetCommand}" CommandParameter="888888888"
                                        ToolTip="Full organ"/>
                                <Button Content="800000008" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding ApplyDrawbarPresetCommand}" CommandParameter="800000008"
                                        ToolTip="Fundamental + Octave"/>
                                <Button Content="006050400" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding ApplyDrawbarPresetCommand}" CommandParameter="006050400"
                                        ToolTip="Flute"/>
                                <Button Content="Reset" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding ResetDrawbarsCommand}"
                                        ToolTip="Reset all drawbars to 0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Drawbar Color Legend -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,8">
                            <Border Background="{StaticResource DrawbarBrownBrush}" Width="12" Height="12" CornerRadius="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Sub-octave" Style="{StaticResource LabelStyle}" Margin="0,0,16,0"/>
                            <Border Background="{StaticResource DrawbarWhiteBrush}" Width="12" Height="12" CornerRadius="2" Margin="0,0,4,0"/>
                            <TextBlock Text="Harmonic" Style="{StaticResource LabelStyle}" Margin="0,0,16,0"/>
                            <Border Background="{StaticResource DrawbarBlackBrush}" Width="12" Height="12" CornerRadius="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,4,0"/>
                            <TextBlock Text="Non-harmonic" Style="{StaticResource LabelStyle}"/>
                        </StackPanel>

                        <!-- 9 Drawbars -->
                        <Border Grid.Row="2" Background="{StaticResource PanelLightBrush}" CornerRadius="6" Padding="16,12">
                            <ItemsControl ItemsSource="{Binding Drawbars}"
                                          ItemTemplate="{StaticResource DrawbarTemplate}"
                                          HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </Grid>
                </Border>

                <!-- Bottom Panels: Percussion, Vibrato/Chorus, Effects -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Percussion Panel -->
                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="PERCUSSION" Style="{StaticResource HeaderStyle}"/>

                            <!-- Percussion Enable -->
                            <ToggleButton Content="Percussion On"
                                          Style="{StaticResource ToggleButtonStyle}"
                                          IsChecked="{Binding PercussionEnabled}"
                                          Margin="0,0,0,12"/>

                            <!-- Decay Speed -->
                            <TextBlock Text="Decay Speed" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Content="Slow" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsPercussionSlow}"
                                             GroupName="PercDecay"/>
                                <RadioButton Content="Fast" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsPercussionFast}"
                                             GroupName="PercDecay"/>
                            </StackPanel>

                            <!-- Harmonic Selection -->
                            <TextBlock Text="Harmonic" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Content="2nd" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsPercussionSecond}"
                                             GroupName="PercHarmonic"
                                             ToolTip="Second harmonic (one octave up)"/>
                                <RadioButton Content="3rd" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsPercussionThird}"
                                             GroupName="PercHarmonic"
                                             ToolTip="Third harmonic (octave + fifth)"/>
                            </StackPanel>

                            <!-- Percussion Level -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Level" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding PercussionLevel, StringFormat='{}{0:P0}'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </Grid>
                            <Slider Value="{Binding PercussionLevel}" Minimum="0" Maximum="1"
                                    Style="{StaticResource DarkSliderStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Vibrato/Chorus Panel -->
                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="VIBRATO / CHORUS" Style="{StaticResource HeaderStyle}"/>

                            <!-- V/C Selector (6 options) -->
                            <TextBlock Text="Scanner Setting" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,12">
                                <RadioButton Content="V1" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsVibratoV1}" GroupName="VibChorus"
                                             ToolTip="Vibrato 1 - Light"/>
                                <RadioButton Content="V2" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsVibratoV2}" GroupName="VibChorus"
                                             ToolTip="Vibrato 2 - Medium"/>
                                <RadioButton Content="V3" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsVibratoV3}" GroupName="VibChorus"
                                             ToolTip="Vibrato 3 - Full"/>
                                <RadioButton Content="C1" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsChorusC1}" GroupName="VibChorus"
                                             ToolTip="Chorus 1 - Light"/>
                                <RadioButton Content="C2" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsChorusC2}" GroupName="VibChorus"
                                             ToolTip="Chorus 2 - Medium"/>
                                <RadioButton Content="C3" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsChorusC3}" GroupName="VibChorus"
                                             ToolTip="Chorus 3 - Full"/>
                            </WrapPanel>

                            <!-- Key Click -->
                            <Grid Margin="0,12,0,4">
                                <TextBlock Text="Key Click" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding KeyClickLevel, StringFormat='{}{0:P0}'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </Grid>
                            <Slider Value="{Binding KeyClickLevel}" Minimum="0" Maximum="1"
                                    Style="{StaticResource DarkSliderStyle}"
                                    ToolTip="Amount of key click on note attack"/>

                            <!-- Tonewheel Leakage -->
                            <Grid Margin="0,12,0,4">
                                <TextBlock Text="Tonewheel Leakage" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding TonewheelLeakage, StringFormat='{}{0:P0}'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </Grid>
                            <Slider Value="{Binding TonewheelLeakage}" Minimum="0" Maximum="1"
                                    Style="{StaticResource DarkSliderStyle}"
                                    ToolTip="Crosstalk between tonewheels for authentic Hammond character"/>
                        </StackPanel>
                    </Border>

                    <!-- Rotary Speaker Panel -->
                    <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="ROTARY SPEAKER (Leslie)" Style="{StaticResource HeaderStyle}"/>

                            <!-- Rotary Enable -->
                            <ToggleButton Content="Rotary Speaker On"
                                          Style="{StaticResource ToggleButtonStyle}"
                                          IsChecked="{Binding RotaryEnabled}"
                                          Margin="0,0,0,12"/>

                            <!-- Speed Control -->
                            <TextBlock Text="Speed" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton Content="Stop" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsRotaryStop}" GroupName="RotarySpeed"
                                             ToolTip="Brake/Stop"/>
                                <RadioButton Content="Slow" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsRotarySlow}" GroupName="RotarySpeed"
                                             ToolTip="Chorale speed (~40 RPM)"/>
                                <RadioButton Content="Fast" Style="{StaticResource SelectorRadioStyle}"
                                             IsChecked="{Binding IsRotaryFast}" GroupName="RotarySpeed"
                                             ToolTip="Tremolo speed (~340 RPM)"/>
                            </StackPanel>

                            <!-- Rotary Mix -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Wet/Dry Mix" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding RotaryMix, StringFormat='{}{0:P0}'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </Grid>
                            <Slider Value="{Binding RotaryMix}" Minimum="0" Maximum="1"
                                    Style="{StaticResource DarkSliderStyle}"/>

                            <!-- Horn Level -->
                            <Grid Margin="0,12,0,4">
                                <TextBlock Text="Horn Level" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding HornLevel, StringFormat='{}{0:P0}'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </Grid>
                            <Slider Value="{Binding HornLevel}" Minimum="0" Maximum="1"
                                    Style="{StaticResource DarkSliderStyle}"
                                    ToolTip="High-frequency horn rotor level"/>

                            <!-- Drum Level -->
                            <Grid Margin="0,12,0,4">
                                <TextBlock Text="Drum Level" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding DrumLevel, StringFormat='{}{0:P0}'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </Grid>
                            <Slider Value="{Binding DrumLevel}" Minimum="0" Maximum="1"
                                    Style="{StaticResource DarkSliderStyle}"
                                    ToolTip="Low-frequency drum rotor level"/>

                            <!-- Overdrive -->
                            <Grid Margin="0,12,0,4">
                                <TextBlock Text="Overdrive" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Overdrive, StringFormat='{}{0:P0}'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </Grid>
                            <Slider Value="{Binding Overdrive}" Minimum="0" Maximum="1"
                                    Style="{StaticResource DarkSliderStyle}"
                                    ToolTip="Tube-style overdrive amount"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Right Panel: Visual Feedback and Info -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Rotary Speaker Visual -->
                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="140"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="LESLIE CABINET" Style="{StaticResource HeaderStyle}"/>

                        <Canvas Grid.Row="1" x:Name="RotaryCanvas" ClipToBounds="True"
                                Background="#101010">
                            <!-- Rotary speaker visualization drawn in code-behind -->
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Current Settings Summary -->
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="CURRENT SETTINGS" Style="{StaticResource HeaderStyle}"/>

                        <!-- Drawbar Display -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Drawbars:" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding DrawbarString}"
                                       Style="{StaticResource ValueStyle}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Grid>

                        <!-- Percussion Status -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Percussion:" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding PercussionStatus}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <!-- Vibrato/Chorus Status -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Vibrato/Chorus:" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding VibratoChorusStatus}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <!-- Rotary Status -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Rotary:" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding RotaryStatus}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Info Panel -->
                <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="HAMMOND DRAWBARS" Style="{StaticResource HeaderStyle}"/>

                            <TextBlock TextWrapping="Wrap" Style="{StaticResource LabelStyle}" Margin="0,0,0,8">
                                The 9 drawbars control the relative volume of different harmonics:
                            </TextBlock>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="16'" Foreground="{StaticResource DrawbarBrownBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Sub-octave (1/2 pitch)" Style="{StaticResource LabelStyle}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="5-1/3'" Foreground="{StaticResource DrawbarBrownBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Fifth above sub (3/2 pitch)" Style="{StaticResource LabelStyle}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="8'" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Fundamental (played pitch)" Style="{StaticResource LabelStyle}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="4'" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Octave (2x pitch)" Style="{StaticResource LabelStyle}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="2-2/3'" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Fifth above octave (3x pitch)" Style="{StaticResource LabelStyle}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="2'" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Two octaves (4x pitch)" Style="{StaticResource LabelStyle}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1-3/5'" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Major third (5x pitch)" Style="{StaticResource LabelStyle}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1-1/3'" Foreground="{StaticResource TextDimBrush}" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Fifth (6x pitch)" Style="{StaticResource LabelStyle}"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1'" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Three octaves (8x pitch)" Style="{StaticResource LabelStyle}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="4,0,4,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Style="{StaticResource LabelStyle}"/>

                <!-- Preview Button -->
                <Button Grid.Column="1" Content="Preview (C4)"
                        Style="{StaticResource DarkButtonStyle}"
                        Command="{Binding PlayPreviewNoteCommand}"
                        CommandParameter="60"
                        Margin="0,0,16,0"/>

                <!-- Mode Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Rotary: " Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding RotarySpeedText}"
                               Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
