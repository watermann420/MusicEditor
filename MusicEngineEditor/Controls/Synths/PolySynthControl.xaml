<UserControl x:Class="MusicEngineEditor.Controls.Synths.PolySynthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="VoiceActiveColor">#00FF88</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="VoiceActiveBrush" Color="{StaticResource VoiceActiveColor}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Vertical Slider Style -->
        <Style x:Key="VerticalSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="POLY SYNTH" Style="{StaticResource HeaderStyle}"
                               FontSize="16" Margin="0,0,20,0"/>
                    <!-- Voice Count Display -->
                    <Border Background="#1A1A1A" CornerRadius="4" Padding="12,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Voices: " Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="ActiveVoicesText" Text="{Binding ActiveVoices, FallbackValue='0'}"
                                       Foreground="{StaticResource VoiceActiveBrush}" FontWeight="Bold"/>
                            <TextBlock Text="/" Foreground="{StaticResource TextDimBrush}" Margin="2,0"/>
                            <TextBlock Text="{Binding MaxVoices, FallbackValue='16'}"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Preset Selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Preset:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="PresetCombo" Width="150" Style="{StaticResource DarkComboBoxStyle}"
                              SelectedIndex="{Binding PresetIndex, Mode=TwoWay, FallbackValue=0}">
                        <ComboBoxItem Content="Init"/>
                        <ComboBoxItem Content="Warm Pad"/>
                        <ComboBoxItem Content="Bright Lead"/>
                        <ComboBoxItem Content="Soft Keys"/>
                        <ComboBoxItem Content="Strings"/>
                        <ComboBoxItem Content="Brass Section"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Voice Settings -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="VOICE SETTINGS" Style="{StaticResource HeaderStyle}"/>

                    <!-- Voice Stealing Mode -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Stealing:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="1" x:Name="StealingModeCombo"
                                  SelectedIndex="{Binding StealingModeIndex, Mode=TwoWay, FallbackValue=1}"
                                  Style="{StaticResource DarkComboBoxStyle}">
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="Oldest"/>
                            <ComboBoxItem Content="Quietest"/>
                            <ComboBoxItem Content="Lowest"/>
                            <ComboBoxItem Content="Highest"/>
                        </ComboBox>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

                    <!-- Vibrato Section -->
                    <TextBlock Text="VIBRATO" Style="{StaticResource HeaderStyle}"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rate:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding VibratoRate, Mode=TwoWay, FallbackValue=5}"
                                Minimum="0.1" Maximum="20" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding VibratoRate, StringFormat='{}{0:F1} Hz', FallbackValue='5.0 Hz'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Depth:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding VibratoDepth, Mode=TwoWay, FallbackValue=0.1}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding VibratoDepth, StringFormat='{}{0:F2}', FallbackValue='0.10'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

                    <!-- Filter LFO Section -->
                    <TextBlock Text="FILTER LFO" Style="{StaticResource HeaderStyle}"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rate:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding FilterLfoRate, Mode=TwoWay, FallbackValue=1}"
                                Minimum="0.1" Maximum="20" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding FilterLfoRate, StringFormat='{}{0:F1} Hz', FallbackValue='1.0 Hz'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Depth:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding FilterLfoDepth, Mode=TwoWay, FallbackValue=0}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding FilterLfoDepth, StringFormat='{}{0:F2}', FallbackValue='0.00'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Center Column: ADSR Envelope -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="AMPLITUDE ENVELOPE" Style="{StaticResource HeaderStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Attack -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="A" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Slider Value="{Binding Attack, Mode=TwoWay, FallbackValue=0.01}"
                                    Minimum="0.001" Maximum="5" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding Attack, StringFormat='{}{0:F2}', FallbackValue='0.01'}"
                                       Style="{StaticResource ValueStyle}"/>
                            <TextBlock Text="sec" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" FontSize="9"/>
                        </StackPanel>

                        <!-- Decay -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="D" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Slider Value="{Binding Decay, Mode=TwoWay, FallbackValue=0.1}"
                                    Minimum="0.001" Maximum="5" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding Decay, StringFormat='{}{0:F2}', FallbackValue='0.10'}"
                                       Style="{StaticResource ValueStyle}"/>
                            <TextBlock Text="sec" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" FontSize="9"/>
                        </StackPanel>

                        <!-- Sustain -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="S" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Slider Value="{Binding Sustain, Mode=TwoWay, FallbackValue=0.7}"
                                    Minimum="0" Maximum="1" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding Sustain, StringFormat='{}{0:F2}', FallbackValue='0.70'}"
                                       Style="{StaticResource ValueStyle}"/>
                            <TextBlock Text="level" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" FontSize="9"/>
                        </StackPanel>

                        <!-- Release -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="R" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            <Slider Value="{Binding Release, Mode=TwoWay, FallbackValue=0.3}"
                                    Minimum="0.001" Maximum="10" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding Release, StringFormat='{}{0:F2}', FallbackValue='0.30'}"
                                       Style="{StaticResource ValueStyle}"/>
                            <TextBlock Text="sec" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" FontSize="9"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Column: Output -->
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="OUTPUT" Style="{StaticResource HeaderStyle}"/>

                    <!-- Volume -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Volume:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Volume, Mode=TwoWay, FallbackValue=0.8}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat='{}{0:F2}', FallbackValue='0.80'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Pan -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pan:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Pan, Mode=TwoWay, FallbackValue=0}"
                                Minimum="-1" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Pan, StringFormat='{}{0:F2}', FallbackValue='0.00'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

                    <!-- Filter -->
                    <TextBlock Text="FILTER" Style="{StaticResource HeaderStyle}"/>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cutoff:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Cutoff, Mode=TwoWay, FallbackValue=10000}"
                                Minimum="20" Maximum="20000" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Cutoff, StringFormat='{}{0:F0}Hz', FallbackValue='10000Hz'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Reso:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" Value="{Binding Resonance, Mode=TwoWay, FallbackValue=0.2}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Resonance, StringFormat='{}{0:F2}', FallbackValue='0.20'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
