<UserControl x:Class="MusicEngineEditor.Controls.Synths.SIDSynthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Synths"
             xmlns:vm="clr-namespace:MusicEngineEditor.ViewModels.Synths"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:SIDSynthViewModel}"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Dark Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="PanelLightColor">#1E1E1E</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>

        <!-- Oscillator Colors -->
        <Color x:Key="Osc1Color">#FF6B6B</Color>
        <Color x:Key="Osc2Color">#6BFF6B</Color>
        <Color x:Key="Osc3Color">#6B6BFF</Color>
        <Color x:Key="FilterColor">#FFD93D</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource PanelLightColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>

        <SolidColorBrush x:Key="Osc1Brush" Color="{StaticResource Osc1Color}"/>
        <SolidColorBrush x:Key="Osc2Brush" Color="{StaticResource Osc2Color}"/>
        <SolidColorBrush x:Key="Osc3Brush" Color="{StaticResource Osc3Color}"/>
        <SolidColorBrush x:Key="FilterBrush" Color="{StaticResource FilterColor}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Vertical Slider Style -->
        <Style x:Key="VerticalSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Label Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder"
                                    Width="16" Height="16"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Margin="0,0,6,0">
                                <Path x:Name="CheckMark"
                                      Data="M2,5 L5,8 L10,2"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Margin="1"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource PanelLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel Border Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Oscillator Panel Style -->
        <Style x:Key="OscillatorPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Padding" Value="8"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title and Chip Model -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SID SYNTH" Style="{StaticResource HeaderStyle}"
                               Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,0,20,0"/>
                    <TextBlock Text="Model:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <ComboBox SelectedIndex="{Binding ChipModelIndex, Mode=TwoWay}"
                              Style="{StaticResource DarkComboBoxStyle}" Width="80">
                        <ComboBoxItem Content="6581"/>
                        <ComboBoxItem Content="8580"/>
                    </ComboBox>
                </StackPanel>

                <!-- Preset Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="C64 Bass" Style="{StaticResource DarkButtonStyle}"
                            Command="{Binding LoadC64BassCommand}" Margin="0,0,6,0"/>
                    <Button Content="Arp Lead" Style="{StaticResource DarkButtonStyle}"
                            Command="{Binding LoadArpLeadCommand}" Margin="0,0,6,0"/>
                    <Button Content="Ring Bell" Style="{StaticResource DarkButtonStyle}"
                            Command="{Binding LoadRingBellCommand}" Margin="0,0,6,0"/>
                    <Button Content="Sync Lead" Style="{StaticResource DarkButtonStyle}"
                            Command="{Binding LoadSyncLeadCommand}" Margin="0,0,6,0"/>
                    <Button Content="Noise Hit" Style="{StaticResource DarkButtonStyle}"
                            Command="{Binding LoadNoiseHitCommand}"/>
                </StackPanel>

                <!-- Volume Control -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Volume:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="1" Width="80"
                            Style="{StaticResource DarkSliderStyle}"/>
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:F2}'}"
                               Style="{StaticResource ValueStyle}" Width="35" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Init/Random -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="20,0,0,0">
                    <Button Content="Init" Style="{StaticResource DarkButtonStyle}"
                            Command="{Binding InitPatchCommand}" Margin="0,0,6,0"/>
                    <Button Content="Random" Style="{StaticResource DarkButtonStyle}"
                            Command="{Binding RandomizePatchCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Oscillator 1 -->
            <Border Grid.Column="0" Style="{StaticResource OscillatorPanelStyle}"
                    BorderBrush="{StaticResource Osc1Brush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Oscillator Header -->
                    <TextBlock Grid.Row="0" Text="OSCILLATOR 1" Style="{StaticResource HeaderStyle}"
                               Foreground="{StaticResource Osc1Brush}"/>

                    <!-- Waveform Selection -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="Waveform" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding Osc1WaveformIndex, Mode=TwoWay}"
                                  Style="{StaticResource DarkComboBoxStyle}">
                            <ComboBoxItem Content="Triangle"/>
                            <ComboBoxItem Content="Sawtooth"/>
                            <ComboBoxItem Content="Pulse"/>
                            <ComboBoxItem Content="Noise"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Pulse Width, Sync, Ring Mod -->
                    <StackPanel Grid.Row="2">
                        <!-- Pulse Width -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pulse Width:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Osc1PulseWidth, Mode=TwoWay}"
                                    Minimum="0" Maximum="4095" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Osc1PulseWidth, StringFormat='{}{0:F0}'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <!-- Sync and Ring Mod -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <CheckBox Content="Sync" IsChecked="{Binding Osc1Sync, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,16,0"/>
                            <CheckBox Content="Ring Mod" IsChecked="{Binding Osc1RingMod, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBoxStyle}"/>
                        </StackPanel>

                        <!-- Filter Routing -->
                        <CheckBox Content="Route to Filter" IsChecked="{Binding Osc1FilterRoute, Mode=TwoWay}"
                                  Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,8"/>
                    </StackPanel>

                    <!-- ADSR Envelope -->
                    <Border Grid.Row="3" Background="{StaticResource PanelLightBrush}"
                            CornerRadius="3" Padding="6" Margin="0,4,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ENVELOPE" Style="{StaticResource LabelStyle}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Attack -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <Slider Value="{Binding Osc1Attack, Mode=TwoWay}" Minimum="0" Maximum="15"
                                            Style="{StaticResource VerticalSliderStyle}"/>
                                    <TextBlock Text="A" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Osc1Attack, StringFormat='{}{0:F0}'}"
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>

                                <!-- Decay -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <Slider Value="{Binding Osc1Decay, Mode=TwoWay}" Minimum="0" Maximum="15"
                                            Style="{StaticResource VerticalSliderStyle}"/>
                                    <TextBlock Text="D" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Osc1Decay, StringFormat='{}{0:F0}'}"
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>

                                <!-- Sustain -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <Slider Value="{Binding Osc1Sustain, Mode=TwoWay}" Minimum="0" Maximum="15"
                                            Style="{StaticResource VerticalSliderStyle}"/>
                                    <TextBlock Text="S" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Osc1Sustain, StringFormat='{}{0:F0}'}"
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>

                                <!-- Release -->
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <Slider Value="{Binding Osc1Release, Mode=TwoWay}" Minimum="0" Maximum="15"
                                            Style="{StaticResource VerticalSliderStyle}"/>
                                    <TextBlock Text="R" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Osc1Release, StringFormat='{}{0:F0}'}"
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Oscillator 2 -->
            <Border Grid.Column="1" Style="{StaticResource OscillatorPanelStyle}"
                    BorderBrush="{StaticResource Osc2Brush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Oscillator Header -->
                    <TextBlock Grid.Row="0" Text="OSCILLATOR 2" Style="{StaticResource HeaderStyle}"
                               Foreground="{StaticResource Osc2Brush}"/>

                    <!-- Waveform Selection -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="Waveform" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding Osc2WaveformIndex, Mode=TwoWay}"
                                  Style="{StaticResource DarkComboBoxStyle}">
                            <ComboBoxItem Content="Triangle"/>
                            <ComboBoxItem Content="Sawtooth"/>
                            <ComboBoxItem Content="Pulse"/>
                            <ComboBoxItem Content="Noise"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Pulse Width, Sync, Ring Mod -->
                    <StackPanel Grid.Row="2">
                        <!-- Pulse Width -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pulse Width:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Osc2PulseWidth, Mode=TwoWay}"
                                    Minimum="0" Maximum="4095" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Osc2PulseWidth, StringFormat='{}{0:F0}'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <!-- Sync and Ring Mod -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <CheckBox Content="Sync" IsChecked="{Binding Osc2Sync, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,16,0"/>
                            <CheckBox Content="Ring Mod" IsChecked="{Binding Osc2RingMod, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBoxStyle}"/>
                        </StackPanel>

                        <!-- Filter Routing -->
                        <CheckBox Content="Route to Filter" IsChecked="{Binding Osc2FilterRoute, Mode=TwoWay}"
                                  Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,8"/>
                    </StackPanel>

                    <!-- ADSR Envelope -->
                    <Border Grid.Row="3" Background="{StaticResource PanelLightBrush}"
                            CornerRadius="3" Padding="6" Margin="0,4,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ENVELOPE" Style="{StaticResource LabelStyle}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Attack -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <Slider Value="{Binding Osc2Attack, Mode=TwoWay}" Minimum="0" Maximum="15"
                                            Style="{StaticResource VerticalSliderStyle}"/>
                                    <TextBlock Text="A" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Osc2Attack, StringFormat='{}{0:F0}'}"
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>

                                <!-- Decay -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <Slider Value="{Binding Osc2Decay, Mode=TwoWay}" Minimum="0" Maximum="15"
                                            Style="{StaticResource VerticalSliderStyle}"/>
                                    <TextBlock Text="D" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Osc2Decay, StringFormat='{}{0:F0}'}"
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>

                                <!-- Sustain -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <Slider Value="{Binding Osc2Sustain, Mode=TwoWay}" Minimum="0" Maximum="15"
                                            Style="{StaticResource VerticalSliderStyle}"/>
                                    <TextBlock Text="S" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Osc2Sustain, StringFormat='{}{0:F0}'}"
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>

                                <!-- Release -->
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <Slider Value="{Binding Osc2Release, Mode=TwoWay}" Minimum="0" Maximum="15"
                                            Style="{StaticResource VerticalSliderStyle}"/>
                                    <TextBlock Text="R" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Osc2Release, StringFormat='{}{0:F0}'}"
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Oscillator 3 -->
            <Border Grid.Column="2" Style="{StaticResource OscillatorPanelStyle}"
                    BorderBrush="{StaticResource Osc3Brush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Oscillator Header -->
                    <TextBlock Grid.Row="0" Text="OSCILLATOR 3" Style="{StaticResource HeaderStyle}"
                               Foreground="{StaticResource Osc3Brush}"/>

                    <!-- Waveform Selection -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="Waveform" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding Osc3WaveformIndex, Mode=TwoWay}"
                                  Style="{StaticResource DarkComboBoxStyle}">
                            <ComboBoxItem Content="Triangle"/>
                            <ComboBoxItem Content="Sawtooth"/>
                            <ComboBoxItem Content="Pulse"/>
                            <ComboBoxItem Content="Noise"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Pulse Width, Sync, Ring Mod -->
                    <StackPanel Grid.Row="2">
                        <!-- Pulse Width -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pulse Width:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Osc3PulseWidth, Mode=TwoWay}"
                                    Minimum="0" Maximum="4095" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Osc3PulseWidth, StringFormat='{}{0:F0}'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <!-- Sync and Ring Mod -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                            <CheckBox Content="Sync" IsChecked="{Binding Osc3Sync, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,16,0"/>
                            <CheckBox Content="Ring Mod" IsChecked="{Binding Osc3RingMod, Mode=TwoWay}"
                                      Style="{StaticResource DarkCheckBoxStyle}"/>
                        </StackPanel>

                        <!-- Filter Routing -->
                        <CheckBox Content="Route to Filter" IsChecked="{Binding Osc3FilterRoute, Mode=TwoWay}"
                                  Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,8"/>
                    </StackPanel>

                    <!-- ADSR Envelope -->
                    <Border Grid.Row="3" Background="{StaticResource PanelLightBrush}"
                            CornerRadius="3" Padding="6" Margin="0,4,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ENVELOPE" Style="{StaticResource LabelStyle}"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Attack -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <Slider Value="{Binding Osc3Attack, Mode=TwoWay}" Minimum="0" Maximum="15"
                                            Style="{StaticResource VerticalSliderStyle}"/>
                                    <TextBlock Text="A" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Osc3Attack, StringFormat='{}{0:F0}'}"
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>

                                <!-- Decay -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <Slider Value="{Binding Osc3Decay, Mode=TwoWay}" Minimum="0" Maximum="15"
                                            Style="{StaticResource VerticalSliderStyle}"/>
                                    <TextBlock Text="D" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Osc3Decay, StringFormat='{}{0:F0}'}"
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>

                                <!-- Sustain -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <Slider Value="{Binding Osc3Sustain, Mode=TwoWay}" Minimum="0" Maximum="15"
                                            Style="{StaticResource VerticalSliderStyle}"/>
                                    <TextBlock Text="S" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Osc3Sustain, StringFormat='{}{0:F0}'}"
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>

                                <!-- Release -->
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <Slider Value="{Binding Osc3Release, Mode=TwoWay}" Minimum="0" Maximum="15"
                                            Style="{StaticResource VerticalSliderStyle}"/>
                                    <TextBlock Text="R" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Osc3Release, StringFormat='{}{0:F0}'}"
                                               Style="{StaticResource ValueStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Filter Section -->
            <Border Grid.Column="3" Style="{StaticResource PanelStyle}"
                    BorderBrush="{StaticResource FilterBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Header -->
                    <TextBlock Grid.Row="0" Text="FILTER" Style="{StaticResource HeaderStyle}"
                               Foreground="{StaticResource FilterBrush}"/>

                    <!-- Filter Type -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <TextBlock Text="Filter Type" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                        <ComboBox SelectedIndex="{Binding FilterTypeIndex, Mode=TwoWay}"
                                  Style="{StaticResource DarkComboBoxStyle}">
                            <ComboBoxItem Content="Low Pass"/>
                            <ComboBoxItem Content="Band Pass"/>
                            <ComboBoxItem Content="High Pass"/>
                            <ComboBoxItem Content="Off"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Cutoff -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock Text="Cutoff" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding FilterCutoff, StringFormat='{}{0:F0}'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Value="{Binding FilterCutoff, Mode=TwoWay}"
                                Minimum="0" Maximum="2047" Style="{StaticResource DarkSliderStyle}"/>
                    </StackPanel>

                    <!-- Resonance -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Resonance" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding FilterResonance, StringFormat='{}{0:F0}'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Value="{Binding FilterResonance, Mode=TwoWay}"
                                Minimum="0" Maximum="15" Style="{StaticResource DarkSliderStyle}"/>
                    </StackPanel>

                    <!-- Filter Routing Summary -->
                    <Border Grid.Row="4" Background="{StaticResource PanelLightBrush}"
                            CornerRadius="3" Padding="8">
                        <StackPanel>
                            <TextBlock Text="FILTER ROUTING" Style="{StaticResource LabelStyle}"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="14" Height="14" CornerRadius="7"
                                        Background="{Binding Osc1FilterRoute, Converter={x:Static local:SIDSynthControl.BoolToFilterBrushConverter}}"
                                        Margin="0,0,6,0"/>
                                <TextBlock Text="OSC 1" Style="{StaticResource LabelStyle}"
                                           Foreground="{StaticResource Osc1Brush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="14" Height="14" CornerRadius="7"
                                        Background="{Binding Osc2FilterRoute, Converter={x:Static local:SIDSynthControl.BoolToFilterBrushConverter}}"
                                        Margin="0,0,6,0"/>
                                <TextBlock Text="OSC 2" Style="{StaticResource LabelStyle}"
                                           Foreground="{StaticResource Osc2Brush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="14" Height="14" CornerRadius="7"
                                        Background="{Binding Osc3FilterRoute, Converter={x:Static local:SIDSynthControl.BoolToFilterBrushConverter}}"
                                        Margin="0,0,6,0"/>
                                <TextBlock Text="OSC 3" Style="{StaticResource LabelStyle}"
                                           Foreground="{StaticResource Osc3Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="4,0,4,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Style="{StaticResource LabelStyle}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="SID Chip: " Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding ChipModelName}" Style="{StaticResource ValueStyle}"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
