<UserControl x:Class="MusicEngineEditor.Controls.Synths.SpeechSynthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="VowelColor">#FF79C6</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="VowelBrush" Color="{StaticResource VowelColor}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Vowel Button Style -->
        <Style x:Key="VowelButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource VowelBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource VowelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset Button Style -->
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="SPEECH SYNTH" Style="{StaticResource HeaderStyle}"
                           FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource VowelBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="TTS Mode" IsChecked="{Binding TtsMode, Mode=TwoWay}"
                              Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,16,0"/>
                    <TextBlock Text="Volume:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider Value="{Binding Volume, Mode=TwoWay, FallbackValue=0.8}"
                            Minimum="0" Maximum="1" Width="100" Style="{StaticResource DarkSliderStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Vowel Grid and Lyrics -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Vowel Selector Grid -->
                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="VOWEL SELECTOR" Style="{StaticResource HeaderStyle}"/>

                        <WrapPanel HorizontalAlignment="Center">
                            <ToggleButton Content="A" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelA, Mode=TwoWay}"/>
                            <ToggleButton Content="E" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelE, Mode=TwoWay}"/>
                            <ToggleButton Content="I" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelI, Mode=TwoWay}"/>
                            <ToggleButton Content="O" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelO, Mode=TwoWay}"/>
                            <ToggleButton Content="U" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelU, Mode=TwoWay}"/>
                            <ToggleButton Content="AE" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelAE, Mode=TwoWay}"/>
                            <ToggleButton Content="OE" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelOE, Mode=TwoWay}"/>
                            <ToggleButton Content="UE" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelUE, Mode=TwoWay}"/>
                            <ToggleButton Content="AI" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelAI, Mode=TwoWay}"/>
                            <ToggleButton Content="AU" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelAU, Mode=TwoWay}"/>
                            <ToggleButton Content="EI" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelEI, Mode=TwoWay}"/>
                            <ToggleButton Content="EU" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelEU, Mode=TwoWay}"/>
                            <ToggleButton Content="OU" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelOU, Mode=TwoWay}"/>
                            <ToggleButton Content="OI" Style="{StaticResource VowelButtonStyle}"
                                          IsChecked="{Binding VowelOI, Mode=TwoWay}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Lyrics Input -->
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="LYRICS (Singing Mode)" Style="{StaticResource HeaderStyle}"/>

                        <TextBox Grid.Row="1" x:Name="LyricsInput"
                                 Text="{Binding Lyrics, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource PanelBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="14"
                                 Padding="8"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Parameters -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Formant Controls -->
                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="FORMANT" Style="{StaticResource HeaderStyle}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Shift:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding FormantShift, Mode=TwoWay, FallbackValue=0}"
                                    Minimum="-12" Maximum="12" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding FormantShift, StringFormat='{}{0:+0;-0;0}st', FallbackValue='0st'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Morph:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding MorphSpeed, Mode=TwoWay, FallbackValue=0.5}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding MorphSpeed, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Glottal Source -->
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="GLOTTAL SOURCE" Style="{StaticResource HeaderStyle}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding GlottalWaveformIndex, Mode=TwoWay, FallbackValue=0}"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="Sine"/>
                                <ComboBoxItem Content="Pulse"/>
                                <ComboBoxItem Content="Noise"/>
                                <ComboBoxItem Content="Impulse"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Breathing:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding BreathingAmount, Mode=TwoWay, FallbackValue=0.1}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding BreathingAmount, StringFormat='{}{0:F2}', FallbackValue='0.10'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Jitter:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Jitter, Mode=TwoWay, FallbackValue=0.01}"
                                    Minimum="0" Maximum="0.1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Jitter, StringFormat='{}{0:F3}', FallbackValue='0.010'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Shimmer:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Shimmer, Mode=TwoWay, FallbackValue=0.01}"
                                    Minimum="0" Maximum="0.1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Shimmer, StringFormat='{}{0:F3}', FallbackValue='0.010'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Presets -->
                <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="PRESETS" Style="{StaticResource HeaderStyle}"/>

                        <Button Content="Robot" Style="{StaticResource PresetButtonStyle}"
                                Command="{Binding LoadPresetCommand}" CommandParameter="Robot"/>
                        <Button Content="Choir" Style="{StaticResource PresetButtonStyle}"
                                Command="{Binding LoadPresetCommand}" CommandParameter="Choir"/>
                        <Button Content="Whisper" Style="{StaticResource PresetButtonStyle}"
                                Command="{Binding LoadPresetCommand}" CommandParameter="Whisper"/>
                        <Button Content="Monster" Style="{StaticResource PresetButtonStyle}"
                                Command="{Binding LoadPresetCommand}" CommandParameter="Monster"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
