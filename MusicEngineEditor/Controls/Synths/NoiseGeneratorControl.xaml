<UserControl x:Class="MusicEngineEditor.Controls.Synths.NoiseGeneratorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="NoiseColor">#BD93F9</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="NoiseBrush" Color="{StaticResource NoiseColor}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="50"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- RadioButton Style -->
        <Style x:Key="NoiseTypeRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="NOISE GENERATOR" Style="{StaticResource HeaderStyle}"
                           FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource NoiseBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Continuous" IsChecked="{Binding ContinuousMode, Mode=TwoWay}"
                              Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,16,0"/>
                    <TextBlock Text="Level:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider Value="{Binding OutputLevel, Mode=TwoWay, FallbackValue=0.5}"
                            Minimum="0" Maximum="1" Width="100" Style="{StaticResource DarkSliderStyle}"/>
                    <TextBlock Text="{Binding OutputLevel, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                               Style="{StaticResource ValueStyle}" Width="40" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Noise Type Selection -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Noise Type -->
                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="NOISE TYPE" Style="{StaticResource HeaderStyle}"/>

                        <StackPanel Grid.Row="1">
                            <RadioButton Content="White Noise" GroupName="NoiseType"
                                         IsChecked="{Binding IsWhiteNoise, Mode=TwoWay}"
                                         Style="{StaticResource NoiseTypeRadioStyle}"/>
                            <TextBlock Text="Equal energy at all frequencies" Style="{StaticResource LabelStyle}"
                                       Margin="20,0,0,8" FontSize="10"/>

                            <RadioButton Content="Pink Noise (1/f)" GroupName="NoiseType"
                                         IsChecked="{Binding IsPinkNoise, Mode=TwoWay}"
                                         Style="{StaticResource NoiseTypeRadioStyle}"/>
                            <TextBlock Text="Equal energy per octave, natural sounding" Style="{StaticResource LabelStyle}"
                                       Margin="20,0,0,8" FontSize="10"/>

                            <RadioButton Content="Brown Noise (1/f²)" GroupName="NoiseType"
                                         IsChecked="{Binding IsBrownNoise, Mode=TwoWay}"
                                         Style="{StaticResource NoiseTypeRadioStyle}"/>
                            <TextBlock Text="Deep rumble, Brownian motion" Style="{StaticResource LabelStyle}"
                                       Margin="20,0,0,8" FontSize="10"/>

                            <RadioButton Content="Blue Noise" GroupName="NoiseType"
                                         IsChecked="{Binding IsBlueNoise, Mode=TwoWay}"
                                         Style="{StaticResource NoiseTypeRadioStyle}"/>
                            <TextBlock Text="Energy increases with frequency" Style="{StaticResource LabelStyle}"
                                       Margin="20,0,0,8" FontSize="10"/>

                            <RadioButton Content="Violet Noise" GroupName="NoiseType"
                                         IsChecked="{Binding IsVioletNoise, Mode=TwoWay}"
                                         Style="{StaticResource NoiseTypeRadioStyle}"/>
                            <TextBlock Text="Emphasis on high frequencies" Style="{StaticResource LabelStyle}"
                                       Margin="20,0,0,8" FontSize="10"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Spectrum Visual -->
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="80"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="SPECTRUM SHAPE" Style="{StaticResource HeaderStyle}"/>

                        <Canvas x:Name="SpectrumCanvas" Grid.Row="1" Background="#0A0A0A" ClipToBounds="True">
                            <!-- Spectrum visualization drawn in code-behind -->
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Filter and Output -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Filter Section -->
                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="FILTER" Style="{StaticResource HeaderStyle}"/>

                        <!-- Filter Type -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Type:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding FilterTypeIndex, Mode=TwoWay, FallbackValue=0}"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="Lowpass"/>
                                <ComboBoxItem Content="Highpass"/>
                                <ComboBoxItem Content="Bandpass"/>
                                <ComboBoxItem Content="Notch"/>
                            </ComboBox>
                        </Grid>

                        <!-- Cutoff -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cutoff:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Cutoff, Mode=TwoWay, FallbackValue=10000}"
                                    Minimum="20" Maximum="20000" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Cutoff, StringFormat='{}{0:F0} Hz', FallbackValue='10000 Hz'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <!-- Resonance -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Resonance:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Resonance, Mode=TwoWay, FallbackValue=0}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Resonance, StringFormat='{}{0:F2}', FallbackValue='0.00'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

                        <!-- Stereo Width -->
                        <TextBlock Text="STEREO" Style="{StaticResource HeaderStyle}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Width:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding StereoWidth, Mode=TwoWay, FallbackValue=1}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding StereoWidth, StringFormat='{}{0:P0}', FallbackValue='100%'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Info -->
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="INFO" Style="{StaticResource HeaderStyle}"/>
                        <TextBlock Text="Use noise generators for percussion, textures, and sound effects. Filter the noise to shape its character."
                                   Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
