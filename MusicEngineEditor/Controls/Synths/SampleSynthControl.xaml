<UserControl x:Class="MusicEngineEditor.Controls.Synths.SampleSynthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="PanelLightColor">#1E1E1E</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="SampleColor">#00FF88</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource PanelLightColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="SampleBrush" Color="{StaticResource SampleColor}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Vertical Slider Style -->
        <Style x:Key="VerticalSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="SAMPLE SYNTH" Style="{StaticResource HeaderStyle}"
                           FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource SampleBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Load Sample" Style="{StaticResource DarkButtonStyle}"
                            Command="{Binding LoadSampleCommand}" Margin="0,0,8,0"/>
                    <TextBlock Text="Volume:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider Value="{Binding Volume, Mode=TwoWay, FallbackValue=0.8}"
                            Minimum="0" Maximum="1" Width="100" Style="{StaticResource DarkSliderStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Sample Zone List -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SAMPLE ZONES" Style="{StaticResource HeaderStyle}"/>

                    <ListBox Grid.Row="1" x:Name="SampleZoneList"
                             ItemsSource="{Binding SampleZones}"
                             SelectedItem="{Binding SelectedZone}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelLightBrush}" CornerRadius="3"
                                        Padding="8,4" Margin="0,2">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding KeyRange}" Foreground="{StaticResource TextDimBrush}"
                                                   FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add" Style="{StaticResource DarkButtonStyle}"
                                Command="{Binding AddZoneCommand}" Width="60"/>
                        <Button Content="Remove" Style="{StaticResource DarkButtonStyle}"
                                Command="{Binding RemoveZoneCommand}" Width="60" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Center: Key/Velocity Mapping & Loop -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Key Range Editor -->
                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="KEY MAPPING" Style="{StaticResource HeaderStyle}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Root Note:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" x:Name="RootNoteCombo"
                                      SelectedIndex="{Binding RootNoteIndex, Mode=TwoWay, FallbackValue=60}"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <!-- Generate notes C-1 to G9 -->
                                <ComboBoxItem Content="C4"/>
                                <ComboBoxItem Content="C#4"/>
                                <ComboBoxItem Content="D4"/>
                                <ComboBoxItem Content="D#4"/>
                                <ComboBoxItem Content="E4"/>
                                <ComboBoxItem Content="F4"/>
                                <ComboBoxItem Content="F#4"/>
                                <ComboBoxItem Content="G4"/>
                                <ComboBoxItem Content="G#4"/>
                                <ComboBoxItem Content="A4"/>
                                <ComboBoxItem Content="A#4"/>
                                <ComboBoxItem Content="B4"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Low Key:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding LowKey, Mode=TwoWay, FallbackValue=0}"
                                    Minimum="0" Maximum="127" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding LowKey, FallbackValue='0'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="High Key:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding HighKey, Mode=TwoWay, FallbackValue=127}"
                                    Minimum="0" Maximum="127" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding HighKey, FallbackValue='127'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <TextBlock Text="VELOCITY" Style="{StaticResource HeaderStyle}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Low Vel:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding LowVelocity, Mode=TwoWay, FallbackValue=0}"
                                    Minimum="0" Maximum="127" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding LowVelocity, FallbackValue='0'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="High Vel:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding HighVelocity, Mode=TwoWay, FallbackValue=127}"
                                    Minimum="0" Maximum="127" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding HighVelocity, FallbackValue='127'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Loop Settings -->
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="LOOP SETTINGS" Style="{StaticResource HeaderStyle}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mode:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding LoopModeIndex, Mode=TwoWay, FallbackValue=0}"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Forward"/>
                                <ComboBoxItem Content="PingPong"/>
                                <ComboBoxItem Content="Reverse"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Start:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding LoopStart, Mode=TwoWay, FallbackValue=0}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding LoopStart, StringFormat='{}{0:P0}', FallbackValue='0%'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="End:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding LoopEnd, Mode=TwoWay, FallbackValue=1}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding LoopEnd, StringFormat='{}{0:P0}', FallbackValue='100%'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Crossfade:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding LoopCrossfade, Mode=TwoWay, FallbackValue=0.01}"
                                    Minimum="0" Maximum="0.5" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding LoopCrossfade, StringFormat='{}{0:P0}', FallbackValue='1%'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RR Group:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding RoundRobinGroup, Mode=TwoWay, FallbackValue=0}"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Group 1"/>
                                <ComboBoxItem Content="Group 2"/>
                                <ComboBoxItem Content="Group 3"/>
                                <ComboBoxItem Content="Group 4"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right: Filter & Envelope -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter -->
                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="FILTER" Style="{StaticResource HeaderStyle}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cutoff:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Cutoff, Mode=TwoWay, FallbackValue=20000}"
                                    Minimum="20" Maximum="20000" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Cutoff, StringFormat='{}{0:F0}Hz', FallbackValue='20000Hz'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Reso:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Resonance, Mode=TwoWay, FallbackValue=0}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Resonance, StringFormat='{}{0:F2}', FallbackValue='0.00'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Amplitude Envelope -->
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="AMP ENVELOPE" Style="{StaticResource HeaderStyle}"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="A" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <Slider Value="{Binding Attack, Mode=TwoWay, FallbackValue=0.001}"
                                        Minimum="0.001" Maximum="5" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding Attack, StringFormat='{}{0:F3}', FallbackValue='0.001'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="D" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <Slider Value="{Binding Decay, Mode=TwoWay, FallbackValue=0.01}"
                                        Minimum="0.001" Maximum="5" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding Decay, StringFormat='{}{0:F2}', FallbackValue='0.01'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="S" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <Slider Value="{Binding Sustain, Mode=TwoWay, FallbackValue=1}"
                                        Minimum="0" Maximum="1" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding Sustain, StringFormat='{}{0:F2}', FallbackValue='1.00'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="R" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <Slider Value="{Binding Release, Mode=TwoWay, FallbackValue=0.1}"
                                        Minimum="0.001" Maximum="10" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding Release, StringFormat='{}{0:F2}', FallbackValue='0.10'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
