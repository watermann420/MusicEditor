<UserControl x:Class="MusicEngineEditor.Controls.Synths.AdvancedSynthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="PanelLightColor">#1E1E1E</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="OscColor">#FFD93D</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource PanelLightColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="OscBrush" Color="{StaticResource OscColor}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Vertical Slider Style -->
        <Style x:Key="VerticalSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="ADVANCED SYNTH" Style="{StaticResource HeaderStyle}"
                           FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource OscBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="Oscillators:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider x:Name="OscCountSlider" Value="{Binding OscillatorCount, Mode=TwoWay, FallbackValue=2}"
                            Minimum="1" Maximum="16" Width="100" IsSnapToTickEnabled="True" TickFrequency="1"
                            Style="{StaticResource DarkSliderStyle}"/>
                    <TextBlock Text="{Binding OscillatorCount, FallbackValue='2'}" Style="{StaticResource ValueStyle}"
                               Width="30" Margin="8,0,0,0" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Volume:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider Value="{Binding Volume, Mode=TwoWay, FallbackValue=0.8}"
                            Minimum="0" Maximum="1" Width="100" Style="{StaticResource DarkSliderStyle}"/>
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:F2}', FallbackValue='0.80'}"
                               Style="{StaticResource ValueStyle}" Width="40" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Oscillator Panel (Scrollable) -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="OSCILLATORS" Style="{StaticResource HeaderStyle}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OscillatorList" ItemsSource="{Binding Oscillators}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelLightBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Osc Number -->
                                            <Border Grid.Column="0" Background="{StaticResource OscBrush}"
                                                    CornerRadius="4" Width="30" Height="30" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Index}" Foreground="{StaticResource BackgroundBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontWeight="Bold"/>
                                            </Border>

                                            <!-- Waveform -->
                                            <StackPanel Grid.Column="1" Margin="4,0">
                                                <TextBlock Text="Waveform" Style="{StaticResource LabelStyle}"/>
                                                <ComboBox SelectedIndex="{Binding WaveformIndex, Mode=TwoWay, FallbackValue=2}"
                                                          Style="{StaticResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="Sine"/>
                                                    <ComboBoxItem Content="Square"/>
                                                    <ComboBoxItem Content="Saw"/>
                                                    <ComboBoxItem Content="Triangle"/>
                                                </ComboBox>
                                            </StackPanel>

                                            <!-- Level -->
                                            <StackPanel Grid.Column="2" Margin="4,0">
                                                <TextBlock Text="Level" Style="{StaticResource LabelStyle}"/>
                                                <Slider Value="{Binding Level, Mode=TwoWay, FallbackValue=0.8}"
                                                        Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                                                <TextBlock Text="{Binding Level, StringFormat='{}{0:F2}', FallbackValue='0.80'}"
                                                           Style="{StaticResource ValueStyle}"/>
                                            </StackPanel>

                                            <!-- Detune -->
                                            <StackPanel Grid.Column="3" Margin="4,0">
                                                <TextBlock Text="Detune (cents)" Style="{StaticResource LabelStyle}"/>
                                                <Slider Value="{Binding Detune, Mode=TwoWay, FallbackValue=0}"
                                                        Minimum="-100" Maximum="100" Style="{StaticResource DarkSliderStyle}"/>
                                                <TextBlock Text="{Binding Detune, StringFormat='{}{0:F0}', FallbackValue='0'}"
                                                           Style="{StaticResource ValueStyle}"/>
                                            </StackPanel>

                                            <!-- Octave -->
                                            <StackPanel Grid.Column="4" Margin="4,0">
                                                <TextBlock Text="Octave" Style="{StaticResource LabelStyle}"/>
                                                <Slider Value="{Binding Octave, Mode=TwoWay, FallbackValue=0}"
                                                        Minimum="-3" Maximum="3" IsSnapToTickEnabled="True" TickFrequency="1"
                                                        Style="{StaticResource DarkSliderStyle}"/>
                                                <TextBlock Text="{Binding Octave, StringFormat='{}{0:+0;-0;0}', FallbackValue='0'}"
                                                           Style="{StaticResource ValueStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Filter, Envelopes, LFO -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filter Section -->
                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="FILTER" Style="{StaticResource HeaderStyle}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Type:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding FilterTypeIndex, Mode=TwoWay, FallbackValue=0}"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="Lowpass"/>
                                <ComboBoxItem Content="Highpass"/>
                                <ComboBoxItem Content="Bandpass"/>
                                <ComboBoxItem Content="Notch"/>
                                <ComboBoxItem Content="MoogLadder"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cutoff:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Cutoff, Mode=TwoWay, FallbackValue=8000}"
                                    Minimum="20" Maximum="20000" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Cutoff, StringFormat='{}{0:F0}Hz', FallbackValue='8000Hz'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Reso:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Resonance, Mode=TwoWay, FallbackValue=0.3}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Resonance, StringFormat='{}{0:F2}', FallbackValue='0.30'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- LFO Section -->
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="LFO" Style="{StaticResource HeaderStyle}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Wave:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding LfoWaveformIndex, Mode=TwoWay, FallbackValue=0}"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="Sine"/>
                                <ComboBoxItem Content="Triangle"/>
                                <ComboBoxItem Content="Square"/>
                                <ComboBoxItem Content="Saw"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Target:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding LfoTargetIndex, Mode=TwoWay, FallbackValue=0}"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="Pitch"/>
                                <ComboBoxItem Content="Filter"/>
                                <ComboBoxItem Content="Amplitude"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rate:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding LfoRate, Mode=TwoWay, FallbackValue=2}"
                                    Minimum="0.1" Maximum="20" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding LfoRate, StringFormat='{}{0:F1}Hz', FallbackValue='2.0Hz'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Depth:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding LfoDepth, Mode=TwoWay, FallbackValue=0.2}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding LfoDepth, StringFormat='{}{0:F2}', FallbackValue='0.20'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Amplitude ADSR -->
                <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="AMP ENVELOPE" Style="{StaticResource HeaderStyle}"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="A" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <Slider Value="{Binding Attack, Mode=TwoWay, FallbackValue=0.01}"
                                        Minimum="0.001" Maximum="5" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding Attack, StringFormat='{}{0:F2}', FallbackValue='0.01'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="D" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <Slider Value="{Binding Decay, Mode=TwoWay, FallbackValue=0.1}"
                                        Minimum="0.001" Maximum="5" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding Decay, StringFormat='{}{0:F2}', FallbackValue='0.10'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="S" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <Slider Value="{Binding Sustain, Mode=TwoWay, FallbackValue=0.7}"
                                        Minimum="0" Maximum="1" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding Sustain, StringFormat='{}{0:F2}', FallbackValue='0.70'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="R" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <Slider Value="{Binding Release, Mode=TwoWay, FallbackValue=0.3}"
                                        Minimum="0.001" Maximum="10" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding Release, StringFormat='{}{0:F2}', FallbackValue='0.30'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
