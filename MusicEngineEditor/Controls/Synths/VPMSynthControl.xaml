<UserControl x:Class="MusicEngineEditor.Controls.Synths.VPMSynthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Synths"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Dark Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="PanelLightColor">#1E1E1E</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="Line1Color">#FF6B6B</Color>
        <Color x:Key="Line2Color">#6BCF6B</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource PanelLightColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="Line1Brush" Color="{StaticResource Line1Color}"/>
        <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Vertical Slider Style -->
        <Style x:Key="VerticalSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="40"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PanelLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Preset Button Style -->
        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VPM SYNTH" Style="{StaticResource HeaderStyle}"
                               Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,0,20,0"/>
                    <TextBlock Text="Casio CZ Style Phase Distortion" Style="{StaticResource LabelStyle}"
                               FontStyle="Italic" Margin="0,0,20,0"/>
                </StackPanel>

                <!-- Master Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Volume:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider x:Name="VolumeSlider" Value="{Binding Volume, Mode=TwoWay, FallbackValue=0.5}"
                            Minimum="0" Maximum="1" Width="100" Style="{StaticResource DarkSliderStyle}"/>
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                               Style="{StaticResource ValueStyle}" Width="40" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Line 1 -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LINE 1" Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource Line1Brush}"/>
                    </StackPanel>

                    <!-- Waveform Selector -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="1" x:Name="Waveform1Combo"
                                  SelectedIndex="{Binding Waveform1Index, Mode=TwoWay, FallbackValue=0}"
                                  Style="{StaticResource DarkComboBoxStyle}">
                            <ComboBoxItem Content="Sawtooth"/>
                            <ComboBoxItem Content="Square"/>
                            <ComboBoxItem Content="Pulse"/>
                            <ComboBoxItem Content="Double Sine"/>
                            <ComboBoxItem Content="Saw-Pulse"/>
                            <ComboBoxItem Content="Resonant 1"/>
                            <ComboBoxItem Content="Resonant 2"/>
                            <ComboBoxItem Content="Resonant 3"/>
                        </ComboBox>
                    </Grid>

                    <!-- DCW Envelope (Wave Shape) -->
                    <TextBlock Text="DCW ENVELOPE (Wave Shape)" Style="{StaticResource LabelStyle}"
                               FontWeight="SemiBold" Margin="0,12,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Attack" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="Dcw1AttackSlider" Value="{Binding DcwAttack, Mode=TwoWay, FallbackValue=90}"
                                    Minimum="0" Maximum="99" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding DcwAttack, StringFormat='{}{0:F0}', FallbackValue='90'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Decay" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="Dcw1DecaySlider" Value="{Binding DcwDecay, Mode=TwoWay, FallbackValue=40}"
                                    Minimum="0" Maximum="99" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding DcwDecay, StringFormat='{}{0:F0}', FallbackValue='40'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Sustain" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="Dcw1SustainSlider" Value="{Binding DcwSustain, Mode=TwoWay, FallbackValue=50}"
                                    Minimum="0" Maximum="99" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding DcwSustain, StringFormat='{}{0:F0}', FallbackValue='50'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="Release" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="Dcw1ReleaseSlider" Value="{Binding DcwRelease, Mode=TwoWay, FallbackValue=30}"
                                    Minimum="0" Maximum="99" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding DcwRelease, StringFormat='{}{0:F0}', FallbackValue='30'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- DCA Envelope (Amplitude) -->
                    <TextBlock Text="DCA ENVELOPE (Amplitude)" Style="{StaticResource LabelStyle}"
                               FontWeight="SemiBold" Margin="0,12,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Attack" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="Dca1AttackSlider" Value="{Binding DcaAttack, Mode=TwoWay, FallbackValue=80}"
                                    Minimum="0" Maximum="99" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding DcaAttack, StringFormat='{}{0:F0}', FallbackValue='80'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Decay" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="Dca1DecaySlider" Value="{Binding DcaDecay, Mode=TwoWay, FallbackValue=50}"
                                    Minimum="0" Maximum="99" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding DcaDecay, StringFormat='{}{0:F0}', FallbackValue='50'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Sustain" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="Dca1SustainSlider" Value="{Binding DcaSustain, Mode=TwoWay, FallbackValue=70}"
                                    Minimum="0" Maximum="99" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding DcaSustain, StringFormat='{}{0:F0}', FallbackValue='70'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="Release" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="Dca1ReleaseSlider" Value="{Binding DcaRelease, Mode=TwoWay, FallbackValue=40}"
                                    Minimum="0" Maximum="99" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding DcaRelease, StringFormat='{}{0:F0}', FallbackValue='40'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Center Panel: Line 2 and Modulation -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <!-- Line 2 Header with Enable Toggle -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LINE 2" Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource Line2Brush}" Margin="0,0,16,0"/>
                        <ToggleButton Content="Enable" Style="{StaticResource ToggleButtonStyle}"
                                      IsChecked="{Binding Line2Enable, Mode=TwoWay}"
                                      Padding="8,2"/>
                    </StackPanel>

                    <!-- Line 2 Waveform -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Waveform:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="1" x:Name="Waveform2Combo"
                                  SelectedIndex="{Binding Waveform2Index, Mode=TwoWay, FallbackValue=0}"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  IsEnabled="{Binding Line2Enable}">
                            <ComboBoxItem Content="Sawtooth"/>
                            <ComboBoxItem Content="Square"/>
                            <ComboBoxItem Content="Pulse"/>
                            <ComboBoxItem Content="Double Sine"/>
                            <ComboBoxItem Content="Saw-Pulse"/>
                            <ComboBoxItem Content="Resonant 1"/>
                            <ComboBoxItem Content="Resonant 2"/>
                            <ComboBoxItem Content="Resonant 3"/>
                        </ComboBox>
                    </Grid>

                    <!-- Line 2 Level -->
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Level:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" x:Name="Line2LevelSlider"
                                Value="{Binding Line2Level, Mode=TwoWay, FallbackValue=0.5}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"
                                IsEnabled="{Binding Line2Enable}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Line2Level, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Detune -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Detune:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" x:Name="DetuneSlider"
                                Value="{Binding Detune, Mode=TwoWay, FallbackValue=0}"
                                Minimum="-100" Maximum="100" Style="{StaticResource DarkSliderStyle}"
                                IsEnabled="{Binding Line2Enable}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Detune, StringFormat='{}{0:F0}c', FallbackValue='0c'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Line Mode (Mix/Ring/Sync) -->
                    <TextBlock Text="LINE MODE" Style="{StaticResource LabelStyle}"
                               FontWeight="SemiBold" Margin="0,12,0,8"/>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mode:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="1" x:Name="LineModeCombo"
                                  SelectedIndex="{Binding LineModeIndex, Mode=TwoWay, FallbackValue=0}"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  IsEnabled="{Binding Line2Enable}">
                            <ComboBoxItem Content="Mix"/>
                            <ComboBoxItem Content="Ring Mod"/>
                            <ComboBoxItem Content="Sync"/>
                        </ComboBox>
                    </Grid>

                    <!-- DCO (Pitch) Envelope -->
                    <TextBlock Text="DCO ENVELOPE (Pitch)" Style="{StaticResource LabelStyle}"
                               FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Depth:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" x:Name="DcoDepthSlider"
                                Value="{Binding DcoDepth, Mode=TwoWay, FallbackValue=0}"
                                Minimum="0" Maximum="4" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding DcoDepth, StringFormat='{}{0:F1} oct', FallbackValue='0.0 oct'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Right Panel: Presets -->
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PRESETS" Style="{StaticResource HeaderStyle}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel>
                            <Button Content="CZ Bass" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="CZBass"/>
                            <Button Content="CZ Organ" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="CZOrgan"/>
                            <Button Content="CZ Strings" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="CZStrings"/>
                            <Button Content="CZ Bells" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="CZBells"/>
                            <Button Content="CZ Sync Lead" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="CZSyncLead"/>
                            <Button Content="Resonant Pad" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="ResonantPad"/>
                            <Button Content="Phase Lead" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="PhaseLead"/>
                            <Button Content="Digital EP" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="DigitalEP"/>
                            <Button Content="Pulse Bass" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="PulseBass"/>
                            <Button Content="Ring Mod" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="RingMod"/>
                        </WrapPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="4,0,4,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage, FallbackValue='Ready'}"
                           Style="{StaticResource LabelStyle}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Waveform: " Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding Waveform1Name, FallbackValue='Sawtooth'}"
                               Foreground="{StaticResource Line1Brush}" FontWeight="SemiBold"/>
                    <TextBlock Text=" | Line 2: " Style="{StaticResource LabelStyle}" Margin="16,0,0,0"/>
                    <TextBlock Text="{Binding Line2StatusText, FallbackValue='Off'}"
                               Foreground="{StaticResource Line2Brush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
