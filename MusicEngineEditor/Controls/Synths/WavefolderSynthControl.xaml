<UserControl x:Class="MusicEngineEditor.Controls.Synths.WavefolderSynthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Synths"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Dark Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="PanelLightColor">#1E1E1E</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="WarningColor">#FF6B6B</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource PanelLightColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Vertical Slider Style -->
        <Style x:Key="VerticalSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="40"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Preset Button Style -->
        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WAVEFOLDER SYNTH" Style="{StaticResource HeaderStyle}"
                               Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,0,20,0"/>
                    <TextBlock Text="Distortion Synthesis" Style="{StaticResource LabelStyle}"
                               FontStyle="Italic" Margin="0,0,20,0"/>
                </StackPanel>

                <!-- Master Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Volume:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider x:Name="VolumeSlider" Value="{Binding Volume, Mode=TwoWay, FallbackValue=0.5}"
                            Minimum="0" Maximum="1" Width="100" Style="{StaticResource DarkSliderStyle}"/>
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                               Style="{StaticResource ValueStyle}" Width="40" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Oscillator and Input -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="OSCILLATOR" Style="{StaticResource HeaderStyle}"/>

                    <!-- Oscillator Type -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Type:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="1" x:Name="OscillatorTypeCombo"
                                  SelectedIndex="{Binding OscillatorTypeIndex, Mode=TwoWay, FallbackValue=0}"
                                  Style="{StaticResource DarkComboBoxStyle}">
                            <ComboBoxItem Content="Sine"/>
                            <ComboBoxItem Content="Sawtooth"/>
                            <ComboBoxItem Content="Triangle"/>
                            <ComboBoxItem Content="Square"/>
                        </ComboBox>
                    </Grid>

                    <!-- Input Gain (Drive) -->
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Input Gain:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" x:Name="DriveSlider"
                                Value="{Binding Drive, Mode=TwoWay, FallbackValue=0.5}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Drive, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Detune -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Detune:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" x:Name="DetuneSlider"
                                Value="{Binding Detune, Mode=TwoWay, FallbackValue=0}"
                                Minimum="-100" Maximum="100" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Detune, StringFormat='{}{0:F0}c', FallbackValue='0c'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Pulse Width (for Square) -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pulse Width:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" x:Name="PulseWidthSlider"
                                Value="{Binding PulseWidth, Mode=TwoWay, FallbackValue=0.5}"
                                Minimum="0.05" Maximum="0.95" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding PulseWidth, StringFormat='{}{0:P0}', FallbackValue='50%'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Amplitude Envelope -->
                    <TextBlock Text="AMPLITUDE ENVELOPE" Style="{StaticResource LabelStyle}"
                               FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Attack" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="AttackSlider" Value="{Binding Attack, Mode=TwoWay, FallbackValue=0.01}"
                                    Minimum="0.001" Maximum="2" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding Attack, StringFormat='{}{0:F2}s', FallbackValue='0.01s'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Decay" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="DecaySlider" Value="{Binding Decay, Mode=TwoWay, FallbackValue=0.1}"
                                    Minimum="0.001" Maximum="2" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding Decay, StringFormat='{}{0:F2}s', FallbackValue='0.10s'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Sustain" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="SustainSlider" Value="{Binding Sustain, Mode=TwoWay, FallbackValue=0.8}"
                                    Minimum="0" Maximum="1" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding Sustain, StringFormat='{}{0:F2}', FallbackValue='0.80'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="Release" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="ReleaseSlider" Value="{Binding Release, Mode=TwoWay, FallbackValue=0.3}"
                                    Minimum="0.001" Maximum="4" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding Release, StringFormat='{}{0:F2}s', FallbackValue='0.30s'}"
                                       Style="{StaticResource ValueStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Center Panel: Wavefolder Controls -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="WAVEFOLDER" Style="{StaticResource HeaderStyle}"/>

                    <!-- Fold Amount -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fold Amount:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" x:Name="FoldAmountSlider"
                                Value="{Binding FoldAmount, Mode=TwoWay, FallbackValue=0.5}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding FoldAmount, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Symmetry -->
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Symmetry:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" x:Name="SymmetrySlider"
                                Value="{Binding Symmetry, Mode=TwoWay, FallbackValue=0.5}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Symmetry, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Stages Selector -->
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Stages:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" x:Name="StagesSlider"
                                Value="{Binding FoldStages, Mode=TwoWay, FallbackValue=3}"
                                Minimum="1" Maximum="8"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding FoldStages, StringFormat='{}{0:F0}', FallbackValue='3'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Algorithm Selector -->
                    <TextBlock Text="ALGORITHM" Style="{StaticResource LabelStyle}"
                               FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Type:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="1" x:Name="AlgorithmCombo"
                                  SelectedIndex="{Binding AlgorithmIndex, Mode=TwoWay, FallbackValue=0}"
                                  Style="{StaticResource DarkComboBoxStyle}">
                            <ComboBoxItem Content="Sine (Smooth)"/>
                            <ComboBoxItem Content="Triangle (Sharp)"/>
                            <ComboBoxItem Content="Soft Clip (Warm)"/>
                            <ComboBoxItem Content="Hard (Aggressive)"/>
                            <ComboBoxItem Content="Asymmetric"/>
                            <ComboBoxItem Content="Multi-Stage"/>
                            <ComboBoxItem Content="Serge"/>
                        </ComboBox>
                    </Grid>

                    <!-- Dry/Wet Mix -->
                    <Grid Margin="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dry/Wet:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" x:Name="MixSlider"
                                Value="{Binding Mix, Mode=TwoWay, FallbackValue=1.0}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Mix, StringFormat='{}{0:P0}', FallbackValue='100%'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>

                    <!-- Fold Envelope Depth -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Env Depth:" Style="{StaticResource LabelStyle}"/>
                        <Slider Grid.Column="1" x:Name="FoldEnvDepthSlider"
                                Value="{Binding FoldEnvelopeDepth, Mode=TwoWay, FallbackValue=0}"
                                Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                        <TextBlock Grid.Column="2" Text="{Binding FoldEnvelopeDepth, StringFormat='{}{0:F2}', FallbackValue='0.00'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Right Panel: Presets -->
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PRESETS" Style="{StaticResource HeaderStyle}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel>
                            <Button Content="Smooth" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="Smooth"/>
                            <Button Content="Aggressive" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="Aggressive"/>
                            <Button Content="Serge" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="Serge"/>
                            <Button Content="Warm" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="Warm"/>
                            <Button Content="Complex" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="Complex"/>
                            <Button Content="Buzzy" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="Buzzy"/>
                            <Button Content="Subtle" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="Subtle"/>
                            <Button Content="Heavy" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="Heavy"/>
                            <Button Content="Asymmetric" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="Asymmetric"/>
                            <Button Content="Buchla" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="Buchla"/>
                        </WrapPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="4,0,4,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage, FallbackValue='Ready'}"
                           Style="{StaticResource LabelStyle}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Osc: " Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding OscillatorName, FallbackValue='Sine'}"
                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text=" | Algorithm: " Style="{StaticResource LabelStyle}" Margin="16,0,0,0"/>
                    <TextBlock Text="{Binding AlgorithmName, FallbackValue='Sine'}"
                               Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text=" | Stages: " Style="{StaticResource LabelStyle}" Margin="16,0,0,0"/>
                    <TextBlock Text="{Binding FoldStages, FallbackValue='3'}"
                               Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
