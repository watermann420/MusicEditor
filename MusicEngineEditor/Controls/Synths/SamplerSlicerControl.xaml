<UserControl x:Class="MusicEngineEditor.Controls.Synths.SamplerSlicerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Synths"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1100"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Converters -->
        <local:SlicerInverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="PanelLightColor">#1E1E1E</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="SliceColor">#FF5722</Color>
        <Color x:Key="WaveformColor">#00FF88</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="SliderTrackColor">#333333</Color>
        <Color x:Key="SelectedSliceColor">#FFD700</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource PanelLightColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SliceBrush" Color="{StaticResource SliceColor}"/>
        <SolidColorBrush x:Key="WaveformBrush" Color="{StaticResource WaveformColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="SliderTrackBrush" Color="{StaticResource SliderTrackColor}"/>
        <SolidColorBrush x:Key="SelectedSliceBrush" Color="{StaticResource SelectedSliceColor}"/>

        <!-- Waveform Gradient Brush -->
        <LinearGradientBrush x:Key="WaveformGradientBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00FF88" Offset="0"/>
            <GradientStop Color="#006644" Offset="0.5"/>
            <GradientStop Color="#00FF88" Offset="1"/>
        </LinearGradientBrush>

        <!-- Slider Style -->
        <Style x:Key="SlicerSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource SliderTrackBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="ParameterLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Label Style -->
        <Style x:Key="ValueLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="50"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="SlicerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#303030"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource SlicerButtonStyle}">
            <Setter Property="Background" Value="#004455"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- Small Button Style -->
        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SlicerButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="MinWidth" Value="50"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="SlicerComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="SlicerToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Item Style for Slices -->
        <Style x:Key="SliceListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#004455"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title and File Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SAMPLER SLICER"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource SliceBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="|" Foreground="{StaticResource TextDimBrush}" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LoadedFileName, FallbackValue='No sample loaded'}"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SliceCount, StringFormat=' ({0} slices)'}"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasLoadedSample, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Transport Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Load Sample"
                            Command="{Binding LoadSampleCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button Content="Export Slices"
                            Command="{Binding ExportSlicesCommand}"
                            Style="{StaticResource SlicerButtonStyle}"
                            IsEnabled="{Binding HasSlices}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Waveform and Slice Display -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Waveform Display with Slice Markers -->
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Margin="8" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Waveform Canvas Area -->
                        <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="4" Margin="8">
                            <Grid x:Name="WaveformContainer" ClipToBounds="True"
                                  MouseLeftButtonDown="WaveformContainer_MouseLeftButtonDown"
                                  MouseMove="WaveformContainer_MouseMove"
                                  MouseLeftButtonUp="WaveformContainer_MouseLeftButtonUp"
                                  MouseRightButtonDown="WaveformContainer_MouseRightButtonDown"
                                  SizeChanged="WaveformContainer_SizeChanged"
                                  Cursor="Hand">

                                <!-- Waveform Canvas -->
                                <Canvas x:Name="WaveformCanvas" Background="Transparent"/>

                                <!-- Slice Markers Canvas -->
                                <Canvas x:Name="SliceMarkersCanvas" Background="Transparent" IsHitTestVisible="False"/>

                                <!-- Playback Position Indicator -->
                                <Canvas x:Name="PlaybackCanvas" Background="Transparent" IsHitTestVisible="False">
                                    <Rectangle x:Name="PlaybackIndicator"
                                               Width="2"
                                               Fill="{StaticResource AccentBrush}"
                                               Canvas.Top="0"
                                               Visibility="Collapsed"/>
                                </Canvas>

                                <!-- Center Line -->
                                <Line x:Name="CenterLine"
                                      Stroke="#333333"
                                      StrokeThickness="1"
                                      X1="0"
                                      X2="{Binding ActualWidth, ElementName=WaveformCanvas}"
                                      StrokeDashArray="4,2"/>

                                <!-- No Sample Overlay -->
                                <Border Background="#80000000"
                                        Visibility="{Binding HasLoadedSample, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="No Sample Loaded"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Click 'Load Sample' to begin"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"/>
                                        <Button Content="Load Sample"
                                                Command="{Binding LoadSampleCommand}"
                                                Style="{StaticResource SlicerButtonStyle}"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Slice Edit Instructions -->
                                <TextBlock Text="Left-click: Add slice | Right-click: Remove slice"
                                           Foreground="{StaticResource TextDimBrush}"
                                           FontSize="10"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,8,4"
                                           Visibility="{Binding HasLoadedSample, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Border>

                        <!-- Slice Detection Controls -->
                        <Border Grid.Row="1" Margin="8,0,8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Slice Mode:" Style="{StaticResource ParameterLabelStyle}" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableSliceModes}"
                                          SelectedItem="{Binding SelectedSliceMode}"
                                          Style="{StaticResource SlicerComboBoxStyle}"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                                    <TextBlock Text="Sensitivity:" Style="{StaticResource ParameterLabelStyle}" Margin="0,0,8,0"/>
                                    <Slider Value="{Binding Sensitivity}"
                                            Minimum="0.1" Maximum="2.0"
                                            Width="120"
                                            Style="{StaticResource SlicerSliderStyle}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding Sensitivity, StringFormat='{}{0:F2}'}"
                                           Style="{StaticResource ValueLabelStyle}"/>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0,0,0">
                                    <Button Content="Auto Slice"
                                            Command="{Binding AutoSliceCommand}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="{Binding HasLoadedSample}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Clear All"
                                            Command="{Binding ClearSlicesCommand}"
                                            Style="{StaticResource SmallButtonStyle}"
                                            IsEnabled="{Binding HasSlices}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Slice List -->
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Margin="8,0,8,8" CornerRadius="4" Height="150">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="SLICES" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Add"
                                        Command="{Binding AddSliceAtCursorCommand}"
                                        Style="{StaticResource SmallButtonStyle}"
                                        ToolTip="Add slice at current position"
                                        Margin="0,0,4,0"/>
                                <Button Content="Remove"
                                        Command="{Binding RemoveSelectedSliceCommand}"
                                        Style="{StaticResource SmallButtonStyle}"
                                        ToolTip="Remove selected slice"
                                        IsEnabled="{Binding HasSelectedSlice}"/>
                            </StackPanel>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 x:Name="SliceListBox"
                                 ItemsSource="{Binding Slices}"
                                 SelectedItem="{Binding SelectedSlice}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource SliceListItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="SliceListBox_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" MinWidth="120">
                                        <TextBlock Text="{Binding Index, StringFormat='Slice {0}'}"
                                                   Foreground="{StaticResource SliceBrush}"
                                                   FontWeight="SemiBold"
                                                   Width="60"/>
                                        <TextBlock Text="{Binding StartTimeFormatted}"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   Margin="4,0,0,0"/>
                                        <TextBlock Text="-"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   Margin="2,0"/>
                                        <TextBlock Text="{Binding EndTimeFormatted}"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Parameter Panel -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" Margin="0,8,8,8" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <!-- Playback Mode Section -->
                        <TextBlock Text="PLAYBACK MODE" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mode:" Style="{StaticResource ParameterLabelStyle}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailablePlayModes}"
                                      SelectedItem="{Binding SelectedPlayMode}"
                                      Style="{StaticResource SlicerComboBoxStyle}"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <!-- Trigger Mode Section -->
                        <TextBlock Text="TRIGGER MODE" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mode:" Style="{StaticResource ParameterLabelStyle}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableTriggerModes}"
                                      SelectedItem="{Binding SelectedTriggerMode}"
                                      Style="{StaticResource SlicerComboBoxStyle}"/>
                        </Grid>

                        <!-- MIDI Note Assignment (visible for Chromatic/Pad modes) -->
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Start Note:" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding StartMidiNote}"
                                    Minimum="0" Maximum="108"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Style="{StaticResource SlicerSliderStyle}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding StartMidiNoteName}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <Button Content="Assign MIDI Notes"
                                Command="{Binding AssignMidiNotesCommand}"
                                Style="{StaticResource SmallButtonStyle}"
                                IsEnabled="{Binding HasSlices}"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0"/>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <!-- Stretch/Pitch Section -->
                        <TextBlock Text="PITCH / TIME" Style="{StaticResource SectionHeaderStyle}"/>

                        <ToggleButton Content="Pitch Lock (Time Stretch)"
                                      IsChecked="{Binding PitchLock}"
                                      Style="{StaticResource SlicerToggleButtonStyle}"
                                      HorizontalAlignment="Left"
                                      Margin="0,4,0,0"
                                      ToolTip="When enabled, slice pitch remains constant during tempo changes"/>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <!-- Output Section -->
                        <TextBlock Text="OUTPUT" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Volume -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Volume:" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding Volume}"
                                    Minimum="0" Maximum="2"
                                    Style="{StaticResource SlicerSliderStyle}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Volume, StringFormat='{}{0:P0}'}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <!-- Velocity Sensitivity -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vel Sens:" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding VelocitySensitivity}"
                                    Minimum="0" Maximum="1"
                                    Style="{StaticResource SlicerSliderStyle}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding VelocitySensitivity, StringFormat='{}{0:P0}'}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <!-- Envelope Section -->
                        <TextBlock Text="ENVELOPE" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Attack -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Attack:" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding AttackTime}"
                                    Minimum="0.001" Maximum="1"
                                    Style="{StaticResource SlicerSliderStyle}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding AttackTime, StringFormat='{}{0:F3}s'}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <!-- Release -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Release:" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding ReleaseTime}"
                                    Minimum="0.001" Maximum="2"
                                    Style="{StaticResource SlicerSliderStyle}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ReleaseTime, StringFormat='{}{0:F3}s'}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <!-- Crossfade -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Crossfade:" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding CrossfadeSamples}"
                                    Minimum="0" Maximum="512"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    Style="{StaticResource SlicerSliderStyle}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CrossfadeSamples, StringFormat='{}{0}'}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <!-- Tempo Section -->
                        <TextBlock Text="TEMPO" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- BPM -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BPM:" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding Bpm}"
                                    Minimum="20" Maximum="300"
                                    Style="{StaticResource SlicerSliderStyle}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Bpm, StringFormat='{}{0:F0}'}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <ToggleButton Content="Quantize to Tempo"
                                      IsChecked="{Binding QuantizeToTempo}"
                                      Style="{StaticResource SlicerToggleButtonStyle}"
                                      HorizontalAlignment="Left"
                                      Margin="0,8,0,0"/>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <!-- Selected Slice Properties -->
                        <TextBlock Text="SELECTED SLICE" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid Visibility="{Binding HasSelectedSlice, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Slice Gain -->
                            <Grid Grid.Row="0" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Gain:" Style="{StaticResource ParameterLabelStyle}"/>
                                <Slider Grid.Column="1"
                                        Value="{Binding SelectedSliceGain}"
                                        Minimum="0" Maximum="2"
                                        Style="{StaticResource SlicerSliderStyle}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SelectedSliceGain, StringFormat='{}{0:F2}'}"
                                           Style="{StaticResource ValueLabelStyle}"/>
                            </Grid>

                            <!-- Slice Pitch -->
                            <Grid Grid.Row="1" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Pitch:" Style="{StaticResource ParameterLabelStyle}"/>
                                <Slider Grid.Column="1"
                                        Value="{Binding SelectedSlicePitch}"
                                        Minimum="0.25" Maximum="4"
                                        Style="{StaticResource SlicerSliderStyle}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SelectedSlicePitch, StringFormat='{}{0:F2}x'}"
                                           Style="{StaticResource ValueLabelStyle}"/>
                            </Grid>

                            <!-- Slice Reverse -->
                            <ToggleButton Grid.Row="2"
                                          Content="Reverse"
                                          IsChecked="{Binding SelectedSliceReverse}"
                                          Style="{StaticResource SlicerToggleButtonStyle}"
                                          HorizontalAlignment="Left"
                                          Margin="0,8,0,0"/>

                            <!-- Preview Slice -->
                            <Button Grid.Row="3"
                                    Content="Preview Slice"
                                    Command="{Binding PreviewSelectedSliceCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"/>
                        </Grid>

                        <TextBlock Text="No slice selected"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontStyle="Italic"
                                   Visibility="{Binding HasSelectedSlice, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage, FallbackValue='Ready'}"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="11"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Duration: "
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="11"/>
                    <TextBlock Text="{Binding TotalDuration, StringFormat='{}{0:F2}s'}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
