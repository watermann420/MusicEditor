<UserControl x:Class="MusicEngineEditor.Controls.Synths.SubtractiveSynthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Synths"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Dark Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="PanelLightColor">#1E1E1E</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="Osc1Color">#FF6B6B</Color>
        <Color x:Key="Osc2Color">#6BCF6B</Color>
        <Color x:Key="FilterColor">#FFA500</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource PanelLightColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="Osc1Brush" Color="{StaticResource Osc1Color}"/>
        <SolidColorBrush x:Key="Osc2Brush" Color="{StaticResource Osc2Color}"/>
        <SolidColorBrush x:Key="FilterBrush" Color="{StaticResource FilterColor}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Vertical Slider Style -->
        <Style x:Key="VerticalSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="40"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Preset Button Style -->
        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SUBTRACTIVE SYNTH" Style="{StaticResource HeaderStyle}"
                               Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,0,20,0"/>
                    <TextBlock Text="Classic Analog-Style Synthesis" Style="{StaticResource LabelStyle}"
                               FontStyle="Italic" Margin="0,0,20,0"/>
                </StackPanel>

                <!-- Master Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Volume:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider x:Name="VolumeSlider" Value="{Binding Volume, Mode=TwoWay, FallbackValue=0.5}"
                            Minimum="0" Maximum="1" Width="100" Style="{StaticResource DarkSliderStyle}"/>
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                               Style="{StaticResource ValueStyle}" Width="40" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Oscillators -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- OSC 1 -->
                        <TextBlock Text="OSCILLATOR 1" Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource Osc1Brush}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Wave:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding Osc1WaveformIndex, Mode=TwoWay, FallbackValue=2}"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="Sine"/>
                                <ComboBoxItem Content="Square"/>
                                <ComboBoxItem Content="Sawtooth"/>
                                <ComboBoxItem Content="Triangle"/>
                                <ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tune:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Osc1Detune, Mode=TwoWay, FallbackValue=0}"
                                    Minimum="-100" Maximum="100" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Osc1Detune, StringFormat='{}{0:F0}c', FallbackValue='0c'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Level:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Osc1Level, Mode=TwoWay, FallbackValue=1.0}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Osc1Level, StringFormat='{}{0:F2}', FallbackValue='1.00'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <!-- OSC 2 -->
                        <TextBlock Text="OSCILLATOR 2" Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource Osc2Brush}" Margin="0,16,0,8"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Wave:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding Osc2WaveformIndex, Mode=TwoWay, FallbackValue=1}"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="Sine"/>
                                <ComboBoxItem Content="Square"/>
                                <ComboBoxItem Content="Sawtooth"/>
                                <ComboBoxItem Content="Triangle"/>
                                <ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tune:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Osc2Detune, Mode=TwoWay, FallbackValue=7}"
                                    Minimum="-100" Maximum="100" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Osc2Detune, StringFormat='{}{0:F0}c', FallbackValue='7c'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Level:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding Osc2Level, Mode=TwoWay, FallbackValue=0.5}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Osc2Level, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <!-- Noise Level -->
                        <TextBlock Text="NOISE" Style="{StaticResource LabelStyle}"
                                   FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Level:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding NoiseLevel, Mode=TwoWay, FallbackValue=0}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding NoiseLevel, StringFormat='{}{0:F2}', FallbackValue='0.00'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center Panel: Filter and Envelopes -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Filter Section -->
                        <TextBlock Text="FILTER" Style="{StaticResource HeaderStyle}"
                                   Foreground="{StaticResource FilterBrush}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Type:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding FilterModeIndex, Mode=TwoWay, FallbackValue=0}"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="Low Pass"/>
                                <ComboBoxItem Content="High Pass"/>
                                <ComboBoxItem Content="Band Pass"/>
                                <ComboBoxItem Content="Notch"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cutoff:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding FilterCutoff, Mode=TwoWay, FallbackValue=0.8}"
                                    Minimum="0.001" Maximum="0.99" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding FilterCutoff, StringFormat='{}{0:F2}', FallbackValue='0.80'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Resonance:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding FilterResonance, Mode=TwoWay, FallbackValue=0.2}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding FilterResonance, StringFormat='{}{0:F2}', FallbackValue='0.20'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Env Amt:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" Value="{Binding FilterEnvAmount, Mode=TwoWay, FallbackValue=0.5}"
                                    Minimum="-1" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding FilterEnvAmount, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <!-- Amp Envelope -->
                        <TextBlock Text="AMP ENVELOPE" Style="{StaticResource LabelStyle}"
                                   FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="A" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                <Slider Value="{Binding AmpAttack, Mode=TwoWay, FallbackValue=0.01}"
                                        Minimum="0.001" Maximum="2" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding AmpAttack, StringFormat='{}{0:F2}', FallbackValue='0.01'}"
                                           Style="{StaticResource ValueStyle}" HorizontalAlignment="Center" FontSize="9"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="D" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                <Slider Value="{Binding AmpDecay, Mode=TwoWay, FallbackValue=0.1}"
                                        Minimum="0.001" Maximum="2" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding AmpDecay, StringFormat='{}{0:F2}', FallbackValue='0.10'}"
                                           Style="{StaticResource ValueStyle}" HorizontalAlignment="Center" FontSize="9"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="S" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                <Slider Value="{Binding AmpSustain, Mode=TwoWay, FallbackValue=0.7}"
                                        Minimum="0" Maximum="1" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding AmpSustain, StringFormat='{}{0:F2}', FallbackValue='0.70'}"
                                           Style="{StaticResource ValueStyle}" HorizontalAlignment="Center" FontSize="9"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="R" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                <Slider Value="{Binding AmpRelease, Mode=TwoWay, FallbackValue=0.3}"
                                        Minimum="0.001" Maximum="4" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding AmpRelease, StringFormat='{}{0:F2}', FallbackValue='0.30'}"
                                           Style="{StaticResource ValueStyle}" HorizontalAlignment="Center" FontSize="9"/>
                            </StackPanel>
                        </Grid>

                        <!-- Filter Envelope -->
                        <TextBlock Text="FILTER ENVELOPE" Style="{StaticResource LabelStyle}"
                                   FontWeight="SemiBold" Margin="0,12,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="A" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                <Slider Value="{Binding FilterAttack, Mode=TwoWay, FallbackValue=0.01}"
                                        Minimum="0.001" Maximum="2" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding FilterAttack, StringFormat='{}{0:F2}', FallbackValue='0.01'}"
                                           Style="{StaticResource ValueStyle}" HorizontalAlignment="Center" FontSize="9"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="D" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                <Slider Value="{Binding FilterDecay, Mode=TwoWay, FallbackValue=0.2}"
                                        Minimum="0.001" Maximum="2" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding FilterDecay, StringFormat='{}{0:F2}', FallbackValue='0.20'}"
                                           Style="{StaticResource ValueStyle}" HorizontalAlignment="Center" FontSize="9"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="S" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                <Slider Value="{Binding FilterSustain, Mode=TwoWay, FallbackValue=0.5}"
                                        Minimum="0" Maximum="1" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding FilterSustain, StringFormat='{}{0:F2}', FallbackValue='0.50'}"
                                           Style="{StaticResource ValueStyle}" HorizontalAlignment="Center" FontSize="9"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="R" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                                <Slider Value="{Binding FilterRelease, Mode=TwoWay, FallbackValue=0.3}"
                                        Minimum="0.001" Maximum="4" Style="{StaticResource VerticalSliderStyle}"/>
                                <TextBlock Text="{Binding FilterRelease, StringFormat='{}{0:F2}', FallbackValue='0.30'}"
                                           Style="{StaticResource ValueStyle}" HorizontalAlignment="Center" FontSize="9"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel: Presets -->
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PRESETS" Style="{StaticResource HeaderStyle}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <WrapPanel>
                            <Button Content="Analog Bass" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="AnalogBass"/>
                            <Button Content="Warm Pad" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="WarmPad"/>
                            <Button Content="Sync Lead" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="SyncLead"/>
                            <Button Content="PWM Strings" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="PWMStrings"/>
                            <Button Content="Auto Pan Arp" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="AutoPanArp"/>
                            <Button Content="Res Pluck" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="ResonantPluck"/>
                            <Button Content="Fat Saw" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="FatSaw"/>
                            <Button Content="Soft Lead" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="SoftLead"/>
                            <Button Content="Sub Bass" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="SubBass"/>
                            <Button Content="Bright Lead" Style="{StaticResource PresetButtonStyle}"
                                    Click="LoadPreset_Click" Tag="BrightLead"/>
                        </WrapPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="4,0,4,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage, FallbackValue='Ready'}"
                           Style="{StaticResource LabelStyle}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="OSC1: " Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding Osc1WaveformName, FallbackValue='Saw'}"
                               Foreground="{StaticResource Osc1Brush}" FontWeight="SemiBold"/>
                    <TextBlock Text=" | OSC2: " Style="{StaticResource LabelStyle}" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding Osc2WaveformName, FallbackValue='Square'}"
                               Foreground="{StaticResource Osc2Brush}" FontWeight="SemiBold"/>
                    <TextBlock Text=" | Filter: " Style="{StaticResource LabelStyle}" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding FilterModeName, FallbackValue='LP'}"
                               Foreground="{StaticResource FilterBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
