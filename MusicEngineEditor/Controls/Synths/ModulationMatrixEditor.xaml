<UserControl x:Class="MusicEngineEditor.Controls.Synths.ModulationMatrixEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Synths"
             xmlns:vm="clr-namespace:MusicEngineEditor.ViewModels.Synths"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:ModulationMatrixEditorViewModel, IsDesignTimeCreatable=True}"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Dark Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="PanelLightColor">#1E1E1E</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="AccentSecondaryColor">#00FF88</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="PositiveModColor">#00FF88</Color>
        <Color x:Key="NegativeModColor">#FF4757</Color>
        <Color x:Key="SourceActiveColor">#FFD93D</Color>
        <Color x:Key="ConnectionGlowColor">#00D9FF</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource PanelLightColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="PositiveModBrush" Color="{StaticResource PositiveModColor}"/>
        <SolidColorBrush x:Key="NegativeModBrush" Color="{StaticResource NegativeModColor}"/>
        <SolidColorBrush x:Key="SourceActiveBrush" Color="{StaticResource SourceActiveColor}"/>
        <SolidColorBrush x:Key="ConnectionGlowBrush" Color="{StaticResource ConnectionGlowColor}"/>

        <!-- Converters -->
        <local:ModEditorBoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:ModEditorAmountToColorConverter x:Key="AmountToColorConverter"/>
        <local:ModEditorAmountToTextConverter x:Key="AmountToTextConverter"/>
        <local:ModEditorSourceActiveToColorConverter x:Key="SourceActiveToColorConverter"/>

        <!-- Panel Border Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#222222"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Source Item Style -->
        <Style x:Key="SourceItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Destination Item Style -->
        <Style x:Key="DestinationItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="ModAmountSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="-100"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="TickFrequency" Value="5"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Track Background -->
                            <Border Grid.Row="0" Height="6" CornerRadius="3"
                                    Background="#333333"
                                    Margin="8,0"/>

                            <!-- Center Line -->
                            <Border Grid.Row="0" Width="2" Height="10"
                                    Background="{StaticResource TextDimBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            <!-- Track -->
                            <Track x:Name="PART_Track" Grid.Row="0">
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{StaticResource AccentBrush}"
                                                             Width="16" Height="16"/>
                                                    <Ellipse Fill="{StaticResource BackgroundBrush}"
                                                             Width="6" Height="6"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4" Padding="8,6">
            <DockPanel>
                <!-- Title -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="MODULATION MATRIX EDITOR"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveConnectionCount, StringFormat=' ({0} connections)'}"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Toolbar Buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Save Preset"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding SavePresetCommand}"
                            ToolTip="Save modulation preset"/>
                    <Button Content="Load Preset"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding LoadPresetCommand}"
                            Margin="4,0,0,0"
                            ToolTip="Load modulation preset"/>
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,2"/>
                    <Button Content="Clear All"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ClearAllConnectionsCommand}"
                            ToolTip="Clear all modulation connections"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Sources -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="MODULATION SOURCES" Style="{StaticResource SectionHeaderStyle}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- LFO Section -->
                            <TextBlock Text="LFO" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10" Margin="0,4,0,4"/>
                            <ItemsControl ItemsSource="{Binding LFOSources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SourceItemStyle}"
                                                Background="{Binding IsActive, Converter={StaticResource SourceActiveToColorConverter}}"
                                                MouseLeftButtonDown="Source_MouseLeftButtonDown"
                                                MouseMove="Source_MouseMove"
                                                MouseLeftButtonUp="Source_MouseLeftButtonUp"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                                         Fill="{StaticResource AccentBrush}"
                                                         Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="~"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="12" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Envelope Section -->
                            <TextBlock Text="ENVELOPE" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10" Margin="0,12,0,4"/>
                            <ItemsControl ItemsSource="{Binding EnvelopeSources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SourceItemStyle}"
                                                Background="{Binding IsActive, Converter={StaticResource SourceActiveToColorConverter}}"
                                                MouseLeftButtonDown="Source_MouseLeftButtonDown"
                                                MouseMove="Source_MouseMove"
                                                MouseLeftButtonUp="Source_MouseLeftButtonUp"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                                         Fill="{StaticResource AccentSecondaryBrush}"
                                                         Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="/\"
                                                           Foreground="{StaticResource AccentSecondaryBrush}"
                                                           FontSize="10" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- MIDI Section -->
                            <TextBlock Text="MIDI" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10" Margin="0,12,0,4"/>
                            <ItemsControl ItemsSource="{Binding MIDISources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SourceItemStyle}"
                                                Background="{Binding IsActive, Converter={StaticResource SourceActiveToColorConverter}}"
                                                MouseLeftButtonDown="Source_MouseLeftButtonDown"
                                                MouseMove="Source_MouseMove"
                                                MouseLeftButtonUp="Source_MouseLeftButtonUp"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                                         Fill="#FF6B6B"
                                                         Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TypeIcon}"
                                                           Foreground="#FF6B6B"
                                                           FontSize="10" FontWeight="Bold"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- MIDI CC Selector -->
                            <Border Style="{StaticResource SourceItemStyle}" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="MIDI CC"
                                               Foreground="{StaticResource TextDimBrush}"
                                               FontSize="10" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding MIDICCNumbers}"
                                              SelectedItem="{Binding SelectedMIDICC}"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              Width="60" FontSize="10"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Center Panel: Connection Canvas -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CONNECTIONS" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Connection Canvas -->
                    <Border Grid.Row="1" Background="#0A0A0A"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <Canvas x:Name="ConnectionCanvas"
                                Background="Transparent"
                                MouseLeftButtonDown="ConnectionCanvas_MouseLeftButtonDown"
                                MouseMove="ConnectionCanvas_MouseMove"
                                MouseLeftButtonUp="ConnectionCanvas_MouseLeftButtonUp"
                                SizeChanged="ConnectionCanvas_SizeChanged">
                            <!-- Connection lines and nodes will be drawn here programmatically -->
                        </Canvas>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Panel: Destinations -->
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="DESTINATIONS" Style="{StaticResource SectionHeaderStyle}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Oscillator Section -->
                            <TextBlock Text="OSCILLATOR" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10" Margin="0,4,0,4"/>
                            <ItemsControl ItemsSource="{Binding OscillatorDestinations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DestinationItemStyle}"
                                                Background="{Binding IsModulated, Converter={StaticResource SourceActiveToColorConverter}}"
                                                MouseLeftButtonDown="Destination_MouseLeftButtonDown"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="4" Height="12"
                                                           Fill="{StaticResource AccentBrush}"
                                                           RadiusX="2" RadiusY="2"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Filter Section -->
                            <TextBlock Text="FILTER" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10" Margin="0,12,0,4"/>
                            <ItemsControl ItemsSource="{Binding FilterDestinations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DestinationItemStyle}"
                                                Background="{Binding IsModulated, Converter={StaticResource SourceActiveToColorConverter}}"
                                                MouseLeftButtonDown="Destination_MouseLeftButtonDown"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="4" Height="12"
                                                           Fill="{StaticResource AccentSecondaryBrush}"
                                                           RadiusX="2" RadiusY="2"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Amp Section -->
                            <TextBlock Text="AMP" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10" Margin="0,12,0,4"/>
                            <ItemsControl ItemsSource="{Binding AmpDestinations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DestinationItemStyle}"
                                                Background="{Binding IsModulated, Converter={StaticResource SourceActiveToColorConverter}}"
                                                MouseLeftButtonDown="Destination_MouseLeftButtonDown"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="4" Height="12"
                                                           Fill="#FFA500"
                                                           RadiusX="2" RadiusY="2"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Effects Section -->
                            <TextBlock Text="EFFECTS" Foreground="{StaticResource TextDimBrush}"
                                       FontSize="10" Margin="0,12,0,4"/>
                            <ItemsControl ItemsSource="{Binding EffectsDestinations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DestinationItemStyle}"
                                                Background="{Binding IsModulated, Converter={StaticResource SourceActiveToColorConverter}}"
                                                MouseLeftButtonDown="Destination_MouseLeftButtonDown"
                                                Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="4" Height="12"
                                                           Fill="#BB6BFF"
                                                           RadiusX="2" RadiusY="2"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Panel: Connection Properties -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="4"
                Visibility="{Binding HasSelectedConnection, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Connection Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedConnection.SourceName}"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" -> "
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedConnection.DestinationName}"
                               Foreground="{StaticResource AccentSecondaryBrush}"
                               FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Amount Slider -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Amount:" Foreground="{StaticResource TextDimBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="-" Style="{StaticResource DarkButtonStyle}"
                            Width="24" Height="24" Padding="0"
                            Command="{Binding DecrementAmountCommand}"/>
                    <Slider x:Name="AmountSlider"
                            Width="200" Margin="8,0"
                            Style="{StaticResource ModAmountSliderStyle}"
                            Value="{Binding SelectedConnection.Amount}"
                            ValueChanged="AmountSlider_ValueChanged"/>
                    <Button Content="+" Style="{StaticResource DarkButtonStyle}"
                            Width="24" Height="24" Padding="0"
                            Command="{Binding IncrementAmountCommand}"/>
                    <TextBlock Text="{Binding SelectedConnection.Amount, Converter={StaticResource AmountToTextConverter}}"
                               Foreground="{Binding SelectedConnection.Amount, Converter={StaticResource AmountToColorConverter}}"
                               FontSize="14" FontWeight="Bold"
                               Width="60" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Spacer -->
                <Border Grid.Column="2"/>

                <!-- Curve Type -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Curve:" Foreground="{StaticResource TextDimBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding CurveTypes}"
                              SelectedItem="{Binding SelectedConnection.CurveType}"
                              Style="{StaticResource DarkComboBoxStyle}"
                              Width="100" FontSize="11"/>
                </StackPanel>

                <!-- Bipolar Toggle -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Bipolar:" Foreground="{StaticResource TextDimBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ToggleButton Content="{Binding SelectedConnection.IsBipolar, Converter={x:Static local:ModulationMatrixEditor.BipolarTextConverter}}"
                                  IsChecked="{Binding SelectedConnection.IsBipolar}"
                                  Style="{StaticResource ToggleButtonStyle}"
                                  Width="50"/>
                </StackPanel>

                <!-- Delete Button -->
                <Button Grid.Column="5" Content="Delete"
                        Style="{StaticResource DarkButtonStyle}"
                        Command="{Binding DeleteConnectionCommand}"
                        Foreground="{StaticResource NegativeModBrush}"/>

                <!-- Close Button -->
                <Button Grid.Column="6" Content="X"
                        Style="{StaticResource DarkButtonStyle}"
                        Command="{Binding DeselectConnectionCommand}"
                        Width="28" Height="28" Padding="0" Margin="8,0,0,0"/>
