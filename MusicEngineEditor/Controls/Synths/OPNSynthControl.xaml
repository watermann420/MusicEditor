<UserControl x:Class="MusicEngineEditor.Controls.Synths.OPNSynthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Synths"
             xmlns:vm="clr-namespace:MusicEngineEditor.ViewModels.Synths"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:OPNSynthViewModel}"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Dark Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="PanelLightColor">#1E1E1E</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="CarrierColor">#00FF88</Color>
        <Color x:Key="ModulatorColor">#FF6B6B</Color>
        <Color x:Key="GenesisBlue">#00A0E0</Color>
        <Color x:Key="WarningColor">#FFAA00</Color>

        <!-- Operator Colors (YM2612 style) -->
        <Color x:Key="Op1Color">#FF6B6B</Color>
        <Color x:Key="Op2Color">#FFD93D</Color>
        <Color x:Key="Op3Color">#6BFF6B</Color>
        <Color x:Key="Op4Color">#00D9FF</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="{StaticResource PanelLightColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="CarrierBrush" Color="{StaticResource CarrierColor}"/>
        <SolidColorBrush x:Key="ModulatorBrush" Color="{StaticResource ModulatorColor}"/>
        <SolidColorBrush x:Key="GenesisBlueBrush" Color="{StaticResource GenesisBlue}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

        <SolidColorBrush x:Key="Op1Brush" Color="{StaticResource Op1Color}"/>
        <SolidColorBrush x:Key="Op2Brush" Color="{StaticResource Op2Color}"/>
        <SolidColorBrush x:Key="Op3Brush" Color="{StaticResource Op3Color}"/>
        <SolidColorBrush x:Key="Op4Brush" Color="{StaticResource Op4Color}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Vertical Slider Style -->
        <Style x:Key="VerticalSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Label Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="30"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PanelLightBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset Button Style (Genesis themed) -->
        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <!-- Algorithm Button Style -->
        <Style x:Key="AlgorithmButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="AlgBorder"
                                Width="50" Height="50"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Margin="3"
                                Cursor="Hand">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AlgBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="AlgBorder" Property="Background" Value="{StaticResource PanelLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AlgBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="AlgBorder" Property="Background" Value="#1A3A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder"
                                    Width="18" Height="18"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Cursor="Hand">
                                <Path x:Name="CheckMark"
                                      Data="M2,6 L6,10 L14,2"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Margin="1"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource PanelLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Panel Border Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title and Preset Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="YM2612 / OPN" Style="{StaticResource HeaderStyle}"
                               Foreground="{StaticResource GenesisBlueBrush}" FontSize="16" Margin="0,0,10,0"/>
                    <TextBlock Text="(Genesis/Mega Drive FM)" Style="{StaticResource LabelStyle}"
                               FontSize="10" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding PresetName}" Style="{StaticResource ValueStyle}"
                               FontSize="14" Margin="0,0,20,0"/>
                    <Button Content="Init" Style="{StaticResource DarkButtonStyle}"
                            Command="{Binding InitPatchCommand}" Margin="0,0,8,0"/>
                    <Button Content="Random" Style="{StaticResource DarkButtonStyle}"
                            Command="{Binding RandomizePatchCommand}"/>
                </StackPanel>

                <!-- Channel Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Channel:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding AvailableChannels}"
                              SelectedIndex="{Binding ActiveChannel}"
                              Style="{StaticResource DarkComboBoxStyle}"
                              Width="80"/>
                </StackPanel>

                <!-- Master Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Volume:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider Value="{Binding MasterVolume}" Minimum="0" Maximum="1" Width="100"
                            Style="{StaticResource DarkSliderStyle}"/>
                    <TextBlock Text="{Binding MasterVolume, StringFormat='{}{0:F2}'}"
                               Style="{StaticResource ValueStyle}" Width="40" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Algorithm Selector and Diagram -->
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ALGORITHM (0-7)" Style="{StaticResource HeaderStyle}"/>

                    <!-- Algorithm Selector Grid (2x4) -->
                    <UniformGrid Grid.Row="1" Rows="2" Columns="4" Margin="0,0,0,12">
                        <RadioButton Style="{StaticResource AlgorithmButtonStyle}" Content="0"
                                     IsChecked="{Binding Algorithm, Converter={x:Static local:OPNSynthControl.AlgorithmConverter}, ConverterParameter=0}"
                                     Command="{Binding SetAlgorithmCommand}" CommandParameter="0"
                                     ToolTip="Serial: 4->3->2->1"/>
                        <RadioButton Style="{StaticResource AlgorithmButtonStyle}" Content="1"
                                     IsChecked="{Binding Algorithm, Converter={x:Static local:OPNSynthControl.AlgorithmConverter}, ConverterParameter=1}"
                                     Command="{Binding SetAlgorithmCommand}" CommandParameter="1"
                                     ToolTip="4->3->2 + 1"/>
                        <RadioButton Style="{StaticResource AlgorithmButtonStyle}" Content="2"
                                     IsChecked="{Binding Algorithm, Converter={x:Static local:OPNSynthControl.AlgorithmConverter}, ConverterParameter=2}"
                                     Command="{Binding SetAlgorithmCommand}" CommandParameter="2"
                                     ToolTip="4->3, 2->1"/>
                        <RadioButton Style="{StaticResource AlgorithmButtonStyle}" Content="3"
                                     IsChecked="{Binding Algorithm, Converter={x:Static local:OPNSynthControl.AlgorithmConverter}, ConverterParameter=3}"
                                     Command="{Binding SetAlgorithmCommand}" CommandParameter="3"
                                     ToolTip="4->3->(2+1)"/>
                        <RadioButton Style="{StaticResource AlgorithmButtonStyle}" Content="4"
                                     IsChecked="{Binding Algorithm, Converter={x:Static local:OPNSynthControl.AlgorithmConverter}, ConverterParameter=4}"
                                     Command="{Binding SetAlgorithmCommand}" CommandParameter="4"
                                     ToolTip="(4->3) + (2->1)"/>
                        <RadioButton Style="{StaticResource AlgorithmButtonStyle}" Content="5"
                                     IsChecked="{Binding Algorithm, Converter={x:Static local:OPNSynthControl.AlgorithmConverter}, ConverterParameter=5}"
                                     Command="{Binding SetAlgorithmCommand}" CommandParameter="5"
                                     ToolTip="4->(3+2+1)"/>
                        <RadioButton Style="{StaticResource AlgorithmButtonStyle}" Content="6"
                                     IsChecked="{Binding Algorithm, Converter={x:Static local:OPNSynthControl.AlgorithmConverter}, ConverterParameter=6}"
                                     Command="{Binding SetAlgorithmCommand}" CommandParameter="6"
                                     ToolTip="(4->3) + 2 + 1"/>
                        <RadioButton Style="{StaticResource AlgorithmButtonStyle}" Content="7"
                                     IsChecked="{Binding Algorithm, Converter={x:Static local:OPNSynthControl.AlgorithmConverter}, ConverterParameter=7}"
                                     Command="{Binding SetAlgorithmCommand}" CommandParameter="7"
                                     ToolTip="Parallel: 4 + 3 + 2 + 1"/>
                    </UniformGrid>

                    <!-- Algorithm Visual Diagram -->
                    <Canvas x:Name="AlgorithmCanvas" Grid.Row="2"
                            Background="Transparent" ClipToBounds="True"
                            SizeChanged="AlgorithmCanvas_SizeChanged"
                            MinHeight="120">
                        <!-- Operators and connections drawn programmatically -->
                    </Canvas>

                    <!-- Algorithm Description -->
                    <Border Grid.Row="3" Background="{StaticResource PanelLightBrush}"
                            CornerRadius="3" Padding="8" Margin="0,8,0,0">
                        <TextBlock Text="{Binding AlgorithmDescription}"
                                   Style="{StaticResource LabelStyle}"
                                   TextWrapping="Wrap"
                                   FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Center Panel: 4 Operators in FM Matrix -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="4-OPERATOR FM MATRIX" Style="{StaticResource HeaderStyle}"/>
                        <TextBlock Text=" (TL: Total Level, AR/D1R/D2R/RR: Rates, MUL: Multiplier, DT: Detune)"
                                   Style="{StaticResource LabelStyle}" FontSize="9" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- 4 Operator Grid (2x2) -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Operators}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OPNOperatorViewModel}">
                                <Border Background="{StaticResource PanelLightBrush}"
                                        BorderBrush="{Binding OperatorColor, Converter={x:Static local:OPNSynthControl.ColorToBrushConverter}}"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        Margin="4"
                                        Padding="10"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="Operator_MouseLeftButtonDown">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Operator Header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{Binding OperatorColor, Converter={x:Static local:OPNSynthControl.ColorToBrushConverter}}"
                                                           FontWeight="Bold" FontSize="16"/>
                                                <TextBlock Text="{Binding IsCarrier, Converter={x:Static local:OPNSynthControl.CarrierTextConverter}}"
                                                           Foreground="{StaticResource CarrierBrush}"
                                                           FontSize="10" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- SSG-EG Enable -->
                                            <CheckBox Grid.Column="2"
                                                      IsChecked="{Binding SsgEgEnabled}"
                                                      Style="{StaticResource DarkCheckBoxStyle}"
                                                      ToolTip="SSG-EG (Software-controlled Sound Generator Envelope)">
                                                <TextBlock Text="SSG" FontSize="9" Foreground="{StaticResource WarningBrush}"/>
                                            </CheckBox>
                                        </Grid>

                                        <!-- Row 1: TL and MUL/DT -->
                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- TL (Total Level) -->
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="TL (0-127)" Style="{StaticResource LabelStyle}"/>
                                                <Slider Value="{Binding TotalLevel}" Minimum="0" Maximum="127"
                                                        Style="{StaticResource DarkSliderStyle}"
                                                        ToolTip="Total Level - Attenuation (higher = quieter)"/>
                                                <TextBlock Text="{Binding TotalLevel, StringFormat='{}{0:F0}'}"
                                                           Style="{StaticResource ValueStyle}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- MUL (Multiplier) -->
                                            <StackPanel Grid.Column="1" Margin="2,0">
                                                <TextBlock Text="MUL (0-15)" Style="{StaticResource LabelStyle}"/>
                                                <Slider Value="{Binding Multiple}" Minimum="0" Maximum="15"
                                                        Style="{StaticResource DarkSliderStyle}"
                                                        ToolTip="Frequency Multiplier (0 = 0.5x)"/>
                                                <TextBlock Text="{Binding MultipleDisplay}"
                                                           Style="{StaticResource ValueStyle}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- DT (Detune) -->
                                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                <TextBlock Text="DT (0-7)" Style="{StaticResource LabelStyle}"/>
                                                <Slider Value="{Binding Detune}" Minimum="0" Maximum="7"
                                                        Style="{StaticResource DarkSliderStyle}"
                                                        ToolTip="Detune value"/>
                                                <TextBlock Text="{Binding Detune, StringFormat='{}{0:F0}'}"
                                                           Style="{StaticResource ValueStyle}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 2: Key Scale -->
                                        <Grid Grid.Row="2" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="KS (Key Scale)" Style="{StaticResource LabelStyle}"/>
                                                    <TextBlock Text="{Binding KeyScale, StringFormat='{}{0:F0}'}"
                                                               Style="{StaticResource ValueStyle}"/>
                                                </Grid>
                                                <Slider Value="{Binding KeyScale}" Minimum="0" Maximum="3"
                                                        Style="{StaticResource DarkSliderStyle}"
                                                        ToolTip="Key Scaling - Higher notes decay faster"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 3: Envelope Rates (AR, D1R, D2R, SL, RR) -->
                                        <Grid Grid.Row="3" Margin="0,8,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="ENVELOPE RATES"
                                                       Style="{StaticResource LabelStyle}"
                                                       FontWeight="SemiBold"/>

                                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- AR (Attack Rate) -->
                                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                    <Slider Value="{Binding AttackRate}" Minimum="0" Maximum="31"
                                                            Style="{StaticResource VerticalSliderStyle}"
                                                            ToolTip="Attack Rate (0-31)"/>
                                                    <TextBlock Text="AR" Style="{StaticResource LabelStyle}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding AttackRate, StringFormat='{}{0:F0}'}"
                                                               Style="{StaticResource ValueStyle}"
                                                               HorizontalAlignment="Center" FontSize="9"/>
                                                </StackPanel>

                                                <!-- D1R (Decay 1 Rate) -->
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                    <Slider Value="{Binding Decay1Rate}" Minimum="0" Maximum="31"
                                                            Style="{StaticResource VerticalSliderStyle}"
                                                            ToolTip="Decay 1 Rate (0-31)"/>
                                                    <TextBlock Text="D1R" Style="{StaticResource LabelStyle}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Decay1Rate, StringFormat='{}{0:F0}'}"
                                                               Style="{StaticResource ValueStyle}"
                                                               HorizontalAlignment="Center" FontSize="9"/>
                                                </StackPanel>

                                                <!-- SL (Sustain Level) -->
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                    <Slider Value="{Binding SustainLevel}" Minimum="0" Maximum="15"
                                                            Style="{StaticResource VerticalSliderStyle}"
                                                            ToolTip="Sustain Level (0-15)"/>
                                                    <TextBlock Text="SL" Style="{StaticResource LabelStyle}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SustainLevel, StringFormat='{}{0:F0}'}"
                                                               Style="{StaticResource ValueStyle}"
                                                               HorizontalAlignment="Center" FontSize="9"/>
                                                </StackPanel>

                                                <!-- D2R (Decay 2 Rate / Sustain Rate) -->
                                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                                    <Slider Value="{Binding Decay2Rate}" Minimum="0" Maximum="31"
                                                            Style="{StaticResource VerticalSliderStyle}"
                                                            ToolTip="Decay 2 / Sustain Rate (0-31)"/>
                                                    <TextBlock Text="D2R" Style="{StaticResource LabelStyle}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Decay2Rate, StringFormat='{}{0:F0}'}"
                                                               Style="{StaticResource ValueStyle}"
                                                               HorizontalAlignment="Center" FontSize="9"/>
                                                </StackPanel>

                                                <!-- RR (Release Rate) -->
                                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                                    <Slider Value="{Binding ReleaseRate}" Minimum="0" Maximum="15"
                                                            Style="{StaticResource VerticalSliderStyle}"
                                                            ToolTip="Release Rate (0-15)"/>
                                                    <TextBlock Text="RR" Style="{StaticResource LabelStyle}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ReleaseRate, StringFormat='{}{0:F0}'}"
                                                               Style="{StaticResource ValueStyle}"
                                                               HorizontalAlignment="Center" FontSize="9"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Right Panel: LFO, Feedback, and Presets -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Feedback Section -->
                <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="FEEDBACK" Style="{StaticResource HeaderStyle}"/>

                        <StackPanel Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Feedback (0-7)" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding Feedback, StringFormat='{}{0:F0}'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </Grid>
                            <Slider Value="{Binding Feedback}" Minimum="0" Maximum="7"
                                    Style="{StaticResource DarkSliderStyle}"
                                    ToolTip="Operator 1 self-feedback amount"/>
                        </StackPanel>

                        <!-- Panning -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Panning" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="L" Margin="0,0,8,0" Foreground="{StaticResource TextBrush}"
                                             IsChecked="{Binding PanLeft}" ToolTip="Left channel only"/>
                                <RadioButton Content="C" Margin="0,0,8,0" Foreground="{StaticResource TextBrush}"
                                             IsChecked="{Binding PanCenter}" ToolTip="Center (both channels)"/>
                                <RadioButton Content="R" Foreground="{StaticResource TextBrush}"
                                             IsChecked="{Binding PanRight}" ToolTip="Right channel only"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- LFO Section -->
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LFO" Style="{StaticResource HeaderStyle}"/>
                            <CheckBox IsChecked="{Binding LfoEnabled}"
                                      Style="{StaticResource DarkCheckBoxStyle}"
                                      Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Enable" FontSize="10"/>
                            </CheckBox>
                        </StackPanel>

                        <!-- LFO Frequency -->
                        <StackPanel Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Frequency (0-7)" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding LfoFrequencyDisplay}"
                                           Style="{StaticResource ValueStyle}"/>
                            </Grid>
                            <Slider Value="{Binding LfoFrequency}" Minimum="0" Maximum="7"
                                    Style="{StaticResource DarkSliderStyle}"
                                    ToolTip="LFO Frequency (index into frequency table)"/>
                        </StackPanel>

                        <!-- PMS (Frequency Modulation Sensitivity) -->
                        <StackPanel Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="PMS (FM Sens 0-7)" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding PmSensitivity, StringFormat='{}{0:F0}'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </Grid>
                            <Slider Value="{Binding PmSensitivity}" Minimum="0" Maximum="7"
                                    Style="{StaticResource DarkSliderStyle}"
                                    ToolTip="Pitch Modulation Sensitivity"/>
                        </StackPanel>

                        <!-- AMS (Amplitude Modulation Sensitivity) -->
                        <StackPanel Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="AMS (AM Sens 0-3)" Style="{StaticResource LabelStyle}"/>
                                <TextBlock Text="{Binding AmSensitivity, StringFormat='{}{0:F0}'}"
                                           Style="{StaticResource ValueStyle}"/>
                            </Grid>
                            <Slider Value="{Binding AmSensitivity}" Minimum="0" Maximum="3"
                                    Style="{StaticResource DarkSliderStyle}"
                                    ToolTip="Amplitude Modulation Sensitivity"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Presets Section (Genesis/Mega Drive Sounds) -->
                <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="GENESIS PRESETS" Style="{StaticResource HeaderStyle}"
                                       Foreground="{StaticResource GenesisBlueBrush}"/>

                            <TextBlock Text="Classic Sounds" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <Button Content="Sonic Lead" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding LoadPresetCommand}" CommandParameter="SonicLead"
                                        ToolTip="Bright lead from Sonic games"/>
                                <Button Content="Genesis Bass" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding LoadPresetCommand}" CommandParameter="GenesisBass"
                                        ToolTip="Punchy Genesis-style bass"/>
                                <Button Content="FM Piano" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding LoadPresetCommand}" CommandParameter="FMPiano"
                                        ToolTip="Classic FM electric piano"/>
                                <Button Content="Brass" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding LoadPresetCommand}" CommandParameter="Brass"
                                        ToolTip="Bright brass section"/>
                            </WrapPanel>

                            <TextBlock Text="Sound Effects" Style="{StaticResource LabelStyle}" Margin="0,8,0,4"/>
                            <WrapPanel>
                                <Button Content="Bell" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding LoadPresetCommand}" CommandParameter="Bell"
                                        ToolTip="Metallic bell tones"/>
                                <Button Content="Strings" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding LoadPresetCommand}" CommandParameter="Strings"
                                        ToolTip="FM string pad"/>
                                <Button Content="Organ" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding LoadPresetCommand}" CommandParameter="Organ"
                                        ToolTip="FM organ sound"/>
                                <Button Content="Slap Bass" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding LoadPresetCommand}" CommandParameter="SlapBass"
                                        ToolTip="Funky slap bass"/>
                            </WrapPanel>

                            <TextBlock Text="Special" Style="{StaticResource LabelStyle}" Margin="0,8,0,4"/>
                            <WrapPanel>
                                <Button Content="SFX Hit" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding LoadPresetCommand}" CommandParameter="SFXHit"
                                        ToolTip="Impact sound effect"/>
                                <Button Content="Laser" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding LoadPresetCommand}" CommandParameter="Laser"
                                        ToolTip="Sci-fi laser sound"/>
                                <Button Content="Power Up" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding LoadPresetCommand}" CommandParameter="PowerUp"
                                        ToolTip="Classic power-up sound"/>
                            </WrapPanel>

                            <!-- Selected Operator Quick Edit -->
                            <TextBlock Text="QUICK EDIT" Style="{StaticResource HeaderStyle}" Margin="0,16,0,0"/>
                            <TextBlock Text="{Binding SelectedOperatorName}"
                                       Foreground="{Binding SelectedOperatorColor, Converter={x:Static local:OPNSynthControl.ColorToBrushConverter}}"
                                       FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Reset Op" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding ResetSelectedOperatorCommand}"
                                        ToolTip="Reset selected operator to defaults"/>
                                <Button Content="Copy to All" Style="{StaticResource PresetButtonStyle}"
                                        Command="{Binding CopyToAllOperatorsCommand}"
                                        ToolTip="Copy selected operator settings to all operators"/>
                            </StackPanel>

                            <!-- MUL Presets -->
                            <TextBlock Text="MUL Presets" Style="{StaticResource LabelStyle}" Margin="0,4,0,4"/>
                            <WrapPanel>
                                <Button Content="0.5" Style="{StaticResource PresetButtonStyle}" Padding="4,2"
                                        Command="{Binding SetMultiplePresetCommand}" CommandParameter="0"/>
                                <Button Content="1" Style="{StaticResource PresetButtonStyle}" Padding="4,2"
                                        Command="{Binding SetMultiplePresetCommand}" CommandParameter="1"/>
                                <Button Content="2" Style="{StaticResource PresetButtonStyle}" Padding="4,2"
                                        Command="{Binding SetMultiplePresetCommand}" CommandParameter="2"/>
                                <Button Content="3" Style="{StaticResource PresetButtonStyle}" Padding="4,2"
                                        Command="{Binding SetMultiplePresetCommand}" CommandParameter="3"/>
                                <Button Content="4" Style="{StaticResource PresetButtonStyle}" Padding="4,2"
                                        Command="{Binding SetMultiplePresetCommand}" CommandParameter="4"/>
                                <Button Content="5" Style="{StaticResource PresetButtonStyle}" Padding="4,2"
                                        Command="{Binding SetMultiplePresetCommand}" CommandParameter="5"/>
                                <Button Content="7" Style="{StaticResource PresetButtonStyle}" Padding="4,2"
                                        Command="{Binding SetMultiplePresetCommand}" CommandParameter="7"/>
                                <Button Content="14" Style="{StaticResource PresetButtonStyle}" Padding="4,2"
                                        Command="{Binding SetMultiplePresetCommand}" CommandParameter="14"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="4,0,4,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Style="{StaticResource LabelStyle}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Algorithm: " Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding AlgorithmShortDescription}"
                               Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,16,0"/>
                    <TextBlock Text="Carriers: " Style="{StaticResource LabelStyle}"/>
                    <ItemsControl ItemsSource="{Binding Operators}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="22" Height="22" Margin="2,0"
                                        CornerRadius="11"
                                        Background="{Binding IsCarrier, Converter={x:Static local:OPNSynthControl.CarrierBackgroundConverter}}"
                                        BorderBrush="{Binding OperatorColor, Converter={x:Static local:OPNSynthControl.ColorToBrushConverter}}"
                                        BorderThickness="2">
                                    <TextBlock Text="{Binding OperatorNumber}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="10" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
