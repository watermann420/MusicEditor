<UserControl x:Class="MusicEngineEditor.Controls.Synths.SimpleSynthControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

        <!-- Slider Style -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Vertical Slider Style -->
        <Style x:Key="VerticalSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Style -->
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="SIMPLE SYNTH" Style="{StaticResource HeaderStyle}"
                           FontSize="16" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Volume:" Style="{StaticResource LabelStyle}" Margin="0,0,8,0"/>
                    <Slider x:Name="VolumeSlider" Value="{Binding Volume, Mode=TwoWay, FallbackValue=0.8}"
                            Minimum="0" Maximum="1" Width="100" Style="{StaticResource DarkSliderStyle}"/>
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:F2}', FallbackValue='0.80'}"
                               Style="{StaticResource ValueStyle}" Width="40" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Waveform and Filter -->
            <StackPanel Grid.Column="0">
                <!-- Waveform Section -->
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="WAVEFORM" Style="{StaticResource HeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Type:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Column="1" x:Name="WaveformCombo"
                                      SelectedIndex="{Binding WaveformIndex, Mode=TwoWay, FallbackValue=1}"
                                      Style="{StaticResource DarkComboBoxStyle}">
                                <ComboBoxItem Content="Sine"/>
                                <ComboBoxItem Content="Square"/>
                                <ComboBoxItem Content="Sawtooth"/>
                                <ComboBoxItem Content="Triangle"/>
                                <ComboBoxItem Content="Pulse"/>
                                <ComboBoxItem Content="Noise"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Filter Section -->
                <Border Style="{StaticResource PanelStyle}">
                    <StackPanel>
                        <TextBlock Text="FILTER" Style="{StaticResource HeaderStyle}"/>

                        <!-- Cutoff -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cutoff:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" x:Name="CutoffSlider"
                                    Value="{Binding Cutoff, Mode=TwoWay, FallbackValue=8000}"
                                    Minimum="20" Maximum="20000" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Cutoff, StringFormat='{}{0:F0} Hz', FallbackValue='8000 Hz'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>

                        <!-- Resonance -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Resonance:" Style="{StaticResource LabelStyle}"/>
                            <Slider Grid.Column="1" x:Name="ResonanceSlider"
                                    Value="{Binding Resonance, Mode=TwoWay, FallbackValue=0.3}"
                                    Minimum="0" Maximum="1" Style="{StaticResource DarkSliderStyle}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Resonance, StringFormat='{}{0:F2}', FallbackValue='0.30'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Column: ADSR Envelope -->
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ADSR ENVELOPE" Style="{StaticResource HeaderStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Attack -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Attack" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="AttackSlider" Value="{Binding Attack, Mode=TwoWay, FallbackValue=0.01}"
                                    Minimum="0.001" Maximum="5" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding Attack, StringFormat='{}{0:F2}s', FallbackValue='0.01s'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Decay -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Decay" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="DecaySlider" Value="{Binding Decay, Mode=TwoWay, FallbackValue=0.1}"
                                    Minimum="0.001" Maximum="5" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding Decay, StringFormat='{}{0:F2}s', FallbackValue='0.10s'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Sustain -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Sustain" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="SustainSlider" Value="{Binding Sustain, Mode=TwoWay, FallbackValue=0.7}"
                                    Minimum="0" Maximum="1" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding Sustain, StringFormat='{}{0:F2}', FallbackValue='0.70'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </StackPanel>

                        <!-- Release -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="Release" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>
                            <Slider x:Name="ReleaseSlider" Value="{Binding Release, Mode=TwoWay, FallbackValue=0.3}"
                                    Minimum="0.001" Maximum="10" Style="{StaticResource VerticalSliderStyle}"/>
                            <TextBlock Text="{Binding Release, StringFormat='{}{0:F2}s', FallbackValue='0.30s'}"
                                       Style="{StaticResource ValueStyle}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
