<UserControl x:Class="MusicEngineEditor.Controls.Spatial.SpatialAudioPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Spatial"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="450"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="HeaderColor">#1F1F1F</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="TextPrimaryColor">#E0E0E0</Color>
        <Color x:Key="TextSecondaryColor">#808080</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="WarningColor">#FFB800</Color>
        <Color x:Key="ErrorColor">#FF4757</Color>
        <Color x:Key="HoverColor">#252525</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Value Label Style -->
        <Style x:Key="ValueLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Status Label Style -->
        <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#0D0D0D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33E0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00B3CC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#404040"/>
                                <Setter Property="Foreground" Value="#808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <Path x:Name="icon" Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="10" Height="10"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3C3C3C"/>
                                <Setter TargetName="icon" Property="Stroke" Value="#FF6B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="SpatialSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="TrackBackground"
                                    Grid.Row="1"
                                    Height="4"
                                    Background="{StaticResource BorderBrush}"
                                    CornerRadius="2"
                                    Margin="5,0"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="SpatialComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- RadioButton Style for Ambisonic Order -->
        <Style x:Key="OrderRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A00D9FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Source List Item Style -->
        <Style x:Key="SourceListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A00D9FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="SPATIAL AUDIO"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Border Background="{StaticResource AccentBrush}"
                                CornerRadius="3"
                                Padding="6,2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="3D"
                                       Foreground="#0D0D0D"
                                       FontSize="9"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close Spatial Audio Panel"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16">

                    <!-- 3D Room Visualization Canvas -->
                    <TextBlock Text="3D ROOM VISUALIZATION" Style="{StaticResource LabelStyle}"/>
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="220"
                            Margin="0,0,0,16">
                        <Grid>
                            <Canvas x:Name="RoomVisualizationCanvas"
                                    ClipToBounds="True"
                                    MouseLeftButtonDown="RoomCanvas_MouseLeftButtonDown"
                                    MouseMove="RoomCanvas_MouseMove"
                                    MouseLeftButtonUp="RoomCanvas_MouseLeftButtonUp"
                                    Background="Transparent">
                                <!-- Grid lines drawn in code-behind -->
                            </Canvas>

                            <!-- Axis Labels -->
                            <TextBlock Text="Front"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Back"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="L"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                            <TextBlock Text="R"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>

                            <!-- Elevation indicator -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,4,8,0">
                                <TextBlock Text="Elev:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="9"
                                           Margin="0,0,4,0"/>
                                <TextBlock x:Name="SelectedElevationText"
                                           Text="0"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="9"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Spatial Sources List -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SPATIAL SOURCES" Style="{StaticResource LabelStyle}"/>
                        <Button Grid.Column="1"
                                Content="+ Add"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,4"
                                FontSize="10"
                                Click="AddSource_Click"/>
                    </Grid>

                    <ListBox x:Name="SourcesListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource SourceListItemStyle}"
                             MaxHeight="150"
                             Margin="0,0,0,16"
                             SelectionChanged="SourcesListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Position indicator dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="10" Height="10"
                                             Fill="{Binding Color}"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>

                                    <!-- Source name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                    <!-- Position display -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PositionDisplay}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <!-- Remove button -->
                                    <Button Grid.Column="3"
                                            Content="X"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="6,2"
                                            FontSize="9"
                                            Click="RemoveSource_Click"
                                            Tag="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Listener Position Control -->
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="LISTENER POSITION (VR/GAME)" Style="{StaticResource LabelStyle}"/>

                            <!-- X Position -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="X:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="ListenerXSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource SpatialSliderStyle}"
                                        Minimum="-10" Maximum="10"
                                        Value="0"
                                        ValueChanged="ListenerPosition_Changed"/>
                                <TextBlock x:Name="ListenerXValue"
                                           Grid.Column="2"
                                           Text="0.0"
                                           Style="{StaticResource ValueLabelStyle}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Y Position -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Y:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="ListenerYSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource SpatialSliderStyle}"
                                        Minimum="-10" Maximum="10"
                                        Value="0"
                                        ValueChanged="ListenerPosition_Changed"/>
                                <TextBlock x:Name="ListenerYValue"
                                           Grid.Column="2"
                                           Text="0.0"
                                           Style="{StaticResource ValueLabelStyle}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Z Position (Height) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Z:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="ListenerZSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource SpatialSliderStyle}"
                                        Minimum="-5" Maximum="5"
                                        Value="0"
                                        ValueChanged="ListenerPosition_Changed"/>
                                <TextBlock x:Name="ListenerZValue"
                                           Grid.Column="2"
                                           Text="0.0"
                                           Style="{StaticResource ValueLabelStyle}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Yaw (Rotation) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Yaw:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           FontSize="10"/>
                                <Slider x:Name="ListenerYawSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource SpatialSliderStyle}"
                                        Minimum="-180" Maximum="180"
                                        Value="0"
                                        ValueChanged="ListenerOrientation_Changed"/>
                                <TextBlock x:Name="ListenerYawValue"
                                           Grid.Column="2"
                                           Text="0"
                                           Style="{StaticResource ValueLabelStyle}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Ambisonic Order Selector -->
                    <TextBlock Text="AMBISONIC ORDER" Style="{StaticResource LabelStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="Order1Radio"
                                     Content="1st Order"
                                     Style="{StaticResource OrderRadioButtonStyle}"
                                     IsChecked="True"
                                     Checked="AmbisonicOrder_Changed"
                                     GroupName="AmbisonicOrder"
                                     Margin="0,0,8,0"/>
                        <RadioButton x:Name="Order2Radio"
                                     Content="2nd Order"
                                     Style="{StaticResource OrderRadioButtonStyle}"
                                     Checked="AmbisonicOrder_Changed"
                                     GroupName="AmbisonicOrder"
                                     Margin="0,0,8,0"/>
                        <RadioButton x:Name="Order3Radio"
                                     Content="3rd Order"
                                     Style="{StaticResource OrderRadioButtonStyle}"
                                     Checked="AmbisonicOrder_Changed"
                                     GroupName="AmbisonicOrder"/>
                    </StackPanel>

                    <!-- Channel count info -->
                    <TextBlock x:Name="AmbisonicChannelInfo"
                               Text="4 channels (W, X, Y, Z)"
                               Style="{StaticResource StatusLabelStyle}"
                               Margin="0,0,0,16"/>

                    <!-- Output Format Selector -->
                    <TextBlock Text="OUTPUT FORMAT" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="OutputFormatComboBox"
                              Style="{StaticResource SpatialComboBoxStyle}"
                              SelectionChanged="OutputFormat_Changed"
                              Margin="0,0,0,16">
                        <ComboBoxItem Content="Binaural (Headphones)" Tag="Binaural"/>
                        <ComboBoxItem Content="5.1 Surround" Tag="Surround51"/>
                        <ComboBoxItem Content="7.1 Surround" Tag="Surround71"/>
                        <ComboBoxItem Content="Ambisonics B-Format" Tag="Ambisonics" IsSelected="True"/>
                        <ComboBoxItem Content="Stereo" Tag="Stereo"/>
                    </ComboBox>

                    <!-- Global Reverb Send -->
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="GLOBAL REVERB (ROOM SIMULATION)" Style="{StaticResource LabelStyle}"/>

                            <!-- Reverb Send Level -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Send Level"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="ReverbSendSlider"
                                        Grid.Column="0"
                                        Style="{StaticResource SpatialSliderStyle}"
                                        Minimum="0" Maximum="100"
                                        Value="30"
                                        Margin="60,0,0,0"
                                        ValueChanged="ReverbSend_Changed"/>
                                <TextBlock x:Name="ReverbSendValue"
                                           Grid.Column="1"
                                           Text="30%"
                                           Style="{StaticResource ValueLabelStyle}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Room Size Preset -->
                            <TextBlock Text="Room Size"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="RoomSizeComboBox"
                                      Style="{StaticResource SpatialComboBoxStyle}"
                                      SelectionChanged="RoomSize_Changed"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="Small (Bathroom/Closet)" Tag="Small"/>
                                <ComboBoxItem Content="Medium (Bedroom/Office)" Tag="Medium" IsSelected="True"/>
                                <ComboBoxItem Content="Large (Living Room)" Tag="Large"/>
                                <ComboBoxItem Content="Hall (Auditorium)" Tag="Hall"/>
                                <ComboBoxItem Content="Outdoor" Tag="Outdoor"/>
                            </ComboBox>

                            <!-- Estimated Reverb Time -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Est. RT60:"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="10"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="ReverbTimeDisplay"
                                           Text="0.8s"
                                           Style="{StaticResource ValueLabelStyle}"
                                           FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status -->
                    <TextBlock x:Name="StatusText"
                               Text="Ready - Select a source to position in 3D space"
                               Style="{StaticResource StatusLabelStyle}"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
