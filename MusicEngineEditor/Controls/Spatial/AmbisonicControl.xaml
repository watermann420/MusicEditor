<UserControl x:Class="MusicEngineEditor.Controls.Spatial.AmbisonicControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Spatial"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextDimColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="SliderTrackColor">#333333</Color>
        <Color x:Key="MeterGreenColor">#00FF88</Color>
        <Color x:Key="MeterYellowColor">#FFB800</Color>
        <Color x:Key="MeterRedColor">#FF4757</Color>
        <Color x:Key="WChannelColor">#00D9FF</Color>
        <Color x:Key="XChannelColor">#FF6B6B</Color>
        <Color x:Key="YChannelColor">#00FF88</Color>
        <Color x:Key="ZChannelColor">#FFB800</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="SliderTrackBrush" Color="{StaticResource SliderTrackColor}"/>
        <SolidColorBrush x:Key="WChannelBrush" Color="{StaticResource WChannelColor}"/>
        <SolidColorBrush x:Key="XChannelBrush" Color="{StaticResource XChannelColor}"/>
        <SolidColorBrush x:Key="YChannelBrush" Color="{StaticResource YChannelColor}"/>
        <SolidColorBrush x:Key="ZChannelBrush" Color="{StaticResource ZChannelColor}"/>

        <!-- Slider Style -->
        <Style x:Key="AmbisonicSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource SliderTrackBrush}"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="ParameterLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Value Label Style -->
        <Style x:Key="ValueLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="MinWidth" Value="55"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="AmbisonicButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#303030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#004455"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="AmbisonicComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Channel Meter Style -->
        <Style x:Key="ChannelMeterStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AMBISONIC CONTROL"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="|" Foreground="{StaticResource TextDimBrush}" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OrderIndicator"
                               Text="1st Order (4ch)"
                               Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Head Tracking Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="HeadTrackingToggle"
                                  Content="Head Tracking (VR)"
                                  Style="{StaticResource ToggleButtonStyle}"
                                  IsChecked="{Binding HeadTrackingEnabled, Mode=TwoWay}"
                                  Checked="HeadTrackingToggle_Changed"
                                  Unchecked="HeadTrackingToggle_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Encoder + Visualization -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Spatial Visualization Area -->
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Margin="8" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 3D Position Visualization -->
                        <Border Grid.Row="0" Background="#0A0A0A" CornerRadius="4" Margin="8">
                            <Grid x:Name="SpatialVisualizationContainer"
                                  MouseLeftButtonDown="SpatialVisualization_MouseLeftButtonDown"
                                  MouseMove="SpatialVisualization_MouseMove"
                                  MouseLeftButtonUp="SpatialVisualization_MouseLeftButtonUp"
                                  SizeChanged="SpatialVisualization_SizeChanged"
                                  Cursor="Hand">
                                <!-- Canvas for visualization -->
                                <Canvas x:Name="SpatialCanvas" Background="Transparent" ClipToBounds="True">
                                    <!-- Grid lines drawn in code-behind -->
                                </Canvas>

                                <!-- Center crosshair -->
                                <Path x:Name="CenterCrosshair"
                                      Stroke="{StaticResource BorderBrush}"
                                      StrokeThickness="1"
                                      StrokeDashArray="4,2"
                                      Data="M 0,-100 L 0,100 M -100,0 L 100,0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                                <!-- Azimuth/Elevation indicator circle -->
                                <Ellipse x:Name="PositionIndicator"
                                         Width="16" Height="16"
                                         Fill="{StaticResource AccentBrush}"
                                         Stroke="White"
                                         StrokeThickness="2"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>

                                <!-- Labels -->
                                <TextBlock Text="FRONT" Foreground="{StaticResource TextDimBrush}" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                <TextBlock Text="BACK" Foreground="{StaticResource TextDimBrush}" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                                <TextBlock Text="LEFT" Foreground="{StaticResource TextDimBrush}" FontSize="10"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Text="RIGHT" Foreground="{StaticResource TextDimBrush}" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </Grid>
                        </Border>

                        <!-- B-Format Channel Meters -->
                        <Border Grid.Row="1" Background="#0A0A0A" CornerRadius="4" Margin="8,0,8,8" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- W Channel -->
                                <StackPanel Grid.Column="0" Margin="4">
                                    <TextBlock Text="W" FontWeight="Bold" Foreground="{StaticResource WChannelBrush}"
                                               HorizontalAlignment="Center" FontSize="12"/>
                                    <TextBlock Text="Omni" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Center" FontSize="9"/>
                                    <Border Background="#1A1A1A" CornerRadius="2" Margin="0,4,0,0" Height="80">
                                        <Grid>
                                            <Rectangle x:Name="WMeter" Fill="{StaticResource WChannelBrush}"
                                                       VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="WValue" Text="0.00" Foreground="{StaticResource WChannelBrush}"
                                               HorizontalAlignment="Center" FontSize="10" FontFamily="Consolas" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- X Channel -->
                                <StackPanel Grid.Column="1" Margin="4">
                                    <TextBlock Text="X" FontWeight="Bold" Foreground="{StaticResource XChannelBrush}"
                                               HorizontalAlignment="Center" FontSize="12"/>
                                    <TextBlock Text="Front" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Center" FontSize="9"/>
                                    <Border Background="#1A1A1A" CornerRadius="2" Margin="0,4,0,0" Height="80">
                                        <Grid>
                                            <Rectangle x:Name="XMeter" Fill="{StaticResource XChannelBrush}"
                                                       VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="XValue" Text="0.00" Foreground="{StaticResource XChannelBrush}"
                                               HorizontalAlignment="Center" FontSize="10" FontFamily="Consolas" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Y Channel -->
                                <StackPanel Grid.Column="2" Margin="4">
                                    <TextBlock Text="Y" FontWeight="Bold" Foreground="{StaticResource YChannelBrush}"
                                               HorizontalAlignment="Center" FontSize="12"/>
                                    <TextBlock Text="Left" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Center" FontSize="9"/>
                                    <Border Background="#1A1A1A" CornerRadius="2" Margin="0,4,0,0" Height="80">
                                        <Grid>
                                            <Rectangle x:Name="YMeter" Fill="{StaticResource YChannelBrush}"
                                                       VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="YValue" Text="0.00" Foreground="{StaticResource YChannelBrush}"
                                               HorizontalAlignment="Center" FontSize="10" FontFamily="Consolas" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Z Channel -->
                                <StackPanel Grid.Column="3" Margin="4">
                                    <TextBlock Text="Z" FontWeight="Bold" Foreground="{StaticResource ZChannelBrush}"
                                               HorizontalAlignment="Center" FontSize="12"/>
                                    <TextBlock Text="Up" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Center" FontSize="9"/>
                                    <Border Background="#1A1A1A" CornerRadius="2" Margin="0,4,0,0" Height="80">
                                        <Grid>
                                            <Rectangle x:Name="ZMeter" Fill="{StaticResource ZChannelBrush}"
                                                       VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="ZValue" Text="0.00" Foreground="{StaticResource ZChannelBrush}"
                                               HorizontalAlignment="Center" FontSize="10" FontFamily="Consolas" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Panel: Parameters -->
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" Margin="0,8,8,8" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <!-- Encoder Section -->
                        <TextBlock Text="ENCODER" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Azimuth -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Azimuth" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider x:Name="AzimuthSlider" Grid.Column="1"
                                    Value="{Binding Azimuth, Mode=TwoWay}"
                                    Minimum="-180" Maximum="180"
                                    Style="{StaticResource AmbisonicSliderStyle}"
                                    ValueChanged="Azimuth_ValueChanged"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Azimuth, StringFormat='{}{0:F1}\u00B0'}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <!-- Elevation -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Elevation" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider x:Name="ElevationSlider" Grid.Column="1"
                                    Value="{Binding Elevation, Mode=TwoWay}"
                                    Minimum="-90" Maximum="90"
                                    Style="{StaticResource AmbisonicSliderStyle}"
                                    ValueChanged="Elevation_ValueChanged"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Elevation, StringFormat='{}{0:F1}\u00B0'}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <!-- Spread -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Spread" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider x:Name="SpreadSlider" Grid.Column="1"
                                    Value="{Binding Spread, Mode=TwoWay}"
                                    Minimum="0" Maximum="1"
                                    Style="{StaticResource AmbisonicSliderStyle}"
                                    ValueChanged="Spread_ValueChanged"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Spread, StringFormat='{}{0:P0}'}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <!-- Decoder Section -->
                        <TextBlock Text="DECODER" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Speaker Layout -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Layout" Style="{StaticResource ParameterLabelStyle}"/>
                            <ComboBox x:Name="SpeakerLayoutCombo" Grid.Column="1"
                                      Style="{StaticResource AmbisonicComboBoxStyle}"
                                      SelectionChanged="SpeakerLayout_SelectionChanged">
                                <ComboBoxItem Content="Stereo" IsSelected="True"/>
                                <ComboBoxItem Content="5.1 Surround"/>
                                <ComboBoxItem Content="7.1 Surround"/>
                                <ComboBoxItem Content="Binaural (Headphones)"/>
                                <ComboBoxItem Content="Custom"/>
                            </ComboBox>
                        </Grid>

                        <!-- Output Format -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Format" Style="{StaticResource ParameterLabelStyle}"/>
                            <ComboBox x:Name="OutputFormatCombo" Grid.Column="1"
                                      Style="{StaticResource AmbisonicComboBoxStyle}"
                                      SelectionChanged="OutputFormat_SelectionChanged">
                                <ComboBoxItem Content="AmbiX (ACN/SN3D)" IsSelected="True"/>
                                <ComboBoxItem Content="FuMa (Legacy)"/>
                                <ComboBoxItem Content="N3D"/>
                            </ComboBox>
                        </Grid>

                        <!-- Decoding Method -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Method" Style="{StaticResource ParameterLabelStyle}"/>
                            <ComboBox x:Name="DecodingMethodCombo" Grid.Column="1"
                                      Style="{StaticResource AmbisonicComboBoxStyle}"
                                      SelectionChanged="DecodingMethod_SelectionChanged">
                                <ComboBoxItem Content="Basic" IsSelected="True"/>
                                <ComboBoxItem Content="Max-rE (Energy Preserving)"/>
                                <ComboBoxItem Content="In-Phase (Psychoacoustic)"/>
                            </ComboBox>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <!-- Rotation Section (Decoder) -->
                        <TextBlock Text="DECODER ROTATION" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Yaw -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Yaw" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider x:Name="YawSlider" Grid.Column="1"
                                    Value="{Binding DecoderYaw, Mode=TwoWay}"
                                    Minimum="-180" Maximum="180"
                                    Style="{StaticResource AmbisonicSliderStyle}"
                                    ValueChanged="Rotation_ValueChanged"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DecoderYaw, StringFormat='{}{0:F1}\u00B0'}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <!-- Pitch -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pitch" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider x:Name="PitchSlider" Grid.Column="1"
                                    Value="{Binding DecoderPitch, Mode=TwoWay}"
                                    Minimum="-90" Maximum="90"
                                    Style="{StaticResource AmbisonicSliderStyle}"
                                    ValueChanged="Rotation_ValueChanged"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DecoderPitch, StringFormat='{}{0:F1}\u00B0'}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <!-- Roll -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Roll" Style="{StaticResource ParameterLabelStyle}"/>
                            <Slider x:Name="RollSlider" Grid.Column="1"
                                    Value="{Binding DecoderRoll, Mode=TwoWay}"
                                    Minimum="-180" Maximum="180"
                                    Style="{StaticResource AmbisonicSliderStyle}"
                                    ValueChanged="Rotation_ValueChanged"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DecoderRoll, StringFormat='{}{0:F1}\u00B0'}"
                                       Style="{StaticResource ValueLabelStyle}"/>
                        </Grid>

                        <!-- Reset Rotation Button -->
                        <Button Content="Reset Rotation"
                                Style="{StaticResource AmbisonicButtonStyle}"
                                Click="ResetRotation_Click"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"/>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <!-- Order Selection -->
                        <TextBlock Text="AMBISONIC ORDER" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Order" Style="{StaticResource ParameterLabelStyle}"/>
                            <ComboBox x:Name="AmbisonicOrderCombo" Grid.Column="1"
                                      Style="{StaticResource AmbisonicComboBoxStyle}"
                                      SelectionChanged="AmbisonicOrder_SelectionChanged">
                                <ComboBoxItem Content="1st Order (4 channels)" IsSelected="True"/>
                                <ComboBoxItem Content="2nd Order (9 channels)"/>
                                <ComboBoxItem Content="3rd Order (16 channels)"/>
                            </ComboBox>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8"/>

                        <!-- Quick Actions -->
                        <TextBlock Text="QUICK ACTIONS" Style="{StaticResource SectionHeaderStyle}"/>

                        <WrapPanel Margin="0,4">
                            <Button Content="Front" Style="{StaticResource AmbisonicButtonStyle}"
                                    Click="QuickPosition_Click" Tag="Front" Margin="0,0,4,4" Padding="8,4"/>
                            <Button Content="Back" Style="{StaticResource AmbisonicButtonStyle}"
                                    Click="QuickPosition_Click" Tag="Back" Margin="0,0,4,4" Padding="8,4"/>
                            <Button Content="Left" Style="{StaticResource AmbisonicButtonStyle}"
                                    Click="QuickPosition_Click" Tag="Left" Margin="0,0,4,4" Padding="8,4"/>
                            <Button Content="Right" Style="{StaticResource AmbisonicButtonStyle}"
                                    Click="QuickPosition_Click" Tag="Right" Margin="0,0,4,4" Padding="8,4"/>
                            <Button Content="Above" Style="{StaticResource AmbisonicButtonStyle}"
                                    Click="QuickPosition_Click" Tag="Above" Margin="0,0,4,4" Padding="8,4"/>
                            <Button Content="Below" Style="{StaticResource AmbisonicButtonStyle}"
                                    Click="QuickPosition_Click" Tag="Below" Margin="0,0,4,4" Padding="8,4"/>
                            <Button Content="Center" Style="{StaticResource AmbisonicButtonStyle}"
                                    Click="QuickPosition_Click" Tag="Center" Margin="0,0,4,4" Padding="8,4"/>
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="Ready"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="11"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Position: "
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="11"/>
                    <TextBlock x:Name="PositionStatus"
                               Text="Az: 0.0, El: 0.0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11"
                               FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
