<UserControl x:Class="MusicEngineEditor.Controls.Spatial.BinauralRendererControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Theme Colors -->
        <Color x:Key="BinauralBackgroundColor">#0D0D0D</Color>
        <Color x:Key="BinauralPanelColor">#181818</Color>
        <Color x:Key="BinauralAccentColor">#00D9FF</Color>
        <Color x:Key="BinauralSuccessColor">#00FF88</Color>
        <Color x:Key="BinauralWarningColor">#FFB800</Color>
        <Color x:Key="BinauralTextColor">#E0E0E0</Color>
        <Color x:Key="BinauralSecondaryTextColor">#808080</Color>
        <Color x:Key="BinauralBorderColor">#2A2A2A</Color>
        <Color x:Key="BinauralGridColor">#1A1A1A</Color>
        <Color x:Key="BinauralHeadColor">#3A3A3A</Color>
        <Color x:Key="BinauralSourceColor">#00D9FF</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BinauralBackgroundBrush" Color="{StaticResource BinauralBackgroundColor}"/>
        <SolidColorBrush x:Key="BinauralPanelBrush" Color="{StaticResource BinauralPanelColor}"/>
        <SolidColorBrush x:Key="BinauralAccentBrush" Color="{StaticResource BinauralAccentColor}"/>
        <SolidColorBrush x:Key="BinauralSuccessBrush" Color="{StaticResource BinauralSuccessColor}"/>
        <SolidColorBrush x:Key="BinauralWarningBrush" Color="{StaticResource BinauralWarningColor}"/>
        <SolidColorBrush x:Key="BinauralTextBrush" Color="{StaticResource BinauralTextColor}"/>
        <SolidColorBrush x:Key="BinauralSecondaryTextBrush" Color="{StaticResource BinauralSecondaryTextColor}"/>
        <SolidColorBrush x:Key="BinauralBorderBrush" Color="{StaticResource BinauralBorderColor}"/>
        <SolidColorBrush x:Key="BinauralGridBrush" Color="{StaticResource BinauralGridColor}"/>
        <SolidColorBrush x:Key="BinauralHeadBrush" Color="{StaticResource BinauralHeadColor}"/>
        <SolidColorBrush x:Key="BinauralSourceBrush" Color="{StaticResource BinauralSourceColor}"/>

        <!-- Parameter Label Style -->
        <Style x:Key="BinauralParameterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource BinauralSecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Parameter Value Style -->
        <Style x:Key="BinauralParameterValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource BinauralTextBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- Header Style -->
        <Style x:Key="BinauralHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BinauralAccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Panel Style -->
        <Style x:Key="BinauralPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BinauralPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BinauralBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="BinauralSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" VerticalAlignment="Center"
                                    Background="#2A2A2A" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="{StaticResource BinauralAccentBrush}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{StaticResource BinauralAccentBrush}"
                                                         Width="14" Height="14"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="BinauralComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BinauralPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BinauralTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BinauralBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="BinauralToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource BinauralPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BinauralTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BinauralBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource BinauralAccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{StaticResource BinauralAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enable Toggle Style (Green when enabled) -->
        <Style x:Key="BinauralEnableToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource BinauralToggleButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource BinauralSuccessBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{StaticResource BinauralSuccessBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bypass Toggle Style (Warning color when bypassed) -->
        <Style x:Key="BinauralBypassToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource BinauralToggleButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource BinauralWarningBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{StaticResource BinauralWarningBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BinauralBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Background="{StaticResource BinauralBackgroundBrush}"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="BINAURAL RENDERER"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BinauralTextBrush}"
                           VerticalAlignment="Center"/>

                <ToggleButton Grid.Column="1"
                              x:Name="EnableToggle"
                              Content="Enable"
                              IsChecked="True"
                              Style="{StaticResource BinauralEnableToggleStyle}"
                              Margin="0,0,8,0"
                              Click="EnableToggle_Click"
                              ToolTip="Enable/disable binaural processing"/>

                <ToggleButton Grid.Column="2"
                              x:Name="BypassToggle"
                              Content="Bypass"
                              Style="{StaticResource BinauralBypassToggleStyle}"
                              Click="BypassToggle_Click"
                              ToolTip="Bypass binaural processing"/>
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- 3D Head Visualization -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top-Down View (Azimuth) -->
                    <Border Grid.Row="0" Style="{StaticResource BinauralPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="TOP VIEW (Azimuth)" Style="{StaticResource BinauralHeaderStyle}"/>

                            <Canvas x:Name="TopViewCanvas"
                                    Grid.Row="1"
                                    ClipToBounds="True"
                                    Background="Transparent"
                                    MouseLeftButtonDown="TopViewCanvas_MouseLeftButtonDown"
                                    MouseLeftButtonUp="TopViewCanvas_MouseLeftButtonUp"
                                    MouseMove="TopViewCanvas_MouseMove"/>
                        </Grid>
                    </Border>

                    <!-- Side View (Elevation) -->
                    <Border Grid.Row="2" Style="{StaticResource BinauralPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="SIDE VIEW (Elevation)" Style="{StaticResource BinauralHeaderStyle}"/>

                            <Canvas x:Name="SideViewCanvas"
                                    Grid.Row="1"
                                    ClipToBounds="True"
                                    Background="Transparent"
                                    MouseLeftButtonDown="SideViewCanvas_MouseLeftButtonDown"
                                    MouseLeftButtonUp="SideViewCanvas_MouseLeftButtonUp"
                                    MouseMove="SideViewCanvas_MouseMove"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Controls Panel -->
                <StackPanel Grid.Column="2">
                    <!-- Position Controls -->
                    <Border Style="{StaticResource BinauralPanelStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="POSITION" Style="{StaticResource BinauralHeaderStyle}"/>

                            <!-- Azimuth -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Azimuth" Style="{StaticResource BinauralParameterLabelStyle}"/>
                                    <TextBlock Grid.Column="1" x:Name="AzimuthValue" Text="0.0"
                                               Style="{StaticResource BinauralParameterValueStyle}"/>
                                </Grid>
                                <Slider Grid.Row="1"
                                        x:Name="AzimuthSlider"
                                        Minimum="-180" Maximum="180" Value="0"
                                        Style="{StaticResource BinauralSliderStyle}"
                                        ValueChanged="AzimuthSlider_ValueChanged"
                                        ToolTip="Horizontal angle: -180 (left/back) to +180 (right/back), 0 = front"/>
                            </Grid>

                            <!-- Elevation -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Elevation" Style="{StaticResource BinauralParameterLabelStyle}"/>
                                    <TextBlock Grid.Column="1" x:Name="ElevationValue" Text="0.0"
                                               Style="{StaticResource BinauralParameterValueStyle}"/>
                                </Grid>
                                <Slider Grid.Row="1"
                                        x:Name="ElevationSlider"
                                        Minimum="-90" Maximum="90" Value="0"
                                        Style="{StaticResource BinauralSliderStyle}"
                                        ValueChanged="ElevationSlider_ValueChanged"
                                        ToolTip="Vertical angle: -90 (below) to +90 (above), 0 = ear level"/>
                            </Grid>

                            <!-- Distance -->
                            <Grid Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Distance" Style="{StaticResource BinauralParameterLabelStyle}"/>
                                    <TextBlock Grid.Column="1" x:Name="DistanceValue" Text="1.0 m"
                                               Style="{StaticResource BinauralParameterValueStyle}"/>
                                </Grid>
                                <Slider Grid.Row="1"
                                        x:Name="DistanceSlider"
                                        Minimum="0" Maximum="100" Value="50"
                                        Style="{StaticResource BinauralSliderStyle}"
                                        ValueChanged="DistanceSlider_ValueChanged"
                                        ToolTip="Distance from listener: 0.1m to 100m (exponential)"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- HRTF Settings -->
                    <Border Style="{StaticResource BinauralPanelStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="HRTF SETTINGS" Style="{StaticResource BinauralHeaderStyle}"/>

                            <!-- HRTF Profile -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Profile:" Style="{StaticResource BinauralParameterLabelStyle}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="HrtfProfileCombo"
                                          Style="{StaticResource BinauralComboBoxStyle}"
                                          SelectionChanged="HrtfProfileCombo_SelectionChanged"
                                          ToolTip="Head-Related Transfer Function profile">
                                    <ComboBoxItem Content="Generic" IsSelected="True"/>
                                    <ComboBoxItem Content="KEMAR"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>
                            </Grid>

                            <!-- Room Size -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Room:" Style="{StaticResource BinauralParameterLabelStyle}"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          x:Name="RoomSizeCombo"
                                          Style="{StaticResource BinauralComboBoxStyle}"
                                          SelectionChanged="RoomSizeCombo_SelectionChanged"
                                          ToolTip="Room size affects early reflections and reverb character">
                                    <ComboBoxItem Content="None" IsSelected="True"/>
                                    <ComboBoxItem Content="Small"/>
                                    <ComboBoxItem Content="Medium"/>
                                    <ComboBoxItem Content="Large"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Distance Model -->
                    <Border Style="{StaticResource BinauralPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="DISTANCE MODEL" Style="{StaticResource BinauralHeaderStyle}"/>

                            <!-- Rolloff Factor -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Rolloff" Style="{StaticResource BinauralParameterLabelStyle}"/>
                                    <TextBlock Grid.Column="1" x:Name="RolloffValue" Text="1.0"
                                               Style="{StaticResource BinauralParameterValueStyle}"/>
                                </Grid>
                                <Slider Grid.Row="1"
                                        x:Name="RolloffSlider"
                                        Minimum="0" Maximum="10" Value="1"
                                        Style="{StaticResource BinauralSliderStyle}"
                                        ValueChanged="RolloffSlider_ValueChanged"
                                        ToolTip="Distance attenuation rolloff factor"/>
                            </Grid>

                            <!-- Air Absorption -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Air Absorption" Style="{StaticResource BinauralParameterLabelStyle}"/>
                                    <TextBlock Grid.Column="1" x:Name="AirAbsorptionValue" Text="0.001"
                                               Style="{StaticResource BinauralParameterValueStyle}"/>
                                </Grid>
                                <Slider Grid.Row="1"
                                        x:Name="AirAbsorptionSlider"
                                        Minimum="0" Maximum="100" Value="1"
                                        Style="{StaticResource BinauralSliderStyle}"
                                        ValueChanged="AirAbsorptionSlider_ValueChanged"
                                        ToolTip="High-frequency damping over distance"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource BinauralPanelBrush}"
                    BorderBrush="{StaticResource BinauralBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Position: "
                                   Foreground="{StaticResource BinauralSecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PositionStatusText"
                                   Text="Az: 0.0, El: 0.0, D: 1.0m"
                                   Foreground="{StaticResource BinauralTextBrush}"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Status: "
                                   Foreground="{StaticResource BinauralSecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Ready"
                                   Foreground="{StaticResource BinauralSuccessBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
