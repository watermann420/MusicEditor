<UserControl x:Class="MusicEngineEditor.Controls.Arrangement.TrackHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:MusicEngineEditor.Controls"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="150"
             Height="60"
             Background="#181818"
             ClipToBounds="True">

    <!-- Context Menu -->
    <UserControl.ContextMenu>
        <ContextMenu x:Name="TrackContextMenu" Background="#1A1A1A" BorderBrush="#3A3A3A">
            <MenuItem Header="Rename Track" Click="RenameMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="R" FontSize="10" FontWeight="Bold" Foreground="#E0E0E0"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Set Color" x:Name="SetColorMenuItem">
                <MenuItem.Icon>
                    <Border Width="12" Height="12" CornerRadius="2" x:Name="ColorMenuIcon" Background="#00D9FF"/>
                </MenuItem.Icon>
                <!-- Color Swatches Submenu - populated dynamically -->
                <MenuItem Header="Red" Tag="#FF4444" Click="ColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#FF4444"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Orange" Tag="#FF8C42" Click="ColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#FF8C42"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Yellow" Tag="#FFD93D" Click="ColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#FFD93D"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Lime" Tag="#A8E06C" Click="ColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#A8E06C"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Green" Tag="#4CAF50" Click="ColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#4CAF50"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Teal" Tag="#26A69A" Click="ColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#26A69A"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Cyan" Tag="#00BCD4" Click="ColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#00BCD4"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Blue" Tag="#4A9EFF" Click="ColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#4A9EFF"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Indigo" Tag="#5C6BC0" Click="ColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#5C6BC0"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Purple" Tag="#9C27B0" Click="ColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#9C27B0"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Magenta" Tag="#E91E8C" Click="ColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#E91E8C"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Pink" Tag="#FF6B9D" Click="ColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2" Background="#FF6B9D"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Auto (by track type)" Tag="Auto" Click="AutoColorMenuItem_Click">
                    <MenuItem.Icon>
                        <Border Width="12" Height="12" CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF6B6B" Offset="0"/>
                                    <GradientStop Color="#4ECDC4" Offset="0.5"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Custom Color..." Click="CustomColorMenuItem_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="..." FontSize="10" FontWeight="Bold" Foreground="#E0E0E0"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Duplicate Track" Click="DuplicateMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="D" FontSize="10" FontWeight="Bold" Foreground="#E0E0E0"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Delete Track" Click="DeleteMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="X" FontSize="10" FontWeight="Bold" Foreground="#FF4757"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>

    <UserControl.Resources>
        <!-- Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="SecondaryTextColor">#808080</Color>

        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>

        <!-- Mute Button Colors -->
        <Color x:Key="MuteActiveColor">#FF4757</Color>
        <SolidColorBrush x:Key="MuteActiveBrush" Color="{StaticResource MuteActiveColor}"/>

        <!-- Solo Button Colors -->
        <Color x:Key="SoloActiveColor">#FFB800</Color>
        <SolidColorBrush x:Key="SoloActiveBrush" Color="{StaticResource SoloActiveColor}"/>

        <!-- Icon Button Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#303030"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#404040"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Collapse Button Style -->
        <Style x:Key="CollapseButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <Path x:Name="arrow"
                                  Data="M 0,0 L 4,4 L 0,8"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#303030"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,1"
            Background="{StaticResource PanelBrush}">
        <Grid Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Track Color Indicator -->
            <Rectangle x:Name="TrackColorRect"
                       Grid.Column="0"
                       Grid.RowSpan="2"
                       Width="4"
                       RadiusX="2"
                       RadiusY="2"
                       Fill="{StaticResource AccentBrush}"
                       VerticalAlignment="Stretch"/>

            <!-- Track Name -->
            <TextBlock x:Name="TrackNameText"
                       Grid.Column="2"
                       Grid.Row="0"
                       Text="Track 1"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

            <!-- Collapse Toggle -->
            <ToggleButton x:Name="CollapseToggle"
                          Grid.Column="3"
                          Grid.Row="0"
                          Style="{StaticResource CollapseButtonStyle}"
                          VerticalAlignment="Center"
                          ToolTip="Collapse/Expand Track"
                          Checked="CollapseToggle_Checked"
                          Unchecked="CollapseToggle_Unchecked"/>

            <!-- Control Buttons -->
            <StackPanel Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0">

                <!-- Mute Button -->
                <Button x:Name="MuteButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="M"
                        ToolTip="Mute Track"
                        Click="MuteButton_Click"/>

                <!-- Solo Button -->
                <Button x:Name="SoloButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="S"
                        Margin="4,0,0,0"
                        ToolTip="Solo Track"
                        Click="SoloButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
