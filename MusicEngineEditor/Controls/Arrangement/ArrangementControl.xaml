<UserControl x:Class="MusicEngineEditor.Controls.Arrangement.ArrangementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Arrangement"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800"
             Background="#0D0D0D"
             ClipToBounds="True">

    <UserControl.Resources>
        <!-- Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="SecondaryTextColor">#808080</Color>

        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>

        <!-- Loop Region Color -->
        <Color x:Key="LoopRegionColor">#3000D9FF</Color>
        <SolidColorBrush x:Key="LoopRegionBrush" Color="{StaticResource LoopRegionColor}"/>

        <!-- Playhead Color (Cyan) -->
        <SolidColorBrush x:Key="PlayheadBrush" Color="{StaticResource AccentColor}"/>

        <!-- Grid Line Colors -->
        <SolidColorBrush x:Key="MajorGridBrush" Color="#303030"/>
        <SolidColorBrush x:Key="MinorGridBrush" Color="#202020"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Top-Left Corner (Empty or Toolbar) -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,1">
            <TextBlock Text="Tracks"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Timeline Ruler (Top) -->
        <local:TimelineRulerControl x:Name="TimelineRuler"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    PixelsPerBeat="{Binding PixelsPerBeat, RelativeSource={RelativeSource AncestorType=local:ArrangementControl}}"
                                    TotalBars="{Binding TotalBars, RelativeSource={RelativeSource AncestorType=local:ArrangementControl}}"
                                    BeatsPerBar="{Binding BeatsPerBar, RelativeSource={RelativeSource AncestorType=local:ArrangementControl}}"
                                    ScrollOffset="{Binding ScrollOffset, RelativeSource={RelativeSource AncestorType=local:ArrangementControl}}"
                                    PlayheadPosition="{Binding PlayheadPosition, RelativeSource={RelativeSource AncestorType=local:ArrangementControl}}"
                                    PlayheadRequested="TimelineRuler_PlayheadRequested"/>

        <!-- Track Headers (Left) -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer x:Name="TrackHeaderScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TrackHeadersPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Main Clips Canvas (Scrollable) -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0">
            <ScrollViewer x:Name="ClipsScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="ClipsScrollViewer_ScrollChanged">
                <Canvas x:Name="ClipsCanvas"
                        Background="Transparent"
                        ClipToBounds="True"
                        MouseLeftButtonDown="ClipsCanvas_MouseLeftButtonDown"
                        MouseLeftButtonUp="ClipsCanvas_MouseLeftButtonUp"
                        MouseMove="ClipsCanvas_MouseMove"
                        MouseRightButtonDown="ClipsCanvas_MouseRightButtonDown">

                    <!-- Grid Lines (drawn programmatically) -->

                    <!-- Loop Region Highlight -->
                    <Rectangle x:Name="LoopRegionRect"
                               Fill="{StaticResource LoopRegionBrush}"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"/>

                    <!-- Playhead Line (Cyan) -->
                    <Rectangle x:Name="PlayheadLine"
                               Width="2"
                               Fill="{StaticResource PlayheadBrush}"
                               IsHitTestVisible="False"
                               Canvas.Top="0"/>

                    <!-- Playhead Triangle at Top -->
                    <Polygon x:Name="PlayheadTriangle"
                             Fill="{StaticResource PlayheadBrush}"
                             IsHitTestVisible="False"
                             Points="0,0 10,0 5,8"/>

                    <!-- Context Menu -->
                    <Canvas.ContextMenu>
                        <ContextMenu x:Name="ClipsContextMenu">
                            <MenuItem Header="Add MIDI Clip" Click="AddMidiClip_Click"/>
                            <MenuItem Header="Add Audio Clip" Click="AddAudioClip_Click"/>
                            <Separator/>
                            <MenuItem Header="Paste" Click="Paste_Click" InputGestureText="Ctrl+V"/>
                            <Separator/>
                            <MenuItem x:Name="LoopMenuItem" Header="Set Loop Region" Click="SetLoopRegion_Click"/>
                            <MenuItem Header="Clear Loop Region" Click="ClearLoopRegion_Click"/>
                        </ContextMenu>
                    </Canvas.ContextMenu>
                </Canvas>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
