<UserControl x:Class="MusicEngineEditor.Controls.Network.OSCControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Network"
             xmlns:vm="clr-namespace:MusicEngineEditor.ViewModels.Network"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="450"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#181818"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#808080"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D9FF"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="LearnActiveBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="InMessageBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="OutMessageBrush" Color="#00D9FF"/>

        <!-- Base Button Style -->
        <Style x:Key="OSCButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button Style -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource OSCButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#0D0D0D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="OSCToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="OSCTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="OSCComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#151515"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Mapping List Item Template -->
        <DataTemplate x:Key="MappingItemTemplate">
            <Border x:Name="ItemBorder"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Indicator -->
                    <Border Grid.Column="0"
                            Width="4"
                            CornerRadius="2"
                            Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLearning}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource LearnActiveBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- Mapping Info -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding AddressPattern}"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="{StaticResource ForegroundBrush}"/>
                        <TextBlock Text="{Binding ParameterName}"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding RangeDisplay}"
                                   FontSize="9"
                                   Foreground="{StaticResource SecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Last Value -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource ElementHoverBrush}"
                            CornerRadius="3"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding LastValue, StringFormat='{}{0:F2}'}"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLearning}" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#1A1A1A"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Message List Item Template -->
        <DataTemplate x:Key="MessageItemTemplate">
            <Border Background="Transparent"
                    Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Timestamp -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}"
                               Foreground="{StaticResource SecondaryBrush}"
                               FontSize="9"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"/>

                    <!-- Direction Badge -->
                    <Border Grid.Column="1"
                            CornerRadius="2"
                            Padding="4,1"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource InMessageBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Direction}" Value="Out">
                                        <Setter Property="Background" Value="{StaticResource OutMessageBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DirectionDisplay}"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Foreground="#0D0D0D"/>
                    </Border>

                    <!-- Address -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding Address}"
                               Foreground="{StaticResource ForegroundBrush}"
                               FontSize="10"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Arguments -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Arguments}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="10"
                               FontFamily="Consolas"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Connection Settings -->
            <RowDefinition Height="Auto"/>
            <!-- Tab Content -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="OSC Control"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#DFE1E5"/>
                    <TextBlock Text="Open Sound Control Configuration"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Server Toggle -->
                <ToggleButton x:Name="ServerToggle"
                              Grid.Column="1"
                              Content="Server Off"
                              IsChecked="{Binding IsServerEnabled, Mode=TwoWay}"
                              Click="ServerToggle_Click">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource OSCToggleButton}">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="Server On"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- Connection Settings -->
        <Border Grid.Row="1"
                Background="#151515"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Incoming Port -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="INCOMING PORT"
                               Style="{StaticResource SectionHeader}"/>
                    <TextBox x:Name="IncomingPortTextBox"
                             Style="{StaticResource OSCTextBox}"
                             Text="{Binding IncomingPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Outgoing Port -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0">
                    <TextBlock Text="OUTGOING PORT"
                               Style="{StaticResource SectionHeader}"/>
                    <TextBox x:Name="OutgoingPortTextBox"
                             Style="{StaticResource OSCTextBox}"
                             Text="{Binding OutgoingPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Target IP -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock Text="TARGET IP"
                               Style="{StaticResource SectionHeader}"/>
                    <TextBox x:Name="TargetIPTextBox"
                             Style="{StaticResource OSCTextBox}"
                             Text="{Binding TargetIPAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Connection Status Indicator -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">
                    <Ellipse x:Name="ConnectionIndicator"
                             Width="10" Height="10"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="Listening">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connected">
                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="Error">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="ConnectionStatusText"
                               Text="{Binding StatusText}"
                               Foreground="{StaticResource SecondaryBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Control for Mappings and Monitor -->
        <TabControl Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,2"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Mappings Tab -->
            <TabItem Header="Mappings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Mapping Toolbar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource PanelBrush}"
                            Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add"
                                    Style="{StaticResource OSCButton}"
                                    Command="{Binding AddMappingCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="Remove"
                                    Style="{StaticResource OSCButton}"
                                    Command="{Binding RemoveMappingCommand}"
                                    Margin="0,0,4,0"/>
                            <Button x:Name="LearnButton"
                                    Content="Learn"
                                    Style="{StaticResource OSCButton}"
                                    Click="LearnButton_Click"
                                    Margin="0,0,4,0"/>
                            <Button Content="Cancel Learn"
                                    Style="{StaticResource OSCButton}"
                                    Command="{Binding CancelLearnModeCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Mappings List -->
                    <ListBox x:Name="MappingsList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Mappings}"
                             SelectedItem="{Binding SelectedMapping, Mode=TwoWay}"
                             ItemTemplate="{StaticResource MappingItemTemplate}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#252525"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Mapping Editor -->
                    <Border Grid.Row="2"
                            x:Name="MappingEditorPanel"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="12"
                            Visibility="{Binding SelectedMapping, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Address Pattern -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="ADDRESS PATTERN"
                                           Style="{StaticResource SectionHeader}"/>
                                <TextBox Style="{StaticResource OSCTextBox}"
                                         Text="{Binding SelectedMapping.AddressPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Parameter Name -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="PARAMETER NAME"
                                           Style="{StaticResource SectionHeader}"/>
                                <TextBox Style="{StaticResource OSCTextBox}"
                                         Text="{Binding SelectedMapping.ParameterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- OSC Range -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="OSC VALUE RANGE"
                                           Style="{StaticResource SectionHeader}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource OSCTextBox}"
                                             Text="{Binding SelectedMapping.OscMinValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"/>
                                    <TextBlock Grid.Column="1"
                                               Text=" - "
                                               Foreground="{StaticResource SecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2"
                                             Style="{StaticResource OSCTextBox}"
                                             Text="{Binding SelectedMapping.OscMaxValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Parameter Range -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="PARAMETER RANGE"
                                           Style="{StaticResource SectionHeader}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource OSCTextBox}"
                                             Text="{Binding SelectedMapping.ParameterMinValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"/>
                                    <TextBlock Grid.Column="1"
                                               Text=" - "
                                               Foreground="{StaticResource SecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2"
                                             Style="{StaticResource OSCTextBox}"
                                             Text="{Binding SelectedMapping.ParameterMaxValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Enabled Checkbox -->
                            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Enabled"
                                      IsChecked="{Binding SelectedMapping.IsEnabled, Mode=TwoWay}"
                                      Foreground="{StaticResource ForegroundBrush}"
                                      Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Monitor Tab -->
            <TabItem Header="Monitor">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Monitor Toolbar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource PanelBrush}"
                            Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Filter -->
                            <TextBox x:Name="FilterTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource OSCTextBox}"
                                     Text="{Binding MessageFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Tag>Filter messages...</TextBox.Tag>
                            </TextBox>

                            <Button Grid.Column="1"
                                    Content="Clear"
                                    Style="{StaticResource OSCButton}"
                                    Command="{Binding ClearLogCommand}"
                                    Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Message List -->
                    <ListBox x:Name="MessageListBox"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Messages}"
                             ItemTemplate="{StaticResource MessageItemTemplate}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Send Test Message -->
                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Style="{StaticResource OSCTextBox}"
                                     Text="{Binding TestMessageAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource OSCTextBox}"
                                     Text="{Binding TestMessageValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="4,0"/>
                            <Button Grid.Column="2"
                                    Content="Send"
                                    Style="{StaticResource AccentButton}"
                                    Command="{Binding SendTestMessageCommand}"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Presets Tab -->
            <TabItem Header="Presets">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Presets Toolbar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource PanelBrush}"
                            Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save Current"
                                    Style="{StaticResource OSCButton}"
                                    Command="{Binding SavePresetCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="Load"
                                    Style="{StaticResource OSCButton}"
                                    Command="{Binding LoadPresetCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="Delete"
                                    Style="{StaticResource OSCButton}"
                                    Command="{Binding DeletePresetCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="Refresh"
                                    Style="{StaticResource OSCButton}"
                                    Command="{Binding RefreshPresetsCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Presets List -->
                    <ListBox Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Presets}"
                             SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#252525"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- No Presets Message -->
                    <TextBlock Grid.Row="1"
                               Text="No presets saved"
                               Foreground="{StaticResource SecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Visibility="{Binding Presets.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Text -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource SecondaryBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"/>

                <!-- Message Counts -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0">
                    <TextBlock Text="IN: "
                               Foreground="{StaticResource SecondaryBrush}"
                               FontSize="10"/>
                    <TextBlock Text="{Binding MessagesReceivedCount}"
                               Foreground="{StaticResource InMessageBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="OUT: "
                               Foreground="{StaticResource SecondaryBrush}"
                               FontSize="10"/>
                    <TextBlock Text="{Binding MessagesSentCount}"
                               Foreground="{StaticResource OutMessageBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
