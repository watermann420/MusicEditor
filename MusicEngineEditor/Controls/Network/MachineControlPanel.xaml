<UserControl x:Class="MusicEngineEditor.Controls.Network.MachineControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Network"
             xmlns:vm="clr-namespace:MusicEngineEditor.ViewModels.Network"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance Type=vm:MachineControlPanelViewModel}"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Color Definitions -->
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#181818"/>
        <SolidColorBrush x:Key="DarkBackgroundBrush" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D9FF"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#007A8F"/>
        <SolidColorBrush x:Key="RecordBrush" Color="#FF4757"/>
        <SolidColorBrush x:Key="PlayBrush" Color="#00CC66"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFA500"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#808080"/>
        <SolidColorBrush x:Key="LockedBrush" Color="#00CC66"/>
        <SolidColorBrush x:Key="SearchingBrush" Color="#FFA500"/>
        <SolidColorBrush x:Key="UnlockedBrush" Color="#FF4757"/>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Transport Button Style -->
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#353535"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play Button Style -->
        <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Background" Value="#1A4D33"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Background" Value="#2D8B57"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Record Button Style -->
        <Style x:Key="RecordButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Background" Value="#4D1A1A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Background" Value="#CC3333"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#353535"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Button Style -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#353535"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Timecode TextBox Style -->
        <Style x:Key="TimecodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Code, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Numeric UpDown Style for Spinner -->
        <Style x:Key="SpinnerTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Code, Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="30"/>
        </Style>

        <!-- Spin Button Style -->
        <Style x:Key="SpinButtonStyle" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#353535"/>
                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Timecode Display -->
                <RowDefinition Height="Auto"/>
                <!-- Transport Controls -->
                <RowDefinition Height="Auto"/>
                <!-- MTC Section -->
                <RowDefinition Height="Auto"/>
                <!-- MMC Section -->
                <RowDefinition Height="Auto"/>
                <!-- MIDI Ports -->
                <RowDefinition Height="Auto"/>
                <!-- Status Bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Machine Control"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ForegroundBrush}"/>
                        <TextBlock Text="MMC/MTC"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Sync Status Indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="SyncIndicator" Width="10" Height="10" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource UnlockedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SyncStatus}" Value="Locked">
                                            <Setter Property="Fill" Value="{StaticResource LockedBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SyncStatus}" Value="Searching">
                                            <Setter Property="Fill" Value="{StaticResource SearchingBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding SyncStatusText}"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource UnlockedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SyncStatus}" Value="Locked">
                                            <Setter Property="Foreground" Value="{StaticResource LockedBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SyncStatus}" Value="Searching">
                                            <Setter Property="Foreground" Value="{StaticResource SearchingBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Timecode Display -->
            <Border Grid.Row="1"
                    Background="{DynamicResource InputBackgroundBrush}"
                    Margin="12,12,12,0"
                    CornerRadius="6"
                    Padding="16,12">
                <StackPanel>
                    <!-- Main Timecode -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding TimecodeDisplay}"
                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"/>

                        <!-- Frame Rate Display -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource ElementHoverBrush}"
                                CornerRadius="3"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding FrameRateValue, StringFormat={}{0} fps}"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryForegroundBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Chase Lock Indicator -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Visibility="{Binding MtcReceiverEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{Binding IsChaseLocked, Converter={StaticResource BoolToChaseColorConverter}}"
                                CornerRadius="2"
                                Padding="8,2">
                            <TextBlock Text="{Binding IsChaseLocked, Converter={StaticResource BoolToChaseLabelConverter}}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Transport Controls -->
            <Border Grid.Row="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    Margin="12,12,12,0"
                    Padding="0">
                <StackPanel>
                    <TextBlock Text="TRANSPORT" Style="{StaticResource SectionHeaderStyle}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Rewind -->
                        <Button Style="{StaticResource TransportButtonStyle}"
                                Command="{Binding RewindCommand}"
                                ToolTip="Rewind (MMC)"
                                Margin="0,0,4,0">
                            <Path Data="M 2,8 L 2,16 M 4,12 L 10,8 L 10,16 Z M 10,12 L 16,8 L 16,16 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="18" Height="14"/>
                        </Button>

                        <!-- Stop -->
                        <Button Style="{StaticResource TransportButtonStyle}"
                                Command="{Binding StopCommand}"
                                ToolTip="Stop (MMC)"
                                Margin="4,0">
                            <Rectangle Width="14" Height="14"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>

                        <!-- Play -->
                        <Button Style="{StaticResource PlayButtonStyle}"
                                Command="{Binding PlayCommand}"
                                ToolTip="Play (MMC)"
                                Margin="4,0">
                            <Path Data="M 0,0 L 16,10 L 0,20 Z"
                                  Fill="{StaticResource PlayBrush}"
                                  Stretch="Uniform" Width="14" Height="16"/>
                        </Button>

                        <!-- Record -->
                        <Button Style="{StaticResource RecordButtonStyle}"
                                Command="{Binding RecordCommand}"
                                ToolTip="Record (MMC)"
                                Margin="4,0">
                            <Ellipse Width="16" Height="16" Fill="{StaticResource RecordBrush}"/>
                        </Button>

                        <!-- Fast Forward -->
                        <Button Style="{StaticResource TransportButtonStyle}"
                                Command="{Binding FastForwardCommand}"
                                ToolTip="Fast Forward (MMC)"
                                Margin="4,0,0,0">
                            <Path Data="M 0,8 L 0,16 L 6,12 Z M 6,8 L 6,16 L 12,12 Z M 14,8 L 14,16"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="18" Height="14"/>
                        </Button>
                    </StackPanel>

                    <!-- Locate Controls -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource TimecodeTextBoxStyle}"
                                 Text="{Binding LocateTimecode, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Enter timecode (HH:MM:SS:FF)"
                                 Margin="0,0,8,0"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource SmallButtonStyle}"
                                Content="LOCATE"
                                Command="{Binding LocateCommand}"
                                ToolTip="Go to specified timecode"
                                Padding="12,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- MTC Section -->
            <Border Grid.Row="3"
                    Background="{StaticResource PanelBackgroundBrush}"
                    Margin="12,12,12,0"
                    Padding="0">
                <StackPanel>
                    <TextBlock Text="MIDI TIME CODE (MTC)" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Frame Rate Selector -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Frame Rate:"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <ComboBox Grid.Column="1"
                                  x:Name="FrameRateComboBox"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  SelectedValue="{Binding SelectedFrameRate}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="24 fps" Tag="{x:Static vm:MtcFrameRate.Fps24}"/>
                            <ComboBoxItem Content="25 fps" Tag="{x:Static vm:MtcFrameRate.Fps25}" IsSelected="True"/>
                            <ComboBoxItem Content="29.97 fps (Drop)" Tag="{x:Static vm:MtcFrameRate.Fps2997}"/>
                            <ComboBoxItem Content="30 fps" Tag="{x:Static vm:MtcFrameRate.Fps30}"/>
                        </ComboBox>
                    </Grid>

                    <!-- MTC Generator/Receiver Toggles -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ToggleButton Grid.Column="0"
                                      Style="{StaticResource ToggleButtonStyle}"
                                      IsChecked="{Binding MtcGeneratorEnabled}"
                                      Content="MTC SEND"
                                      ToolTip="Enable MTC Generation (send timecode)"
                                      Margin="0,0,4,0"/>

                        <ToggleButton Grid.Column="1"
                                      Style="{StaticResource ToggleButtonStyle}"
                                      IsChecked="{Binding MtcReceiverEnabled}"
                                      Content="MTC CHASE"
                                      ToolTip="Enable MTC Chase (receive/sync to external timecode)"
                                      Margin="4,0,0,0"/>
                    </Grid>

                    <!-- Offset Controls -->
                    <Border Background="{DynamicResource BackgroundBrush}"
                            CornerRadius="4"
                            Margin="0,12,0,0"
                            Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Offset:"
                                           Foreground="{StaticResource SecondaryForegroundBrush}"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding OffsetDisplay}"
                                           FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                           FontSize="14"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,6,0,0">
                                <Button Style="{StaticResource SmallButtonStyle}"
                                        Content="Reset"
                                        Command="{Binding ResetOffsetCommand}"
                                        ToolTip="Reset offset to 00:00:00:00"
                                        Margin="0,0,4,0"/>
                                <Button Style="{StaticResource SmallButtonStyle}"
                                        Content="Set Current"
                                        Command="{Binding SetCurrentAsOffsetCommand}"
                                        ToolTip="Set current timecode as offset"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- MMC Section -->
            <Border Grid.Row="4"
                    Background="{StaticResource PanelBackgroundBrush}"
                    Margin="12,12,12,0"
                    Padding="0">
                <StackPanel>
                    <TextBlock Text="MIDI MACHINE CONTROL (MMC)" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Device ID -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Device ID:"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <Slider Grid.Column="1"
                                x:Name="DeviceIdSlider"
                                Minimum="0"
                                Maximum="127"
                                Value="{Binding DeviceId}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding DeviceId, StringFormat={}{0}}"
                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                   FontSize="12"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Width="30"
                                   TextAlignment="Right"/>
                    </Grid>

                    <TextBlock Text="(127 = All Devices)"
                               FontSize="9"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,8"/>

                    <!-- MMC Send/Receive Toggles -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ToggleButton Grid.Column="0"
                                      Style="{StaticResource ToggleButtonStyle}"
                                      IsChecked="{Binding MmcSendEnabled}"
                                      Content="MMC SEND"
                                      ToolTip="Send MMC commands to external devices"
                                      Margin="0,0,4,0"/>

                        <ToggleButton Grid.Column="1"
                                      Style="{StaticResource ToggleButtonStyle}"
                                      IsChecked="{Binding MmcReceiveEnabled}"
                                      Content="MMC RECEIVE"
                                      ToolTip="Receive and respond to MMC commands"
                                      Margin="4,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- MIDI Ports Section -->
            <Border Grid.Row="5"
                    Background="{StaticResource PanelBackgroundBrush}"
                    Margin="12,12,12,0"
                    Padding="0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="MIDI PORTS" Style="{StaticResource SectionHeaderStyle}"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource SmallButtonStyle}"
                                Content="Refresh"
                                Command="{Binding RefreshMidiPortsCommand}"
                                ToolTip="Refresh MIDI port list"
                                Margin="0,0,0,8"/>
                    </Grid>

                    <!-- Input Port -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Input:"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding MidiInputPorts}"
                                  SelectedItem="{Binding SelectedMidiInputPort}"
                                  DisplayMemberPath="Name"/>
                    </Grid>

                    <!-- Output Port -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Output:"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding MidiOutputPorts}"
                                  SelectedItem="{Binding SelectedMidiOutputPort}"
                                  DisplayMemberPath="Name"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="6"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,12,0,0"
                    Padding="12,8">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource SecondaryForegroundBrush}"
                           FontSize="10"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
