<UserControl x:Class="MusicEngineEditor.Controls.Network.NetworkSyncPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Network"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="400"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Dark theme colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="SecondaryTextColor">#808080</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="HeaderColor">#181818</Color>
        <Color x:Key="SuccessColor">#00CC66</Color>
        <Color x:Key="WarningColor">#FFB800</Color>
        <Color x:Key="ErrorColor">#FF4757</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

        <!-- Master enable toggle button style -->
        <Style x:Key="MasterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accordion header style -->
        <Style x:Key="AccordionToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Expand/Collapse indicator -->
                                <TextBlock x:Name="ExpandIndicator"
                                           Grid.Column="0"
                                           Text="+"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>

                                <!-- Status indicator placeholder -->
                                <ContentPresenter x:Name="StatusContent"
                                                  Grid.Column="2"
                                                  ContentSource="Tag"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="8,0"/>

                                <!-- Connection indicator -->
                                <Ellipse x:Name="StatusIndicator"
                                         Grid.Column="3"
                                         Width="8" Height="8"
                                         Fill="{StaticResource SecondaryTextBrush}"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandIndicator" Property="Text" Value="-"/>
                                <Setter TargetName="border" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1F1F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section panel style -->
        <Style x:Key="SectionContentStyle" TargetType="Border">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Status indicator style -->
        <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="{StaticResource SecondaryTextBrush}"/>
        </Style>

        <!-- Feature toggle style -->
        <Style x:Key="FeatureToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action button style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#303030"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style -->
        <Style x:Key="NetworkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- TextBox style -->
        <Style x:Key="NetworkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- Peer item style -->
        <Style x:Key="PeerItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#303030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boolean to visibility converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Network / Sync"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="GlobalStatusText"
                               Text="All features disabled"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Global Network Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="GlobalStatusBadge"
                            CornerRadius="10"
                            Padding="8,4"
                            Background="#2D2D2D"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="GlobalStatusIndicator"
                                     Width="6" Height="6"
                                     Fill="{StaticResource SecondaryTextBrush}"
                                     Margin="0,0,6,0"/>
                            <TextBlock x:Name="GlobalStatusLabel"
                                       Text="Offline"
                                       FontSize="10"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Border>

                    <ToggleButton x:Name="MasterEnableToggle"
                                  Content="Enable All"
                                  Style="{StaticResource MasterToggleStyle}"
                                  Click="MasterEnableToggle_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content - Scrollable Accordion -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Network Interface Selector -->
                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Network Interface:"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <ComboBox x:Name="NetworkInterfaceComboBox"
                                  Grid.Column="1"
                                  Style="{StaticResource NetworkComboBoxStyle}"
                                  SelectionChanged="NetworkInterfaceComboBox_SelectionChanged"/>
                    </Grid>
                </Border>

                <!-- Ableton Link Section -->
                <StackPanel>
                    <ToggleButton x:Name="LinkSectionToggle"
                                  Style="{StaticResource AccordionToggleStyle}"
                                  IsChecked="True"
                                  Click="SectionToggle_Click">
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ableton Link"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="LinkPeerCountLabel"
                                           Text="(0 peers)"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <Border x:Name="LinkSectionContent"
                            Style="{StaticResource SectionContentStyle}">
                        <StackPanel>
                            <!-- Link Enable Toggle -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Enable Link Sync"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="Sync tempo and transport with other Link-enabled apps"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <ToggleButton x:Name="LinkEnableToggle"
                                              Grid.Column="1"
                                              Content="OFF"
                                              Style="{StaticResource FeatureToggleStyle}"
                                              Width="50"
                                              Click="LinkEnableToggle_Click"/>
                            </Grid>

                            <!-- Link Status -->
                            <Border Background="{DynamicResource PianoRollBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="10"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="Tempo"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="LinkTempoLabel"
                                                   Text="120.00"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="BPM"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="Peers"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="LinkPeersLabel"
                                                   Text="0"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Connected"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Beat"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="LinkBeatLabel"
                                                   Text="1.1"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Position"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Link Options -->
                            <CheckBox x:Name="LinkStartStopSyncCheck"
                                      Content="Enable Start/Stop Sync"
                                      Foreground="{StaticResource TextBrush}"
                                      IsChecked="True"
                                      FontSize="11"
                                      Margin="0,0,0,6"
                                      Click="LinkStartStopSyncCheck_Click"/>

                            <CheckBox x:Name="LinkTempoFollowCheck"
                                      Content="Follow tempo changes from peers"
                                      Foreground="{StaticResource TextBrush}"
                                      IsChecked="True"
                                      FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- OSC Control Section -->
                <StackPanel>
                    <ToggleButton x:Name="OscSectionToggle"
                                  Style="{StaticResource AccordionToggleStyle}"
                                  IsChecked="False"
                                  Click="SectionToggle_Click">
                        <ToggleButton.Content>
                            <TextBlock Text="OSC Control" FontWeight="SemiBold"/>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <Border x:Name="OscSectionContent"
                            Style="{StaticResource SectionContentStyle}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <!-- OSC Enable Toggle -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Enable OSC Server"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="Receive OSC messages from controllers (TouchOSC, etc)"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <ToggleButton x:Name="OscEnableToggle"
                                              Grid.Column="1"
                                              Content="OFF"
                                              Style="{StaticResource FeatureToggleStyle}"
                                              Width="50"
                                              Click="OscEnableToggle_Click"/>
                            </Grid>

                            <!-- OSC Port Settings -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Listen Port"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="0,0,8,4"/>
                                <TextBox x:Name="OscListenPortInput"
                                         Grid.Row="1" Grid.Column="0"
                                         Style="{StaticResource NetworkTextBoxStyle}"
                                         Text="8000"
                                         Margin="0,0,8,0"/>

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="Feedback Port"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="OscFeedbackPortInput"
                                         Grid.Row="1" Grid.Column="1"
                                         Style="{StaticResource NetworkTextBoxStyle}"
                                         Text="9000"/>
                            </Grid>

                            <!-- OSC Feedback Host -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Feedback Host"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="OscFeedbackHostInput"
                                         Style="{StaticResource NetworkTextBoxStyle}"
                                         Text="127.0.0.1"/>
                            </StackPanel>

                            <!-- OSC Template -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Controller Template"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="OscTemplateComboBox"
                                          Style="{StaticResource NetworkComboBoxStyle}">
                                    <ComboBoxItem Content="Custom" IsSelected="True"/>
                                    <ComboBoxItem Content="TouchOSC Mixer"/>
                                    <ComboBoxItem Content="Lemur Mixer"/>
                                    <ComboBoxItem Content="Generic XY Controller"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Content="Configure Mappings..."
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="OscConfigureMappings_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Network MIDI Section -->
                <StackPanel>
                    <ToggleButton x:Name="MidiSectionToggle"
                                  Style="{StaticResource AccordionToggleStyle}"
                                  IsChecked="False"
                                  Click="SectionToggle_Click">
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Network MIDI"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="MidiSessionCountLabel"
                                           Text="(0 sessions)"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <Border x:Name="MidiSectionContent"
                            Style="{StaticResource SectionContentStyle}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <!-- Network MIDI Enable Toggle -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Enable RTP-MIDI"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="Share MIDI over the network with other devices"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <ToggleButton x:Name="NetworkMidiEnableToggle"
                                              Grid.Column="1"
                                              Content="OFF"
                                              Style="{StaticResource FeatureToggleStyle}"
                                              Width="50"
                                              Click="NetworkMidiEnableToggle_Click"/>
                            </Grid>

                            <!-- Session Name -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Session Name"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="MidiSessionNameInput"
                                         Style="{StaticResource NetworkTextBoxStyle}"
                                         Text="MusicEngine MIDI"/>
                            </StackPanel>

                            <!-- Discovered Sessions -->
                            <TextBlock Text="Discovered Sessions"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="10"
                                       Margin="0,0,0,4"/>

                            <Border Background="{DynamicResource PianoRollBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="0"
                                    Height="120"
                                    Margin="0,0,0,12">
                                <ListBox x:Name="MidiSessionsList"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerStyle="{StaticResource PeerItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0"
                                                         Width="6" Height="6"
                                                         Fill="{Binding StatusBrush}"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Host}"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Connect"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="MidiConnect_Click"
                                        Margin="0,0,8,0"/>
                                <Button Content="Open Dialog..."
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="MidiOpenDialog_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Machine Control (MMC/MTC) Section -->
                <StackPanel>
                    <ToggleButton x:Name="MmcSectionToggle"
                                  Style="{StaticResource AccordionToggleStyle}"
                                  IsChecked="False"
                                  Click="SectionToggle_Click">
                        <ToggleButton.Content>
                            <TextBlock Text="Machine Control (MMC/MTC)" FontWeight="SemiBold"/>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <Border x:Name="MmcSectionContent"
                            Style="{StaticResource SectionContentStyle}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <!-- MMC Enable Toggle -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Enable MMC"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="MIDI Machine Control for transport sync"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <ToggleButton x:Name="MmcEnableToggle"
                                              Grid.Column="1"
                                              Content="OFF"
                                              Style="{StaticResource FeatureToggleStyle}"
                                              Width="50"
                                              Click="MmcEnableToggle_Click"/>
                            </Grid>

                            <!-- MTC Enable Toggle -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Enable MTC"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="11"/>
                                    <TextBlock Text="MIDI Timecode for precise sync"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <ToggleButton x:Name="MtcEnableToggle"
                                              Grid.Column="1"
                                              Content="OFF"
                                              Style="{StaticResource FeatureToggleStyle}"
                                              Width="50"
                                              Click="MtcEnableToggle_Click"/>
                            </Grid>

                            <!-- MTC Frame Rate -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="MTC Frame Rate"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="MtcFrameRateComboBox"
                                          Style="{StaticResource NetworkComboBoxStyle}"
                                          SelectionChanged="MtcFrameRateComboBox_SelectionChanged">
                                    <ComboBoxItem Content="24 fps"/>
                                    <ComboBoxItem Content="25 fps"/>
                                    <ComboBoxItem Content="29.97 fps (Drop Frame)" IsSelected="True"/>
                                    <ComboBoxItem Content="30 fps"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Timecode Display -->
                            <Border Background="{DynamicResource PianoRollBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="12"
                                    Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Current Timecode"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="9"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TimecodeDisplay"
                                               Text="00:00:00:00"
                                               FontFamily="Consolas"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- MMC Device ID -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="MMC Device ID"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="0,0,8,4"/>
                                <ComboBox x:Name="MmcDeviceIdComboBox"
                                          Grid.Row="1" Grid.Column="0"
                                          Style="{StaticResource NetworkComboBoxStyle}"
                                          Margin="0,0,8,0">
                                    <ComboBoxItem Content="All Devices (7F)" IsSelected="True"/>
                                    <ComboBoxItem Content="Device 1"/>
                                    <ComboBoxItem Content="Device 2"/>
                                    <ComboBoxItem Content="Custom..."/>
                                </ComboBox>

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="Mode"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="MmcModeComboBox"
                                          Grid.Row="1" Grid.Column="1"
                                          Style="{StaticResource NetworkComboBoxStyle}">
                                    <ComboBoxItem Content="Master" IsSelected="True"/>
                                    <ComboBoxItem Content="Slave"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusBarText"
                           Grid.Column="0"
                           Text="Ready"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Content="Refresh"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="RefreshButton_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="SettingsButton"
                            Content="Settings"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
