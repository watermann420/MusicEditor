<UserControl x:Class="MusicEngineEditor.Controls.Network.NetworkMIDIPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Network"
             xmlns:vm="clr-namespace:MusicEngineEditor.ViewModels.Network"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="450"
             Background="#0D0D0D">

    <UserControl.Resources>
        <!-- Color Definitions -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="AccentDarkColor">#0099B3</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="TextPrimaryColor">#E0E0E0</Color>
        <Color x:Key="TextSecondaryColor">#808080</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="WarningColor">#FFB800</Color>
        <Color x:Key="ErrorColor">#FF4757</Color>
        <Color x:Key="HoverColor">#252525</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track"
                                Background="#3C3F44"
                                CornerRadius="11"
                                BorderThickness="0">
                            <Grid>
                                <Ellipse x:Name="thumb"
                                         Width="18" Height="18"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         Margin="2,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="PortComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Session List Item Style -->
        <Style x:Key="SessionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Peer List Item Style -->
        <Style x:Key="PeerItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Activity Indicator Style -->
        <Style x:Key="ActivityIndicatorStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="#3C3F44"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Channel CheckBox Style -->
        <Style x:Key="ChannelCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16">
                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Network MIDI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="RTP-MIDI / Network MIDI"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Enable Toggle -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Enable"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ToggleButton x:Name="EnableToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding IsNetworkMidiEnabled, Mode=TwoWay}"
                                      Click="EnableToggle_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Bonjour/mDNS Status -->
                <Border Background="{StaticResource PanelBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0"
                                 Width="8" Height="8"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBonjourAvailable}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Bonjour/mDNS Discovery"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding BonjourStatus}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <ProgressBar Grid.Column="2"
                                     IsIndeterminate="True"
                                     Width="60" Height="3"
                                     Visibility="{Binding IsDiscovering, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Session Name Input -->
                <Border Background="{StaticResource PanelBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SESSION NAME" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBox x:Name="SessionNameInput"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding SessionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <!-- Session Actions -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Create Session"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CreateSessionCommand}"
                            IsEnabled="{Binding IsNetworkMidiEnabled}"/>

                    <Button Grid.Column="2"
                            Content="Leave Session"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding LeaveSessionCommand}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>

                <!-- Available Sessions -->
                <Border Background="{StaticResource PanelBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="AVAILABLE SESSIONS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>

                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,4"
                                    FontSize="10"
                                    Command="{Binding RefreshSessionsCommand}"
                                    Click="RefreshButton_Click"/>
                        </Grid>

                        <!-- Session List -->
                        <ListBox x:Name="AvailableSessionsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="150"
                                 ItemsSource="{Binding AvailableSessions}"
                                 SelectedItem="{Binding SelectedAvailableSession, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource SessionItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding SessionName}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding HostAddress}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0">
                                            <TextBlock Text="{Binding LatencyMs}"
                                                       FontSize="10"
                                                       Foreground="{Binding LatencyBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text=" ms"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{StaticResource AccentBrush}"
                                                CornerRadius="8"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding PeerCount}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State -->
                        <TextBlock Text="No sessions found"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AvailableSessions.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Join Button -->
                        <Button Content="Join Selected Session"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding JoinSessionCommand}"
                                IsEnabled="{Binding SelectedAvailableSession, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>

                <!-- Connected Sessions -->
                <Border Background="{StaticResource PanelBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="CONNECTED PEERS" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding CurrentSessionName}"
                                           FontSize="10"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Peer List -->
                        <ListBox Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="120"
                                 ItemsSource="{Binding ConnectedPeers}"
                                 ItemContainerStyle="{StaticResource PeerItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0"
                                                 Width="8" Height="8"
                                                 Fill="{Binding StatusBrush}"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding IpAddress}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding LatencyDisplay}"
                                                   FontSize="10"
                                                   Foreground="{Binding LatencyBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- MIDI Activity and Statistics -->
                <Border Background="{StaticResource PanelBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MIDI ACTIVITY" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- MIDI In -->
                            <Border Grid.Column="0"
                                    Background="#0D0D0D"
                                    CornerRadius="4"
                                    Padding="12"
                                    Margin="0,0,4,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse x:Name="MidiInIndicator"
                                                 Width="10" Height="10"
                                                 Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#3C3F44"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MidiInActive}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="MIDI In"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding TotalMessagesIn}"/>
                                    <TextBlock Text="messages"
                                               FontSize="9"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- MIDI Out -->
                            <Border Grid.Column="1"
                                    Background="#0D0D0D"
                                    CornerRadius="4"
                                    Padding="12"
                                    Margin="4,0,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse x:Name="MidiOutIndicator"
                                                 Width="10" Height="10"
                                                 Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#3C3F44"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MidiOutActive}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="MIDI Out"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding TotalMessagesOut}"/>
                                    <TextBlock Text="messages"
                                               FontSize="9"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Connection Quality -->
                        <Border Background="#0D0D0D"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Connection Quality"
                                               FontSize="11"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}">
                                        <TextBlock.Text>
                                            <Binding Path="AverageLatencyMs" StringFormat="Avg Latency: {0} ms"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Quality Indicator -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="QualityBar1" Width="8" Height="16" CornerRadius="2" Margin="1,0" Background="#3C3F44"/>
                                    <Border x:Name="QualityBar2" Width="8" Height="16" CornerRadius="2" Margin="1,0" Background="#3C3F44"/>
                                    <Border x:Name="QualityBar3" Width="8" Height="16" CornerRadius="2" Margin="1,0" Background="#3C3F44"/>
                                    <Border x:Name="QualityBar4" Width="8" Height="16" CornerRadius="2" Margin="1,0" Background="#3C3F44"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Virtual Port Selection -->
                <Border Background="{StaticResource PanelBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="VIRTUAL PORTS" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Input Port"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource PortComboBoxStyle}"
                                          ItemsSource="{Binding InputPorts}"
                                          SelectedItem="{Binding SelectedInputPort, Mode=TwoWay}"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Output Port"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource PortComboBoxStyle}"
                                          ItemsSource="{Binding OutputPorts}"
                                          SelectedItem="{Binding SelectedOutputPort, Mode=TwoWay}"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Channel Filtering -->
                <Border Background="{StaticResource PanelBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="CHANNEL FILTERING" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>

                            <CheckBox Grid.Column="1"
                                      Content="All Channels"
                                      Style="{StaticResource ChannelCheckBoxStyle}"
                                      IsChecked="{Binding FilterAllChannels, Mode=TwoWay}"
                                      Click="AllChannelsCheckBox_Click"/>
                        </Grid>

                        <Border Background="#0D0D0D"
                                CornerRadius="4"
                                Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" Content="Ch 1" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel1Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" Content="Ch 2" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel2Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                                <CheckBox Grid.Row="0" Grid.Column="2" Content="Ch 3" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel3Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                                <CheckBox Grid.Row="0" Grid.Column="3" Content="Ch 4" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel4Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>

                                <CheckBox Grid.Row="1" Grid.Column="0" Content="Ch 5" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel5Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" Content="Ch 6" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel6Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                                <CheckBox Grid.Row="1" Grid.Column="2" Content="Ch 7" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel7Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                                <CheckBox Grid.Row="1" Grid.Column="3" Content="Ch 8" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel8Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>

                                <CheckBox Grid.Row="2" Grid.Column="0" Content="Ch 9" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel9Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                                <CheckBox Grid.Row="2" Grid.Column="1" Content="Ch 10" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel10Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                                <CheckBox Grid.Row="2" Grid.Column="2" Content="Ch 11" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel11Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                                <CheckBox Grid.Row="2" Grid.Column="3" Content="Ch 12" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel12Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>

                                <CheckBox Grid.Row="3" Grid.Column="0" Content="Ch 13" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel13Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                                <CheckBox Grid.Row="3" Grid.Column="1" Content="Ch 14" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel14Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                                <CheckBox Grid.Row="3" Grid.Column="2" Content="Ch 15" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel15Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                                <CheckBox Grid.Row="3" Grid.Column="3" Content="Ch 16" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding Channel16Enabled}" IsEnabled="{Binding FilterAllChannels, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- MIDI Routing Options -->
                <Border Background="{StaticResource PanelBrush}"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MIDI ROUTING OPTIONS" Style="{StaticResource SectionHeaderStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <CheckBox Content="Send Clock" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding SendClock}" Margin="0,0,0,4"/>
                                <CheckBox Content="Send Program Changes" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding SendProgramChanges}" Margin="0,0,0,4"/>
                                <CheckBox Content="Send SysEx" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding SendSysEx}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <CheckBox Content="Receive Clock" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding ReceiveClock}" Margin="0,0,0,4"/>
                                <CheckBox Content="Receive Program Changes" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding ReceiveProgramChanges}" Margin="0,0,0,4"/>
                                <CheckBox Content="Receive SysEx" Style="{StaticResource ChannelCheckBoxStyle}" IsChecked="{Binding ReceiveSysEx}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status Bar -->
                <Border Background="{StaticResource PanelBrush}"
                        CornerRadius="4"
                        Padding="12">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Background="#CC0D0D0D"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="100" Height="4"/>
                <TextBlock Text="Please wait..."
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
