<UserControl x:Class="MusicEngineEditor.Controls.Network.LinkSyncPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MusicEngineEditor.Controls.Network"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="380"
             MinHeight="400" MinWidth="320">

    <UserControl.Resources>
        <!-- Theme Colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="PanelColor">#181818</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="ErrorColor">#FF4757</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="WarningColor">#FF9500</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="TextSecondaryColor">#808080</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="HoverColor">#252525</Color>
        <Color x:Key="DownbeatColor">#FF6B6B</Color>
        <Color x:Key="BeatActiveColor">#00D9FF</Color>
        <Color x:Key="BeatInactiveColor">#3A3A3A</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}"/>
        <SolidColorBrush x:Key="DownbeatBrush" Color="{StaticResource DownbeatColor}"/>
        <SolidColorBrush x:Key="BeatActiveBrush" Color="{StaticResource BeatActiveColor}"/>
        <SolidColorBrush x:Key="BeatInactiveBrush" Color="{StaticResource BeatInactiveColor}"/>

        <!-- Converters -->
        <local:LinkBoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:LinkInverseBoolConverter x:Key="InverseBoolConverter"/>
        <local:LinkConnectionStatusToColorConverter x:Key="StatusToColorConverter"/>
        <local:LinkBeatIndicatorToColorConverter x:Key="BeatToColorConverter"/>
        <local:FractionToWidthConverter x:Key="FractionToWidthConverter"/>

        <!-- Link Toggle Button Style -->
        <Style x:Key="LinkToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Toggle Button Style -->
        <Style x:Key="SmallToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transport Button Style -->
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Button Style -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tempo Display Style -->
        <Style x:Key="TempoDisplayStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Peer List Item Template -->
        <DataTemplate x:Key="PeerItemTemplate">
            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10,6"
                    Margin="0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Indicator -->
                    <Ellipse Grid.Column="0"
                             Width="8" Height="8"
                             Fill="{StaticResource SuccessBrush}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>

                    <!-- Peer Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="11"
                                   FontWeight="Medium"/>
                        <TextBlock Text="{Binding PeerId}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9"/>
                    </StackPanel>

                    <!-- Leader Badge -->
                    <Border Grid.Column="2"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="2"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsTempoLeader, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="LEADER"
                                   Foreground="#0D0D0D"
                                   FontSize="8"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Beat Indicator Template -->
        <DataTemplate x:Key="BeatIndicatorTemplate">
            <Border x:Name="BeatBorder"
                    Width="24" Height="24"
                    CornerRadius="12"
                    Margin="3,0"
                    BorderThickness="2"
                    BorderBrush="{StaticResource BorderBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BeatInactiveBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BeatActiveBrush}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsDownbeat}" Value="True"/>
                                    <Condition Binding="{Binding IsActive}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{StaticResource DownbeatBrush}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding DisplayNumber}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="10"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title and Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LINK SYNC"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <!-- Connection Status Indicator -->
                        <Ellipse x:Name="ConnectionIndicator"
                                 Width="10" Height="10"
                                 Margin="10,0,0,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connected">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="Searching">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <TextBlock Text="{Binding ConnectionStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Link Enable Toggle -->
                    <ToggleButton Grid.Column="1"
                                  x:Name="LinkToggle"
                                  Content="LINK"
                                  Style="{StaticResource LinkToggleStyle}"
                                  IsChecked="{Binding IsLinkEnabled, Mode=TwoWay}"
                                  ToolTip="Enable/Disable Ableton Link"/>
                </Grid>
            </Border>

            <!-- Tempo Section -->
            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Session Tempo -->
                    <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="SESSION TEMPO" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="-" Style="{StaticResource SmallButtonStyle}"
                                    Click="DecreaseSessionTempo_Click"
                                    ToolTip="Decrease tempo"/>
                            <TextBlock Text="{Binding SessionTempoFormatted}"
                                       Style="{StaticResource TempoDisplayStyle}"
                                       Margin="8,0"/>
                            <Button Content="+" Style="{StaticResource SmallButtonStyle}"
                                    Click="IncreaseSessionTempo_Click"
                                    ToolTip="Increase tempo"/>
                        </StackPanel>
                        <TextBlock Text="BPM"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Local Tempo -->
                    <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="LOCAL TEMPO" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LocalTempoFormatted}"
                                   Style="{StaticResource TempoDisplayStyle}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="BPM"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="9"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Tempo Lock Toggle -->
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                        <ToggleButton x:Name="TempoLockToggle"
                                      Style="{StaticResource SmallToggleStyle}"
                                      IsChecked="{Binding IsTempoLocked, Mode=TwoWay}"
                                      ToolTip="Lock tempo to follow session">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="FOLLOW SESSION" Margin="0,0,4,0"/>
                                <TextBlock Text="(Locked)"
                                           Visibility="{Binding IsTempoLocked, Converter={StaticResource BoolToVisConverter}}"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Transport / Sync Section -->
            <Border Grid.Row="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Start/Stop Sync Button -->
                    <ToggleButton Grid.Column="0"
                                  x:Name="SyncToggle"
                                  Style="{StaticResource LinkToggleStyle}"
                                  IsChecked="{Binding IsSyncRunning, Mode=TwoWay}"
                                  Width="80"
                                  ToolTip="Start/Stop sync playback">
                        <ToggleButton.Content>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="14" Margin="0,0,6,0">
                                    <!-- Play Icon (shown when not running) -->
                                    <Polygon Points="0,0 12,7 0,14"
                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                             Visibility="{Binding IsSyncRunning, Converter={StaticResource InverseBoolConverter}}"/>
                                    <!-- Stop Icon (shown when running) -->
                                    <Rectangle Width="10" Height="10"
                                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                               Visibility="{Binding IsSyncRunning, Converter={StaticResource BoolToVisConverter}}"/>
                                </Grid>
                                <TextBlock x:Name="SyncButtonText" Text="START"/>
                            </StackPanel>
                        </ToggleButton.Content>
                    </ToggleButton>

                    <!-- Phase Display -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="PHASE" Style="{StaticResource SectionHeaderStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PhaseDisplayText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Start/Stop Sync Enable -->
                    <ToggleButton Grid.Column="2"
                                  x:Name="StartStopSyncToggle"
                                  Style="{StaticResource SmallToggleStyle}"
                                  IsChecked="{Binding IsStartStopSyncEnabled, Mode=TwoWay}"
                                  Content="START/STOP SYNC"
                                  ToolTip="Enable start/stop synchronization"/>
                </Grid>
            </Border>

            <!-- Visual Metronome Section -->
            <Border Grid.Row="3"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="VISUAL METRONOME" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Quantum Selector -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Quantum:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <ComboBox x:Name="QuantumCombo"
                                      Width="50"
                                      FontSize="10"
                                      SelectedItem="{Binding Quantum, Mode=TwoWay}"
                                      ItemsSource="{Binding QuantumOptions}"
                                      ToolTip="Beats per bar for phase alignment"/>
                        </StackPanel>
                    </Grid>

                    <!-- Beat Indicators -->
                    <ItemsControl x:Name="BeatIndicatorsControl"
                                  ItemsSource="{Binding BeatIndicators}"
                                  ItemTemplate="{StaticResource BeatIndicatorTemplate}"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Beat Progress Bar -->
                    <Border Background="{StaticResource BorderBrush}"
                            CornerRadius="2"
                            Height="4"
                            Margin="0,10,0,0"
                            x:Name="BeatProgressContainer">
                        <Border x:Name="BeatProgressBar"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                Width="0"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Latency Section -->
            <Border Grid.Row="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="LATENCY COMPENSATION"
                               Style="{StaticResource SectionHeaderStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="-" Style="{StaticResource SmallButtonStyle}"
                                Click="DecreaseLatency_Click"
                                ToolTip="Decrease latency compensation"/>
                        <TextBlock Text="{Binding LatencyFormatted}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                   Margin="12,0"
                                   VerticalAlignment="Center"/>
                        <Button Content="+" Style="{StaticResource SmallButtonStyle}"
                                Click="IncreaseLatency_Click"
                                ToolTip="Increase latency compensation"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Reset"
                            Style="{StaticResource SmallButtonStyle}"
                            Width="Auto"
                            Padding="8,4"
                            Click="ResetLatency_Click"
                            ToolTip="Reset latency to 0"/>
                </Grid>
            </Border>

            <!-- Peer List Section -->
            <Border Grid.Row="5"
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Peer List Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="CONNECTED PEERS" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Text="{Binding PeerCount, StringFormat=' ({0})'}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,6"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Refresh"
                                Style="{StaticResource SmallButtonStyle}"
                                Width="Auto"
                                Padding="8,4"
                                Click="RefreshPeers_Click"
                                ToolTip="Refresh peer list"/>
                    </Grid>

                    <!-- Peer List -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PeerList"
                                          ItemsSource="{Binding Peers}"
                                          ItemTemplate="{StaticResource PeerItemTemplate}"
                                          Padding="4">
                                <!-- Empty State -->
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Peers.Count}" Value="0">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ItemsControl">
                                                            <TextBlock Text="No peers connected"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       FontSize="11"
                                                                       FontStyle="Italic"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,20"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="6"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,6,6"
                    Padding="12,6">
                <TextBlock x:Name="StatusText"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
