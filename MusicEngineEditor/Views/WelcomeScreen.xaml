<Window x:Class="MusicEngineEditor.Views.WelcomeScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicEngineEditor.Views"
        mc:Ignorable="d"
        Title="Welcome to MusicEngine Editor"
        Height="550" Width="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Value Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:PinnedToStarConverter x:Key="PinnedToStarConverter"/>
        <local:PinnedToColorConverter x:Key="PinnedToColorConverter"/>

        <!-- Pin Button Star Character Converter -->
        <Style x:Key="PinButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFD700"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="Padding" Value="24,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF"/>
                                <Setter Property="Foreground" Value="#0D0D0D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D9FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00A8CC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00A8CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Recent Project Item Style -->
        <Style x:Key="ProjectItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#2A2A2A"
                                Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D9FF30"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox Style -->
        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="checkBorder"
                                    Width="16" Height="16"
                                    Background="#0A0A0A"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0,0,8,0">
                                <Path x:Name="checkMark"
                                      Data="M2,5 L5,8 L10,2"
                                      Stroke="#00D9FF"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="2"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#00D9FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#00D9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Drop Shadow -->
    <Border Background="#0D0D0D"
            CornerRadius="8"
            BorderBrush="#333333"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="30"
                              ShadowDepth="0"
                              Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="#181818"
                    CornerRadius="8,8,0,0"
                    Padding="20,16"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="MusicEngine Editor"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#E0E0E0"/>
                        <TextBlock Text="Welcome"
                                   FontSize="12"
                                   Foreground="#00D9FF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1"
                            Content="&#xE8BB;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Background="Transparent"
                            Foreground="#808080"
                            BorderThickness="0"
                            Padding="8"
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#FF4757"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Left Side: Recent Projects -->
                <Border Grid.Column="0"
                        Background="#0D0D0D"
                        Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Recent Projects Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Recent Projects"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#E0E0E0"/>
                            <TextBlock Text="Double-click to open, click star to pin"
                                       FontSize="11"
                                       Foreground="#606060"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Recent Projects List -->
                        <ListBox x:Name="RecentProjectsList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ProjectItemStyle}"
                                 MouseDoubleClick="RecentProjectsList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Pin Button -->
                                        <Button Grid.Column="0"
                                                Style="{StaticResource PinButtonStyle}"
                                                Click="PinButton_Click"
                                                Tag="{Binding FilePath}"
                                                ToolTip="Pin/Unpin project"
                                                Margin="0,0,8,0">
                                            <Button.Content>
                                                <TextBlock Text="{Binding IsPinned, Converter={StaticResource PinnedToStarConverter}}"
                                                           Foreground="{Binding IsPinned, Converter={StaticResource PinnedToColorConverter}}"/>
                                            </Button.Content>
                                        </Button>

                                        <!-- Project Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E0E0E0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FilePath}"
                                                       FontSize="11"
                                                       Foreground="#606060"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"
                                                       ToolTip="{Binding FilePath}"/>
                                        </StackPanel>

                                        <!-- Modified Date -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Margin="12,0,0,0">
                                            <TextBlock Text="{Binding LastModifiedFormatted}"
                                                       FontSize="11"
                                                       Foreground="#808080"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State -->
                        <StackPanel x:Name="EmptyState"
                                    Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="48"
                                       Foreground="#404040"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="No recent projects"
                                       FontSize="14"
                                       Foreground="#606060"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>
                            <TextBlock Text="Create or open a project to get started"
                                       FontSize="11"
                                       Foreground="#505050"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Vertical Separator -->
                <Border Grid.Column="1"
                        Width="1"
                        Background="#2A2A2A"/>

                <!-- Right Side: Actions -->
                <Border Grid.Column="2"
                        Background="#181818"
                        Padding="24,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Get Started"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#E0E0E0"
                                   Margin="0,0,0,20"/>

                        <!-- New Project Button -->
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Click="NewProject_Click"
                                Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="New Project"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Create a new music project"
                                               FontSize="11"
                                               Foreground="#808080"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Open Project Button -->
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Click="OpenProject_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Open Project"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Browse for existing project"
                                               FontSize="11"
                                               Foreground="#808080"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Border Height="1"
                                Background="#333333"
                                Margin="0,24,0,24"/>

                        <!-- Version Info -->
                        <StackPanel>
                            <TextBlock Text="Version 1.0.0"
                                       FontSize="11"
                                       Foreground="#505050"/>
                            <TextBlock Text="Professional Music Production"
                                       FontSize="11"
                                       Foreground="#404040"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Bar -->
            <Border Grid.Row="2"
                    Background="#141414"
                    CornerRadius="0,0,8,8"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Don't show on startup checkbox -->
                    <CheckBox x:Name="DontShowCheckBox"
                              Content="Don't show this window on startup"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              Checked="DontShowCheckBox_Changed"
                              Unchecked="DontShowCheckBox_Changed"/>

                    <!-- Skip Button -->
                    <Button Grid.Column="1"
                            Content="Skip"
                            Background="Transparent"
                            Foreground="#808080"
                            BorderThickness="1"
                            BorderBrush="#333333"
                            Padding="16,6"
                            Cursor="Hand"
                            Click="SkipButton_Click"
                            ToolTip="Continue without opening a project">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#252525"/>
                                                    <Setter Property="Foreground" Value="#E0E0E0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
