<Window x:Class="MusicEngineEditor.Views.Dialogs.WorkspacePresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicEngineEditor.Views.Dialogs"
        mc:Ignorable="d"
        Title="Workspace Presets"
        Width="900" Height="650"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#0D0D0D"
        Foreground="#E0E0E0">

    <Window.Resources>
        <!-- Theme Colors -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0D0D0D"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#141414"/>
        <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#181818"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="BrightForegroundBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#808080"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D9FF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#5A7FC4"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#00FF88"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#D9A343"/>
        <SolidColorBrush x:Key="RecordingBrush" Color="#FF4444"/>
        <SolidColorBrush x:Key="MixingBrush" Color="#44AAFF"/>
        <SolidColorBrush x:Key="MasteringBrush" Color="#FFD700"/>
        <SolidColorBrush x:Key="EditingBrush" Color="#44FF88"/>
        <SolidColorBrush x:Key="PerformanceBrush" Color="#FF44FF"/>

        <!-- Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource EditorBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Preset Card Style -->
        <Style x:Key="PresetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource EditorBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Background" Value="#1E1E1E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBox Item Style -->
        <Style x:Key="PresetListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:CategoryToBrushConverter x:Key="CategoryToBrushConverter"/>
        <local:ShortcutToVisibilityConverter x:Key="ShortcutToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Workspace Presets" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource BrightForegroundBrush}"/>
                    <TextBlock Text="Switch between different workspace layouts for various workflows"
                               FontSize="12" Foreground="{StaticResource SecondaryForegroundBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SaveCurrentButton" Content="Save Current Layout"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="SaveCurrentButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ImportButton" Content="Import"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="ImportButton_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ExportButton" Content="Export"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="ExportButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="350"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Preset Lists -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Built-in Presets Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Built-in Presets" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource BrightForegroundBrush}"/>
                    <TextBlock Text="(read-only)" FontSize="11"
                               Foreground="{StaticResource SecondaryForegroundBrush}"
                               Margin="8,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Built-in Presets List -->
                <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl x:Name="BuiltInPresetsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PresetCardStyle}"
                                            MouseLeftButtonDown="PresetCard_MouseLeftButtonDown"
                                            MouseLeftButtonUp="PresetCard_MouseLeftButtonUp"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Category Color Bar -->
                                            <Border Grid.Column="0" Width="40" Height="40"
                                                    Background="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}"
                                                    CornerRadius="4" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding IconName}" FontSize="14" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name and Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource BrightForegroundBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{StaticResource SecondaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                            </StackPanel>

                                            <!-- Shortcut -->
                                            <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}"
                                                    CornerRadius="3" Padding="8,4" VerticalAlignment="Center"
                                                    Visibility="{Binding Shortcut, Converter={StaticResource ShortcutToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Shortcut}" FontSize="11" FontFamily="Consolas"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- User Presets Header -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,10">
                    <TextBlock Text="Your Presets" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource BrightForegroundBrush}"/>
                    <Button x:Name="NewPresetButton" Content="+ New"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="NewPresetButton_Click" Margin="12,0,0,0"
                            Padding="8,4" FontSize="11"/>
                </StackPanel>

                <!-- User Presets List -->
                <Border Grid.Row="3" Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl x:Name="UserPresetsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PresetCardStyle}"
                                            MouseLeftButtonDown="PresetCard_MouseLeftButtonDown"
                                            MouseLeftButtonUp="PresetCard_MouseLeftButtonUp"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Thumbnail or Icon -->
                                            <Border Grid.Column="0" Width="40" Height="40"
                                                    Background="{StaticResource AccentBrush}"
                                                    CornerRadius="4" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding IconName}" FontSize="14" FontWeight="Bold"
                                                           Foreground="White" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name and Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource BrightForegroundBrush}"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{StaticResource SecondaryForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                            </StackPanel>

                                            <!-- Shortcut -->
                                            <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}"
                                                    CornerRadius="3" Padding="8,4" VerticalAlignment="Center"
                                                    Margin="8,0"
                                                    Visibility="{Binding Shortcut, Converter={StaticResource ShortcutToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Shortcut}" FontSize="11" FontFamily="Consolas"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                            </Border>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="..." Style="{StaticResource ActionButtonStyle}"
                                                        Padding="8,4" FontWeight="Bold"
                                                        Click="PresetMenuButton_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Right Panel: Details/Preview -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Selected Preset Header -->
                <TextBlock Grid.Row="0" Text="Selected Preset" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource BrightForegroundBrush}" Margin="0,0,0,10"/>

                <!-- Preview Thumbnail -->
                <Border Grid.Row="1" Background="{StaticResource EditorBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Height="120" Margin="0,0,0,15">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4"/>
                        <TextBlock x:Name="NoPreviewText" Text="No Preview Available"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   FontSize="11"/>
                    </Grid>
                </Border>

                <!-- Details Panel -->
                <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="15">
                    <StackPanel x:Name="DetailsPanel">
                        <TextBlock x:Name="DetailNameText" Text="--" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrightForegroundBrush}" Margin="0,0,0,8"/>

                        <TextBlock x:Name="DetailDescriptionText" Text="--" FontSize="12"
                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,15"/>

                        <!-- Layout Info -->
                        <TextBlock Text="Layout Configuration" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Category:" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="11"/>
                            <TextBlock x:Name="DetailCategoryText" Text="--" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Shortcut:" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="11"/>
                            <TextBlock x:Name="DetailShortcutText" Text="--" HorizontalAlignment="Right" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Created:" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="11"/>
                            <TextBlock x:Name="DetailCreatedText" Text="--" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Modified:" Foreground="{StaticResource SecondaryForegroundBrush}" FontSize="11"/>
                            <TextBlock x:Name="DetailModifiedText" Text="--" HorizontalAlignment="Right" FontSize="11"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,15,0,15"/>

                        <!-- Visible Panels -->
                        <TextBlock Text="Visible Panels" FontWeight="SemiBold" FontSize="12"
                                   Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,10"/>
                        <WrapPanel x:Name="VisiblePanelsWrap">
                            <!-- Dynamically populated -->
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Apply Button -->
                <Button Grid.Row="3" x:Name="ApplyButton" Content="Apply Preset"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ApplyButton_Click" Margin="0,15,0,0"
                        Height="40" FontSize="14"/>
            </Grid>
        </Grid>

        <!-- Bottom Button Panel -->
        <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource ActionButtonStyle}"
                        IsCancel="True" Padding="20,8" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Context Menu for User Presets -->
        <Popup x:Name="PresetContextMenu" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" Placement="MousePoint">
            <Border Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="4">
                <StackPanel>
                    <Button Content="Rename" Style="{StaticResource ActionButtonStyle}"
                            Click="RenamePreset_Click" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"/>
                    <Button Content="Duplicate" Style="{StaticResource ActionButtonStyle}"
                            Click="DuplicatePreset_Click" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"/>
                    <Button Content="Update with Current Layout" Style="{StaticResource ActionButtonStyle}"
                            Click="UpdatePreset_Click" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"/>
                    <Separator Background="{StaticResource BorderBrush}" Margin="4,4"/>
                    <Button Content="Delete" Style="{StaticResource ActionButtonStyle}"
                            Click="DeletePreset_Click" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Foreground="#FF6666"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
