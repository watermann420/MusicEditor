<Window x:Class="MusicEngineEditor.Views.SessionViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MusicEngineEditor.Views"
        mc:Ignorable="d"
        Title="Session View"
        Width="1000" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Dark theme colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="TitleBarColor">#181818</Color>
        <Color x:Key="ToolbarColor">#1A1A1A</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="SuccessColor">#00FF88</Color>
        <Color x:Key="ErrorColor">#FF4757</Color>
        <Color x:Key="WarningColor">#FFB800</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="SecondaryTextColor">#808080</Color>
        <Color x:Key="ButtonHoverColor">#252525</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="LocalBackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="{StaticResource ToolbarColor}"/>
        <SolidColorBrush x:Key="LocalBorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}"/>

        <!-- Title Bar Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style (red on hover) -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource LocalBackgroundBrush}"
            BorderBrush="{StaticResource LocalBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Custom Title Bar -->
                <RowDefinition Height="32"/>
                <!-- Main Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource LocalBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <!-- Session View Icon -->
                        <Grid Width="16" Height="16" Margin="0,0,8,0">
                            <Rectangle Width="4" Height="4" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,6" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Rectangle Width="4" Height="4" Fill="{StaticResource AccentBrush}" Margin="6,0,0,6" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Rectangle Width="4" Height="4" Fill="{StaticResource WarningBrush}" Margin="0,6,6,0" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Rectangle Width="4" Height="4" Fill="{StaticResource ErrorBrush}" Margin="6,6,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBlock Text="Session View"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="GridSizeText"
                                   Text=""
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Content="&#x2212;"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize"/>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Content="&#x25A1;"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize"/>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource CloseButtonStyle}"
                                Content="&#x2715;"
                                Click="CloseButton_Click"
                                ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content - Session View -->
            <views:SessionView x:Name="SessionViewControl"
                               Grid.Row="1"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"/>
        </Grid>
    </Border>
</Window>
