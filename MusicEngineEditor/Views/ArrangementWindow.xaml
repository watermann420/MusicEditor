<Window x:Class="MusicEngineEditor.Views.ArrangementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MusicEngineEditor.Controls.Arrangement"
        mc:Ignorable="d"
        Title="Arrangement"
        Width="1200" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        ShowInTaskbar="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Dark theme colors -->
        <Color x:Key="BackgroundColor">#0D0D0D</Color>
        <Color x:Key="TitleBarColor">#181818</Color>
        <Color x:Key="ToolbarColor">#1A1A1A</Color>
        <Color x:Key="BorderColor">#2A2A2A</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="SecondaryTextColor">#808080</Color>
        <Color x:Key="ButtonHoverColor">#252525</Color>
        <Color x:Key="MinimapColor">#1E1E1E</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="LocalBackgroundBrush" Color="{StaticResource BackgroundColor}"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="{StaticResource ToolbarColor}"/>
        <SolidColorBrush x:Key="LocalBorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}"/>
        <SolidColorBrush x:Key="MinimapBrush" Color="{StaticResource MinimapColor}"/>

        <!-- Title Bar Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style (red on hover) -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LocalBorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button Style -->
        <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LocalBorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ToolbarBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LocalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Slider Style -->
        <Style x:Key="ZoomSliderStyle" TargetType="Slider">
            <Setter Property="Minimum" Value="0.25"/>
            <Setter Property="Maximum" Value="4"/>
            <Setter Property="Value" Value="1"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource LocalBackgroundBrush}"
            BorderBrush="{StaticResource LocalBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Custom Title Bar -->
                <RowDefinition Height="32"/>
                <!-- Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- Main Content -->
                <RowDefinition Height="*"/>
                <!-- Overview Minimap -->
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource LocalBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <TextBlock Text="Arrangement"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TrackCountText"
                                   Text=""
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Content="&#x2212;"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize"/>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource CloseButtonStyle}"
                                Content="&#x2715;"
                                Click="CloseButton_Click"
                                ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Toolbar -->
            <Border Grid.Row="1"
                    Background="{StaticResource ToolbarBrush}"
                    BorderBrush="{StaticResource LocalBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,6">
                <DockPanel>
                    <!-- Left Section -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <!-- Snap Toggle -->
                        <ToggleButton x:Name="SnapToggle"
                                      Style="{StaticResource ToolbarToggleButtonStyle}"
                                      Content="Snap"
                                      IsChecked="True"
                                      ToolTip="Enable grid snapping"/>

                        <Rectangle Width="1"
                                   Fill="{StaticResource LocalBorderBrush}"
                                   Margin="12,4"/>

                        <!-- Grid Selector -->
                        <TextBlock Text="Grid:"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="GridCombo"
                                  Style="{StaticResource ToolbarComboBoxStyle}"
                                  SelectionChanged="GridCombo_SelectionChanged"
                                  ToolTip="Grid resolution">
                            <ComboBoxItem Content="1 Bar" Tag="4" IsSelected="True"/>
                            <ComboBoxItem Content="1/2 Bar" Tag="2"/>
                            <ComboBoxItem Content="1 Beat" Tag="1"/>
                            <ComboBoxItem Content="1/2 Beat" Tag="0.5"/>
                            <ComboBoxItem Content="1/4 Beat" Tag="0.25"/>
                        </ComboBox>

                        <Rectangle Width="1"
                                   Fill="{StaticResource LocalBorderBrush}"
                                   Margin="12,4"/>

                        <!-- Zoom Slider -->
                        <TextBlock Text="Zoom:"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Slider x:Name="ZoomSlider"
                                Style="{StaticResource ZoomSliderStyle}"
                                ValueChanged="ZoomSlider_ValueChanged"
                                ToolTip="Horizontal zoom level"/>
                        <TextBlock x:Name="ZoomText"
                                   Text="100%"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Width="45"
                                   Margin="8,0,0,0"/>

                        <Rectangle Width="1"
                                   Fill="{StaticResource LocalBorderBrush}"
                                   Margin="12,4"/>

                        <!-- Add Track Button -->
                        <Button x:Name="AddTrackButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Content="+ Add Track"
                                Click="AddTrackButton_Click"
                                ToolTip="Add new track"/>
                    </StackPanel>

                    <!-- Right Section -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                        <TextBlock x:Name="StatusText"
                                   Text=""
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Spacer -->
                    <Border/>
                </DockPanel>
            </Border>

            <!-- Main Content - Arrangement Control -->
            <controls:ArrangementControl x:Name="ArrangementView"
                                         Grid.Row="2"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"/>

            <!-- Overview Minimap -->
            <Border Grid.Row="3"
                    Background="{StaticResource MinimapBrush}"
                    BorderBrush="{StaticResource LocalBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Minimap Label -->
                    <TextBlock Grid.Column="0"
                               Text="Overview"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <!-- Minimap Content Placeholder -->
                    <Border Grid.Column="1"
                            x:Name="MinimapContent"
                            Background="{StaticResource LocalBackgroundBrush}"
                            BorderBrush="{StaticResource LocalBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                        <!-- Viewport indicator -->
                        <Canvas x:Name="MinimapCanvas" ClipToBounds="True">
                            <Border x:Name="ViewportIndicator"
                                    Background="#3000D9FF"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    Height="40"
                                    Width="100"
                                    Canvas.Left="0"
                                    Canvas.Top="4"/>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
